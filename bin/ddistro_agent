def explore_spec(checkout, services=False):
    """EXPLORE_SPEC, plus the checkout operation for a session that negotiated change_files and the services operation
    for one that negotiated service_control."""
    if not checkout and not services:
        return EXPLORE_SPEC
    spec = json.loads(json.dumps(EXPLORE_SPEC))
    schema = spec["inputSchema"]["properties"]
    if services:
        schema["operation"]["enum"].append("services")
        spec["description"] = spec["description"].replace(" It cannot change anything", (
            " services: the typed service operations ddistro_action propose_service can offer (targets, verbs, "
            "branches) and the unsupported ones with why; it takes no other field. It cannot change anything"))
    if not checkout:
        return spec
    schema["operation"]["enum"].append("checkout")
    schema["root"]["description"] = "list/search/read/config/checkout only (required): a root id from roots"
    schema["paths"] = {"type": "array", "minItems": 1, "maxItems": FILE_CHECKOUT_PATHS,
                       "items": {"type": "string", "maxLength": FILE_CHECKOUT_PATH_CHARS},
                       "description": "checkout only (required): files relative to root, existing or new"}
    spec["description"] = spec["description"].replace(" It cannot change anything and takes no SQL.", (
        " checkout copies files of one root whose roots entry has change true into this chat's workspace at "
        "/work/<root>/<path> (new files may be named too); edit them there, then propose them with ddistro_action "
        "propose_file_change. Nothing live changes without the user's approval; it takes no SQL."))
    return spec


# What to do next for an explore error, by ddistro (or broker) error code.
EXPLORE_HINTS = {
    "invalid_arguments": "fix the arguments named in the message; call roots for root ids or db_schema for tables",
    "invalid_argument": "fix the value named in the message; use roots, list or db_schema to find valid names",
    "refused": "that path or query is outside the read policy (masked, binary or raw SQL); pick another file or "
               "use a structured query_json",
    "limit_reached": "narrow the request: a smaller lines, limit or depth, a sub-path, or more filters",
    "not_found": "it does not exist there; list the parent folder or run db_schema to see what does",
    "unsupported": "this root or database has no reviewed read access; say so instead of guessing",
    "permission_denied": "the database reader is not granted for that; report it, the user can rerun "
                         "install_assistant_runtime --db-reader",
    "helper_unavailable": "read access is not installed on this machine; use ddistro_read diagnostics instead",
    "helper_untrusted": "read access is not installed on this machine; use ddistro_read diagnostics instead",
    "unsafe_path": "the path crosses a link or writable folder and was not read; report the path",
    "timeout": "the read ran out of time; narrow it to a sub-path or fewer rows",
    "output_too_large": "narrow the request: a smaller lines, limit or depth, a sub-path, or more filters",
    "conflict": "nothing was checked out: a workspace copy was edited while its live file changed too, or an unknown "
                "file sits at that workspace path; report the path to the user",
}
# A refusal of a task that cannot hold multi-root changes (ddistro changes details.reason).
