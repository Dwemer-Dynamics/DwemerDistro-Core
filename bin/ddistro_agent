# Profiles live only in requirements so the account-home user layer cannot redefine them.
# There is deliberately no managed [permissions.filesystem] deny_read (Codex 0.163.0): Codex
# always makes its per-session arg0 helper alias directory, $CODEX_HOME/tmp/arg0-linux/codex-arg0*
# (symlinks to the pinned runtime binary and a lock file; no credentials), an extra readable
# root, and rejects startup if any managed deny_read root contains it. A managed deny on /agent,
# /agent/home or /agent/home/tmp therefore cannot load, and exact managed denies beneath the
# profile's /agent deny would be nested masks under its read-only tmpfs, which the Linux sandbox
# does not support. The only selectable profile denies /agent, and the Linux sandbox masks all
# of /agent for tools. sandbox_command makes the alias root read-only, so Codex skips the alias
# (and its extra readable root) and uses the pinned runtime binary as its sandbox helper.
# There is deliberately no legacy allowed_sandbox_modes either: Codex 0.163.0 classifies any
# profile with a write entry as workspace-write, so ["read-only"] would reject dwemer-scratch and
# fall back to a read-only profile. allowed_permission_profiles and default_permissions are the
# authority, and the broker strips every client sandbox, sandboxPolicy, and permissions override.
REQUIREMENTS_TOML = """\
# Managed by ddistro_agent; bound read-only at /etc/codex/requirements.toml in the sandbox.
allowed_approval_policies = ["never"]
default_permissions = "dwemer-scratch"
allow_login_shell = false
allow_managed_hooks_only = true

[allowed_permission_profiles]
dwemer-scratch = true

[permissions.dwemer-scratch]
description = "DwemerDistro assistant: task scratch only"

[permissions.dwemer-scratch.filesystem]
":minimal" = "read"
":slash_tmp" = "write"
"/usr" = "read"
"/etc" = "read"
"/opt/dwemerdistro-agent/runtime" = "read"
"/task" = "read"
"/agent" = "deny"

[permissions.dwemer-scratch.filesystem.":workspace_roots"]
"." = "write"

[permissions.dwemer-scratch.network]
enabled = false

[features]
apps = false
browser_use = false
