TOOL_CONCURRENCY = 2
# A runaway read loop is bounded per turn (calls and returned text) and per session. A full distro check is
# about 4-10 calls. Past the turn limits calls are answered with an actionable refusal; once refusals reach
# TOOL_TURN_CALLS again the broker interrupts that turn itself. The client can always send turn/interrupt.
TOOL_TURN_CALLS = 16
TOOL_TURN_TEXT = 512 * 1024
TOOL_SESSION_CALLS = 256
TOOL_TRACKED_TURNS = 64
# On session end diagnostic children get SIGTERM, then SIGKILL after this grace; their threads are joined.
TOOL_STOP_GRACE = 2.0
# An oversized response is discarded unread up to this many bytes in total; beyond that the session closes.
SERVER_DISCARD_LIMIT = 256 * 1024 * 1024
SHUTDOWN_GRACE = 10.0
# The client reader polls so it can leave before interpreter shutdown instead of blocking in stdin.
CLIENT_POLL = 0.2
