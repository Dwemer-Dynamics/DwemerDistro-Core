# live_service (with live_run and live_run_auto, and only when ddistro service list answers): operation service restarts
# or checks the code-owned apache or a root-registered service through the trusted `ddistro service <verb> <id>` in the
# distro's own namespaces. Nothing from the request becomes a command, path or argument but a checked id and a verb;
# ddistro resolves and validates the id again. A restart starts at once without a card (service control is routine);
# stop, start, PostgreSQL and unregistered targets are refused before anything runs. See ASSISTANT_RUNTIME.md
# "Service operation".
RUN_SERVICE_CAPABILITY = "live_service"
RUN_SERVICE_OPERATION = "service"
RUN_SERVICE_VERBS = ("restart", "status", "list")
# Mirrors ddistro SERVICE_ID.
RUN_SERVICE_ID = re.compile(r"^[a-z][a-z0-9-]{1,31}\Z")
RUN_SERVICE_PROPERTIES = {
    "target": {"type": "string", "maxLength": 32,
               "description": "service restart/status (required): apache or a registered id from verb list"},
    "verb": {"type": "string", "enum": list(RUN_SERVICE_VERBS),
             "description": "service only (required): restart (runs at once), status or list (read-only)"}}
RUN_SERVICE_ROUTE = (" Restart or check services with operation service (verb list, status or restart, target, "
                     "reason), never from run code: it runs the trusted DwemerDistro service control in the distro's "
                     "own view at once, without asking, and verifies a new process in the distro's own mount and network namespaces and "
                     "its ports (an HTTP check, if any, proves only that it answers, not that it is healthy). Targets "
                     "are apache (shared: every server pauses for a few seconds) and the root-registered services verb "
                     "list returns with their label and impact. stop, start and PostgreSQL are not offered, and "
                     "a service that is not registered needs root to register a trusted init wrapper first; do not "
                     "start it yourself from run code.")
RUN_SERVICE_HINTS = {
    "verified": "a new process runs in the distro's own view and its ports answer; that is not application health",
    "failed": "the restart ran but was not verified; report the failed checks and do not retry automatically",
    "running": "the process is in the distro's own view and its ports answer; that is not application health",
    "degraded": ("the process is running but a check failed; namespace failed means it is in a private run view and "
                 "unreachable: restart it with operation service"),
    "not_running": "no live process behind its pid file",
    "unchecked": "the process runs and its ports answer, but its namespaces could not be read; not verified",
    "refused": "nothing ran; fix the request named in the message",
    "unsupported": ("nothing ran: only apache and root-registered services are supported; an unregistered service needs "
                    "root to register a trusted init wrapper. Do not start it from run code"),
