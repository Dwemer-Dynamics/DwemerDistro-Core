# The live actions. The model can only propose; the broker announces the proposal to the client
# (ddistro/action/proposed, with an id the model never sees), and only the client's ddistro/action/decide approve
# for that pending, unexpired proposal of the same thread runs its fixed root ddistro command once.
# Declared only to a client that opts in with initialize capabilities.ddistroActions: "restart_service" (fixed
# `ddistro service restart <service>`) and, separately, "configure_model" (a CHIM profile role's connector, through
# `ddistro models preview|apply|rollback-preview|rollback herika`). A client without configure_model gets exactly the
# restart-only declaration below and can never be sent a model proposal.
ACTION_TOOL = "ddistro_action"
ACTION_CAPABILITY = "restart_service"
ACTION_MODEL_CAPABILITY = "configure_model"
ACTION_OPERATIONS = {ACTION_CAPABILITY: ("propose_restart",),
