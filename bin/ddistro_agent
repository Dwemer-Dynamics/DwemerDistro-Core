def action_spec(capabilities):
    """The ddistro_action declaration for the client's opted-in capabilities. restart_service alone is exactly
    ACTION_SPEC, so an older client keeps its schema; the schema is flat and per-operation fields are runtime checks."""
    if capabilities == {ACTION_CAPABILITY}:
        return ACTION_SPEC
    files = ACTION_FILES_CAPABILITY in capabilities
    service = ACTION_SERVICE_CAPABILITY in capabilities
    # Without change_files or service_control the declaration is exactly the earlier restart+model one.
    model = ACTION_MODEL_CAPABILITY in capabilities or not (files or service)
    operations = [name for capability in (ACTION_CAPABILITY, ACTION_MODEL_CAPABILITY, ACTION_FILES_CAPABILITY,
                                          ACTION_SERVICE_CAPABILITY)
                  if capability in capabilities for name in ACTION_OPERATIONS[capability]]
    properties = {"operation": {"type": "string", "enum": operations}}
    if ACTION_CAPABILITY in capabilities:
        properties["service"] = {"type": "string", "enum": list(ACTION_SERVICES), "description": "propose_restart only"}
    if service:
        properties.update({
            "target": {"type": "string", "maxLength": 32,
                       "description": "propose_service only (required): a target id from ddistro_explore services, "
                                      "apache or herika, lorkhan, stobe, dialectic, reign"},
            "verb": {"type": "string", "enum": list(SERVICE_VERBS),
                     "description": "propose_service only (required): restart for apache; install or update for a server"},
            "branch": {"type": "string", "maxLength": 100,
                       "description": "propose_service install/update only: a branch from services (default main)"}})
    if model:
        properties.update({
            "profile_id": {"type": "integer", "minimum": 1, "maximum": ACTION_ID_MAX,
                           "description": "propose_model_change only: a CHIM profile id from ddistro_read model_options"},
            "role": {"type": "string", "enum": list(ACTION_MODEL_ROLES), "description": "propose_model_change only"},
            "connector_id": {"type": "integer", "minimum": 1, "maximum": ACTION_ID_MAX,
                             "description": "propose_model_change only: an existing LLM connector id from model_options"}})
    properties["reason"] = {"type": "string", "maxLength": ACTION_REASON_CHARS,
                            "description": "one plain sentence shown to the user: why this should help"}
    return {"type": "function", "name": ACTION_TOOL,
            "description": "Propose one live change; you cannot approve or run it. The user sees the exact change with "
                           "Approve or Cancel in the launcher, and only their approval runs it, once. "
                           + ("propose_restart restarts one allowlisted service. " if ACTION_CAPABILITY in capabilities else "")
                           + ("propose_model_change points one role of one CHIM profile at an existing LLM connector "
                              "(ids from ddistro_read model_options; it never edits connectors, keys or files). "
                              "propose_model_rollback undoes this chat's last applied model change exactly. " if model else "")
                           + ("propose_file_change offers every edit in this chat's workspace (files checked out with "
                              "ddistro_explore checkout and edited under /work/<root>/) as one reviewed diff; "
                              "propose_file_undo offers to undo this chat's last applied file change. Both take only "
                              "reason. " if files else "")
                           + ("propose_service offers one typed operation from ddistro_explore services: restart "
                              "apache, or install or update one server on an allowed branch. It takes target, verb, "
                              "optional branch and reason, never a command; unsupported targets and verbs are refused "
                              "with the reason. Service health is not checked by it. " if service else "")
                           + "The reply says "
                           "whether it was refused, cancelled, expired, a conflict, not executed, unknown or executed, and "
                           "whether a fresh read verified it; report exactly that. At most one of each operation per turn.",
            "inputSchema": {"type": "object", "additionalProperties": False, "required": ["operation", "reason"],
                            "properties": properties}}


def action_id(arguments, key):
    """A positive integer id that fits PostgreSQL integer; booleans, floats, strings and overflow are refused."""
    value = arguments.get(key)
    if type(value) is not int or not 0 < value <= ACTION_ID_MAX:
        raise PolicyError(-32602, "%s must be a positive whole number id" % key)
    return value


def model_plan(payload, undo):
    """The private plan (receipt id and confirmation) and the public view of a ddistro models preview, or None."""
    if not isinstance(payload, dict) or payload.get("state") != "previewed":
        return None
    receipt, confirm, diff = payload.get("receipt_id"), payload.get("plan_sha256"), payload.get("diff")
    profile, role = payload.get("profile"), payload.get("role")

    def side(value):
        connector = value.get("connector") if isinstance(value, dict) else None
        if (not isinstance(value, dict) or value.get("value") is not None and type(value.get("value")) is not int
                or connector is not None and not isinstance(connector, dict)):
            raise ValueError("side")
        return {"connector_id": value.get("value"), "connector": None if connector is None else {
            key: str(connector.get(key) or "")[:256] for key in ("label", "model", "provider", "driver")}}
    try:
        if (not isinstance(receipt, str) or not MODEL_RECEIPT_PATTERN.match(receipt) or not isinstance(confirm, str)
                or not MODEL_HASH_PATTERN.match(confirm) or not isinstance(diff, list) or len(diff) != 3
                or not all(isinstance(line, str) and len(line) <= 1200 for line in diff)
                or not isinstance(profile, dict) or type(profile.get("id")) is not int or role not in ACTION_MODEL_ROLES):
            return None
        view = {"product": "herika", "profile": {"id": profile["id"], "label": str(profile.get("label") or "")[:256]},
                "role": role, "before": side(payload.get("before")), "after": side(payload.get("after")), "diff": diff}
    except ValueError:
        return None
    if not undo and view["after"]["connector"] is None:
        return None
    return {"receipt_id": receipt, "plan_sha256": confirm, "view": sanitize(view)}


def model_outcome(ok, payload, plan):
    """The proposal's state from ddistro models apply/rollback: its own reported state for this receipt, busy or expired,
    not_executed for a refusal before the write, and unknown for anything else (a timeout, a lost or odd result)."""
    if ok:
        if (isinstance(payload, dict) and payload.get("receipt_id") == plan["receipt_id"]
                and payload.get("state") in ACTION_MODEL_STATES):
            if payload["state"] == "verified" and payload.get("verified") is not True:
                return "unknown"
            return payload["state"]
        return "unknown"
    code = payload.get("code") if isinstance(payload, dict) else None
    if code in ("busy", "expired"):
        return code
    return "not_executed" if code in ACTION_MODEL_NOT_RUN_CODES else "unknown"


def model_executed(state):
    """True when a model change was written, False when it was not, None when that is not known."""
    if state in ("verified", "unverified"):
        return True
    return None if state == "unknown" else False


def file_diff_lines(diff):
    """The full unified diff as the Launcher's line array, or None when it cannot be shown whole: over 4000 lines,
    4096 characters a line or 256 KiB, a control character, or no ---/+++ header pair. Never cut to fit."""
    if not isinstance(diff, str) or not diff:
        return None
    lines = diff.split("\n")
    if diff.endswith("\n"):
        lines.pop()
    if not 0 < len(lines) <= FILE_DIFF_LINES:
        return None
    total = 0
    for line in lines:
        body = line[:-1] if line.endswith("\r") else line
        if len(line) > FILE_DIFF_LINE_CHARS or FILE_DIFF_CONTROL.search(body):
            return None
        try:
            total += len(line.encode("utf-8")) + 1
        except UnicodeEncodeError:
            return None
    if total > FILE_DIFF_BYTES or not lines[0].startswith(("diff ", "--- ")):
        return None
    if not any(a.startswith("--- ") and b.startswith("+++ ") for a, b in zip(lines, lines[1:])):
        return None
    return lines


def file_plan(payload, undo, task_id):
    """(plan, refusal) from ddistro changes stage or rollback-preview. The plan keeps the hash the approval binds and
    the files the receipt must match; the refusal is an error code and message when no card may be shown."""
    if not isinstance(payload, dict) or payload.get("task_id") != task_id:
        return None, ("helper_protocol", "ddistro returned an unexpected preview")
    if undo and payload.get("state") == "nothing_to_undo":
        return None, ("nothing_to_undo", "this chat has no applied file change left to undo")
    digest = payload.get("preview_sha256" if undo else "manifest_sha256")
    files = payload.get("files")
    if (payload.get("state") != ("undo_available" if undo else "staged") or not isinstance(digest, str)
            or not MODEL_HASH_PATTERN.match(digest) or not isinstance(files, list)
            or not all(isinstance(item, dict) for item in files)):
        return None, ("helper_protocol", "ddistro returned an unexpected preview")
    if not files:
        return None, ("no_changes", "the workspace copies match their live files; edit /work/<root>/... first")
    if payload.get("diff_truncated") not in (None, False):
        return None, ("diff_too_large", "the diff was truncated, so it cannot be reviewed; propose fewer files")
    lines = file_diff_lines(payload.get("diff"))
    if lines is None:
        return None, ("diff_too_large", "the full diff exceeds %d lines, %d characters a line or %d KiB, or has "
                      "control characters, so it cannot be reviewed; propose fewer or smaller edits"
                      % (FILE_DIFF_LINES, FILE_DIFF_LINE_CHARS, FILE_DIFF_BYTES // 1024))
    keys = sorted((str(item.get("root")), str(item.get("path"))) for item in files)
    view = [{key: sanitize(item.get(key)) for key in ("root", "path", "action")} for item in files]
    return {"sha256": digest, "diff": lines, "files": keys, "view": view}, None


def file_outcome(ok, payload, plan, undo, task_id):
    """The proposal's state from ddistro changes apply/undo, read from its receipt, never guessed: verified only when
    the receipt binds the approved hash and wrote every reviewed file; conflict/stale when nothing was overwritten."""
    if ok:
        receipt = payload.get("receipt") if isinstance(payload, dict) else None
        if not isinstance(receipt, dict) or payload.get("task_id") != task_id:
            return "not_executed" if isinstance(payload, dict) and payload.get("state") == "no_changes" else "unknown"
        files = receipt.get("files") if isinstance(receipt.get("files"), list) else []
        bound = (receipt.get("preview_sha256") if undo else receipt.get("manifest_sha256")) == plan["sha256"]
        written = sorted((str(item.get("root")), str(item.get("path"))) for item in files
                         if isinstance(item, dict) and item.get("state") == "written")
        state = "rolled_back" if undo else "applied"
        if bound and receipt.get("state") == state and payload.get("state") == state and written == plan["files"]:
            return "verified"
        return "unknown"
    code = payload.get("code") if isinstance(payload, dict) else None
    details = payload.get("details") if isinstance(payload, dict) and isinstance(payload.get("details"), dict) else {}
    if code == "conflict":
        return "stale" if details.get("reason") in ("stale_stage", "stale_preview") else "conflict"
    if code == "busy":
        return "busy"
    if code == "failed" and isinstance(details.get("receipt"), dict):
        return "failed"  # the receipt says no file was written
    if code == "partial" and details.get("state") not in ("interrupted",) and isinstance(details.get("receipt"), dict):
        return "failed"  # some files were written; the receipt lists which
    return "not_executed" if code in FILE_NOT_RUN_CODES else "unknown"


def file_executed(state, payload):
    """True when live files were written, False when none were, None when that is not known."""
    if state == "verified":
        return True
    if state == "failed":
        details = payload.get("details") if isinstance(payload, dict) else None
        receipt = details.get("receipt") if isinstance(details, dict) else None
        files = receipt.get("files") if isinstance(receipt, dict) else None
        return any(isinstance(item, dict) and item.get("state") == "written" for item in files or ())
    return None if state == "unknown" else False


def service_request(arguments):
    """(target, verb, branch) for validated propose_service arguments. Only the fixed fields exist: a command, argv,
    environment or script key is refused like any unknown key, and unsupported targets and verbs are refused with
    ddistro's reason before anything runs. Returns (None, refusal) instead when the matrix has no such operation."""
    reject_unknown(arguments, ("operation", "target", "verb", "branch", "reason"))
    target, verb, branch = arguments.get("target"), arguments.get("verb"), arguments.get("branch")
    if not isinstance(target, str) or not SERVICE_TARGET.match(target):
        raise PolicyError(-32602, "target must be a target id from ddistro_explore services")
    if not isinstance(verb, str) or not SERVICE_VERB.match(verb):
        raise PolicyError(-32602, "verb must be one of " + ", ".join(SERVICE_VERBS))
    if target not in SERVICE_TARGETS:
        why = SERVICE_POSTGRES_REASON if target == "postgresql" else SERVICE_COMPONENT_REASON
        return None, {"code": "unsupported", "message": "%s has no typed operation: %s" % (target, why),
                      "details": {"reason": "unsupported_target"}}
    if verb not in SERVICE_TARGETS[target]:
        why = SERVICE_UNSUPPORTED_VERBS.get(verb, "not a typed operation for this target")
        return None, {"code": "unsupported", "message": "%s is not offered for %s (%s): %s" % (
            verb, target, ", ".join(SERVICE_TARGETS[target]), why), "details": {"reason": "unsupported_verb"}}
    if branch is not None:
        if target == "apache":
            raise PolicyError(-32602, "apache restart takes no branch")
        if not isinstance(branch, str) or not SERVICE_BRANCH.match(branch) or ".." in branch:
            raise PolicyError(-32602, "branch must be a branch name from ddistro_explore services, like main or dev")
    return (target, verb, branch), None


def service_summary(lines):
    """The receipt's summary as the Launcher's service card lines, or None: 1-8 non-blank lines of at most 4096
    characters, no control characters, 8 KiB in total. Never cut to fit."""
    if not isinstance(lines, list) or not 0 < len(lines) <= SERVICE_SUMMARY_LINES:
        return None
    total = 0
    for line in lines:
        if (not isinstance(line, str) or not line.strip() or len(line) > SERVICE_SUMMARY_LINE_CHARS
                or FILE_DIFF_CONTROL.search(line) or "\t" in line):
            return None
        try:
            total += len(line.encode("utf-8"))
        except UnicodeEncodeError:
            return None
    return lines if total <= SERVICE_SUMMARY_BYTES else None


def service_stamp(value):
    """Epoch seconds of ddistro's model_stamp (YYYY-MM-DDTHH:MM:SSZ), or None."""
    if not isinstance(value, str) or not re.match(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\Z", value):
        return None
    try:
        return calendar.timegm(time.strptime(value, "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        return None


def service_plan(payload, request, task_id, thread_id, now=None):
    """The private plan (receipt id, plan hash) and the card view of ddistro operations preview, or None. Every binding
    is checked against what the broker asked: target, verb, branch (main when a server got none), task and thread, a
    fresh unexecuted preview, a 128-bit receipt id, sha256 hashes and a receipt expiry within its 120 s TTL."""
    target, verb, branch = request
    if not isinstance(payload, dict):
        return None
    receipt, digest, helper = payload.get("receipt_id"), payload.get("plan_sha256"), payload.get("helper_sha256")
    expires = service_stamp(payload.get("expires_at"))
    now = time.time() if now is None else now
    expected = None if target == "apache" else (branch or "main")
    lines = service_summary(payload.get("summary"))
    if (payload.get("state") != "previewed" or payload.get("target") != target or payload.get("verb") != verb
            or payload.get("branch") != expected or payload.get("task_id") != task_id
            or payload.get("thread_id") != thread_id or payload.get("executed") is not None
            or payload.get("verified") is not False or payload.get("replayed") is not False
            or not isinstance(receipt, str) or not MODEL_RECEIPT_PATTERN.match(receipt)
            or not isinstance(digest, str) or not MODEL_HASH_PATTERN.match(digest)
            or not isinstance(helper, str) or not MODEL_HASH_PATTERN.match(helper)
            or expires is None or expires > now + SERVICE_PREVIEW_SECONDS + SERVICE_EXPIRY_MARGIN or lines is None):
        return None
    seconds = min(ACTION_APPROVAL_SECONDS, expires - now - SERVICE_EXPIRY_MARGIN)
    if seconds <= 0:
        return None
    resolved = payload.get("resolved_branch")
    view = {"target": target, "verb": verb, "diff": sanitize(lines)}
    if expected is not None:
        view["branch"] = expected
    return {"receipt_id": receipt, "plan_sha256": digest, "seconds": seconds, "view": view,
            "resolved_branch": resolved if isinstance(resolved, str) and SERVICE_BRANCH.match(resolved) else None}


def service_checks(result):
    """The receipt's own checks, bounded and without output; [] when it recorded none."""
    checks = result.get("checks") if isinstance(result, dict) else None
    if not isinstance(checks, list):
        return []
    return [{"id": str(c.get("id"))[:64], "result": c.get("result") if c.get("result") in ("passed", "failed") else
             "unknown", "detail": sanitize(str(c.get("detail") or "")[:200])} for c in checks[:16] if isinstance(c, dict)]


def service_outcome(ok, payload, plan, request, task_id, thread_id):
    """(state, executed) from ddistro operations apply, read from its receipt and never guessed from an exit code:
    verified only when the receipt for this exact plan says verified, executed and every recorded check passed."""
    if not ok:
        code = payload.get("code") if isinstance(payload, dict) else None
        if code == "busy":
            return "busy", False
        return ("not_executed", False) if code in SERVICE_NOT_RUN_CODES else ("unknown", None)
    target, verb, _ = request
    if (not isinstance(payload, dict) or payload.get("receipt_id") != plan["receipt_id"]
            or payload.get("plan_sha256") != plan["plan_sha256"] or payload.get("target") != target
            or payload.get("verb") != verb or payload.get("task_id") != task_id or payload.get("thread_id") != thread_id
            or payload.get("state") not in SERVICE_STATES):
        return "unknown", None
    state, executed = payload["state"], payload.get("executed")
    if state in ("verified", "unverified", "failed"):
        if executed is not True:
            return "unknown", None
        checks = service_checks(payload.get("result"))
        if state == "verified" and not (payload.get("verified") is True and checks
                                        and all(c["result"] == "passed" for c in checks)):
            return "unverified", True
        return state, True
    if executed is not False:
        return "unknown", None
    return state, False


def service_targets_view(payload):
    """ddistro operations targets for the model: the matrix and the unsupported reasons, without handler names."""
    if not isinstance(payload, dict) or not isinstance(payload.get("targets"), list):
        return payload
    view = {"targets": [{key: item[key] for key in SERVICE_TARGET_KEYS if key in item}
                        for item in payload["targets"][:32] if isinstance(item, dict)]}
    for key in ("unsupported", "verification", "preview_seconds"):
        if key in payload:
            view[key] = payload[key]
    view["approval"] = ("propose_service shows the user the preview summary with Approve or Cancel; only approval runs "
                        "it, once. Service health is not checked.")
    return view


# live_run: general commands on the LIVE distro through the trusted ddistro_run supervisor. Declared only to a client
# that opts in with initialize capabilities.ddistroActions ["live_run"], and only when ddistro_run is a trusted
# root-owned file whose digest the attestation binds and whose isolation canary (live_run_isolation) passed. Without
# live_run_auto every run needs the user's approval of the exact request (or an active task grant of this session
# covering its account and network); with it, a run declared routine and showing no destructive sign starts at once and
# every other run needs that approval (never a grant). The model cannot approve, and the broker sends exactly the
# approved or automatic request bytes to the supervisor.
RUN_TOOL = "ddistro_run"
