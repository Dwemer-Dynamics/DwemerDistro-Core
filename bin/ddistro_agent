EXEC_SPEC = {
    "type": "function", "name": EXEC_TOOL,
    "description": "Runs one command in a dedicated sandbox to compute over DwemerDistro files: as an unprivileged "
                   "user, with no network, no databases and no capabilities. The files you list are captured now, "
                   "redacted, and mounted read-only at /inspect/<root>/<path>; they are snapshots, not the live files. "
                   "Only /work (this chat's workspace) and /tmp are writable, and nothing live can change. argv[0] is "
                   "one of " + ", ".join(EXEC_PROGRAMS) + ". stdout is capped at 64 KiB and stderr at 16 KiB. The "
                   "reply gives status (exited, timed_out, signaled), exit_code, whether output was truncated, and a "
                   "receipt per snapshot (captured_at, sha256, redactions).",
    "inputSchema": {"type": "object", "additionalProperties": False, "required": ["argv"], "properties": {
        "argv": {"type": "array", "minItems": 1, "maxItems": EXEC_ARGV_ITEMS, "items": {"type": "string"},
                 "description": "the program and its arguments, for example [\"grep\", \"-n\", \"text\", "
                                "\"/inspect/herika/conf/a.php\"]; at most 16 KiB in total"},
        "files": {"type": "array", "maxItems": EXEC_FILES,
                  "description": "files to snapshot into /inspect/<root>/<path>; secret, VCS, dependency, runtime, "
