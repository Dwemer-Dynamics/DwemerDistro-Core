CONFIG_TOML = """\
# Managed by ddistro_agent; bound read-only at /etc/codex/config.toml in the sandbox.
default_permissions = "dwemer-scratch"
approval_policy = "never"
check_for_update_on_startup = false

[shell_environment_policy]
inherit = "core"
"""

APP_SERVER_COMMAND = (RUNTIME_BIN_DIR + "/codex", "app-server", "--strict-config", "--listen", "stdio://")


class Refusal(Exception):
    """A fail-closed condition with a stable, secret-free reason code."""

    def __init__(self, reason):
        super().__init__(reason)
        self.reason = reason


class PolicyError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def sha256_bytes(data):
    return hashlib.sha256(data).hexdigest()


def sha256_file(path):
    digest = hashlib.sha256()
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            digest.update(chunk)
    finally:
        os.close(fd)
    return digest.hexdigest()


def policy_sha256():
    return sha256_bytes((LAYOUT_VERSION + "\0" + REQUIREMENTS_TOML + "\0" + CONFIG_TOML).encode())


def root_only_writable(st):
    return st.st_uid == 0 and not st.st_mode & 0o022


def trusted_chain(path, reason):
    """Every component of an absolute path must be a real, root-owned, root-only-writable entry."""
    current = "/"
    st = os.lstat(current)
    if not root_only_writable(st):
        raise Refusal(reason)
    for part in [p for p in path.split("/") if p]:
        current = os.path.join(current, part)
        try:
            st = os.lstat(current)
        except OSError:
            raise Refusal(reason)
        if stat.S_ISLNK(st.st_mode) or not root_only_writable(st):
            raise Refusal(reason)
    return st


def open_root_dir(path, reason, private=False):
    """Open a directory without following symlinks, requiring root ownership on every component."""
    fd = os.open("/", O_PATH_DIR)
    try:
        if not root_only_writable(os.fstat(fd)):
            raise Refusal(reason)
        for part in [p for p in path.split("/") if p]:
            next_fd = os.open(part, O_PATH_DIR, dir_fd=fd)
            os.close(fd)
            fd = next_fd
            if not root_only_writable(os.fstat(fd)):
                raise Refusal(reason)
        if private and os.fstat(fd).st_mode & 0o077:
            raise Refusal(reason)
        return fd
    except OSError:
        os.close(fd)
        raise Refusal(reason)
    except Refusal:
        os.close(fd)
        raise


def read_bounded(fd, limit):
    data = b""
    while len(data) <= limit:
        chunk = os.read(fd, 65536)
        if not chunk:
            return data
        data += chunk
    raise Refusal("metadata_too_large")


def write_root_file(dir_fd, name, data, mode):
    """Atomically replace a file in a root-only directory."""
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(4))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=dir_fd)
    try:
        os.fchmod(fd, mode)
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)


def remove_entry(dir_fd, name):
    try:
        os.unlink(name, dir_fd=dir_fd)
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------- installation and attestation

def agent_identity():
    try:
        pw = pwd.getpwnam(AGENT_USER)
    except KeyError:
        raise Refusal("agent_identity_missing")
    if pw.pw_uid == 0 or pw.pw_gid == 0 or pw.pw_shell not in NOLOGIN_SHELLS:
        raise Refusal("agent_identity_unsafe")
    if any(AGENT_USER in g.gr_mem for g in grp.getgrall()):
        raise Refusal("agent_identity_unsafe")
    # The group gets search access above /work, so it must be ddagent's alone.
    try:
        group = grp.getgrgid(pw.pw_gid)
    except KeyError:
        raise Refusal("agent_identity_unsafe")
    if group.gr_name != AGENT_USER or group.gr_mem or any(
            p.pw_gid == pw.pw_gid and p.pw_name != AGENT_USER for p in pwd.getpwall()):
        raise Refusal("agent_identity_unsafe")
    return pw


def pinned_executable(path, expected, attestation, stat_field, digest_field):
    st = trusted_chain(path, "runtime_untrusted")
    if not stat.S_ISREG(st.st_mode) or not st.st_mode & 0o100:
        raise Refusal("runtime_untrusted")
    key = [st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns]
    # status may reuse an attested digest when the root-owned file is provably unchanged.
    if attestation and attestation.get(stat_field) == key and attestation.get(digest_field) == expected:
        digest = expected
    else:
        digest = sha256_file(path)
    if digest != expected:
        raise Refusal("runtime_hash_mismatch")
    return key


def runtime_state(attestation):
    key = pinned_executable(RUNTIME_BINARY, RUNTIME_SHA256, attestation, "runtime_stat", "runtime_sha256")
    trusted_chain(RUNTIME_BIN_DIR, "runtime_untrusted")
    for name in RUNTIME_LINKS:
        try:
            if os.readlink(os.path.join(RUNTIME_BIN_DIR, name)) != "../" + RUNTIME_NAME:
                raise Refusal("runtime_untrusted")
        except OSError:
            raise Refusal("runtime_untrusted")
    host_key = pinned_executable(CODE_MODE_HOST, CODE_MODE_HOST_SHA256, attestation,
                                 "code_mode_host_stat", "code_mode_host_sha256")
    return key, host_key


def bwrap_state():
    st = trusted_chain(BWRAP, "bwrap_missing")
    if not stat.S_ISREG(st.st_mode):
        raise Refusal("bwrap_missing")
    try:
        result = subprocess.run([BWRAP, "--help"], stdin=subprocess.DEVNULL, capture_output=True,
                                timeout=10, env={"PATH": SAFE_PATH})
    except (OSError, subprocess.TimeoutExpired):
        raise Refusal("bwrap_unsupported")
    usage = result.stdout + result.stderr
    if any(flag not in usage for flag in (b"--bind-fd", b"--ro-bind-data", b"--clearenv", b"--die-with-parent")):
        raise Refusal("bwrap_unsupported")
    # The sandbox guard runs on the host's read-only /usr, so its interpreter must be root's.
    python = os.path.realpath(GUARD_PYTHON)
    if not python.startswith("/usr/") or not stat.S_ISREG(trusted_chain(python, "python_untrusted").st_mode):
        raise Refusal("python_untrusted")
    return sha256_file(BWRAP)


def scratch_ancestor(st, identity):
    """A root directory above /work: ddagent's dedicated group may search it, never list or change it."""
    return (stat.S_ISDIR(st.st_mode) and st.st_uid == 0 and st.st_gid == identity.pw_gid
            and stat.S_IMODE(st.st_mode) == SCRATCH_ANCESTOR_MODE)


def open_tasks_root(identity):
    fd = open_root_dir(TASKS_ROOT, "state_untrusted")
    if not scratch_ancestor(os.fstat(fd), identity):
        os.close(fd)
        raise Refusal("tasks_root_untrusted")
    return fd


def state_layout(identity):
    for path, private in ((STATE_ROOT, False), (AGENT_STATE, False), (THREADS_DIR, True)):
        os.close(open_root_dir(path, "state_untrusted", private))
    os.close(open_tasks_root(identity))
    try:
        st = os.lstat(os.path.join(STATE_ROOT, ACCOUNT_HOME_NAME))
    except OSError:
        raise Refusal("account_home_missing")
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != identity.pw_uid or st.st_mode & 0o077:
        raise Refusal("account_home_untrusted")


def installation(attestation=None):
    """Verify everything a session depends on; returns the facts an attestation is bound to."""
    if platform.system() != "Linux" or platform.machine() != "x86_64":
        raise Refusal("unsupported_platform")
    helper = os.path.realpath(__file__)
    if not stat.S_ISREG(trusted_chain(helper, "helper_untrusted").st_mode):
        raise Refusal("helper_untrusted")
    runtime_stat, host_stat = runtime_state(attestation)
    identity = agent_identity()
    bwrap_digest = bwrap_state()
    state_layout(identity)
    uname = os.uname()
    return identity, {
        "schema_version": ATTESTATION_SCHEMA,
        "provider": PROVIDER,
        "codex_version": CODEX_VERSION,
        "runtime_sha256": RUNTIME_SHA256,
        "runtime_stat": runtime_stat,
        "code_mode_host_sha256": CODE_MODE_HOST_SHA256,
        "code_mode_host_stat": host_stat,
        "policy_sha256": policy_sha256(),
        "helper_sha256": sha256_file(helper),
        "bwrap_sha256": bwrap_digest,
        "kernel": "%s %s" % (uname.release, uname.version),
        "agent_uid": identity.pw_uid,
        "agent_gid": identity.pw_gid,
    }


def read_attestation():
    try:
        dir_fd = open_root_dir(AGENT_STATE, "state_untrusted")
    except Refusal:
        return None
    try:
        fd = os.open(ATTESTATION_NAME, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=dir_fd)
    except OSError:
        os.close(dir_fd)
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or not root_only_writable(st):
            return None
        document = json.loads(read_bounded(fd, METADATA_LIMIT))
        return document if isinstance(document, dict) else None
    except (OSError, ValueError, Refusal):
        return None
    finally:
        os.close(fd)
        os.close(dir_fd)


def attestation_matches(attestation, binding):
    if not attestation or attestation.get("passed") is not True:
        return False
    return all(attestation.get(key) == value for key, value in binding.items())


def verified_session_identity():
    """Full verification for a session: fresh runtime hash plus a matching attestation."""
    identity, binding = installation(None)
    attestation = read_attestation()
    if attestation is None:
        raise Refusal("probe_required")
    if not attestation_matches(attestation, binding):
        raise Refusal("probe_stale")
    return identity


# ---------------------------------------------------------------- task and account state

def load_task(task_id, identity):
    if not TASK_ID_PATTERN.match(task_id):
        raise Refusal("task_id_invalid")
    tasks_fd = open_tasks_root(identity)
    task_fd = meta_fd = None
    try:
        try:
            task_fd = os.open(task_id, O_DIR, dir_fd=tasks_fd)
        except FileNotFoundError:
            raise Refusal("task_missing")
        except OSError:
            raise Refusal("task_untrusted")
        st = os.fstat(task_fd)
        # A root-only 0700 task predates the runtime; it gains search access only after all checks.
        legacy = st.st_uid == 0 and stat.S_IMODE(st.st_mode) == 0o700
        if not (legacy or scratch_ancestor(st, identity)):
            raise Refusal("task_untrusted")
        try:
            meta_fd = os.open("task.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=task_fd)
        except OSError:
            raise Refusal("task_metadata_missing")
        st = os.fstat(meta_fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o177:
            raise Refusal("task_untrusted")
        try:
            document = json.loads(read_bounded(meta_fd, TASK_METADATA_LIMIT))
        except ValueError:
            raise Refusal("task_metadata_invalid")
        context = sanitize_task(document, task_id)
        try:
            work_fd = os.open("work", O_PATH_DIR, dir_fd=task_fd)
        except OSError:
            raise Refusal("task_work_missing")
        st = os.fstat(work_fd)
        if st.st_uid != identity.pw_uid:
            os.close(work_fd)
            raise Refusal("work_owner_mismatch")
        if st.st_mode & 0o002:
            os.close(work_fd)
            raise Refusal("task_untrusted")
        if legacy:
            try:
                os.fchown(task_fd, 0, identity.pw_gid)
                os.fchmod(task_fd, SCRATCH_ANCESTOR_MODE)
            except OSError:
                os.close(work_fd)
                raise Refusal("task_untrusted")
        return context, work_fd
    finally:
        for fd in (meta_fd, task_fd, tasks_fd):
            if fd is not None:
                os.close(fd)


def sanitize_task(document, task_id):
    if not isinstance(document, dict):
        raise Refusal("task_metadata_invalid")
    version = document.get("schema_version")
    if type(version) is not int or version != SCHEMA_VERSION or document.get("task_id") != task_id:
        raise Refusal("task_metadata_invalid")
    product = document.get("product")
    workspace = document.get("workspace")
    if not isinstance(product, str) or not PRODUCT_PATTERN.match(product):
        raise Refusal("task_metadata_invalid")
    if not isinstance(workspace, str) or not 0 < len(workspace) <= 256 or not workspace.isprintable():
        raise Refusal("task_metadata_invalid")
    # Only these labels reach the model; nothing from task.json is used as a host path.
    return {"schema_version": SCHEMA_VERSION, "task_id": task_id, "product": product,
            "workspace": workspace, "scratch": SANDBOX_WORK}


def open_account_home(identity, managed=True):
    """The account home as an O_PATH descriptor; managed (serve) also refuses any unmanaged config file in it."""
    state_fd = open_root_dir(STATE_ROOT, "state_untrusted")
    try:
        home_fd = os.open(ACCOUNT_HOME_NAME, O_PATH_DIR, dir_fd=state_fd)
    except OSError:
        raise Refusal("account_home_missing")
    finally:
        os.close(state_fd)
    st = os.fstat(home_fd)
    if st.st_uid != identity.pw_uid or st.st_mode & 0o077:
        os.close(home_fd)
        raise Refusal("account_home_untrusted")
    try:
        agent_fd = open_root_dir(AGENT_STATE, "state_untrusted")
        try:
            os.stat(HOME_CONFIG_PENDING, dir_fd=agent_fd, follow_symlinks=False)
            pending = True
        except FileNotFoundError:
            pending = False
        except OSError:
            pending = True
        finally:
            os.close(agent_fd)
    except Refusal:
        os.close(home_fd)
        raise
    if pending:
        os.close(home_fd)
        raise Refusal("home_config_repair_pending")
    for name in UNMANAGED_HOME_FILES if managed else ():
        try:
            os.stat(name, dir_fd=home_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError:
            pass
        os.close(home_fd)
        raise Refusal("account_home_unmanaged_config")
    return home_fd


class SingletonLock:
    def __init__(self):
        dir_fd = open_root_dir(AGENT_STATE, "state_untrusted")
        try:
            self.fd = os.open(LOCK_NAME, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dir_fd)
        except OSError:
            raise Refusal("state_untrusted")
        finally:
            os.close(dir_fd)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as exc:
            os.close(self.fd)
            if exc.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
                raise Refusal("busy")
            raise Refusal("state_untrusted")


class ThreadStore:
    """Root-owned task -> Codex thread mapping; resume and turns are limited to these threads."""

    def __init__(self, task_id):
        self.task_id = task_id
        self.ids = []
        if task_id is None:
            return
        dir_fd = open_root_dir(THREADS_DIR, "state_untrusted", private=True)
        try:
            fd = os.open(task_id + ".json", os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=dir_fd)
        except FileNotFoundError:
            return
        except OSError:
            raise Refusal("state_untrusted")
        finally:
            os.close(dir_fd)
        try:
            st = os.fstat(fd)
            # Same rule as task.json: a regular root file with mode 0600 or stricter.
            if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o177:
                raise Refusal("state_untrusted")
            document = json.loads(read_bounded(fd, METADATA_LIMIT))
            if not isinstance(document, dict) or document.get("task_id") != task_id:
                raise Refusal("state_untrusted")
            ids = document.get("thread_ids")
            if not isinstance(ids, list):
                raise Refusal("state_untrusted")
            self.ids = [i for i in ids if isinstance(i, str) and 0 < len(i) <= 128]
        except ValueError:
            raise Refusal("state_untrusted")
        finally:
            os.close(fd)

    def __contains__(self, thread_id):
        return isinstance(thread_id, str) and thread_id in self.ids

    def add(self, thread_id):
        if not isinstance(thread_id, str) or not 0 < len(thread_id) <= 128 or thread_id in self.ids:
            return
        self.ids = (self.ids + [thread_id])[-MAX_THREADS_PER_TASK:]
        self._save()

    def remove(self, thread_id):
        if thread_id in self.ids:
            self.ids = [i for i in self.ids if i != thread_id]
            self._save()

    def _save(self):
        if self.task_id is None:
            return
        document = {"schema_version": SCHEMA_VERSION, "task_id": self.task_id, "thread_ids": self.ids}
        dir_fd = open_root_dir(THREADS_DIR, "state_untrusted", private=True)
        try:
            write_root_file(dir_fd, self.task_id + ".json", json.dumps(document).encode(), 0o600)
        finally:
            os.close(dir_fd)


# ---------------------------------------------------------------- sandbox

# Trusted guard: this root-supplied code runs in the root-owned GUARD_PYTHON from the read-only
# /usr bind, as the agent UID, as the first program in every sandbox, before Codex or any probe
# command. bwrap resolves --bind-fd sources by path; the guard requires that /agent/home and /work
# are the device:inode of the descriptors root opened, that the process is exactly the agent UID
# and GID with no groups, no_new_privs and no capabilities, and only then execs the command.
SANDBOX_GUARD = r"""
import os, sys
uid, gid = int(sys.argv[1]), int(sys.argv[2])
def ident(path):
    try:
        st = os.lstat(path)
    except OSError:
        return None
    return "%d:%d" % (st.st_dev, st.st_ino)
status = open("/proc/self/status").read()
if (os.getresuid() != (uid, uid, uid) or os.getresgid() != (gid, gid, gid) or os.getgroups() not in ([], [gid])
        or "NoNewPrivs:\t1" not in status or "CapEff:\t0000000000000000" not in status
        or ident("/agent/home") != sys.argv[3] or ident("/work") != sys.argv[4]):
    sys.stderr.write("ddistro_agent guard: sandbox identity mismatch\n")
    sys.exit(97)  # GUARD_EXIT
os.execv(sys.argv[5], sys.argv[5:])
"""


def fd_identity(fd):
    st = os.fstat(fd)
    return "%d:%d" % (st.st_dev, st.st_ino)


def sandbox_files(identity, context):
    passwd = "root:x:0:0::/nonexistent:/usr/sbin/nologin\n%s:x:%d:%d::%s:/usr/sbin/nologin\n" % (
        AGENT_USER, identity.pw_uid, identity.pw_gid, SANDBOX_USER_HOME)
    group = "root:x:0:\n%s:x:%d:\n" % (AGENT_USER, identity.pw_gid)
    files = {
        "/etc/passwd": passwd.encode(),
        "/etc/group": group.encode(),
        "/etc/codex/requirements.toml": REQUIREMENTS_TOML.encode(),
        "/etc/codex/config.toml": CONFIG_TOML.encode(),
        SANDBOX_CONTEXT: (json.dumps(context, indent=2) + "\n").encode(),
    }
    # Copied as data so WSL's generated resolv.conf never exposes /mnt or /run.
    for name in ("hosts", "resolv.conf"):
        try:
            with open(os.path.realpath("/etc/" + name), "rb") as handle:
                files["/etc/" + name] = handle.read(32 * 1024)
        except OSError:
            continue
    return files


def sandbox_command(identity, context, work_fd, home_fd, command, expect=None):
    """Outer bubblewrap sandbox; returns argv and the descriptors it consumes.

    expect overrides the (home, work) identities the guard requires; only the probe uses it."""
    home_id, work_id = expect or (fd_identity(home_fd), fd_identity(work_fd))
    guard = [GUARD_PYTHON, "-I", "-S", "-c", SANDBOX_GUARD, str(identity.pw_uid), str(identity.pw_gid), home_id, work_id]
    env = {"HOME": SANDBOX_USER_HOME, "USER": AGENT_USER, "LOGNAME": AGENT_USER, "PATH": SANDBOX_PATH,
           "LANG": "C.UTF-8", "TMPDIR": "/tmp", "CODEX_HOME": SANDBOX_HOME}
    argv = [BWRAP, "--unshare-all", "--share-net", "--die-with-parent", "--new-session", "--clearenv"]
    for key, value in env.items():
        argv += ["--setenv", key, value]
    argv += ["--ro-bind", "/usr", "/usr", "--tmpfs", "/usr/local"]
    for name in ROOT_LINKS:
        path = "/" + name
        if os.path.islink(path):
            argv += ["--symlink", os.readlink(path), path]
        elif os.path.isdir(path):
            argv += ["--ro-bind", path, path]
    argv += ["--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp", "--tmpfs", "/home",
             "--dir", SANDBOX_USER_HOME, "--dir", "/etc", "--dir", "/etc/codex", "--dir", "/task",
             "--dir", "/agent", "--dir", RUNTIME_ROOT, "--ro-bind", RUNTIME_DIR, RUNTIME_DIR]
    for name in ETC_BINDS:
        path = "/etc/" + name
        real = os.path.realpath(path)
        if os.path.exists(path) and real.startswith(("/etc/", "/usr/")):
            argv += ["--ro-bind", path, path]
    fds = []
    for dest, data in sandbox_files(identity, context).items():
        read_fd, write_fd = os.pipe()
        try:
            if len(data) >= 60000:
                raise Refusal("sandbox_setup_failed")
            os.write(write_fd, data)
        finally:
            os.close(write_fd)
        fds.append(read_fd)
        argv += ["--ro-bind-data", str(read_fd), dest]
    # Read-only empty arg0 alias root: Codex cannot create its per-session alias directory, warns,
    # and uses the pinned runtime binary as its sandbox helper. On a bwrap without --argv0
    # (Debian 12's 0.8.0) the helper would otherwise be exec'd by its alias path under the denied
    # /agent and fail inside the tool sandbox.
    argv += ["--bind-fd", str(home_fd), SANDBOX_HOME, "--bind-fd", str(work_fd), SANDBOX_WORK,
             "--tmpfs", ARG0_ALIAS_ROOT, "--remount-ro", ARG0_ALIAS_ROOT,
             "--chdir", SANDBOX_WORK, "--"] + guard + list(command)
    return argv, fds + [home_fd, work_fd]


def drop_privileges():
    """Runs in the child after setgroups/setgid/setuid: no core dumps, no new privileges."""
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    if LIBC.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        raise OSError(ctypes.get_errno(), "no_new_privs")


def spawn_sandboxed(identity, context, work_fd, home_fd, command, stdin, stdout, stderr, expect=None):
    argv, fds = sandbox_command(identity, context, work_fd, home_fd, command, expect)
    try:
        return subprocess.Popen(argv, stdin=stdin, stdout=stdout, stderr=stderr, pass_fds=fds, close_fds=True,
                                user=identity.pw_uid, group=identity.pw_gid, extra_groups=[], process_group=0,
                                preexec_fn=drop_privileges, env={"PATH": SAFE_PATH}, cwd="/")
    except OSError:
        raise Refusal("sandbox_setup_failed")
    finally:
        for fd in fds[:-2]:
            os.close(fd)


def stop_process_group(proc, grace=SHUTDOWN_GRACE):
    """Orderly stop: EOF first, then signal only this session's own process group."""
    try:
        if proc.stdin:
            proc.stdin.close()
    except OSError:
        pass
    try:
        proc.wait(grace)
        return
    except subprocess.TimeoutExpired:
        pass
    for sig in (signal.SIGTERM, signal.SIGKILL):
        if proc.poll() is not None:
            return
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            return
        try:
            proc.wait(3)
            return
        except subprocess.TimeoutExpired:
            continue


# ---------------------------------------------------------------- JSONL broker

def request_key(request_id):
    return (type(request_id).__name__, request_id)


def valid_request_id(request_id):
    if isinstance(request_id, bool):
        return False
    return isinstance(request_id, int) or (isinstance(request_id, str) and len(request_id) <= 128)


def reject_unknown(params, allowed):
    extra = sorted(set(params) - set(allowed))
    if extra:
        raise PolicyError(-32602, "parameter not permitted by DwemerDistro assistant policy: " + extra[0][:64])


def bounded_text(params, key):
    value = params.get(key)
    if value is not None and (not isinstance(value, str) or len(value) > TEXT_LIMIT):
        raise PolicyError(-32602, "invalid parameter: " + key)


def enforce_sandbox(params):
    """Pin cwd, approvals, and the managed profile; legacy workspaceWrite maps to the stronger profile."""
    if params.get("approvalPolicy") not in (None, "never"):
        raise PolicyError(-32602, "approvalPolicy must be never")
    if params.get("approvalsReviewer") not in (None, "user"):
        raise PolicyError(-32602, "approvalsReviewer is not permitted")
    if params.get("cwd") not in (None, SANDBOX_WORK):
        raise PolicyError(-32602, "cwd must be " + SANDBOX_WORK)
    if params.get("permissions") not in (None, PROFILE):
        raise PolicyError(-32602, "permissions must be " + PROFILE)
    if params.get("sandbox") not in (None, "workspace-write"):
        raise PolicyError(-32602, "sandbox override is not permitted")
    policy = params.get("sandboxPolicy")
    if policy is not None:
        if not isinstance(policy, dict) or policy.get("type") != "workspaceWrite":
            raise PolicyError(-32602, "sandboxPolicy override is not permitted")
        if policy.get("writableRoots") or policy.get("networkAccess") or policy.get("readOnlyAccess"):
            raise PolicyError(-32602, "sandboxPolicy override is not permitted")
    for key in ("sandbox", "sandboxPolicy", "permissions", "approvalsReviewer"):
        params.pop(key, None)
    params["approvalPolicy"] = "never"
    params["cwd"] = SANDBOX_WORK
    bounded_text(params, "developerInstructions")
    bounded_text(params, "model")
    return params


def bounded_id(params, key, required=False):
    value = params.get(key)
    if value is None and not required:
        return
    if not isinstance(value, str) or not 0 < len(value) <= 128:
        raise PolicyError(-32602, "invalid parameter: " + key)


def page_limit(params, bounds):
    """Fill in the default page size; refuse anything outside 1..maximum."""
    value = params.get("limit")
    if value is None:
        params["limit"] = bounds[0]
    elif isinstance(value, bool) or not isinstance(value, int) or not 0 < value <= bounds[1]:
        raise PolicyError(-32602, "limit must be 1-%d" % bounds[1])


def check_choice(params, key, choices):
    if params.get(key) not in (None,) + choices:
        raise PolicyError(-32602, "invalid parameter: " + key)


def check_cursor(params, anchor=False):
    cursor = params.get("cursor")
    if cursor is None or isinstance(cursor, str) and 0 < len(cursor) <= CURSOR_LIMIT:
        return
    # thread/items/list also takes an exclusive item anchor inside the requested turn.
    if anchor and isinstance(cursor, dict) and cursor.get("type") == "item":
        reject_unknown(cursor, ("type", "itemId"))
        bounded_id(cursor, "itemId", required=True)
        if params.get("turnId") is not None:
            return
    raise PolicyError(-32602, "invalid parameter: cursor")


def clip_strings(value, cap, counter, key=None):
    if isinstance(value, str):
        if len(value) <= cap or key in CLIP_KEYS or (key or "").endswith("Id"):
            return value
        counter[0] += 1
        return value[:cap] + CLIP_MARK % (len(value) - cap, len(value))
    if isinstance(value, list):
        return [clip_strings(item, cap, counter) for item in value]
    if isinstance(value, dict):
        return {k: clip_strings(v, cap, counter, k) for k, v in value.items()}
    return value


def encode(message):
    return json.dumps(message, separators=(",", ":")).encode() + b"\n"


def bounded_line(message, budget):
    """The message re-encoded under budget, clipping ever shorter strings; None when that is not enough."""
    line = encode(message)
    if len(line) <= budget:
        return line
    body = "result" if isinstance(message.get("result"), dict) else "params"
    for cap in CLIP_STEPS:
        counter = [0]
        projected = clip_strings(message, cap, counter)
        if isinstance(projected.get(body), dict):
            projected[body]["ddistroTruncation"] = {"clippedStrings": counter[0], "maxStringChars": cap,
                                                    "budgetBytes": budget}
        line = encode(projected)
        if len(line) <= budget:
            return line
    return None


def sanitize(value, key=None):
    """Tool output strings: no control characters, URL queries, or secret-shaped values."""
    if isinstance(value, str):
        value = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "?", value)
        # The component catalog's sha256 is a digest ddistro computed, not a secret.
        if key == "sha256" and re.match(r"^[0-9a-f]{64}\Z", value):
            return value
        # Ids and inventory's validated 40-hex commits would otherwise match the hex-token shape.
        return value if key in CLIP_KEYS + ("commit",) else DIAG_SECRETS.sub("[redacted]", DIAG_URL_QUERY.sub(r"\1?[redacted]", value))
    if isinstance(value, list):
        return [sanitize(item) for item in value]
    if isinstance(value, dict):
        return {str(k)[:128]: sanitize(v, k) for k, v in value.items()}
    return value


def tool_argv(arguments):
    """Exact ddistro argv and envelope command for validated ddistro_read arguments."""
    if not isinstance(arguments, dict):
        raise PolicyError(-32602, "arguments must be an object")
    reject_unknown(arguments, ("operation", "product", "log_source", "log", "lines", "query", "since"))
    operation, product = arguments.get("operation"), arguments.get("product")
    if operation not in TOOL_OPERATIONS:
        raise PolicyError(-32602, "operation must be one of " + ", ".join(TOOL_OPERATIONS))
    if operation != "logs" and any(key in arguments for key in ("log_source", "log", "lines", "query", "since")):
        raise PolicyError(-32602, "log_source, log, lines, query and since apply only to logs")
    if operation == "inventory":
        if "product" in arguments:
            raise PolicyError(-32602, "inventory takes no product")
        return ["inventory"]
    if operation in ("status", "health", "performance", "update_check"):
        command = "update-check" if operation == "update_check" else operation
        if product is None and "product" not in arguments:
            return [command]
        if product in TOOL_LOG_SOURCES:
            raise PolicyError(-32602, "%s has logs only: use operation logs with log_source %s; %s takes a server "
                                      "product (%s) or none" % (product, product, operation, ", ".join(TOOL_PRODUCTS)))
        if product not in TOOL_PRODUCTS:
            raise PolicyError(-32602, "product must be one of " + ", ".join(TOOL_PRODUCTS))
        return [command, product]
    if operation in ("models", "model_options"):
        if arguments.get("product", "herika") != "herika":
            raise PolicyError(-32602, "%s supports only herika" % operation)
        return ["models", "herika"] if operation == "models" else ["models", "options", "herika"]
    if "log_source" in arguments:
        if "product" in arguments:
            raise PolicyError(-32602, "logs takes product or log_source, not both")
        if arguments["log_source"] not in TOOL_LOG_SOURCES:
            raise PolicyError(-32602, "log_source must be one of " + ", ".join(TOOL_LOG_SOURCES))
        product = arguments["log_source"]
    elif product not in TOOL_LOGS:
        raise PolicyError(-32602, "logs needs product (one of %s) or log_source (one of %s)" % (
            ", ".join(TOOL_PRODUCTS), ", ".join(TOOL_LOG_SOURCES)))
    lines = arguments.get("lines", 50)
    if isinstance(lines, bool) or not isinstance(lines, int) or not 1 <= lines <= TOOL_LOG_LINES:
        raise PolicyError(-32602, "lines must be 1-%d" % TOOL_LOG_LINES)
    argv = ["logs", product, "--lines", str(lines)]
    if "log" in arguments:
        if arguments["log"] not in TOOL_LOGS[product]:
            raise PolicyError(-32602, "log must be one of " + ", ".join(TOOL_LOGS[product]))
        argv += ["--log", arguments["log"]]
    if "query" in arguments:
        query = memory_value(arguments, "query", TOOL_LOG_QUERY)
        if "\n" in query:
            raise PolicyError(-32602, "query must be one line of plain text")
        argv += ["--query", query]
    if "since" in arguments:
        since = arguments["since"]
        if not isinstance(since, str) or not TOOL_SINCE.match(since):
            raise PolicyError(-32602, "since must be a UTC time like 2026-10-20T14:00:00Z")
        try:
            time.strptime(since, "%Y-%m-%dT%H:%M:%SZ")
        except ValueError:
            raise PolicyError(-32602, "since is not a valid date and time")
        argv += ["--since", since]
    return argv


def memory_value(arguments, key, limit):
    value = arguments.get(key)
    # ddistro takes --json and --request-id anywhere on its command line, so neither may be a value.
    if (not isinstance(value, str) or not value.strip() or len(value) > limit
            or value.strip() in ("--json", "--request-id") or re.search(r"[\x00-\x08\x0b-\x1f\x7f]", value)):
        raise PolicyError(-32602, "%s must be 1-%d characters of plain text" % (key, limit))
    return value


def memory_argv(arguments, task_id, thread_id):
    """Exact ddistro argv for validated ddistro_memory arguments; provenance comes from the broker, never the model."""
    if not isinstance(arguments, dict):
        raise PolicyError(-32602, "arguments must be an object")
    reject_unknown(arguments, ("operation", "query", "text", "kind"))
    operation = arguments.get("operation")
    if operation == "search":
        reject_unknown(arguments, ("operation", "query"))
        return ["memory", "search", "--assistant", "--query", memory_value(arguments, "query", MEMORY_QUERY_CHARS),
                "--limit", str(MEMORY_RESULTS)]
    if operation != "remember":
        raise PolicyError(-32602, "operation must be one of " + ", ".join(MEMORY_OPERATIONS))
    reject_unknown(arguments, ("operation", "text", "kind"))
    if arguments.get("kind") not in MEMORY_KINDS:
        raise PolicyError(-32602, "kind must be one of " + ", ".join(MEMORY_KINDS))
    if task_id is None:
        raise PolicyError(-32602, "remember needs a task session")
    return ["memory", "add", "--source", "assistant", "--kind", arguments["kind"], "--text",
            memory_value(arguments, "text", MEMORY_TEXT_CHARS), "--task", task_id, "--thread", thread_id]


class DiagnosticChild:
    """One ddistro run in its own process group. The group is signalled only while its leader is unreaped,
    so a recycled pid is never signalled."""

    def __init__(self, proc):
        self.proc = proc
        self.lock = threading.Lock()
        self.reaped = False

    def signal(self, sig):
        with self.lock:
            if not self.reaped:
                try:
                    os.killpg(self.proc.pid, sig)
                except (ProcessLookupError, PermissionError):
                    pass

    def reap(self):
        # Wait for exit without reaping, then reap under the lock that signal() holds.
        try:
            os.waitid(os.P_PID, self.proc.pid, os.WEXITED | os.WNOWAIT)
        except ChildProcessError:
            pass
        with self.lock:
            self.proc.wait()
            self.reaped = True


def run_ddistro(argv, registry=None):
    """Runs root-owned ddistro --json with fixed argv, a minimal environment, and bounded time and output.

    registry (the broker) adopts the child so session shutdown can stop it; adopt() refuses once the session
    is stopping. Returns (ok, data_or_error) after checking the envelope shape; never raises for helper failures."""
    try:
        st = trusted_chain(DDISTRO, "helper_untrusted")
        if not stat.S_ISREG(st.st_mode):
            raise Refusal("helper_untrusted")
    except Refusal:
        return False, {"code": "helper_untrusted", "message": DDISTRO + " is missing or not root-owned"}
    env = {"PATH": SAFE_PATH, "LANG": "C.UTF-8"}
    port = os.environ.get("DDISTRO_POSTGRES_PORT", "")
    if re.match(r"^[0-9]{1,5}\Z", port):
        env["DDISTRO_POSTGRES_PORT"] = port
    proc = subprocess.Popen([DDISTRO] + argv + ["--json"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, env=env, cwd="/", close_fds=True, start_new_session=True)
    child = DiagnosticChild(proc)
    if registry is not None and not registry.adopt(child):
        child.signal(signal.SIGKILL)
        proc.stdout.close()
        child.reap()
        return False, {"code": "cancelled", "message": "the assistant session is closing"}
    expired = []

    def kill():
        expired.append(True)
        child.signal(signal.SIGKILL)
    timer = threading.Timer(TOOL_TIMEOUT, kill)
    timer.daemon = True
    timer.start()
    out = b""
    try:
        out = proc.stdout.read(TOOL_STDOUT_LIMIT + 1)
        if len(out) > TOOL_STDOUT_LIMIT:
            kill()
    finally:
        timer.cancel()
        proc.stdout.close()
        child.reap()
        if registry is not None:
            registry.release(child)
    if registry is not None and registry.stopping:
        return False, {"code": "cancelled", "message": "the assistant session is closing"}
    if expired:
        reason = "output_too_large" if len(out) > TOOL_STDOUT_LIMIT else "timeout"
        return False, {"code": reason, "message": "ddistro %s did not finish within bounds" % argv[0]}
    try:
        document = json.loads(out.decode("utf-8"))
    except ValueError:
        document = None
    expected = (" ".join(argv[:2]) if argv[0] in ("memory", "service") or argv[0] == "models" and argv[1] != "herika"
                else argv[0])
    if (not isinstance(document, dict) or document.get("schema_version") != 1 or document.get("command") != expected
            or document.get("ok") not in (True, False)):
        return False, {"code": "helper_protocol", "message": "ddistro returned an unexpected document"}
    if document["ok"]:
        if not isinstance(document.get("data"), dict):
            return False, {"code": "helper_protocol", "message": "ddistro returned no data"}
        return True, document["data"]
    error = document.get("error") if isinstance(document.get("error"), dict) else {}
    return False, {"code": str(error.get("code", "failed"))[:64], "message": str(error.get("message", ""))[:1024]}


THREAD_START_KEYS = ("model", "approvalPolicy", "approvalsReviewer", "cwd", "sandbox", "permissions",
                     "developerInstructions", "ephemeral", "serviceName", "personality", "serviceTier")
THREAD_RESUME_KEYS = ("threadId", "model", "approvalPolicy", "approvalsReviewer", "cwd", "sandbox", "permissions",
                      "developerInstructions", "personality", "serviceTier", "excludeTurns")
TURN_START_KEYS = ("threadId", "input", "model", "effort", "summary", "approvalPolicy", "approvalsReviewer", "cwd",
                   "sandboxPolicy", "permissions", "outputSchema", "personality", "serviceTier", "clientUserMessageId")
LOGIN_KEYS = {"chatgpt": ("type", "appBrand", "codexStreamlinedLogin", "useHostedLoginSuccessPage"),
              "chatgptDeviceCode": ("type",)}
# Read-only or account methods whose parameters do not affect the sandbox.
PASSTHROUGH_METHODS = ("model/list", "configRequirements/read", "permissionProfile/list",
                       "account/rateLimits/read")
THREAD_LIFECYCLE_METHODS = ("thread/archive", "thread/unarchive", "thread/delete")
SIMPLE_METHODS = {"account/read": ("refreshToken",), "account/login/cancel": ("loginId",), "account/logout": ()}
# Server requests whose client answers could widen access; the broker always denies them.
DENIED_SERVER_REQUESTS = ("item/commandExecution/requestApproval", "item/fileChange/requestApproval",
                          "item/permissions/requestApproval", "execCommandApproval", "applyPatchApproval",
                          "mcpServer/elicitation/request", "account/chatgptAuthTokens/refresh")


class Broker:
    """Bidirectional JSONL relay that only forwards the launcher's allowed method surface."""

    def __init__(self, proc, client_in, client_out, threads, err_sink=None, run_tool=run_ddistro, memory=False):
        self.proc = proc
        self.client_in = client_in
        self.client_out = client_out
        self.threads = threads
        self.err_sink = err_sink
        self.out_lock = threading.Lock()
        self.in_lock = threading.Lock()
        self.state_lock = threading.Lock()
        self.pending = {}
        self.server_requests = {}
        # thread/list is answered from the task's own index: one internal thread/read per listed id.
        self.internal = {}
        self.internal_seq = 0
        # ddistro_read is declared only after the client opts into experimentalApi; calls are answered here.
        self.experimental = False
        self.run_tool = run_tool
        # ddistro_memory is declared too when the user's memory retrieval was on as the session started.
        self.memory = memory
        self.tool_slots = threading.Semaphore(TOOL_CONCURRENCY)
        # Diagnostic runs owned by this session: their threads and process groups (see _stop_diagnostics).
        self.tool_jobs = set()
        self.children = set()
        self.stopping = False
        # _stop_diagnostics runs once; a second caller (client EOF and run() may race) waits for the first.
        self.diagnostics_claimed = False
        self.diagnostics_stopped = threading.Event()
        # (threadId, turnId) -> [calls, text bytes, interrupted], oldest evicted; plus a session call count.
        self.turn_budgets = collections.OrderedDict()
        self.session_calls = 0
        self.failure = None
        self.stop_timer = None
        self.closed = False
        # ddistro_action: the capabilities the client opted into (none until it does); proposals live only in this
        # session's memory.
        self.actions = frozenset()
        self.proposals = {}
        self.proposed_turns = set()
        # The tool thread running an approved restart, which teardown waits for (see _stop_children).
        self.action_job = None

    def run(self):
        reader = threading.Thread(target=self._pump_client, daemon=True)
        reader.start()
        threading.Thread(target=self._drain_stderr, daemon=True).start()
        self._pump_server()
        self.closed = True
        if self.stop_timer:
            self.stop_timer.cancel()
        self._stop_diagnostics()
        stop_process_group(self.proc)
        reader.join(CLIENT_POLL * 10)
        return self.proc.returncode

    # diagnostic children
    def adopt(self, child):
        with self.state_lock:
            if self.stopping:
                return False
            self.children.add(child)
            return True

    def release(self, child):
        with self.state_lock:
            self.children.discard(child)

    def _stop_diagnostics(self):
        """No new runs; SIGTERM then SIGKILL exactly the adopted groups; join every tool thread."""
        self._cancel_proposals(None, "cancelled")
        with self.state_lock:
            self.stopping = True
            first = not self.diagnostics_claimed
            self.diagnostics_claimed = True
            children, jobs = list(self.children), list(self.tool_jobs)
        if not first:
            self.diagnostics_stopped.wait()
            return
        try:
            self._stop_children(children, jobs)
        finally:
            self.diagnostics_stopped.set()

    def _stop_children(self, children, jobs):
        for child in children:
            child.signal(signal.SIGTERM)
        deadline = time.monotonic() + TOOL_STOP_GRACE
        for job in jobs:
            job.join(max(0.0, deadline - time.monotonic()))
        with self.state_lock:
            children, jobs = list(self.children), list(self.tool_jobs)
        for child in children:
            child.signal(signal.SIGKILL)
        for job in jobs:
            # Bounded: each remaining run was just SIGKILLed and only has to be reaped.
            job.join(TOOL_STOP_GRACE + 3)
        with self.state_lock:
            action = self.action_job
        if action is not None:
            # An approved restart is never stopped (see _run_action). Wait for its fresh check so the client still gets the
            # result, bounded by run_ddistro's own timeout; the root CLI runs in its own session and finishes regardless.
            action.join(TOOL_TIMEOUT + 5)

    def request_stop(self):
        """Signal-safe (takes no locks): no new diagnostics, then terminate only this session's process group.

        Running diagnostics are stopped by the client reader, which sees stopping within CLIENT_POLL."""
        self.stopping = True
        if self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass

    def _fail(self, reason):
        with self.state_lock:
            if self.failure is None:
                self.failure = reason
        self.request_stop()

    # client -> server
    def _client_lines(self):
        """Client lines, a partial line at EOF, or one over-limit chunk; stops once the server is gone."""
        try:
            fd = self.client_in.fileno()
        except (AttributeError, OSError, ValueError):
            fd = None
        if fd is None:
            while not self.closed:
                try:
                    line = self.client_in.readline(CLIENT_LINE_LIMIT + 1)
                except (OSError, ValueError):
                    return
                if not line:
                    return
                yield line
            return
        pending = bytearray()
        while not (self.closed or self.stopping):
            try:
                if not select.select([fd], [], [], CLIENT_POLL)[0]:
                    continue
                chunk = os.read(fd, 65536)
            except (OSError, ValueError):
                break
            if not chunk:
                break
            start = len(pending)
            pending += chunk
            while True:
                end = pending.find(b"\n", start)
                if end < 0:
                    break
                yield bytes(pending[:end + 1])
                del pending[:end + 1]
                start = 0
            if len(pending) > CLIENT_LINE_LIMIT:
                yield bytes(pending)
                return
        if pending and not (self.closed or self.stopping):
            yield bytes(pending)

    def _pump_client(self):
        for line in self._client_lines():
            if len(line) > CLIENT_LINE_LIMIT:
                self._fail("client_message_too_large")
                return
            if line.strip():
                self._handle_client(line)
        try:
            with self.in_lock:
                self.proc.stdin.close()
        except OSError:
            pass
        if self.closed:
            return
        self.stop_timer = threading.Timer(SHUTDOWN_GRACE, self.request_stop)
        self.stop_timer.daemon = True
        self.stop_timer.start()
        # The client is gone: stop diagnostics now rather than once the App Server exits, which can take
        # longer than the launcher waits before killing this broker.
        self._stop_diagnostics()

    def _handle_client(self, line):
        try:
            message = json.loads(line)
        except ValueError:
            self._reply_error(None, -32700, "parse error")
            return
        if not isinstance(message, dict):
            self._reply_error(None, -32600, "invalid request")
            return
        method = message.get("method")
        if method is not None:
            if "id" not in message:
                if method == "initialized":
                    self._to_server(message)
                return
            request_id = message["id"]
            if not valid_request_id(request_id) or not isinstance(method, str):
                self._reply_error(None, -32600, "invalid request")
                return
            if isinstance(request_id, str) and request_id.startswith(INTERNAL_ID_PREFIX):
                self._reply_error(request_id, -32600, "request id prefix is reserved")
                return
            try:
                if method == "ddistro/action/decide":
                    self._decide_action(request_id, message.get("params"))
                    return
                message["params"] = self._authorize(method, message.get("params"))
                if method in ("turn/start", "turn/interrupt"):
                    # A new or stopped turn ends any pending proposal: it can no longer be approved.
                    self._cancel_proposals(message["params"].get("threadId"), "cancelled")
                if method == "thread/list":
                    self._list_threads(request_id, message["params"])
                    return
            except PolicyError as exc:
                self._reply_error(request_id, exc.code, exc.message)
                return
            if method in ("thread/start", "thread/resume") + HISTORY_METHODS + THREAD_LIFECYCLE_METHODS:
                with self.state_lock:
                    if len(self.pending) >= MAX_TRACKED_REQUESTS:
                        self._reply_error(request_id, -32001, "too many requests in progress")
                        return
                    self.pending[request_key(request_id)] = (
                        (method, message["params"]["threadId"]) if method == "thread/delete" else method)
            self._to_server(message)
            return
        if "id" in message and ("result" in message or "error" in message):
            with self.state_lock:
                server_method = self.server_requests.pop(request_key(message["id"]), None)
            if server_method is None:
                return
            if server_method in DENIED_SERVER_REQUESTS:
                message = {"id": message["id"], "error": {"code": -32001, "message": "denied by DwemerDistro assistant policy"}}
            self._to_server(message)

    def _authorize(self, method, params):
        if params is None:
            params = {}
        if not isinstance(params, dict):
            raise PolicyError(-32602, "params must be an object")
        if method in PASSTHROUGH_METHODS:
            return params
        if method == "initialize":
            capabilities = params.get("capabilities")
            experimental = capabilities.get("experimentalApi") if isinstance(capabilities, dict) else None
            if experimental not in (None, True, False):
                raise PolicyError(-32602, "invalid parameter: capabilities.experimentalApi")
            self.experimental = experimental is True
            actions = capabilities.pop("ddistroActions", None) if isinstance(capabilities, dict) else None
            if actions is not None and (not isinstance(actions, list) or len(actions) > len(ACTION_OPERATIONS)
                                        or any(not isinstance(name, str) or name not in ACTION_OPERATIONS for name in actions)
                                        or len(set(actions)) != len(actions)):
                raise PolicyError(-32602, "invalid parameter: capabilities.ddistroActions")
            # Codex never sees this broker-only field; the action needs the dynamic tools experimentalApi enables.
            self.actions = frozenset(actions or ()) if self.experimental else frozenset()
            return params
        if method in SIMPLE_METHODS:
            reject_unknown(params, SIMPLE_METHODS[method])
            return params
        if method == "account/login/start":
            allowed = LOGIN_KEYS.get(params.get("type"))
            if allowed is None:
                raise PolicyError(-32602, "only chatgpt browser or device-code sign-in is supported")
            reject_unknown(params, allowed)
            return params
        if method == "thread/start":
            reject_unknown(params, THREAD_START_KEYS)
            # Client tool declarations are never accepted; the broker owns the exact declaration.
            if self.experimental:
                params["dynamicTools"] = ([TOOL_SPEC] + ([MEMORY_SPEC] if self.memory else [])
                                          + ([action_spec(self.actions)] if self.actions else []))
            self._cancel_proposals(None, "cancelled")
            return enforce_sandbox(params)
        if method == "thread/resume":
            reject_unknown(params, THREAD_RESUME_KEYS)
            self._require_thread(params)
            # Full-history hydration is unbounded; history is paged with thread/turns/list and thread/items/list.
            if params.get("excludeTurns") not in (None, True):
                raise PolicyError(-32602, "excludeTurns must be true; page history with thread/turns/list")
            params["excludeTurns"] = True
            self._cancel_proposals(None, "cancelled")
            return enforce_sandbox(params)
        if method == "thread/read":
            reject_unknown(params, ("threadId", "includeTurns"))
            self._require_thread(params)
            if params.get("includeTurns") not in (None, False):
                raise PolicyError(-32602, "includeTurns must be false; page history with thread/turns/list")
            params["includeTurns"] = False
            return params
        if method == "thread/turns/list":
            reject_unknown(params, ("threadId", "cursor", "limit", "sortDirection", "itemsView"))
            self._require_thread(params)
            check_cursor(params)
            check_choice(params, "sortDirection", ("asc", "desc"))
            check_choice(params, "itemsView", ("notLoaded", "summary", "full"))
            page_limit(params, FULL_TURN_PAGE if params.get("itemsView") == "full" else TURN_PAGE)
            return params
        if method == "thread/items/list":
            reject_unknown(params, ("threadId", "turnId", "cursor", "limit", "sortDirection"))
            self._require_thread(params)
            bounded_id(params, "turnId")
            check_cursor(params, anchor=True)
            check_choice(params, "sortDirection", ("asc", "desc"))
            page_limit(params, ITEM_PAGE)
            return params
        if method == "thread/list":
            reject_unknown(params, ("cursor", "limit", "sortDirection"))
            check_cursor(params)
            check_choice(params, "sortDirection", ("asc", "desc"))
            page_limit(params, THREAD_PAGE)
            return params
        if method == "turn/start":
            reject_unknown(params, TURN_START_KEYS)
            self._require_thread(params)
            self._check_input(params.get("input"))
            return enforce_sandbox(params)
        if method == "turn/interrupt":
            reject_unknown(params, ("threadId", "turnId"))
            self._require_thread(params)
            return params
        if method in THREAD_LIFECYCLE_METHODS:
            # Sent by the launcher only after an explicit user click; only this task's threads, never the account's.
            reject_unknown(params, ("threadId",))
            self._require_thread(params)
            return params
        raise PolicyError(-32601, "method not available in DwemerDistro assistant: " + method[:64])

    def _require_thread(self, params):
        with self.state_lock:
            known = params.get("threadId") in self.threads
        if not known:
            raise PolicyError(-32602, "threadId does not belong to this task")

    def _list_threads(self, request_id, params):
        """thread/list from this task's own index, never Codex's account-wide list; newest first by default.

        The cursor is the last listed thread id. Each listed id is read with an internal metadata-only
        thread/read; ids Codex can no longer read (for example ephemeral threads) are left out.
        """
        with self.state_lock:
            ids = list(self.threads.ids)
        if params.get("sortDirection") != "asc":
            ids.reverse()
        start = 0
        if params.get("cursor") is not None:
            if params["cursor"] not in ids:
                raise PolicyError(-32602, "invalid parameter: cursor")
            start = ids.index(params["cursor"]) + 1
        page = ids[start:start + params["limit"]]
        listing = {"id": request_id, "threads": [None] * len(page), "waiting": len(page),
                   "next": page[-1] if start + len(page) < len(ids) else None}
        if not page:
            self._finish_listing(listing)
            return
        requests = []
        with self.state_lock:
            if len(self.internal) + len(page) > MAX_TRACKED_REQUESTS:
                raise PolicyError(-32001, "too many history reads in progress")
            for index, thread_id in enumerate(page):
                self.internal_seq += 1
                internal_id = INTERNAL_ID_PREFIX + str(self.internal_seq)
                self.internal[request_key(internal_id)] = (listing, index, thread_id)
                requests.append({"id": internal_id, "method": "thread/read",
                                 "params": {"threadId": thread_id, "includeTurns": False}})
        for request in requests:
            self._to_server(request)

    def _collect_listing(self, slot, result):
        if not isinstance(slot, tuple):
            return  # the answer to a broker-internal request such as turn/interrupt
        listing, index, thread_id = slot
        thread = result.get("thread") if isinstance(result, dict) else None
        with self.state_lock:
            if isinstance(thread, dict) and thread.get("id") == thread_id:
                listing["threads"][index] = clip_strings(dict(thread, turns=[]), 4096, [0])
            listing["waiting"] -= 1
            done = listing["waiting"] == 0
        if done:
            self._finish_listing(listing)

    def _finish_listing(self, listing):
        result = {"data": [thread for thread in listing["threads"] if thread is not None],
                  "nextCursor": listing["next"], "backwardsCursor": None}
        self._to_client(self._fit({"id": listing["id"], "result": result}))

    @staticmethod
    def _check_input(items):
        if not isinstance(items, list) or not 0 < len(items) <= 64:
            raise PolicyError(-32602, "input must be a non-empty list")
        for item in items:
            kind = item.get("type") if isinstance(item, dict) else None
            if kind == "text" and isinstance(item.get("text"), str) and len(item["text"]) <= CLIENT_LINE_LIMIT:
                reject_unknown(item, ("type", "text", "text_elements"))
                continue
            url = item.get("url") if kind == "image" else None
            if isinstance(url, str) and url.startswith(("data:image/", "https://")):
                reject_unknown(item, ("type", "url", "detail"))
                continue
            raise PolicyError(-32602, "only text and image URL input is permitted")

    def _to_server(self, message):
        data = json.dumps(message, separators=(",", ":")).encode() + b"\n"
        try:
            with self.in_lock:
                self.proc.stdin.write(data)
                self.proc.stdin.flush()
        except (OSError, ValueError):
            self._fail("server_input_closed")

    def _reply_error(self, request_id, code, message):
        self._to_client(json.dumps({"id": request_id, "error": {"code": code, "message": message}}).encode() + b"\n")

    # server -> client
    def _pump_server(self):
        while True:
            try:
                line = self.proc.stdout.readline(SERVER_LINE_LIMIT + 1)
                if len(line) > SERVER_LINE_LIMIT:
                    if not self._drop_oversized(line):
                        return
                    continue
            except (OSError, ValueError):
                return
            if not line:
                return
            line = self._inspect_server(line)
            if line is not None and len(line) > CLIENT_BYTE_BUDGET:
                line = self._fit_line(line)
            if line is not None and not self._to_client(line):
                self._fail("client_closed")
                return

    def _too_large(self, request_id):
        return encode({"id": request_id, "error": {"code": -32003, "message": (
            "response exceeds the DwemerDistro assistant byte budget; request a smaller limit or itemsView summary"),
            "data": {"reason": "response_too_large", "budgetBytes": CLIENT_BYTE_BUDGET}}})

    def _fit(self, message):
        return bounded_line(message, CLIENT_BYTE_BUDGET) or self._too_large(message["id"])

    def _fit_line(self, line):
        """An over-budget line clipped to fit; otherwise an error for a response, nothing for anything else."""
        try:
            message = json.loads(line)
        except ValueError:
            message = None
        if not isinstance(message, dict):
            return None
        fitted = bounded_line(message, CLIENT_BYTE_BUDGET)
        if fitted is not None or "id" not in message:
            return fitted
        if "method" not in message:
            return self._too_large(message["id"])
        if valid_request_id(message["id"]):
            with self.state_lock:
                self.server_requests.pop(request_key(message["id"]), None)
        self._to_server({"id": message["id"], "error": {"code": -32003, "message": "request too large for the client"}})
        return None

    def _drop_oversized(self, line):
        """A line over SERVER_LINE_LIMIT is never parsed. A response identified by its leading id is discarded
        (bounded by SERVER_DISCARD_LIMIT) and its request answered with an error; anything else (a notification
        or request that cannot be dropped without leaving client state stale) closes the session. False: stop."""
        match = RESPONSE_HEAD.match(line[:512])
        if match is None:
            self._close_oversized("a message over %d MiB that is not an identifiable response"
                                  % (SERVER_LINE_LIMIT >> 20))
            return False
        discarded = len(line)
        while not line.endswith(b"\n"):
            line = self.proc.stdout.readline(4 * 1024 * 1024)
            discarded += len(line)
            if not line:
                return False
            if discarded > SERVER_DISCARD_LIMIT:
                self._close_oversized("a response over %d MiB" % (SERVER_DISCARD_LIMIT >> 20))
                return False
        request_id = json.loads(match.group(1))
        key = request_key(request_id)
        with self.state_lock:
            slot = self.internal.pop(key, None)
            self.pending.pop(key, None)
        if slot is not None:
            self._collect_listing(slot, None)
        else:
            self._to_client(self._too_large(request_id))
        return True

    def _close_oversized(self, what):
        """Answers every request the broker tracks with an actionable error, then closes the session."""
        message = ("Codex App Server sent %s; the assistant session is closing. Start a new session; if this "
                   "repeats, page history with a smaller limit or itemsView summary." % what)
        with self.state_lock:
            ids = [key[1] for key in self.pending]
            listings = {id(slot[0]): slot[0]["id"] for slot in self.internal.values() if isinstance(slot, tuple)}
            ids += listings.values()
            self.pending.clear()
            self.internal.clear()
        for request_id in ids:
            self._to_client(encode({"id": request_id, "error": {"code": -32003, "message": message,
                                                                 "data": {"reason": "server_message_too_large"}}}))
        self._fail("server_message_too_large")

    def _inspect_server(self, line):
        try:
            message = json.loads(line)
        except ValueError:
            return line
        if not isinstance(message, dict) or "id" not in message:
            return line
        key = request_key(message["id"]) if valid_request_id(message["id"]) else None
        if key is None:
            return line
        if "method" not in message:
            with self.state_lock:
                slot = self.internal.pop(key, None)
            if slot is not None:
                self._collect_listing(slot, message.get("result"))
                return None
        if message.get("method") == "item/tool/call":
            # Answered here and never shown to the client, so a client cannot answer or spoof it.
            self._start_tool(message)
            return None
        if "method" in message:
            with self.state_lock:
                if len(self.server_requests) < MAX_TRACKED_REQUESTS:
                    self.server_requests[key] = message["method"]
            return line
        with self.state_lock:
            method = self.pending.pop(key, None)
        result = message.get("result")
        if isinstance(method, tuple):
            if isinstance(result, dict):
                # Deleted by Codex: forget only that id from this task's mapping; task state is untouched.
                with self.state_lock:
                    try:
                        self.threads.remove(method[1])
                    except (OSError, Refusal):
                        self.failure = self.failure or "state_untrusted"
            return line
        if method == "thread/read" and isinstance(result, dict) and isinstance(result.get("thread"), dict):
            result["thread"]["turns"] = []
            return encode(message)
        if method not in ("thread/start", "thread/resume") or not isinstance(result, dict):
            return line
        thread = result.get("thread") if isinstance(result.get("thread"), dict) else {}
        profile = result.get("activePermissionProfile") if isinstance(result.get("activePermissionProfile"), dict) else {}
        if (profile.get("id") != PROFILE or result.get("approvalPolicy") != "never"
                or result.get("cwd") != SANDBOX_WORK or not isinstance(thread.get("id"), str)):
            self._fail("policy_mismatch")
            return json.dumps({"id": message["id"], "error": {
                "code": -32001, "message": "DwemerDistro assistant policy was not applied; session closed"}}).encode() + b"\n"
        with self.state_lock:
            try:
                self.threads.add(thread["id"])
            except (OSError, Refusal):
                self.failure = self.failure or "state_untrusted"
        return line

    def _charge_tool(self, params):
        """Counts one call against the session and its turn; returns (turn budget key, refusal or None)."""
        thread_id, turn_id = params.get("threadId"), params.get("turnId")
        key = (thread_id, turn_id) if isinstance(thread_id, str) and isinstance(turn_id, str) \
            and 0 < len(turn_id) <= 128 else None
        interrupt = False
        with self.state_lock:
            self.session_calls += 1
            if self.session_calls > TOOL_SESSION_CALLS:
                return key, {"code": "session_tool_limit", "message": (
                    "ddistro_read and ddistro_memory are limited to %d calls per assistant session; answer from the "
                    "evidence already gathered and start a new session for more checks" % TOOL_SESSION_CALLS)}
            if key is None or thread_id not in self.threads:
                return None, None  # refused as invalid by _run_tool_call
            budget = self.turn_budgets.get(key)
            if budget is None:
                budget = self.turn_budgets[key] = [0, 0, False]
                while len(self.turn_budgets) > TOOL_TRACKED_TURNS:
                    self.turn_budgets.popitem(last=False)
            budget[0] += 1
            if budget[0] <= TOOL_TURN_CALLS and budget[1] < TOOL_TURN_TEXT:
                return key, None
            if budget[0] >= 2 * TOOL_TURN_CALLS and not budget[2]:
                budget[2] = interrupt = True
        if interrupt:
            # The model ignored TOOL_TURN_CALLS refusals; end the turn as the client's turn/interrupt would.
            self._internal_request("turn/interrupt", {"threadId": thread_id, "turnId": turn_id})
        return None, {"code": "turn_tool_limit", "message": (
            "ddistro_read and ddistro_memory are limited to %d calls and %d KiB of output per turn together; stop "
            "calling them, answer from the evidence already gathered, and let the user ask again in a new turn"
            % (TOOL_TURN_CALLS, TOOL_TURN_TEXT // 1024))}

    def _internal_request(self, method, params):
        with self.state_lock:
            if len(self.internal) >= MAX_TRACKED_REQUESTS:
                return
            self.internal_seq += 1
            internal_id = INTERNAL_ID_PREFIX + str(self.internal_seq)
            self.internal[request_key(internal_id)] = method
        self._to_server({"id": internal_id, "method": method, "params": params})

    def _start_tool(self, message):
        params = message.get("params") if isinstance(message.get("params"), dict) else {}
        if self.stopping:
            self._tool_reply(message["id"], params, False, {"code": "cancelled", "message": "the session is closing"})
            return
        key, refusal = self._charge_tool(params)
        if refusal is not None:
            self._tool_reply(message["id"], params, False, refusal)
            return
        if not self.tool_slots.acquire(blocking=False):
            self._tool_reply(message["id"], params, False, {"code": "busy", "message": "another diagnostic is running"})
            return
        job = threading.Thread(target=self._run_tool_call, args=(message["id"], params, key), daemon=True)
        with self.state_lock:
            started = not self.stopping
            if started:
                self.tool_jobs.add(job)
                job.start()
        if not started:
            self.tool_slots.release()

    def _run_tool_call(self, request_id, params, key=None):
        try:
            try:
                tool = params.get("tool")
                if (tool not in (TOOL_NAME, MEMORY_TOOL, ACTION_TOOL) or tool == MEMORY_TOOL and not self.memory
                        or tool == ACTION_TOOL and not self.actions or params.get("namespace") is not None):
                    raise PolicyError(-32602, "unknown tool")
                thread_id = params.get("threadId")
                with self.state_lock:
                    owned = isinstance(thread_id, str) and thread_id in self.threads
                    task_id = self.threads.task_id
                if not owned:
                    raise PolicyError(-32602, "threadId does not belong to this task")
                if tool == ACTION_TOOL:
                    self._run_action(request_id, params, key)
                    return
                argv = (memory_argv(params.get("arguments"), task_id, thread_id) if tool == MEMORY_TOOL
                        else tool_argv(params.get("arguments")))
            except PolicyError as exc:
                ok, payload = False, {"code": "invalid_arguments", "message": exc.message}
            else:
                try:
                    # The real runner is handed this broker so shutdown can stop the run's process group.
                    ok, payload = self.run_tool(argv, self) if self.run_tool is run_ddistro else self.run_tool(argv)
                except (OSError, ValueError):
                    ok, payload = False, {"code": "failed", "message": "ddistro could not be run"}
            if not self.stopping:
                self._tool_reply(request_id, params, ok, payload, key)
        finally:
            with self.state_lock:
                self.tool_jobs.discard(threading.current_thread())
            self.tool_slots.release()

    # ddistro_action
    def _cancel_proposals(self, thread_id, state):
        """Ends every pending proposal (of thread_id, or all): it can no longer be approved and nothing runs."""
        with self.state_lock:
            for proposal in self.proposals.values():
                if proposal["state"] in ("preparing", "proposed") and thread_id in (None, proposal["thread"]):
                    proposal["state"] = state
                    proposal["event"].set()

    def _decide_action(self, request_id, params):
        """The client's answer to one proposal. Single use: only a pending, unexpired proposal of the same thread
        changes, under the lock, so a replayed, late, or racing decision changes nothing."""
        if not isinstance(params, dict):
            raise PolicyError(-32602, "params must be an object")
        reject_unknown(params, ("proposalId", "threadId", "decision"))
        if params.get("decision") not in ("approve", "cancel"):
            raise PolicyError(-32602, "decision must be approve or cancel")
        with self.state_lock:
            proposal_id = params.get("proposalId")
            proposal = self.proposals.get(proposal_id) if isinstance(proposal_id, str) else None
            if proposal is None or proposal["thread"] != params.get("threadId"):
                raise PolicyError(-32001, "no such proposal")
            if proposal["state"] == "proposed" and (self.stopping or time.monotonic() > proposal["expires"]):
                proposal["state"] = "expired"
                proposal["event"].set()
            if proposal["state"] != "proposed":
                raise PolicyError(-32001, "proposal is no longer pending: " + proposal["state"])
            proposal["state"] = "approved" if params["decision"] == "approve" else "cancelled"
            proposal["event"].set()
            state = proposal["state"]
        self._to_client(encode({"id": request_id, "result": {"state": state}}))

    def _reserve_proposal(self, proposal):
        """Takes the session's one proposal slot unless another proposal is preparing, pending or running, or this turn
        already proposed this operation. Returns (busy, repeated); the slot is taken only when both are false."""
        with self.state_lock:
            busy = self.stopping or any(p["state"] in ("preparing", "proposed", "approved", "executing")
                                        for p in self.proposals.values())
            repeated = (proposal["thread"], proposal["turn"], proposal["operation"]) in self.proposed_turns
            if not (busy or repeated):
                # Finished proposals are dropped; a decision for one is then "no such proposal", which also fails closed.
                self.proposals = {proposal["id"]: proposal}
        return busy, repeated

    def _await_decision(self, proposal):
        """Waits for the client's decision or the expiry. Returns (go, state); go means approved, now executing."""
        while not proposal["event"].wait(CLIENT_POLL):
            with self.state_lock:
                if proposal["state"] == "proposed" and (self.stopping or time.monotonic() > proposal["expires"]):
                    proposal["state"] = "cancelled" if self.stopping else "expired"
                    proposal["event"].set()
        with self.state_lock:
            go = proposal["state"] == "approved" and not self.stopping
            if go:
                proposal["state"] = "executing"
                self.action_job = threading.current_thread()
            elif proposal["state"] == "approved":
                proposal["state"] = "not_executed"
            return go, proposal["state"]

    def _run_action(self, request_id, params, key):
        arguments = params.get("arguments") if isinstance(params.get("arguments"), dict) else {}
        thread_id, turn_id = params.get("threadId"), params.get("turnId")
        operation = arguments.get("operation")
        if operation in ACTION_OPERATIONS[ACTION_MODEL_CAPABILITY] and ACTION_MODEL_CAPABILITY in self.actions:
            self._run_model_action(request_id, arguments, thread_id, turn_id, key)
            return
        service = arguments.get("service") if arguments.get("service") in ACTION_SERVICES else None
        try:
            offered = [name for capability in sorted(self.actions) for name in ACTION_OPERATIONS[capability]]
            if operation not in offered:
                raise PolicyError(-32602, "operation must be one of " + ", ".join(offered))
            reject_unknown(arguments, ("operation", "service", "reason"))
            if service is None:
                raise PolicyError(-32602, "operation must be propose_restart and service one of " + ", ".join(ACTION_SERVICES))
            reason = memory_value(arguments, "reason", ACTION_REASON_CHARS)
            if not isinstance(turn_id, str) or not 0 < len(turn_id) <= 128:
                raise PolicyError(-32602, "turnId is required")
        except PolicyError as exc:
            self._action_reply(request_id, service, "refused", {"code": "invalid_arguments", "message": exc.message}, key)
            return
        proposal = {"id": secrets.token_hex(16), "thread": thread_id, "turn": turn_id, "service": service,
                    "operation": "propose_restart", "action": "restart", "state": "proposed", "event": threading.Event(),
                    "expires": time.monotonic() + ACTION_APPROVAL_SECONDS}
        busy, repeated = self._reserve_proposal(proposal)
        if busy or repeated:
            self._action_reply(request_id, service, "busy" if busy else "refused", {
                "code": "busy" if busy else "invalid_arguments",
                "message": "another proposal is pending" if busy else "only one restart proposal per turn"}, key)
            return
        with self.state_lock:
            self.proposed_turns.add((thread_id, turn_id, "propose_restart"))
        label, impact = ACTION_SERVICES[service]
        expires_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + ACTION_APPROVAL_SECONDS))
        self._to_client(encode({"method": "ddistro/action/proposed", "params": {
            "proposalId": proposal["id"], "threadId": thread_id, "turnId": turn_id, "action": "restart",
            "service": service, "label": label, "impact": impact, "reason": sanitize(reason), "expiresAt": expires_at}}))
        go, state = self._await_decision(proposal)
        if not go:
            self._finish_action(request_id, proposal, state, None, key)
            return
        # Not adopted into the session's stoppable runs: once started, a restart finishes even if the client leaves,
        # because stopping it midway could leave the service down.
        try:
            ok, payload = self.run_tool(["service", "restart", service])
        except (OSError, ValueError):
            ok, payload = False, {"code": "failed", "message": "ddistro could not be run"}
        code = payload.get("code") if isinstance(payload, dict) else None
        if ok and isinstance(payload, dict) and payload.get("executed") is True:
            verified = payload.get("verified") is True and payload.get("state") == "verified"
            state = "verified" if verified else "failed"
        elif code == "busy":
            state = "busy"
        elif code in ACTION_NOT_RUN_CODES:
            state = "not_executed"
        else:
            # Stopped at its time bound or an unreadable result: the init script may have run, so never "not run".
            state = "failed"
        with self.state_lock:
            proposal["state"] = state
        self._finish_action(request_id, proposal, state, payload, key)

    def _finish_action(self, request_id, proposal, state, payload, key):
        detail = sanitize(payload) if isinstance(payload, dict) else None
        executed = state in ("verified", "failed")
        self._to_client(encode({"method": "ddistro/action/updated", "params": {
            "proposalId": proposal["id"], "threadId": proposal["thread"], "action": "restart", "state": state,
            "executed": executed, "verified": state == "verified",
            "checks": detail.get("checks", []) if detail and executed else []}}))
        if not self.stopping:
            self._action_reply(request_id, proposal["service"], state, detail, key, approved=detail is not None)

    def _action_reply(self, request_id, service, state, detail, key, approved=False):
        """The model's view: proposed and approved are separate from executed and verified; no proposal id."""
        executed = state in ("verified", "failed")
        document = {"tool": ACTION_TOOL, "operation": "propose_restart", "service": service,
                    "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "state": state,
                    "proposed": state not in ("refused",) and not (state == "busy" and not approved),
                    "user_approved": approved, "executed": executed, "verified": state == "verified"}
        if executed:
            document["data"] = {k: detail.get(k) for k in ("checks", "before", "after", "verified_at", "output_tail")}
        elif detail is not None:
            document["error"] = detail
        self._reply_action_document(request_id, document, state == "verified", key)

    def _reply_action_document(self, request_id, document, success, key):
        line = bounded_line({"result": document}, TOOL_TEXT_BUDGET)
        text = json.dumps(json.loads(line)["result"], separators=(",", ":")) if line else json.dumps(
            {"tool": ACTION_TOOL, "state": document["state"], "executed": document["executed"],
             "verified": document["verified"]})
        if key is not None:
            with self.state_lock:
                budget = self.turn_budgets.get(key)
                if budget is not None:
                    budget[1] += len(text)
        self._to_server({"id": request_id, "result": {"success": success,
                                                      "contentItems": [{"type": "inputText", "text": text}]}})

    def _run_model_action(self, request_id, arguments, thread_id, turn_id, key):
        """propose_model_change and propose_model_rollback. The broker, not the model, runs the root preview (which
        binds the receipt to this task and thread) and keeps its receipt id and confirmation; the client sees the
        exact diff, and only its approval of this proposal runs the matching apply or rollback once."""
        operation = arguments.get("operation")
        undo = operation == "propose_model_rollback"
        try:
            if undo:
                reject_unknown(arguments, ("operation", "reason"))
            else:
                reject_unknown(arguments, ("operation", "profile_id", "role", "connector_id", "reason"))
                profile_id, connector_id = action_id(arguments, "profile_id"), action_id(arguments, "connector_id")
                if arguments.get("role") not in ACTION_MODEL_ROLES:
                    raise PolicyError(-32602, "role must be one of " + ", ".join(ACTION_MODEL_ROLES))
            reason = memory_value(arguments, "reason", ACTION_REASON_CHARS)
            if not isinstance(turn_id, str) or not 0 < len(turn_id) <= 128:
                raise PolicyError(-32602, "turnId is required")
            with self.state_lock:
                task_id = self.threads.task_id
            if not isinstance(task_id, str):
                raise PolicyError(-32602, "a model change needs a task session")
        except PolicyError as exc:
            self._model_reply(request_id, operation, "refused", None, {"code": "invalid_arguments", "message": exc.message}, key)
            return
        if undo:
            preview = ["models", "rollback-preview", "herika", "--task", task_id, "--thread", thread_id]
        else:
            preview = ["models", "preview", "herika", "--profile", str(profile_id), "--role", arguments["role"],
                       "--connector", str(connector_id), "--task", task_id, "--thread", thread_id]
        proposal = {"id": secrets.token_hex(16), "thread": thread_id, "turn": turn_id, "service": None,
                    "operation": operation, "action": "model_rollback" if undo else "model_change", "state": "preparing",
                    "event": threading.Event(), "expires": 0.0}
        busy, repeated = self._reserve_proposal(proposal)
        if busy or repeated:
            self._model_reply(request_id, operation, "busy" if busy else "refused", None, {
                "code": "busy" if busy else "invalid_arguments",
                "message": "another proposal is pending" if busy else "only one %s per turn" % operation}, key)
            return
        try:
            ok, payload = self.run_tool(preview, self) if self.run_tool is run_ddistro else self.run_tool(preview)
        except (OSError, ValueError):
            ok, payload = False, {"code": "failed", "message": "ddistro could not be run"}
        plan = model_plan(payload, undo) if ok else None
        with self.state_lock:
            shown = plan is not None and proposal["state"] == "preparing" and not self.stopping
            if shown:
                proposal["state"] = "proposed"
                proposal["expires"] = time.monotonic() + ACTION_APPROVAL_SECONDS
                self.proposed_turns.add((thread_id, turn_id, operation))
            elif proposal["state"] == "preparing":
                proposal["state"] = "refused"
            state = proposal["state"]
        if not shown:
            error = payload if not ok else {"code": "helper_protocol", "message": "ddistro returned an unexpected preview"}
            self._model_reply(request_id, operation, state, None, sanitize(error) if plan is None else None, key)
            return
        expires_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + ACTION_APPROVAL_SECONDS))
        self._to_client(encode({"method": "ddistro/action/proposed", "params": {
            "proposalId": proposal["id"], "threadId": thread_id, "turnId": turn_id, "action": proposal["action"],
            "label": ACTION_MODEL_LABEL, "impact": ACTION_MODEL_ROLLBACK_IMPACT if undo else ACTION_MODEL_IMPACT,
            "reason": sanitize(reason), "expiresAt": expires_at, "change": plan["view"]}}))
        go, state = self._await_decision(proposal)
        payload = None
        if go:
            # Not adopted into the session's stoppable runs, like a restart: once the write starts it finishes and is
            # resolved by the CLI, so its outcome is never cut off mid-transaction by the session's end.
            argv = ["models", "rollback" if undo else "apply", "herika", "--receipt", plan["receipt_id"],
                    "--plan-sha256", plan["plan_sha256"]]
            try:
                ok, payload = self.run_tool(argv)
            except (OSError, ValueError):
                ok, payload = False, {"code": "failed", "message": "ddistro could not be run"}
            state = model_outcome(ok, payload, plan)
            with self.state_lock:
                proposal["state"] = state
        executed = model_executed(state)
        self._to_client(encode({"method": "ddistro/action/updated", "params": {
            "proposalId": proposal["id"], "threadId": thread_id, "action": proposal["action"], "state": state,
            "executed": executed, "verified": state == "verified", "checks": []}}))
        if not self.stopping:
            error = sanitize(payload) if go and not ok and isinstance(payload, dict) else None
            self._model_reply(request_id, operation, state, plan["view"], error, key, approved=go)

    def _model_reply(self, request_id, operation, state, view, error, key, approved=False):
        """The model's view of a model change: the exact change and its state, never the receipt id or confirmation."""
        document = {"tool": ACTION_TOOL, "operation": operation if operation in ACTION_OPERATIONS[ACTION_MODEL_CAPABILITY] else None,
                    "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "state": state,
                    "proposed": state != "refused" and not (state == "busy" and not approved),
                    "user_approved": approved, "executed": model_executed(state), "verified": state == "verified"}
        if view is not None:
            document["change"] = {k: view[k] for k in ("profile", "role", "before", "after")}
        if state in ("verified", "unverified"):
            document["verification"] = ("database_assignment: a fresh read of the CHIM database; provider and in-game "
                                        "replies were not tested")
        if error is not None:
            document["error"] = {"code": str(error.get("code", "failed"))[:64], "message": str(error.get("message", ""))[:1024]}
        self._reply_action_document(request_id, document, state == "verified", key)

    def _tool_reply(self, request_id, params, ok, payload, key=None):
        arguments = params.get("arguments") if isinstance(params.get("arguments"), dict) else {}
        tool = MEMORY_TOOL if params.get("tool") == MEMORY_TOOL and self.memory else TOOL_NAME
        operations = MEMORY_OPERATIONS if tool == MEMORY_TOOL else TOOL_OPERATIONS
        operation = arguments.get("operation") if arguments.get("operation") in operations else None
        payload = sanitize(payload)
        trimmed = self._fit_log_lines(payload) if ok and operation == "logs" else 0
        coverage = self._coverage(params, ok, payload, operation, trimmed)
        document = {"tool": tool, "operation": operation,
                    "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "ok": ok,
                    "data" if ok else "error": payload, "coverage": coverage}
        line = bounded_line({"result": document}, TOOL_TEXT_BUDGET)
        if line is not None and b'"ddistroTruncation"' in line and coverage["result"] == "checked":
            coverage["result"] = "truncated"
            line = bounded_line({"result": document}, TOOL_TEXT_BUDGET)
        if line is None:
            coverage["result"] = "failed"
            ok, text = False, json.dumps({"tool": tool, "operation": operation, "ok": False, "error": {
                "code": "output_too_large", "message": "narrow the request"}, "coverage": coverage})
        else:
            text = json.dumps(json.loads(line)["result"], separators=(",", ":"))
        if key is not None:
            with self.state_lock:
                budget = self.turn_budgets.get(key)
                if budget is not None:
                    budget[1] += len(text)
        self._to_server({"id": request_id, "result": {"success": ok,
                                                      "contentItems": [{"type": "inputText", "text": text}]}})

    @staticmethod
    def _fit_log_lines(payload):
        """Drops the oldest log lines until the reply fits TOOL_TEXT_BUDGET unclipped; returns how many were dropped."""
        lines = payload.get("lines") if isinstance(payload, dict) else None
        if not isinstance(lines, list):
            return 0
        dropped = 0
        # Room for the envelope and the coverage object around the data.
        while lines and len(encode(payload)) > TOOL_TEXT_BUDGET - 2048:
            step = max(1, len(lines) // 4)
            lines = lines[step:]
            dropped += step
            payload["lines"] = lines
        if dropped:
            payload["budget_trimmed_lines"] = dropped
            payload["truncated"] = True
        return dropped

    def _coverage(self, params, ok, payload, operation, trimmed):
        """What this call covered, and what the turn and session budgets leave, from the broker's own counters."""
        thread_id, turn_id = params.get("threadId"), params.get("turnId")
        with self.state_lock:
            budget = self.turn_budgets.get((thread_id, turn_id)) if isinstance(turn_id, str) else None
            calls, text = (budget[0], budget[1]) if budget else (0, 0)
            session = self.session_calls
        code = payload.get("code") if not ok and isinstance(payload, dict) else None
        if ok:
            # Read from each operation's own completeness fields: a plain tail that returned the lines asked for is
            # complete; a search or since window says so in filter.complete; models and inventory flag truncated
            # lists, and inventory.complete covers its sections (an unavailable section makes it incomplete).
            # Unavailable models are failed, a log not written yet skipped.
            data = payload if isinstance(payload, dict) else {}
            search = data.get("filter")
            sections = []
            if operation == "inventory":
                extensions = data.get("extensions")
                items = extensions.get("items") if isinstance(extensions, dict) else None
                sections = [data.get("custom_mods"), data.get("catalog")] + [
                    item for item in (items if isinstance(items, list) else []) if isinstance(item, dict)]
            # model_options flags its two lists; update_check is complete only when every product was fully inspected.
            truncated = data.get("truncated")
            incomplete = (isinstance(search, dict) and search.get("complete") is not True
                          or operation == "models" and truncated is not False
                          or operation == "model_options" and (not isinstance(truncated, dict) or not truncated
                                                               or any(value is not False for value in truncated.values()))
                          or operation == "update_check" and data.get("complete") is not True
                          or operation == "inventory" and (data.get("complete") is not True
                                                           or not isinstance(data.get("catalog"), dict)
                                                           or data["catalog"].get("available") is not True or any(
                              isinstance(section, dict) and section.get("truncated") is True for section in sections)))
            if operation == "logs" and data.get("available") is False:
                result = "skipped"
            elif operation == "models" and data.get("available") is not True:
                result = "failed"
            elif operation == "performance" and data.get("complete") is not True:
                result = "truncated"
            else:
                result = "truncated" if trimmed or incomplete else "checked"
        elif code in ("turn_tool_limit", "session_tool_limit"):
            result = "budget_hit"
        elif code == "invalid_arguments":
            result = "refused"
        elif code in ("busy", "cancelled"):
            result = "skipped"
        else:
            result = "failed"
        coverage = {"result": result, "turn_calls": calls, "turn_calls_left": max(0, TOOL_TURN_CALLS - calls),
                    "turn_output_kib_left": max(0, TOOL_TURN_TEXT - text) // 1024,
                    "session_calls_left": max(0, TOOL_SESSION_CALLS - session)}
        summary = payload.get("summary") if ok and operation in ("health", "performance") and isinstance(payload, dict) else None
        if isinstance(summary, dict) and operation == "performance":
            coverage["performance"] = {key: summary[key] for key in ("measured", "failed", "skipped")
                                       if type(summary.get(key)) is int}
        elif isinstance(summary, dict):
            coverage["health"] = {key: summary[key] for key in ("passed", "failed", "skipped")
                                  if type(summary.get(key)) is int}
            coverage["health"].update(self._health_checks(payload.get("checks")))
        return coverage

    @staticmethod
    def _health_checks(checks):
        """Each check's id and result, so a client can count unique checks across overlapping health reads (herika,
        then all) instead of adding summaries. Bounded; an entry that is not a known id and result is left out and
        marks the list incomplete, and an unknown result is never passed through as passed."""
        listed, complete = [], isinstance(checks, list)
        for check in checks if isinstance(checks, list) else []:
            check_id = check.get("id") if isinstance(check, dict) else None
            result = check.get("result") if isinstance(check, dict) else None
            if (len(listed) >= COVERAGE_HEALTH_CHECKS or not isinstance(check_id, str)
                    or not COVERAGE_CHECK_ID.match(check_id) or result not in ("passed", "failed", "skipped")):
                complete = False
                continue
            listed.append({"id": check_id, "result": result})
        return {"checks": listed, "checks_complete": complete}

    def _to_client(self, data):
        try:
            with self.out_lock:
                self.client_out.write(data)
                self.client_out.flush()
            return True
        except (OSError, ValueError):
            return False

    def _drain_stderr(self):
        forwarded = 0
        while True:
            try:
                chunk = self.proc.stderr.read1(4096)
            except (OSError, ValueError):
                return
            if not chunk:
                return
            if self.err_sink is not None and forwarded < STDERR_LIMIT:
                chunk = chunk[:STDERR_LIMIT - forwarded]
                forwarded += len(chunk)
                try:
                    self.err_sink.write(chunk)
                    self.err_sink.flush()
                except (OSError, ValueError):
                    pass


# ---------------------------------------------------------------- commands

def require_root():
    if os.geteuid() != 0:
        raise Refusal("requires_root")


def cmd_status():
    report = {"installed": False, "probe_passed": False, "provider": PROVIDER, "version": None, "reason": "not_installed"}
    try:
        attestation = read_attestation()
        _, binding = installation(attestation)
        report["installed"] = True
        report["version"] = CODEX_VERSION
        if attestation is None:
            report["reason"] = "probe_required"
        elif not attestation_matches(attestation, binding):
            report["reason"] = "probe_stale"
        else:
            report["probe_passed"] = True
            report["reason"] = "ready"
    except Refusal as exc:
        report["reason"] = exc.reason
    except OSError:
        report["reason"] = "state_untrusted"
    print(json.dumps(report))
    return 0


def refuse_session(reason):
    """Fail closed without starting a model, answering JSON-RPC requests with the reason."""
    sys.stderr.write(json.dumps({"error": "assistant_unavailable", "reason": reason}) + "\n")
    sys.stderr.flush()
    if sys.stdin.isatty():
        return 3
    fd = sys.stdin.fileno()
    deadline = time.monotonic() + REFUSAL_WINDOW
    pending = b""
    answered = 0
    while answered < 16 and len(pending) <= CLIENT_LINE_LIMIT:
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
            break
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        pending += chunk
        while b"\n" in pending and answered < 16:
            line, pending = pending.split(b"\n", 1)
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if isinstance(message, dict) and isinstance(message.get("method"), str) and valid_request_id(message.get("id")):
                error = {"code": -32001, "message": "DwemerDistro assistant unavailable", "data": {"reason": reason}}
                sys.stdout.buffer.write(json.dumps({"id": message["id"], "error": error}).encode() + b"\n")
                sys.stdout.buffer.flush()
                answered += 1
    return 3


def cmd_serve(task_id):
    try:
        require_root()
        if not TASK_ID_PATTERN.match(task_id):
            raise Refusal("task_id_invalid")
        # Task errors are reported even when the runtime still needs a probe.
        context, work_fd = load_task(task_id, agent_identity())
        identity = verified_session_identity()
        lock = SingletonLock()
        home_fd = open_account_home(identity)
        threads = ThreadStore(task_id)
        # The memory tool is declared only if retrieval is on now; any failure leaves it undeclared.
        try:
            ok, memory = run_ddistro(["memory", "status"])
            memory = ok and memory.get("settings", {}).get("retrieval") is True
        except (OSError, ValueError):
            memory = False
        try:
            proc = spawn_sandboxed(identity, context, work_fd, home_fd, APP_SERVER_COMMAND,
                                   subprocess.PIPE, subprocess.PIPE, subprocess.PIPE)
        finally:
            os.close(work_fd)
            os.close(home_fd)
    except Refusal as exc:
        return refuse_session(exc.reason)
    except OSError:
        return refuse_session("state_untrusted")
    broker = Broker(proc, sys.stdin.buffer, sys.stdout.buffer, threads, sys.stderr.buffer, memory=memory)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda *_: broker.request_stop())
    returncode = broker.run()
    if broker.failure:
        sys.stderr.write(json.dumps({"error": "session_closed", "reason": broker.failure}) + "\n")
        return 4
    del lock
    return 0 if returncode in (0, -signal.SIGTERM) else 4


# ---------------------------------------------------------------- account-home config repair

def inspect_home_config(identity, home_fd):
    """Classifies the account home for home-config: clean, repairable, or refused with a reason.

    Only a config.toml that is ddagent's own private regular file (0600 or stricter, one link, at most 4 KiB) and
    whose whole content is the known project-trust entry is repairable, and only when no other unmanaged file is
    present. Returns (report, fd, st); fd is a read-only descriptor of that file, set only when it is repairable."""
    report = {"state": "clean", "reason": None, "file": HOME_CONFIG_NAME, "sha256": None, "size": None}

    def refuse(reason, fd=None):
        if fd is not None:
            os.close(fd)
        report.update(state="refused", reason=reason)
        return report, None, None
    others = False
    for name in UNMANAGED_HOME_FILES:
        try:
            if name != HOME_CONFIG_NAME:
                os.stat(name, dir_fd=home_fd, follow_symlinks=False)
                others = True
        except FileNotFoundError:
            continue
        except OSError:
            others = True
    try:
        before = os.stat(HOME_CONFIG_NAME, dir_fd=home_fd, follow_symlinks=False)
    except FileNotFoundError:
        return refuse("other_unmanaged_file") if others else (report, None, None)
    except OSError:
        return refuse("config_unreadable")
    if others:
        return refuse("other_unmanaged_file")
    if stat.S_ISLNK(before.st_mode):
        return refuse("config_symlink")
    if not stat.S_ISREG(before.st_mode):
        return refuse("config_not_regular")
    if before.st_size > HOME_CONFIG_LIMIT:
        return refuse("config_oversize")
    if before.st_uid != identity.pw_uid or before.st_gid != identity.pw_gid:
        return refuse("config_wrong_owner")
    if before.st_mode & 0o7077:
        return refuse("config_unsafe_mode")
    if before.st_nlink != 1:
        return refuse("config_hard_linked")
    try:
        fd = os.open(HOME_CONFIG_NAME, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC,
                     dir_fd=home_fd)
    except OSError:
        return refuse("config_unreadable")
    st = os.fstat(fd)
    if ((st.st_dev, st.st_ino) != (before.st_dev, before.st_ino) or not stat.S_ISREG(st.st_mode)
            or st.st_nlink != 1 or st.st_mode & 0o7077):
        return refuse("config_changed", fd)
    data = os.pread(fd, HOME_CONFIG_LIMIT + 1, 0)
    report["size"] = len(data)
    if len(data) > HOME_CONFIG_LIMIT:
        return refuse("config_oversize", fd)
    if not KNOWN_SAFE_HOME_CONFIG.match(data):
        return refuse("config_unknown_content", fd)
    report.update(state="repairable", sha256=sha256_bytes(data))
    return report, fd, st


def sync_dir(dir_fd):
    fd = os.open(".", O_DIR, dir_fd=dir_fd)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def quarantine_home_config(home_fd, fd, st, found):
    """Moves the validated config.toml, unchanged, into a new root-only quarantine folder and writes its receipt.

    The pending guard is written first and removed only once the moved file is verified and its receipt is durable.
    A move that cannot be verified is put back without overwriting anything; if that is not possible the guard stays.
    Any exception after the guard is written leaves it in place, so serve keeps refusing."""
    agent_fd = open_root_dir(AGENT_STATE, "state_untrusted")
    root_fd = entry_fd = None
    try:
        try:
            os.mkdir(QUARANTINE_NAME, 0o700, dir_fd=agent_fd)
        except FileExistsError:
            pass
        root_fd = os.open(QUARANTINE_NAME, O_DIR, dir_fd=agent_fd)
        info = os.fstat(root_fd)
        if info.st_uid != 0 or info.st_mode & 0o077:
            return {"state": "refused", "reason": "quarantine_untrusted"}
        if len(os.listdir(root_fd)) >= QUARANTINE_LIMIT:
            return {"state": "refused", "reason": "quarantine_full"}
        name = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + secrets.token_hex(4)
        os.mkdir(name, 0o700, dir_fd=root_fd)
        entry_fd = os.open(name, O_DIR, dir_fd=root_fd)
        os.fchmod(entry_fd, 0o700)
        write_root_file(agent_fd, HOME_CONFIG_PENDING, json.dumps({"id": name}).encode(), 0o600)
        sync_dir(agent_fd)
        try:
            os.rename(HOME_CONFIG_NAME, HOME_CONFIG_NAME, src_dir_fd=home_fd, dst_dir_fd=entry_fd)
        except OSError:
            os.rmdir(name, dir_fd=root_fd)
            os.unlink(HOME_CONFIG_PENDING, dir_fd=agent_fd)
            return {"state": "refused", "reason": "quarantine_failed"}
        moved = os.stat(HOME_CONFIG_NAME, dir_fd=entry_fd, follow_symlinks=False)
        verified = ((moved.st_dev, moved.st_ino) == (st.st_dev, st.st_ino) and stat.S_ISREG(moved.st_mode)
                    and moved.st_nlink == 1 and sha256_bytes(os.pread(fd, HOME_CONFIG_LIMIT + 1, 0)) == found["sha256"])
        if not verified:
            # Something replaced or changed the file between inspection and the move: put whatever was moved back
            # (link fails rather than overwrite a new file), then drop the guard; the home is exactly as found.
            try:
                os.link(HOME_CONFIG_NAME, HOME_CONFIG_NAME, src_dir_fd=entry_fd, dst_dir_fd=home_fd, follow_symlinks=False)
                sync_dir(home_fd)
                os.unlink(HOME_CONFIG_NAME, dir_fd=entry_fd)
                os.rmdir(name, dir_fd=root_fd)
                os.unlink(HOME_CONFIG_PENDING, dir_fd=agent_fd)
                return {"state": "refused", "reason": "config_changed"}
            except OSError:
                pass
        receipt = {"schema_version": SCHEMA_VERSION, "action": "quarantine_account_home_config", "id": name,
                   "file": HOME_CONFIG_NAME, "sha256": found["sha256"], "size": found["size"], "uid": st.st_uid,
                   "gid": st.st_gid, "mode": "%04o" % stat.S_IMODE(st.st_mode), "mtime": int(st.st_mtime),
                   "quarantined_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "verified": verified}
        write_root_file(entry_fd, "receipt.json", json.dumps(receipt).encode(), 0o600)
        # The moved file's data, the entry (file and receipt), the new entry in the quarantine folder, the
        # quarantine folder in the agent state, and the home's removed name are all durable before the guard goes;
        # any failure here raises with the guard still pending and every file kept.
        os.fsync(fd)
        os.fsync(entry_fd)
        sync_dir(root_fd)
        sync_dir(agent_fd)
        sync_dir(home_fd)
        result = {"id": name, "path": "%s/%s/%s" % (AGENT_STATE, QUARANTINE_NAME, name)}
        if not verified:
            # Could not be put back: kept in quarantine with its receipt and the guard stays; nothing is deleted.
            return {"state": "refused", "reason": "home_config_repair_pending", "receipt": result}
        os.unlink(HOME_CONFIG_PENDING, dir_fd=agent_fd)
        sync_dir(agent_fd)
        return {"state": "repaired", "reason": None, "receipt": result}
    finally:
        for handle in (entry_fd, root_fd, agent_fd):
            if handle is not None:
                os.close(handle)


def cmd_home_config(repair=False, expected=None):
    """Status of the account home's unmanaged config (the dry run, with the proposal's sha256), or its repair.

    The repair takes the serve lock without waiting, so it never runs beside a session or probe, and needs the
    exact sha256 that status proposed; it refuses while any ddagent process exists. Exit 0 for a status or a
    completed repair, 75 when the lock is held, otherwise 1."""
    report = {"state": "refused", "reason": None, "file": HOME_CONFIG_NAME, "sha256": None, "size": None,
              "receipt": None}
    code = 1
    try:
        require_root()
        if repair and not SHA256_PATTERN.match(expected or ""):
            raise Refusal("sha256_required")
        identity = agent_identity()
        state_layout(identity)
        lock = SingletonLock()
        home_fd = fd = None
        try:
            home_fd = open_account_home(identity, managed=False)
            found, fd, st = inspect_home_config(identity, home_fd)
            report.update(found)
            if not repair:
                code = 0
            elif found["state"] == "clean":
                # The proposal is stale: the file it named is gone. A refusal, so the wrapper sees no repair.
                report.update(state="refused", reason="proposal_changed")
            elif found["state"] != "repairable":
                pass
            elif found["sha256"] != expected:
                report.update(state="refused", reason="proposal_changed")
            elif not no_agent_processes(identity, timeout=0):
                report.update(state="refused", reason="agent_running")
            else:
                report.update(quarantine_home_config(home_fd, fd, st, found))
                code = 0 if report["state"] == "repaired" else 1
        finally:
            for handle in (fd, home_fd, lock.fd):
                if handle is not None:
                    os.close(handle)
    except Refusal as exc:
        report.update(state="busy" if exc.reason == "busy" else "refused", reason=exc.reason)
        code = 75 if exc.reason == "busy" else 1
    except OSError:
        report.update(state="refused", reason="state_untrusted")
    print(json.dumps(report))
    return code


