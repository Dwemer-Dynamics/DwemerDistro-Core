IDENT = re.compile(r"^[a-z_][a-z0-9_]{0,62}\Z")
AGGREGATES = ("count", "count_distinct", "sum", "min", "max", "avg")
OPERATORS = {"eq": "=", "ne": "<>", "lt": "<", "le": "<=", "gt": ">", "ge": ">="}
QUERY_KEYS = {"schema", "table", "columns", "aggregates", "filters", "group_by", "order_by", "limit", "offset"}
RAW_SQL_HINT = ("Raw SQL is not accepted. Send a JSON object with table, and optionally schema, columns, aggregates "
                "[{fn: count|count_distinct|sum|min|max|avg, column, as}], filters [{column, op, value}], group_by, "
                "order_by [{key, dir}], limit, offset. Run db schema first for the approved tables and columns.")


def db_policy(product):
    if product not in DB_PRODUCTS:
        raise AccessError("invalid_argument", "Unknown product for db. Expected one of: " + ", ".join(DB_PRODUCTS) + ".")
    policy = DB_POLICY[product]
    if policy.get("unsupported"):
        raise AccessError("unsupported", f"No tables are reviewed for {product} yet.",
                          {"product": product, "reason": policy["unsupported"]})
    return policy


def qi(name):
    """Quote an identifier that already matched IDENT."""
    if not IDENT.match(name):
        raise AccessError("invalid_argument", "Invalid identifier.")
    return '"' + name + '"'


def check_schema(policy, schema):
    if schema in (None, "public"):
        return "public"
    pattern = policy.get("profile_schema")
    if not isinstance(schema, str) or not pattern or not pattern.match(schema):
        raise AccessError("invalid_argument", "schema must be public" + (" or a chim_profile_* playthrough schema"
                                                                         if pattern else "") + ".")
    return schema


def table_columns(policy, table):
    """{name: (class, sql expression template)} for one approved table."""
    if not isinstance(table, str) or table not in policy["tables"]:
        raise AccessError("invalid_argument", "table must be one of: " + ", ".join(sorted(policy["tables"])) + ".",
                          {"hint": "db schema"})
    cols = {name: (cls, qi(name)) for name, cls in policy["tables"][table].items()}
    for name, cls in policy.get("projection", {}).get(table, {}).get("columns", {}).items():
        cols[name] = (cls, qi(name))
    return cols


class Params:
    """Values as psql variables (-v pN=value), referenced as :'pN', so psql quotes them as literals."""

    def __init__(self):
        self.values = []

    def add(self, value):
        if isinstance(value, bool):
            return "TRUE" if value else "FALSE"
        if isinstance(value, int):
            if not -2 ** 63 <= value < 2 ** 63:
                raise AccessError("invalid_argument", "Integer value out of range.")
            return str(value)
        if isinstance(value, float):
            if value != value or value in (float("inf"), float("-inf")):
                raise AccessError("invalid_argument", "Number values must be finite.")
            return repr(value)
        if isinstance(value, str):
            if len(value) > LIMITS["db_value_chars"] or "\0" in value:
                raise AccessError("invalid_argument", f"Text values are limited to {LIMITS['db_value_chars']} characters.")
            self.values.append(value)
            return f":'p{len(self.values)}'"
        raise AccessError("invalid_argument", "Filter values must be text, numbers, or true/false.")


def parse_query_json(raw):
    """The structured query object from the --query-json text; raw SQL is refused with a hint."""
    if not isinstance(raw, str) or len(raw) > 16384:
        raise AccessError("invalid_argument", "--query-json must be a JSON object of up to 16 KiB.")
    try:
        query = json.loads(raw)
    except ValueError:
        query = None
    if not isinstance(query, dict):
        raise AccessError("refused", RAW_SQL_HINT, {"reason": "raw_sql_refused" if re.search(
            r"(?i)\b(select|insert|update|delete|with|copy|set|create|drop|alter|grant|call|do)\b", raw)
            else "not_json_object"})
    if any(key in query for key in ("sql", "query", "raw", "expression", "where")):
        raise AccessError("refused", RAW_SQL_HINT, {"reason": "raw_sql_refused"})
    unknown = set(query) - QUERY_KEYS
    if unknown:
        raise AccessError("invalid_argument", "Unknown query fields: " + ", ".join(sorted(unknown)[:8]) + ". " + RAW_SQL_HINT)
    return query


def as_list(query, key, limit):
    value = query.get(key, [])
    if not isinstance(value, list) or len(value) > limit:
        raise AccessError("invalid_argument", f"{key} must be a list of at most {limit} items.")
    return value


def build_query(product, query):
    """(sql, params, output column names, limit) from a validated structured query. Only identifiers from
    the policy and generated operators reach the SQL text; every value is a typed literal or psql variable."""
    policy = db_policy(product)
    schema = check_schema(policy, query.get("schema"))
    table = query.get("table")
    cols = table_columns(policy, table)
    params = Params()
    projection = policy.get("projection", {}).get(table)
    used = set()

    def column(name, what):
        if not isinstance(name, str) or name not in cols:
            raise AccessError("invalid_argument", f"Unknown {what} column for {table}: use a column from db schema.",
                              {"column": name if isinstance(name, str) and len(name) < 64 else None,
                               "allowed": sorted(cols), "hint": "db schema"})
        used.add(name)
        return cols[name]

    def output(name):
        cls, expr = column(name, "selected")
        return f"left(({expr})::text, {LIMITS['db_cell_chars']})" if cls == "t" else expr

    columns = as_list(query, "columns", LIMITS["db_columns"])
    aggregates = as_list(query, "aggregates", LIMITS["db_aggregates"])
    group_by = as_list(query, "group_by", LIMITS["db_group_by"])
    if not columns and not aggregates:
        columns = sorted(cols)
    if aggregates and any(name not in group_by for name in columns):
        raise AccessError("invalid_argument", "With aggregates, every listed column must also be in group_by.")
    if group_by and not aggregates:
        raise AccessError("invalid_argument", "group_by needs at least one aggregate.")
    if len(set(columns)) != len(columns):
        raise AccessError("invalid_argument", "columns must not repeat.")
    items, names = [], []
    for name in columns:
        items.append(f"{output(name)} AS {qi(name)}")
        names.append(name)
    for index, agg in enumerate(aggregates):
        if not isinstance(agg, dict) or set(agg) - {"fn", "column", "as"} or agg.get("fn") not in AGGREGATES:
            raise AccessError("invalid_argument", "Each aggregate is {fn: count|count_distinct|sum|min|max|avg, column, as}.")
        fn, target = agg["fn"], agg.get("column")
        alias = agg.get("as") or (f"{fn}_{target}" if target else fn)
        if not isinstance(alias, str) or not IDENT.match(alias) or alias in names:
            raise AccessError("invalid_argument", "aggregate 'as' must be a new lower-case identifier.")
        if target is None:
            if fn != "count":
                raise AccessError("invalid_argument", f"{fn} needs a column.")
            expr = "count(*)"
        else:
            cls, source = column(target, "aggregate")
            if fn in ("sum", "avg") and cls != "n":
                raise AccessError("invalid_argument", f"{fn} works on numeric columns only.")
            if fn == "count_distinct":
                expr = f"count(DISTINCT {source})"
            elif fn in ("min", "max") and cls == "t":
                expr = f"left({fn}(({source})::text), {LIMITS['db_cell_chars']})"
            else:
                expr = f"{fn}({source})"
        items.append(f"{expr} AS {qi(alias)}")
        names.append(alias)
    where = []
    for flt in as_list(query, "filters", LIMITS["db_filters"]):
        if not isinstance(flt, dict) or set(flt) - {"column", "op", "value", "values"}:
            raise AccessError("invalid_argument", "Each filter is {column, op, value} or {column, op: in|not_in, values}.")
        cls, expr = column(flt.get("column"), "filter")
        op = flt.get("op")
        if op in OPERATORS:
            where.append(f"{expr} {OPERATORS[op]} {params.add(flt.get('value'))}")
        elif op in ("in", "not_in"):
            values = flt.get("values")
            if not isinstance(values, list) or not 1 <= len(values) <= LIMITS["db_in_values"]:
                raise AccessError("invalid_argument", f"{op} needs values: a list of 1-{LIMITS['db_in_values']}.")
            where.append(f"{expr} {'IN' if op == 'in' else 'NOT IN'} ({', '.join(params.add(v) for v in values)})")
        elif op in ("is_null", "not_null"):
            where.append(f"{expr} IS {'NOT ' if op == 'not_null' else ''}NULL")
        elif op in ("contains", "starts_with"):
            value = flt.get("value")
            if not isinstance(value, str) or not value:
                raise AccessError("invalid_argument", f"{op} needs a text value.")
            ref = params.add(value)
            if op == "contains":
                where.append(f"strpos(lower(({expr})::text), lower({ref})) > 0")
            else:
                where.append(f"starts_with(lower(({expr})::text), lower({ref}))")
        else:
            raise AccessError("invalid_argument", "op must be eq, ne, lt, le, gt, ge, in, not_in, is_null, not_null, "
                                                  "contains, or starts_with.")
    groups = [column(name, "group_by")[1] for name in group_by]
    order = []
    for entry in as_list(query, "order_by", LIMITS["db_order_by"]):
        if not isinstance(entry, dict) or set(entry) - {"key", "dir"} or entry.get("dir", "asc") not in ("asc", "desc"):
            raise AccessError("invalid_argument", "Each order_by entry is {key: column or aggregate alias, dir: asc|desc}.")
        key = entry.get("key")
        if key not in names:
            raise AccessError("invalid_argument", "order_by keys must be selected columns or aggregate aliases.")
        order.append(f"{qi(key)} {entry.get('dir', 'asc').upper()}")
    limit = bounded_int(query.get("limit"), "limit", 1, LIMITS["db_rows"], LIMITS["db_default_rows"])
    offset = bounded_int(query.get("offset"), "offset", 0, LIMITS["db_offset"], 0)
    source = table
    if projection and used & set(projection["columns"]):
        source = projection["view"]  # code-owned view name; never taken from the query
    sql = f"SELECT {', '.join(items)} FROM {qi(schema)}.{qi(source)}"
    if where:
        sql += " WHERE " + " AND ".join(where)
    if groups:
        sql += " GROUP BY " + ", ".join(groups)
    if order:
        sql += " ORDER BY " + ", ".join(order)
    sql += f" LIMIT {limit + 1} OFFSET {offset}"
    wrapped = f"SELECT coalesce(json_agg(r), '[]'::json) FROM ({sql}) r"
    return wrapped, params.values, names, limit, schema


# --- Bounded subprocess (process group, timeout, output cap, cancellation) ----------

def trusted_binary(path):
    """A root-owned, non-group/other-writable file in a root-owned directory, following one link hop."""
    try:
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode):
            parent = os.stat(os.path.dirname(path))
            if info.st_uid != 0 or parent.st_uid != 0 or parent.st_mode & 0o022:
                return False
            path = os.path.normpath(os.path.join(os.path.dirname(path), os.readlink(path)))
            info = os.lstat(path)
        parent = os.stat(os.path.dirname(path))
    except OSError:
        return False
    return (stat.S_ISREG(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022 and parent.st_uid == 0
            and not parent.st_mode & 0o022 and os.access(path, os.X_OK))


def run_bounded(argv, stdin=b"", timeout=15, limit=1024 * 1024, env=None):
    """(exit code, stdout bytes, stderr tail). The child runs in its own session and its whole process
    group is stopped on timeout, overflow, or cancellation (which is re-raised)."""
    proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env or {},
                            cwd="/", close_fds=True, start_new_session=True)
    out, err, state = bytearray(), bytearray(), {"overflow": False}

    def drain(stream, buf, cap, flag):
        while True:
            chunk = stream.read(65536)
            if not chunk:
                return
            if len(buf) + len(chunk) > cap:
                buf += chunk[:max(0, cap - len(buf))]
                if flag:
                    state["overflow"] = True
                    kill_group(proc)
                    return
            else:
                buf += chunk

    def feed():
        try:
            proc.stdin.write(stdin)
            proc.stdin.close()
        except OSError:
            pass

    threads = [threading.Thread(target=drain, args=(proc.stdout, out, limit, True), daemon=True),
               threading.Thread(target=drain, args=(proc.stderr, err, 16 * 1024, False), daemon=True),
               threading.Thread(target=feed, daemon=True)]
    for thread in threads:
        thread.start()
    try:
        try:
            proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            kill_group(proc)
            raise AccessError("timeout", f"The read did not finish within {timeout} seconds.", {"reason": "timeout"})
    except BaseException:
        kill_group(proc)
        raise
    finally:
        for thread in threads:
            thread.join(2)
    if state["overflow"]:
        raise AccessError("limit_reached", "The result was larger than the output limit.", {"reason": "output_limit"})
    return proc.returncode, bytes(out), bytes(err).decode("utf-8", "replace")


def kill_group(proc):
    for sig in (signal.SIGTERM, getattr(signal, "SIGKILL", signal.SIGTERM)):
        try:
            os.killpg(proc.pid, sig)
        except (ProcessLookupError, PermissionError, AttributeError, OSError):
            return
        try:
            proc.wait(timeout=2)
            return
        except subprocess.TimeoutExpired:
            continue


def psql_argv(database, params):
    argv = [DB_RUNUSER, "-u", DB_ROLE, "--", DB_PSQL, "-X", "-A", "-t", "-q", "--no-password", "-v", "ON_ERROR_STOP=1",
            "-h", DB_SOCKET, "-p", DB_PORT, "-d", database]
    for index, value in enumerate(params, 1):
        argv += ["-v", f"p{index}={value}"]
    return argv + ["-f", "-"]


def psql_script(sql):
    return ("BEGIN TRANSACTION READ ONLY;\n"
            f"SET LOCAL statement_timeout = {LIMITS['db_statement_ms']};\n"
            "SET LOCAL lock_timeout = 1000;\n"
            "SET LOCAL search_path = pg_catalog;\n"
            f"{sql};\nROLLBACK;\n").encode("utf-8")


def psql_env():
    return {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PGCONNECT_TIMEOUT": "5",
            "PGAPPNAME": "ddistro-access", "PGTZ": "UTC",
            "PGOPTIONS": "-c default_transaction_read_only=on -c statement_timeout=5000 -c lock_timeout=1000 "
                         "-c idle_in_transaction_session_timeout=5000"}


def psql_failure(stderr):
    """Map a psql error to an AccessError without echoing data."""
    text = stderr.strip().split("\n")[0] if stderr.strip() else ""
    lower = text.lower()
    if "does not exist" in lower and ("user " + DB_ROLE in lower or "role \"" + DB_ROLE in lower):
        return AccessError("unsupported", "The ddreader database role is not provisioned. Root runs "
                           "install_assistant_runtime --db-reader.", {"reason": "db_reader_missing"})
    if "peer authentication failed" in lower or "no pg_hba.conf entry" in lower:
        return AccessError("unsupported", "PostgreSQL does not accept local peer login for ddreader.",
                           {"reason": "unsupported_auth"})
    if "permission denied" in lower:
        return AccessError("permission_denied", "ddreader has no read grant for that table or column. Use db schema "
                           "for what is granted. Saving or loading a CHIM playthrough rebuilds those tables without grants; "
                           "the automatic grant refresh did not restore it (see details.refresh), so root reruns "
                           "install_assistant_runtime --db-reader.",
                           {"reason": "not_granted", "hint": "db schema"})
    if "does not exist" in lower and any(spec["view"] in lower for policy in DB_POLICY.values()
                                         for spec in policy.get("projection", {}).values()):
        return AccessError("unsupported", "The derived NPC memory view is not provisioned in that schema (loading a "
                           "CHIM playthrough removes it from public) and the automatic grant refresh did not restore it "
                           "(see details.refresh). Root reruns install_assistant_runtime --db-reader.", {"reason": "projection_missing"})
    if "statement timeout" in lower or "lock timeout" in lower:
        return AccessError("timeout", "PostgreSQL stopped the read at its time limit.", {"reason": "statement_timeout"})
    if "does not exist" in lower:
        return AccessError("not_found", "That schema, table, or column does not exist here.", {"hint": "db schema"})
    clean, _ = redact_text(text)
    return AccessError("failed", "The read-only query failed.", {"psql": clip(clean, 300)})


def run_db(product, sql, params, runner=None):
    """Run one generated SELECT as ddreader; returns decoded JSON. runner is a test seam with run_bounded's signature."""
    database = DB_PRODUCTS[product]
    if runner is None:
        if not (trusted_binary(DB_RUNUSER) and trusted_binary(DB_PSQL)):
            raise AccessError("helper_unavailable", "runuser or psql is not a trusted root-owned program.")
        runner = run_bounded
    code, out, err = runner(psql_argv(database, params), stdin=psql_script(sql), timeout=LIMITS["db_seconds"],
                            limit=LIMITS["db_output_bytes"], env=psql_env())
    if code != 0:
        raise psql_failure(err)
    try:
        return json.loads(out.decode("utf-8").strip() or "null")
    except ValueError:
        raise AccessError("failed", "PostgreSQL returned unexpected output.", {"reason": "protocol"})


def clean_cell(value):
    if isinstance(value, str):
        text, n = redact_text(value)
        return clip(text, LIMITS["db_cell_chars"]), n
    if isinstance(value, (dict, list)):
        return "[structured]", 0
    return value, 0


def db_query(product, raw_json, runner=None, refresher=None):
    query = parse_query_json(raw_json)
    sql, params, names, limit, schema = build_query(product, query)
    refresher = default_refresher(runner, refresher)
    refresh = no_refresh()
    started = time.monotonic()
    try:
        rows = run_db(product, sql, params, runner) or []
    except AccessError as error:
        trigger = error.details.get("reason")
        # Only a gap in public (the schema CHIM drops on load) triggers the one refresh; a snapshot never does.
        if refresher is None or schema != "public" or trigger not in REFRESH_TRIGGERS:
            raise
        refresh = refresher(product, trigger)
        if not refresh["ok"]:
            error.details["refresh"] = refresh
            raise
        try:
            rows = run_db(product, sql, params, runner) or []
        except AccessError as again:
            again.details["refresh"] = refresh
            raise
    elapsed = int((time.monotonic() - started) * 1000)
    truncated = len(rows) > limit
    out, redactions = [], 0
    for row in rows[:limit]:
        cells = []
        for name in names:
            value, n = clean_cell(row.get(name) if isinstance(row, dict) else None)
            redactions += n
            cells.append(value)
        out.append(cells)
    return result({"product": product, "database": DB_PRODUCTS[product], "schema": schema, "table": query["table"],
                   "columns": names, "rows": out, "row_count": len(out), "redactions": redactions, "ms": elapsed,
                   "transaction": "read_only", "role": DB_ROLE},
                  complete=not truncated, reason="row_limit" if truncated else None,
                  coverage={"limit": limit, "offset": query.get("offset", 0), "cell_chars": LIMITS["db_cell_chars"],
                            "refresh": refresh})


def schema_sql(policy, schema, table):
    """Granted columns of approved tables (information_schema shows only columns ddreader may read)."""
    tables = sorted(policy["tables"]) if table is None else [table]
    names = ", ".join("'" + name + "'" for name in tables)
    views = [spec["view"] for name, spec in sorted(policy.get("projection", {}).items()) if name in tables]
    relations = f"(k.relkind = 'r' AND c.table_name IN ({names}))"
    if views:
        relations = f"({relations} OR (k.relkind = 'v' AND c.table_name IN ({', '.join(repr(v) for v in views)})))"
    if schema is None:
        schemas = "c.table_schema = 'public'"
        if policy.get("profile_schema"):
            schemas = "(c.table_schema = 'public' OR c.table_schema LIKE 'chim\\_profile\\_%')"
    else:
        schemas = "c.table_schema = '" + schema + "'"
    return ("SELECT coalesce(json_agg(t ORDER BY t.schema, t.table), '[]'::json) FROM ("
            "SELECT c.table_schema AS schema, c.table_name AS table, json_agg(json_build_array(c.column_name, c.data_type)"
            " ORDER BY c.ordinal_position) AS columns, max(k.reltuples)::bigint AS row_estimate "
            "FROM information_schema.columns c JOIN pg_class k ON k.relname = c.table_name "
            "JOIN pg_namespace n ON n.oid = k.relnamespace AND n.nspname = c.table_schema "
            f"WHERE {schemas} AND {relations} GROUP BY c.table_schema, c.table_name "
            f"LIMIT {LIMITS['db_tables'] + 1}) t")


def db_schema(product, schema=None, table=None, runner=None, refresher=None):
    policy = db_policy(product)
    if schema is not None:
        schema = check_schema(policy, schema)
    if table is not None:
        table_columns(policy, table)
    refresher = default_refresher(runner, refresher)
    data = schema_result(product, policy, schema, table, runner, no_refresh())
    # Only a gap in public (the schema CHIM drops on load) triggers the one refresh; a snapshot never does.
    gap = data["reason"] == "public_not_granted" or any(
        entry.get("derived") == "projection_missing" and entry["schema"] == "public" for entry in data["tables"])
    if refresher is None or not gap:
        return data
    trigger = "public_not_granted" if data["reason"] == "public_not_granted" else "projection_missing"
    refresh = refresher(product, trigger)
    if not refresh["ok"]:
        data["coverage"]["refresh"] = refresh
        return data
    return schema_result(product, policy, schema, table, runner, refresh)


def schema_result(product, policy, schema, table, runner, refresh):
    rows = run_db(product, schema_sql(policy, schema, table), [], runner) or []
    projections = policy.get("projection", {})
    by_view = {spec["view"]: base for base, spec in projections.items()}
    # Granted projection-view columns per (schema, base table); the view itself is not listed as a table.
    derived = {(row.get("schema"), by_view[row.get("table")]): {name for name, _ in row.get("columns") or []}
               for row in rows if row.get("table") in by_view}
    rows = [row for row in rows if row.get("table") not in by_view]
    truncated = len(rows) > LIMITS["db_tables"]
    tables = []
    for row in rows[:LIMITS["db_tables"]]:
        approved = policy["tables"].get(row.get("table"), {})
        projection = projections.get(row.get("table"), {})
        granted = derived.get((row.get("schema"), row.get("table")), set())
        columns = [{"name": name, "type": kind, "class": "text" if approved.get(name) == "t" else "value"}
                   for name, kind in row.get("columns") or [] if name in approved]
        columns += [{"name": name, "type": "derived", "class": "text" if cls == "t" else "value",
                     "source": projection["source"] + "." + projection["path"], "via": projection["view"]}
                    for name, cls in projection.get("columns", {}).items() if name in granted]
        entry = {"schema": row.get("schema"), "table": row.get("table"), "columns": columns,
                 "row_estimate": row.get("row_estimate"), "row_estimate_kind": "planner_estimate"}
        if projection and not granted:
            entry["derived"] = "projection_missing"  # its derived columns are unavailable, never zero
        tables.append(entry)
    # CHIM drops and re-clones public on every playthrough load, which removes ddreader's grants there.
    public_missing = schema in (None, "public") and not any(row.get("schema") == "public" for row in rows)
    playthroughs, playthrough_reason = None, None
    meta = policy.get("meta")
    if meta:
        fields = ", ".join(qi(c) for c in meta["columns"])
        pairs = ", ".join(f"'{c}', {qi(c)}" for c in meta["columns"])
        sql = (f"SELECT coalesce(json_agg(json_build_object({pairs}) ORDER BY m.{qi('id')}), '[]'::json) "
               f"FROM (SELECT {fields} FROM {qi(meta['schema'])}.{qi(meta['table'])} LIMIT 200) m")
        try:
            playthroughs = run_db(product, sql, [], runner)
        except AccessError as error:
            playthrough_reason = error.details.get("reason", error.code)
    reason = None
    if truncated:
        reason = "table_limit"
    elif public_missing:
        reason = "public_not_granted"
    elif playthrough_reason:
        reason = "playthroughs_unavailable"
    return result({"product": product, "database": DB_PRODUCTS[product], "tables": tables,
                   "playthroughs": playthroughs, "playthroughs_reason": playthrough_reason,
                   "notes": policy.get("notes", []),
                   "query_contract": "db query PRODUCT --query-json OBJECT (see ASSISTANT.md)"},
                  complete=reason is None, reason=reason,
                  coverage={"tables": len(tables), "approved_tables": sorted(policy["tables"]),
                            "missing_tables_mean": "not granted or not present, not empty",
                            "refresh": refresh,
                            "recovery": "the automatic grant refresh did not restore public (see coverage.refresh); root "
                                        "reruns install_assistant_runtime --db-reader" if public_missing else None})


# --- Grant script for install_assistant_runtime --db-reader -----------------------

def grant_sql(database):
    """Idempotent grants for one product database, from the policy only. Runs as postgres via the installer.

    First drops every table-, view- and column-level privilege and schema USAGE that ddreader itself holds in
    this database (REVOKE ALL ON TABLE does not remove column grants, so columns are revoked by name), then
    grants the reviewed columns and the managed projection views again, all in the installer's one
    transaction. Only ddreader's own ACL entries change: no other role, PUBLIC default, owner, or row."""
    product = next((key for key, name in DB_PRODUCTS.items() if name == database), None)
    if product is None:
        raise AccessError("invalid_argument", "Unknown database.")
    policy = DB_POLICY[product]
    plan = {"tables": {table: list(cols) for table, cols in policy["tables"].items()},
            "profile_regex": policy["profile_schema"].pattern.replace("\\Z", "$") if policy.get("profile_schema") else None,
            "meta": policy.get("meta"),
            "projections": [{"table": table, "view": spec["view"], "source": spec["source"], "base": spec["base"]}
                            for table, spec in sorted(policy.get("projection", {}).items())]}
    literal = json.dumps(plan, sort_keys=True).replace("'", "''")
    view_sql = PROJECTION_VIEW_SQL.replace("'", "''")
    comment = PROJECTION_COMMENT.replace("'", "''")
    return f"""DO $ddreader$
DECLARE
  plan jsonb := '{literal}';
  reader oid; me oid; r record; p jsonb; s text; t text; keep text; rel oid;
  schemas text[] := ARRAY['public']; profiles text[];
BEGIN
  PERFORM pg_catalog.set_config('search_path', 'pg_catalog', true);
  SELECT oid INTO reader FROM pg_catalog.pg_roles WHERE rolname = '{DB_ROLE}';
  IF reader IS NULL THEN
    RAISE EXCEPTION 'role {DB_ROLE} is missing';
  END IF;
  SELECT oid INTO me FROM pg_catalog.pg_roles WHERE rolname = current_user;
  -- 1. Drop ddreader's own relation, column and schema privileges everywhere in this database.
  FOR r IN SELECT n.nspname, c.relname, c.oid FROM pg_catalog.pg_class c
      JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
      WHERE c.relkind IN ('r', 'p', 'v', 'm', 'f')
        AND (EXISTS (SELECT 1 FROM pg_catalog.aclexplode(c.relacl) a WHERE a.grantee = reader)
          OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute a, pg_catalog.aclexplode(a.attacl) x
                     WHERE a.attrelid = c.oid AND a.attnum > 0 AND x.grantee = reader)) LOOP
    EXECUTE format('REVOKE ALL ON TABLE %I.%I FROM {DB_ROLE}', r.nspname, r.relname);
    SELECT string_agg(quote_ident(a.attname), ', ') INTO keep FROM pg_catalog.pg_attribute a
      WHERE a.attrelid = r.oid AND a.attnum > 0 AND NOT a.attisdropped
        AND EXISTS (SELECT 1 FROM pg_catalog.aclexplode(a.attacl) x WHERE x.grantee = reader);
    IF keep IS NOT NULL THEN
      EXECUTE format('REVOKE ALL (%s) ON TABLE %I.%I FROM {DB_ROLE}', keep, r.nspname, r.relname);
    END IF;
  END LOOP;
  FOR s IN SELECT n.nspname FROM pg_catalog.pg_namespace n
      WHERE EXISTS (SELECT 1 FROM pg_catalog.aclexplode(n.nspacl) a WHERE a.grantee = reader) LOOP
    EXECUTE format('REVOKE ALL ON SCHEMA %I FROM {DB_ROLE}', s);
  END LOOP;
  -- 2. public plus the playthrough snapshot schemas listed in playthrough_profiles.
  IF plan->>'profile_regex' IS NOT NULL AND to_regclass('chim_meta.playthrough_profiles') IS NOT NULL THEN
    EXECUTE 'SELECT array_agg(schema_name) FROM chim_meta.playthrough_profiles WHERE schema_name ~ $1'
      INTO profiles USING plan->>'profile_regex';
    SELECT schemas || coalesce(array_agg(nspname::text), '{{}}') INTO schemas FROM pg_catalog.pg_namespace
      WHERE nspname = ANY(coalesce(profiles, '{{}}'));
  END IF;
  FOREACH s IN ARRAY schemas LOOP
    EXECUTE format('GRANT USAGE ON SCHEMA %I TO {DB_ROLE}', s);
    FOR t IN SELECT jsonb_object_keys(plan->'tables') LOOP
      SELECT c.oid INTO rel FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = s AND c.relname = t AND c.relkind = 'r';
      CONTINUE WHEN rel IS NULL;
      SELECT string_agg(quote_ident(a.attname), ', ') INTO keep FROM pg_catalog.pg_attribute a
        WHERE a.attrelid = rel AND a.attnum > 0 AND NOT a.attisdropped
          AND a.attname IN (SELECT jsonb_array_elements_text(plan->'tables'->t));
      IF keep IS NOT NULL THEN
        EXECUTE format('GRANT SELECT (%s) ON TABLE %I.%I TO {DB_ROLE}', keep, s, t);
      END IF;
    END LOOP;
    -- 3. Managed projection views: created or refreshed only when the source table has the reviewed columns
    -- (the JSON source as json/jsonb); a same-named object that is not ours stops the whole run.
    FOR p IN SELECT jsonb_array_elements(plan->'projections') LOOP
      SELECT c.oid INTO rel FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = s AND c.relname = p->>'table' AND c.relkind = 'r';
      CONTINUE WHEN rel IS NULL OR NOT EXISTS (SELECT 1 FROM pg_catalog.pg_attribute a
          WHERE a.attrelid = rel AND a.attname = p->>'source' AND NOT a.attisdropped
            AND a.atttypid IN ('pg_catalog.json'::pg_catalog.regtype, 'pg_catalog.jsonb'::pg_catalog.regtype))
        OR (SELECT count(*) FROM pg_catalog.pg_attribute a WHERE a.attrelid = rel AND NOT a.attisdropped
              AND a.attname IN (SELECT jsonb_array_elements_text(p->'base'))) < jsonb_array_length(p->'base');
      SELECT c.oid INTO rel FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
        WHERE n.nspname = s AND c.relname = p->>'view';
      IF rel IS NOT NULL AND NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class c WHERE c.oid = rel AND c.relkind = 'v'
          AND c.relowner = me AND pg_catalog.obj_description(c.oid, 'pg_class') = '{comment}') THEN
        RAISE EXCEPTION 'refusing to replace %.%: it exists and is not the DwemerDistro-managed view', s, p->>'view';
      END IF;
      EXECUTE format('{view_sql}', s, p->>'view', p->>'table');
      EXECUTE format('COMMENT ON VIEW %I.%I IS %L', s, p->>'view', '{comment}');
      EXECUTE format('REVOKE ALL ON TABLE %I.%I FROM PUBLIC', s, p->>'view');
      EXECUTE format('GRANT SELECT ON TABLE %I.%I TO {DB_ROLE}', s, p->>'view');
    END LOOP;
  END LOOP;
  IF plan->'meta' IS NOT NULL AND plan->'meta' <> 'null'::jsonb THEN
    SELECT c.oid INTO rel FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
      WHERE n.nspname = plan->'meta'->>'schema' AND c.relname = plan->'meta'->>'table' AND c.relkind = 'r';
    IF rel IS NOT NULL THEN
      EXECUTE format('GRANT USAGE ON SCHEMA %I TO {DB_ROLE}', plan->'meta'->>'schema');
      SELECT string_agg(quote_ident(a.attname), ', ') INTO keep FROM pg_catalog.pg_attribute a
        WHERE a.attrelid = rel AND a.attnum > 0 AND NOT a.attisdropped
          AND a.attname IN (SELECT jsonb_array_elements_text(plan->'meta'->'columns'));
      IF keep IS NOT NULL THEN
        EXECUTE format('GRANT SELECT (%s) ON TABLE %I.%I TO {DB_ROLE}', keep, plan->'meta'->>'schema',
                       plan->'meta'->>'table');
      END IF;
    END IF;
  END IF;
  RAISE NOTICE 'ddreader grants refreshed for % schema(s)', array_length(schemas, 1);
END
$ddreader$;
"""


# --- Automatic, bounded refresh after a CHIM playthrough save/load -------------------
# CHIM's load drops public CASCADE and clones a snapshot back without views or grants, so ddreader loses
# access on every load. A db command that hits exactly that gap runs the installer's refresh script once as
# postgres for the one reviewed database being read, then retries once. The script is fixed: it takes only a
# database name from DB_PRODUCTS, never model text, and it stops unchanged unless ddreader is already the
# dedicated, unprivileged reader the installer created. It never creates accounts or roles, and never touches
# other roles, PUBLIC defaults, owners, rows, pg_hba or services.
REFRESH_TRIGGERS = ("not_granted", "projection_missing", "public_not_granted")
REFRESH_NOTICE = re.compile(r"ddreader grants refreshed for (\d+) schema")


def refresh_sql(database):
    """grant_sql wrapped in a dedicated-role check and before/after fingerprints of ddreader's privileges and
    the managed views. Run as postgres in one transaction (psql -1); prints two md5 lines."""
    comment = DB_ROLE_COMMENT.replace("'", "''")
    view_comment = PROJECTION_COMMENT.replace("'", "''")
    reader = f"(SELECT oid FROM pg_catalog.pg_roles WHERE rolname = '{DB_ROLE}')"
    fingerprint = f"""SELECT pg_catalog.md5(coalesce(pg_catalog.string_agg(x, ',' ORDER BY x), '')) FROM (
  SELECT c.oid::regclass::text || ':' || a.privilege_type FROM pg_catalog.pg_class c, pg_catalog.aclexplode(c.relacl) a
    WHERE a.grantee = {reader}
  UNION ALL SELECT c.oid::regclass::text || '.' || t.attname || ':' || a.privilege_type
    FROM pg_catalog.pg_attribute t JOIN pg_catalog.pg_class c ON c.oid = t.attrelid, pg_catalog.aclexplode(t.attacl) a
    WHERE a.grantee = {reader}
  UNION ALL SELECT n.nspname || ':' || a.privilege_type FROM pg_catalog.pg_namespace n, pg_catalog.aclexplode(n.nspacl) a
    WHERE a.grantee = {reader}
  UNION ALL SELECT 'view:' || c.oid::regclass::text FROM pg_catalog.pg_class c
    WHERE c.relkind = 'v' AND pg_catalog.obj_description(c.oid, 'pg_class') = '{view_comment}') s(x);
"""
    return f"""SET LOCAL search_path = pg_catalog;
SET LOCAL statement_timeout = {LIMITS['db_refresh_statement_ms']};
SET LOCAL lock_timeout = {LIMITS['db_refresh_lock_ms']};
DO $ddcheck$
DECLARE r record;
BEGIN
  SELECT g.rolsuper OR g.rolcreatedb OR g.rolcreaterole OR g.rolreplication OR g.rolbypassrls OR NOT g.rolcanlogin
           OR g.rolinherit AS privileged,
         coalesce(pg_catalog.shobj_description(g.oid, 'pg_authid'), '') AS note,
         NOT coalesce('default_transaction_read_only=on' = ANY(g.rolconfig), false) AS writable,
         (SELECT count(*) FROM pg_catalog.pg_auth_members m WHERE m.member = g.oid OR m.roleid = g.oid)
           + (SELECT count(*) FROM pg_catalog.pg_database d WHERE d.datdba = g.oid)
           + (SELECT count(*) FROM pg_catalog.pg_class c WHERE c.relowner = g.oid)
           + (SELECT count(*) FROM pg_catalog.pg_namespace n WHERE n.nspowner = g.oid)
           + (SELECT count(*) FROM pg_catalog.pg_proc f WHERE f.proowner = g.oid) AS ties,
         pg_catalog.has_database_privilege(g.oid, pg_catalog.current_database(), 'CONNECT') AS can_connect
    INTO r FROM pg_catalog.pg_roles g WHERE g.rolname = '{DB_ROLE}';
  IF NOT FOUND THEN
    RAISE EXCEPTION 'ddreader_not_installed';
  END IF;
  IF r.privileged OR r.writable OR r.note <> '{comment}' OR r.ties <> 0 OR NOT r.can_connect THEN
    RAISE EXCEPTION 'ddreader_not_dedicated';
  END IF;
END
$ddcheck$;
{fingerprint}{grant_sql(database)}{fingerprint}"""


def refresh_argv(database):
    return [DB_RUNUSER, "-u", "postgres", "--", DB_PSQL, "-X", "-A", "-t", "-q", "--no-password", "-v", "ON_ERROR_STOP=1",
            "-h", DB_SOCKET, "-p", DB_PORT, "-d", database, "-1", "-f", "-"]


def refresh_env():
    return {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PGCONNECT_TIMEOUT": "5",
            "PGAPPNAME": "ddistro-access-refresh", "PGTZ": "UTC",
            "PGOPTIONS": f"-c statement_timeout={LIMITS['db_refresh_statement_ms']} "
                         f"-c lock_timeout={LIMITS['db_refresh_lock_ms']} -c idle_in_transaction_session_timeout=10000"}


def no_refresh():
    return {"count": 0, "trigger": None, "ok": None, "metadata_changed": False, "schemas": None, "reason": None}


def default_refresher(runner, refresher):
    """Production reads (runner None) refresh with refresh_grants; a test runner refreshes only when given one."""
    if refresher is not None:
        return refresher
    return refresh_grants if runner is None else None


def refresh_grants(product, trigger, runner=None):
    """Run refresh_sql once as postgres for the product's database. Returns a coverage record and never raises
    an AccessError: a refusal or failure is reported (ok false) and the caller keeps the original error."""
    info = dict(no_refresh(), count=1, trigger=trigger, ok=False, database=DB_PRODUCTS.get(product))
    if product not in DB_PRODUCTS or not DB_POLICY.get(product, {}).get("tables"):
        return dict(info, count=0, reason="not_reviewed")
    if runner is None:
        if not hasattr(os, "geteuid") or os.geteuid() != 0:
            return dict(info, count=0, reason="not_root")
        if not (trusted_binary(DB_RUNUSER) and trusted_binary(DB_PSQL)):
            return dict(info, count=0, reason="helper_unavailable")
        runner = run_bounded
    database = DB_PRODUCTS[product]
    try:
        code, out, err = runner(refresh_argv(database), stdin=refresh_sql(database).encode("utf-8"),
                                timeout=LIMITS["db_refresh_seconds"], limit=64 * 1024, env=refresh_env())
    except AccessError as error:
        return dict(info, reason=error.details.get("reason", error.code))
    if code != 0:
        lower = err.lower()
        for marker, reason in (("ddreader_not_installed", "db_reader_missing"),
                               ("ddreader_not_dedicated", "role_not_dedicated"),
                               ("refusing to replace", "view_collision"), ("lock timeout", "lock_timeout"),
                               ("statement timeout", "statement_timeout"), ("does not exist", "database_missing")):
            if marker in lower:
                return dict(info, reason=reason)
        clean, _ = redact_text(err.strip().split("\n")[0] if err.strip() else "")
        return dict(info, reason="failed", psql=clip(clean, 300))
    prints = [line.strip() for line in out.decode("utf-8", "replace").splitlines() if line.strip()]
    if len(prints) != 2:
        return dict(info, reason="protocol")
    match = REFRESH_NOTICE.search(err)
    return dict(info, ok=True, metadata_changed=prints[0] != prints[1], schemas=int(match.group(1)) if match else None)


if __name__ == "__main__":
    if sys.argv[1:] == ["--emit-databases"]:  # product databases with reviewed tables, one per line
        sys.stdout.write("".join(DB_PRODUCTS[key] + "\n" for key, spec in DB_POLICY.items() if spec["tables"]))
        sys.exit(0)
    if len(sys.argv) == 3 and sys.argv[1] == "--emit-grant-sql" and sys.argv[2] in DB_PRODUCTS.values():
        sys.stdout.write(grant_sql(sys.argv[2]))
        sys.exit(0)
    if len(sys.argv) == 3 and sys.argv[1] == "--emit-refresh-sql" and sys.argv[2] in DB_PRODUCTS.values():
        sys.stdout.write(refresh_sql(sys.argv[2]))
        sys.exit(0)
    sys.stderr.write("ddistro_access is a library for ddistro. Only --emit-databases, --emit-grant-sql DATABASE and "
                     "--emit-refresh-sql DATABASE are commands.\n")
    sys.exit(64)
