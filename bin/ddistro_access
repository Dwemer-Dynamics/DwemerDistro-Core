# Derived values over one fixed JSON path, served only through an installer-managed view owned by the
# installing superuser. ddreader is granted the view, never the source column; the builder targets the view
# only when a projection column is used, so id/npc_name/count queries keep reading the base table.
PROJECTION_COMMENT = "DwemerDistro assistant managed projection v1 (ddistro_access); safe to drop"
HERIKA_PROJECTION = {
    "core_npc_master": {"view": "ddreader_core_npc_master", "source": "extended_data", "path": "middle_term_memory",
                        "base": ["id", "npc_name"],
                        "columns": {"middle_term_memory_count": "n", "middle_term_memory_type": "t",
                                    "middle_term_memory_present": "n"}},
}
# Format args: 1 schema, 2 view, 3 table. search_path is pg_catalog while it is created; functions are qualified.
PROJECTION_VIEW_SQL = (
    "CREATE OR REPLACE VIEW %1$I.%2$I WITH (security_barrier = true) AS SELECT m.id, m.npc_name, "
    "CASE WHEN x.v IS NULL OR pg_catalog.jsonb_typeof(x.v) = 'null' THEN 0::pg_catalog.int8 "
    "WHEN pg_catalog.jsonb_typeof(x.v) = 'array' THEN pg_catalog.jsonb_array_length(x.v)::pg_catalog.int8 "
    "WHEN pg_catalog.jsonb_typeof(x.v) = 'object' THEN (SELECT pg_catalog.count(*) FROM pg_catalog.jsonb_object_keys(x.v)) "
    "ELSE NULL END AS middle_term_memory_count, "
    "COALESCE(pg_catalog.jsonb_typeof(x.v), 'absent') AS middle_term_memory_type, "
    "CASE WHEN x.v IS NULL OR x.v IN ('null'::pg_catalog.jsonb, '\"\"'::pg_catalog.jsonb, '[]'::pg_catalog.jsonb, "
    "'{}'::pg_catalog.jsonb) THEN 0 ELSE 1 END AS middle_term_memory_present "
    "FROM %1$I.%3$I m CROSS JOIN LATERAL (SELECT (m.extended_data)::pg_catalog.jsonb -> 'middle_term_memory' AS v) x")
DB_POLICY = {
