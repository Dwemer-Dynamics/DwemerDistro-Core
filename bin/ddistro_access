#!/usr/bin/env python3
"""Code-owned read-only access policy for the assistant: roots, deny rules, bounded file reads,
data-only config parsing, and a structured PostgreSQL query builder.

This file is a library loaded by ddistro (after a root-ownership check), not a command. The only
command-line uses are --emit-databases, --emit-grant-sql DATABASE and --emit-refresh-sql DATABASE, which print the reviewed
database names and the ddreader grant scripts built from the constants below for install_assistant_runtime
--db-reader; they never connect to anything themselves. The same fixed refresh script is the only thing the
db commands run as postgres, once per request, when CHIM's playthrough save/load has removed ddreader's
grants or managed view (see refresh_grants).

Nothing here takes a root path, SQL text, or a command from the caller: roots, databases, tables and
columns come only from the tables in this file. The component catalog cannot add or widen a root.
"""
import configparser
import datetime
import errno
import fnmatch
import json
import os
import re
import signal
import stat
import subprocess
import sys
import threading
import time

try:
    import tomllib
except ImportError:  # Python < 3.11
    tomllib = None

POLICY_VERSION = 1

