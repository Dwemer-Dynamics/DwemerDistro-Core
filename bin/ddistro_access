SECRET_NAME = re.compile(r"(?i)^(\.env(\..*)?|.*\.env|\.htpasswd|\.netrc|\.pgpass|\.git-credentials|\.npmrc|\.pypirc"
                         r"|id_(rsa|dsa|ecdsa|ed25519).*|.*\.(pem|key|p12|pfx|crt|kdbx|keystore|jks)"
                         r"|.*(secret|credential|passw|token|api_?key|private).*)\Z")
MEDIA_EXT = re.compile(r"(?i).*\.(wav|mp3|ogg|flac|opus|m4a|png|jpe?g|gif|webp|bmp|ico|mp4|webm|avi|gguf|safetensors"
                       r"|bin|onnx|pt|pth|ckpt|npy|npz|pkl|pickle|h5|zip|tar|gz|tgz|bz2|xz|7z|rar|so|dll|exe|o|a"
                       r"|pyc|whl|sqlite3?|db|dump|backup|bak|iso|img)\Z")

PATH_PART = re.compile(r"^[A-Za-z0-9._@+=,-][A-Za-z0-9._@+=, -]{0,254}\Z")
GLOB = re.compile(r"^[A-Za-z0-9._*?\[\]-]{1,64}\Z")
MAX_PATH_CHARS = 1024

LIMITS = {
    "list_depth": 3, "list_entries": 500, "dir_scan": 4096, "walk_entries": 20000, "walk_seconds": 10,
    "search_results": 100, "search_query_chars": 200, "search_file_bytes": 1024 * 1024,
    "search_total_bytes": 32 * 1024 * 1024, "search_files": 5000, "search_seconds": 20, "search_per_file": 20,
    "read_lines": 400, "read_file_bytes": 1024 * 1024, "line_chars": 4096, "match_chars": 400,
    "config_files": 20, "config_file_bytes": 256 * 1024, "config_keys": 500, "config_value_chars": 512,
    "config_depth": 6,
    "db_rows": 500, "db_default_rows": 100, "db_cell_chars": 512, "db_output_bytes": 1024 * 1024,
    "db_seconds": 15, "db_statement_ms": 5000, "db_tables": 300, "db_filters": 16, "db_in_values": 50,
    "db_aggregates": 8, "db_group_by": 4, "db_order_by": 4, "db_columns": 32, "db_value_chars": 512,
    "db_offset": 100000, "db_refresh_seconds": 20, "db_refresh_statement_ms": 10000, "db_refresh_lock_ms": 2000,
}

NOFOLLOW = getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
DIR_FLAGS = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | NOFOLLOW
FILE_FLAGS = os.O_RDONLY | NOFOLLOW | getattr(os, "O_NONBLOCK", 0)


class AccessError(Exception):
    """code is one of ddistro's error names; details never carry file content."""

    def __init__(self, code, message, details=None):
        super().__init__(message)
        self.code, self.message, self.details = code, message, details or {}


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def iso_mtime(epoch):
    return datetime.datetime.fromtimestamp(int(epoch), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def result(data, complete=True, reason=None, coverage=None):
    """Every read response: captured_at, complete, truncated, reason, coverage."""
    out = {"captured_at": now_iso(), "complete": complete, "truncated": not complete, "reason": reason,
           "coverage": coverage or {}}
    out.update(data)
    return out


# --- Redaction (shared with later snapshot code) -------------------------------------

CONTROL = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|[\x00-\x08\x0b-\x1f\x7f]")
URL_USERINFO = re.compile(r"(?i)\b([a-z][a-z0-9+.-]{1,15}://)[^\s/@\"'<>]+@")
SECRET_WORDS = (r"authorization|api[_-]?key|apikey|pairing[_-]?key|(?:access|refresh|auth|id|bearer|session)[_-]?token"
                r"|(?:access|secret|session|signing|encryption|client)[_-]?key|token|password|passwd|passphrase|pwd"
                r"|secret|private[_-]?key|credentials?|dsn|connection[_-]?string|cookie")
# A key is one whole identifier ending in a secret word, so /etc/passwd, max_tokens and my_password_count are not.
SECRET_IDENT = r"(?:[A-Za-z0-9_.-]*[_.-])?(?:%s)(?:[_.-]?(?:value|hash|b64|base64))?(?![A-Za-z0-9_])" % SECRET_WORDS
URL_QUERY = re.compile(r"(?i)\bhttps?://[^\s\"'<>?#]+[?#][^\s\"'<>]*")
URL_PARAM = re.compile(r"(?i)([?&#;](?:%s|[A-Za-z0-9_.-]*(?:sig|signature|code|auth|jwt|x-amz-[a-z-]+)|key)=)"
                       r"[^&#;\s\"'<>]+" % SECRET_IDENT)
AUTH_SCHEME = re.compile(r"(?i)\b(bearer|basic|token)\s+[A-Za-z0-9._~+/=-]{8,}")
# One key and its value: a quoted string (JSON stays parseable) or an unquoted run up to the next quoted key/close.
KEY_VALUE = re.compile(r"(?im)((?<![A-Za-z0-9_/\\.-])%s([\"'\]\)]{0,3})\s*(?:=>|[:=])\s*)(?!\[redacted)"
                       r"(?:\"((?:[^\"\\\r\n]|\\.)+)\"|'((?:[^'\\\r\n]|\\.)+)'"
                       r"|([^\s\"',}\]][^\r\n]*?)(?=\s*(?:,\s*[\"']|(?<!\[redacted)[}\]]\s*(?:[,}\]]|$)|$)))" % SECRET_IDENT)
# Clearly non-literal right-hand sides: a $variable (PHP $_POST[...] included) or an environment lookup.
CODE_VALUE = re.compile(r"^(?:\$[A-Za-z_]|(?:process\.env|os\.environ|getenv|env)\b)")
DSN_PASSWORD = re.compile(r"(?i)(?<![\w$./-])(password|pwd)=(?!\$|\[redacted\])[^\s;'\"]+")
TOKEN_SHAPES = re.compile(r"\b(?:hf_|sk-|sk_|gh[pousr]_|github_pat_|xox[abp]-|AKIA|AIza)[A-Za-z0-9_-]{16,}")
JWT = re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]*")
PEM = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(-----END [A-Z ]*PRIVATE KEY-----|\Z)", re.S)
SECRET_KEY = re.compile(r"(?i)(key|token|secret|passw|pwd|auth|cookie|credential|private|dsn|bearer|session_id)")
OPAQUE_VALUE = re.compile(r"^[A-Za-z0-9_\-+/=.]{32,}\Z")


def redact_text(text):
    """Returns (redacted text, number of substitutions). Control bytes become '?'."""
    count = 0
    text = CONTROL.sub("?", text)

    def url(match):
        nonlocal count
        clean, n = URL_PARAM.subn(r"\1[redacted]", match.group(0))
        count += n
        return clean

    def key_value(match):
        nonlocal count
        double, single, bare = match.group(3), match.group(4), match.group(5)
        if bare is not None and CODE_VALUE.match(bare):
            return match.group(0)
        count += 1
        if double is not None or (bare is not None and '"' in match.group(2)):
            return match.group(1) + '"[redacted]"'
        if single is not None:
            return match.group(1) + "'[redacted]'"
        return match.group(1) + "[redacted]"

    text, n = PEM.subn("[redacted private key]", text)
    count += n
    text, n = URL_USERINFO.subn(r"\1[redacted]@", text)
    count += n
    text = URL_QUERY.sub(url, text)
    text, n = AUTH_SCHEME.subn(r"\1 [redacted]", text)
    count += n
    text = KEY_VALUE.sub(key_value, text)
    for pattern, replacement in ((DSN_PASSWORD, r"\1=[redacted]"), (JWT, "[redacted]"), (TOKEN_SHAPES, "[redacted]")):
        text, n = pattern.subn(replacement, text)
        count += n
    return text, count


def clip(text, limit):
    return text if len(text) <= limit else text[:limit] + " [truncated]"


def clean_line(text, limit=None):
    text, n = redact_text(text)
    return clip(text, limit or LIMITS["line_chars"]), n


# --- Policy checks ------------------------------------------------------------------

def get_root(root_id):
    """The policy row for an id; ids come only from ACCESS_ROOTS."""
    if not isinstance(root_id, str) or root_id not in ACCESS_ROOTS:
        raise AccessError("invalid_argument", "Unknown root. Use ddistro access roots for the valid ids.",
                          {"roots": sorted(ACCESS_ROOTS)})
    spec = ACCESS_ROOTS[root_id]
    if spec.get("unsupported"):
        raise AccessError("unsupported", f"{root_id} has no readable root.",
                          {"root": root_id, "reason": spec["unsupported"]})
    return spec


def normalize_rel(raw):
    """A relative path inside a root as a list of parts; '' or '.' is the root itself."""
    if raw is None or raw in ("", "."):
        return []
    if not isinstance(raw, str) or len(raw) > MAX_PATH_CHARS or raw.startswith("/") or "\\" in raw \
            or CONTROL.search(raw):
        raise AccessError("invalid_argument", "--path must be a relative path inside the root.")
    parts = raw.strip("/").split("/")
    if any(part in ("", ".", "..") or not PATH_PART.match(part) for part in parts):
        raise AccessError("invalid_argument", "--path must be a plain relative path without . or .. parts.")
    return parts


def deny_reason(spec, parts, is_dir):
    """None when allowed, else secret|vcs|dependency|runtime|media. parts are relative to the root."""
    for index, part in enumerate(parts):
        lower = part.lower()
        last = index == len(parts) - 1
        if (not last or is_dir) and lower in DENY_DIRS:
            return DENY_DIRS[lower]
        if index == 0 and part in spec.get("deny_top", ()):
            return "dependency"
    if not parts:
        return None
    rel = "/".join(parts)
    deny_rel = spec.get("deny_rel")
    if deny_rel and (deny_rel.match(rel) or (is_dir and deny_rel.match(rel + "/"))):
        return "secret"
    if not is_dir:
        if SECRET_NAME.match(parts[-1]):
            return "secret"
        if MEDIA_EXT.match(parts[-1]):
            return "media"
    return None


def require_allowed(spec, parts, is_dir):
    reason = deny_reason(spec, parts, is_dir)
    if reason:
        code = "secret_path" if reason == "secret" else "excluded_" + reason
        raise AccessError("refused", "That path is not readable through the assistant (" + code + ").",
                          {"path": "/".join(parts), "reason": code})


# --- No-follow filesystem access ------------------------------------------------------

def os_reason(error, dir_fd=None, name=None):
    """Linux reports ENOTDIR, not ELOOP, for O_DIRECTORY|O_NOFOLLOW on a symlink; lstat tells them apart."""
    if error.errno == errno.ENOTDIR and dir_fd is not None:
        try:
            if stat.S_ISLNK(os.stat(name, dir_fd=dir_fd, follow_symlinks=False).st_mode):
                return "symlink"
        except OSError:
            pass
    return {errno.ENOENT: "absent", errno.ELOOP: "symlink", errno.ENOTDIR: "not_directory",
            errno.EACCES: "permission", errno.EPERM: "permission"}.get(error.errno, "unreadable")


def open_root(root_id):
    """Open a policy root from / without following links. Returns an fd; the caller closes it."""
    spec = get_root(root_id)
    path = spec["path"]
    fd = os.open("/", DIR_FLAGS)
    try:
        for part in path.strip("/").split("/"):
            try:
                child = os.open(part, DIR_FLAGS, dir_fd=fd)
            except OSError as error:
                reason = os_reason(error, fd, part)
                code = "not_found" if reason == "absent" else "unsafe_path" if reason == "symlink" else "failed"
                raise AccessError(code, f"{root_id} root is {reason.replace('_', ' ')}.",
                                  {"root": root_id, "path": path, "reason": reason})
            info = os.fstat(child)
            os.close(fd)
            fd = child
            if info.st_mode & 0o002 and not info.st_mode & stat.S_ISVTX:
                raise AccessError("unsafe_path", f"A folder in the {root_id} root path is world-writable.",
                                  {"root": root_id, "reason": "world_writable"})
        return fd
    except BaseException:
        os.close(fd)
        raise


def open_dir(root_fd, parts):
    fd = os.dup(root_fd)
    try:
        for part in parts:
            try:
                child = os.open(part, DIR_FLAGS, dir_fd=fd)
            except OSError as error:
                reason = os_reason(error, fd, part)
                code = {"absent": "not_found", "symlink": "unsafe_path", "not_directory": "invalid_argument"}
                raise AccessError(code.get(reason, "failed"), f"{'/'.join(parts)} cannot be opened ({reason}).",
                                  {"path": "/".join(parts), "reason": reason})
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_regular(root_fd, parts, limit):
    """Bytes of one regular, single-link file opened without following links; refuses oversize."""
    parent = open_dir(root_fd, parts[:-1])
    try:
        try:
            fd = os.open(parts[-1], FILE_FLAGS, dir_fd=parent)
        except OSError as error:
            reason = os_reason(error, parent, parts[-1])
            code = {"absent": "not_found", "symlink": "unsafe_path"}.get(reason, "failed")
            raise AccessError(code, f"{'/'.join(parts)} cannot be opened ({reason}).",
                              {"path": "/".join(parts), "reason": reason})
    finally:
        os.close(parent)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise AccessError("invalid_argument", "Only regular files can be read.", {"reason": "not_regular"})
        if info.st_nlink != 1:
            raise AccessError("unsafe_path", "Hard-linked files are not read.", {"reason": "hard_link"})
        if info.st_size > limit:
            raise AccessError("limit_reached", f"The file is larger than {limit} bytes.",
                              {"reason": "oversize", "size": info.st_size, "limit": limit})
        data = os.read(fd, limit + 1)
        if len(data) > limit:
            raise AccessError("limit_reached", "The file grew past the read limit.", {"reason": "oversize"})
        return data, info
    finally:
        os.close(fd)


def decode_text(data):
    """UTF-8 text or None for binary."""
    if b"\0" in data[:8192]:
        return None
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return None


def scan_dir(fd, limit):
    """Up to limit entries of an open directory: (name, kind, size, mtime); complete flag."""
    rows, complete = [], True
    with os.scandir(fd) as entries:
        for count, entry in enumerate(entries):
            if count >= limit:
                complete = False
                break
            try:
                info = entry.stat(follow_symlinks=False)
            except OSError:
                rows.append((entry.name, "unreadable", None, None))
                continue
            if stat.S_ISLNK(info.st_mode):
                kind = "link"
            elif stat.S_ISDIR(info.st_mode):
                kind = "dir"
            elif stat.S_ISREG(info.st_mode):
                kind = "file"
            else:
                kind = "other"
            rows.append((entry.name, kind, info.st_size if kind == "file" else None, info.st_mtime))
    rows.sort()
    return rows, complete


def walk(root_fd, spec, start_parts, max_depth, deadline, budget):
    """Breadth-first nofollow walk. Yields (parts, kind, size, mtime, deny); records cut reasons in budget."""
    queue = [(start_parts, 0)]
    while queue:
        parts, depth = queue.pop(0)
        if time.monotonic() > deadline:
            budget["reason"] = "time_limit"
            return
        try:
            fd = open_dir(root_fd, parts)
        except AccessError as error:
            budget["skipped"][error.details.get("reason", "unreadable")] = \
                budget["skipped"].get(error.details.get("reason", "unreadable"), 0) + 1
            continue
        try:
            rows, complete = scan_dir(fd, LIMITS["dir_scan"])
        finally:
            os.close(fd)
        budget["dirs"] += 1
        if not complete:
            budget["reason"] = budget["reason"] or "dir_scan_limit"
        for name, kind, size, mtime in rows:
            budget["entries"] += 1
            if budget["entries"] > LIMITS["walk_entries"]:
                budget["reason"] = "scan_limit"
                return
            if PATH_PART.match(name):
                child = parts + [name]
                deny = deny_reason(spec, child, kind == "dir")
            else:  # shown with control characters replaced, never opened
                child, deny = parts + [CONTROL.sub("?", name)], "unsupported_name"
            yield child, kind, size, mtime, deny
            if kind == "dir" and not deny and depth + 1 < max_depth:
                queue.append((child, depth + 1))


def new_budget():
    return {"dirs": 0, "entries": 0, "reason": None, "skipped": {}}


def bounded_int(value, name, low, high, default):
    if value is None:
        return default
    if isinstance(value, str):
        if not re.match(r"^[0-9]{1,7}\Z", value):
            raise AccessError("invalid_argument", f"{name} must be a whole number from {low} to {high}.")
        value = int(value)
    if isinstance(value, bool) or not isinstance(value, int) or not low <= value <= high:
        raise AccessError("invalid_argument", f"{name} must be a whole number from {low} to {high}.")
    return value


def roots(presence=None):
    """Policy rows; presence is an optional {catalog id: state} map used only as a label."""
    rows = []
    for root_id, spec in ACCESS_ROOTS.items():
        row = {"id": root_id, "kind": spec["kind"], "path": spec["path"], "read": not spec.get("unsupported"),
               "change": spec["change"], "db": root_id in DB_PRODUCTS, "config": "data_only" if spec["path"] else None,
               "unsupported": spec.get("unsupported")}
        if spec["path"]:
            try:
                info = os.lstat(spec["path"])
                row["present"] = "present" if stat.S_ISDIR(info.st_mode) else "unsafe"
            except FileNotFoundError:
                row["present"] = "absent"
            except OSError:
                row["present"] = "unknown"
        else:
            row["present"] = (presence or {}).get(root_id, "unknown")
        rows.append(row)
    return result({"roots": rows, "policy_version": POLICY_VERSION})


def list_files(root_id, path=None, depth=None, limit=None):
    spec = get_root(root_id)
    parts = normalize_rel(path)
    require_allowed(spec, parts, True)
    depth = bounded_int(depth, "--depth", 1, LIMITS["list_depth"], 1)
    limit = bounded_int(limit, "--limit", 1, LIMITS["list_entries"], 200)
    root_fd = open_root(root_id)
    budget, entries = new_budget(), []
    try:
        fd = open_dir(root_fd, parts)  # a clear error when the start folder itself is missing
        os.close(fd)
        for child, kind, size, mtime, deny in walk(root_fd, spec, parts, depth, time.monotonic() + LIMITS["walk_seconds"],
                                                   budget):
            if len(entries) >= limit:
                budget["reason"] = "entry_limit"
                break
            entries.append({"path": "/".join(child), "type": kind, "size": size,
                            "mtime": iso_mtime(mtime) if mtime is not None else None, "masked": deny})
    finally:
        os.close(root_fd)
    return result({"root": root_id, "path": "/".join(parts), "depth": depth, "entries": entries},
                  complete=budget["reason"] is None, reason=budget["reason"],
                  coverage={"dirs": budget["dirs"], "entries_seen": budget["entries"], "skipped": budget["skipped"],
                            "masked_not_descended": True, "links_followed": False})


def search_files(root_id, query=None, path=None, name_glob=None, limit=None):
    """Literal case-insensitive content search (matching redacted lines), or a name search with only a glob."""
    spec = get_root(root_id)
    parts = normalize_rel(path)
    require_allowed(spec, parts, True)
    if query is not None and (not isinstance(query, str) or not query.strip()
                              or len(query) > LIMITS["search_query_chars"] or CONTROL.search(query)):
        raise AccessError("invalid_argument", f"--query must be 1-{LIMITS['search_query_chars']} characters of plain text.")
    if name_glob is not None and (not isinstance(name_glob, str) or not GLOB.match(name_glob)):
        raise AccessError("invalid_argument", "--name-glob must be up to 64 characters of letters, digits, . _ - * ? [ ].")
    if query is None and name_glob is None:
        raise AccessError("invalid_argument", "files search needs --query, --name-glob, or both.")
    limit = bounded_int(limit, "--limit", 1, LIMITS["search_results"], 50)
    needle = query.lower() if query else None
    deadline = time.monotonic() + LIMITS["search_seconds"]
    budget, matches = new_budget(), []
    skipped = {"masked": 0, "binary": 0, "oversize": 0, "unreadable": 0, "link": 0, "hard_link": 0}
    scanned_files = scanned_bytes = 0
    root_fd = open_root(root_id)
    try:
        for child, kind, size, mtime, deny in walk(root_fd, spec, parts, 32, deadline, budget):
            if len(matches) >= limit:
                budget["reason"] = "result_limit"
                break
            if kind == "link":
                skipped["link"] += 1
                continue
            if kind != "file":
                continue
            if deny:
                skipped["masked"] += 1
                continue
            if name_glob and not fnmatch.fnmatch(child[-1].lower(), name_glob.lower()):
                continue
            if needle is None:
                matches.append({"path": "/".join(child), "size": size, "mtime": iso_mtime(mtime)})
                continue
            if size is None or size > LIMITS["search_file_bytes"]:
                skipped["oversize"] += 1
                continue
            if scanned_files >= LIMITS["search_files"] or scanned_bytes + size > LIMITS["search_total_bytes"]:
                budget["reason"] = "byte_limit"
                break
            try:
                data, _ = read_regular(root_fd, child, LIMITS["search_file_bytes"])
            except AccessError as error:
                skipped["hard_link" if error.details.get("reason") == "hard_link" else "unreadable"] += 1
                continue
            scanned_files += 1
            scanned_bytes += len(data)
            text = decode_text(data)
            if text is None:
                skipped["binary"] += 1
                continue
            hits = 0
            for number, line in enumerate(text.split("\n"), 1):
                clean, _ = redact_text(line.rstrip("\r"))
                if needle in clean.lower():
                    matches.append({"path": "/".join(child), "line": number,
                                    "text": clip(clean, LIMITS["match_chars"])})
                    hits += 1
                    if hits >= LIMITS["search_per_file"] or len(matches) >= limit:
                        break
    finally:
        os.close(root_fd)
    return result({"root": root_id, "path": "/".join(parts), "query": query, "name_glob": name_glob,
                   "mode": "content" if needle else "name", "match": "literal_case_insensitive_redacted",
                   "matches": matches},
                  complete=budget["reason"] is None, reason=budget["reason"],
                  coverage={"dirs": budget["dirs"], "entries_seen": budget["entries"], "files_scanned": scanned_files,
                            "bytes_scanned": scanned_bytes, "skipped": dict(skipped, **budget["skipped"]),
                            "per_file_match_limit": LIMITS["search_per_file"]})


def read_file(root_id, path, start=None, lines=None):
    spec = get_root(root_id)
    parts = normalize_rel(path)
    if not parts:
        raise AccessError("invalid_argument", "files read needs --path to a file.")
    require_allowed(spec, parts, False)
    start = bounded_int(start, "--start", 1, 10 ** 7, 1)
    count = bounded_int(lines, "--lines", 1, LIMITS["read_lines"], 200)
    root_fd = open_root(root_id)
    try:
        data, info = read_regular(root_fd, parts, LIMITS["read_file_bytes"])
    finally:
        os.close(root_fd)
    text = decode_text(data)
    if text is None:
        raise AccessError("refused", "The file is binary or not UTF-8 text.", {"path": "/".join(parts), "reason": "binary"})
    rows = text.split("\n")
    if rows and rows[-1] == "":
        rows.pop()
    window, redactions = [], 0
    for line in rows[start - 1:start - 1 + count]:
        clean, n = clean_line(line.rstrip("\r"))
        redactions += n
        window.append(clean)
    end = start + len(window) - 1
    complete = end >= len(rows)
    return result({"root": root_id, "path": "/".join(parts), "start": start, "end": end if window else None,
                   "total_lines": len(rows), "size": info.st_size, "mtime": iso_mtime(info.st_mtime),
                   "lines": window, "redactions": redactions},
                  complete=complete, reason=None if complete else "line_window",
                  coverage={"next_start": None if complete else end + 1})


# --- Config: parsed data only, never executed ----------------------------------------

CONFIG_DIRS = ([], ["conf"], ["config"])
CONFIG_FORMATS = {".json": "json", ".ini": "ini", ".cfg": "ini", ".conf": "ini", ".toml": "toml",
                  ".yaml": "unsupported", ".yml": "unsupported"}
PHP_TARGET = re.compile(r'^\$([A-Za-z_][A-Za-z0-9_]{0,63})((?:\[\s*(?:"[A-Za-z0-9_. -]{1,64}"|\'[A-Za-z0-9_. -]{1,64}\''
                        r'|[0-9]{1,6})\s*\])*)\s*=\s*(.*?)\s*;\s*\Z', re.S)
PHP_INDEX = re.compile(r'\[\s*(?:"([^"]*)"|\'([^\']*)\'|([0-9]+))\s*\]')
PHP_NUMBER = re.compile(r"^-?(?:[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\Z")


def php_literal(text):
    """(True, value) for a plain literal, else (False, reason). Never evaluates anything."""
    lower = text.lower()
    if lower in ("true", "false"):
        return True, lower == "true"
    if lower == "null":
        return True, None
    if PHP_NUMBER.match(text):
        return True, float(text) if any(c in text for c in ".eE") else int(text)
    if lower in ("[]", "array()"):
        return True, {}
    if len(text) >= 2 and text[0] == text[-1] == "'":
        body = text[1:-1]
        if re.search(r"(?<!\\)(?:\\\\)*'", body):
            return False, "expression"
        return True, body.replace("\\'", "'").replace("\\\\", "\\")
    if len(text) >= 2 and text[0] == text[-1] == '"':
        body = text[1:-1]
        if re.search(r'(?<!\\)(?:\\\\)*"', body):
            return False, "expression"
        if re.search(r"(?<!\\)\$", body):
            return False, "interpolation"
        return True, body.replace('\\"', '"').replace("\\$", "$").replace("\\\\", "\\")
    return False, "expression"


def php_statements(text):
    """Top-level statements split on ; outside strings and comments; (start line, text)."""
    out, buf, line, start, index, quote = [], [], 1, None, 0, None
    while index < len(text):
        char = text[index]
        if quote:
            buf.append(char)
            if char == "\\" and index + 1 < len(text):
                buf.append(text[index + 1])
                index += 1
            elif char == quote:
                quote = None
        elif char in "\"'":
            quote = char
            buf.append(char)
            start = start or line
        elif text.startswith("//", index) or char == "#":
            end = text.find("\n", index)
            index = len(text) if end < 0 else end
            continue
        elif text.startswith("/*", index):
            end = text.find("*/", index + 2)
            line += text[index:len(text) if end < 0 else end].count("\n")
            index = len(text) if end < 0 else end + 2
            continue
        elif text.startswith("<?php", index) or text.startswith("?>", index):
            index += 5 if text.startswith("<?php", index) else 2
            continue
        elif char == ";":
            buf.append(char)
            out.append((start or line, "".join(buf).strip()))
            buf, start = [], None
        else:
            if not char.isspace():
                start = start or line
            buf.append(char)
        if char == "\n":
            line += 1
        index += 1
    if "".join(buf).strip():
        out.append((start or line, "".join(buf).strip()))
    return out


def parse_php_assignments(text):
    """{dotted key: value} for literal assignments; unparsed lists the key or line only, never the value."""
    values, unparsed = {}, []
    for line, statement in php_statements(text):
        match = PHP_TARGET.match(statement)
        if not match:
            unparsed.append({"line": line, "key": None, "reason": "statement"})
            continue
        name, indexes, rhs = match.groups()
        keys = [name] + [a or b or c for a, b, c in PHP_INDEX.findall(indexes)]
        if name == "GLOBALS" and len(keys) > 1:
            keys = keys[1:]
        ok, value = php_literal(rhs)
        key = ".".join(keys)
        if ok:
            values[key] = value
        else:
            unparsed.append({"line": line, "key": key, "reason": value})
    return values, unparsed


def flatten(value, prefix, out, depth=0):
    if isinstance(value, dict) and value and depth < LIMITS["config_depth"]:
        for key, child in value.items():
            flatten(child, f"{prefix}.{key}" if prefix else str(key), out, depth + 1)
    elif isinstance(value, list) and value and depth < LIMITS["config_depth"]:
        for index, child in enumerate(value[:50]):
            flatten(child, f"{prefix}[{index}]", out, depth + 1)
    elif isinstance(value, (dict, list)):
        out[prefix] = "[nested]" if value else value
    else:
        out[prefix] = value


def public_value(key, value):
    """(value, redacted?) for one flattened config entry."""
    if SECRET_KEY.search(key):
        return ("<set>" if value not in (None, "", {}, []) else "<unset>"), True
    if isinstance(value, str):
        if OPAQUE_VALUE.match(value) or JWT.search(value):
            return "[redacted]", True
        clean, n = redact_text(value)
        return clip(clean, LIMITS["config_value_chars"]), n > 0
    return value, False


def parse_config(data, fmt):
    """(values, unparsed, error) from file bytes. Formats: json, ini, toml, php_assign."""
    text = decode_text(data)
    if text is None:
        return {}, [], "binary"
    values, unparsed = {}, []
    try:
        if fmt == "json":
            flatten(json.loads(text), "", values)
        elif fmt == "toml":
            if tomllib is None:
                return {}, [], "toml_unavailable"
            flatten(tomllib.loads(text), "", values)
        elif fmt == "ini":
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                parser.read_string(text)
            except configparser.MissingSectionHeaderError:
                parser.read_string("[_]\n" + text)
            for section in parser.sections():
                for key, value in parser.items(section, raw=True):
                    values[(key if section == "_" else f"{section}.{key}")] = value
        elif fmt == "php_assign":
            values, unparsed = parse_php_assignments(text)
        else:
            return {}, [], "unsupported_format"
    except (ValueError, configparser.Error, RecursionError):
        return {}, [], "parse_error"
    return values, unparsed, None


def config_candidates(root_fd, spec):
    """(rel parts, format, deny) for the root's fixed PHP config and data files in '', conf/, config/."""
    seen, out = set(), []
    for rel, fmt in spec.get("php_config", ()):
        out.append((rel.split("/"), fmt, None))
        seen.add(rel)
    for parts in CONFIG_DIRS:
        try:
            fd = open_dir(root_fd, parts)
        except AccessError:
            continue
        try:
            rows, _ = scan_dir(fd, LIMITS["dir_scan"])
        finally:
            os.close(fd)
        for name, kind, size, _ in rows:
            ext = os.path.splitext(name)[1].lower()
            rel = "/".join(parts + [name])
            if kind != "file" or ext not in CONFIG_FORMATS or rel in seen or not PATH_PART.match(name):
                continue
            seen.add(rel)
            out.append((parts + [name], CONFIG_FORMATS[ext], deny_reason(spec, parts + [name], False)))
    return out


def config_get(root_id, key=None):
    """Parsed public values with provenance. Values are file data, not the effective runtime setting."""
    spec = get_root(root_id)
    if key is not None and (not isinstance(key, str) or not re.match(r"^[A-Za-z0-9_.\[\] -]{1,128}\Z", key)):
        raise AccessError("invalid_argument", "--key must be up to 128 letters, digits, and . _ - [ ].")
    root_fd = open_root(root_id)
    files, reason, total = [], None, 0
    try:
        candidates = config_candidates(root_fd, spec)
        if len(candidates) > LIMITS["config_files"]:
            candidates, reason = candidates[:LIMITS["config_files"]], "file_limit"
        php_paths = {rel for rel, _ in spec.get("php_config", ())}
        for parts, fmt, deny in candidates:
            rel = "/".join(parts)
            entry = {"path": rel, "format": fmt, "parsed": False, "reason": None, "values": {}, "unparsed": [],
                     "redacted_keys": 0}
            files.append(entry)
            if deny and rel not in php_paths:
                entry["reason"] = "secret_path" if deny == "secret" else "excluded_" + deny
                continue
            if fmt == "unsupported":
                entry["reason"] = "unsupported_format"
                continue
            try:
                data, _ = read_regular(root_fd, parts, LIMITS["config_file_bytes"])
            except AccessError as error:
                entry["reason"] = error.details.get("reason", error.code)
                continue
            values, unparsed, error = parse_config(data, fmt)
            if error:
                entry["reason"] = error
                continue
            entry["parsed"] = True
            for name, value in values.items():
                if key and not (name == key or name.startswith(key + ".") or name.startswith(key + "[")):
                    continue
                if total >= LIMITS["config_keys"]:
                    reason = "key_limit"
                    break
                shown, redacted = public_value(name, value)
                entry["values"][name] = shown
                entry["redacted_keys"] += int(redacted)
                total += 1
            entry["unparsed"] = [row for row in unparsed if not key or (row["key"] or "").startswith(key)][:100]
    finally:
        os.close(root_fd)
    return result({"root": root_id, "key": key, "files": files, "execution": "none",
                   "effective_value": "uncertain",
                   "note": "Values are parsed from files without running them. Loaders, includes, profiles, and "
                           "database settings may override them; unparsed entries name the key only."},
                  complete=reason is None, reason=reason, coverage={"files": len(files), "keys": total})


# --- Database: dedicated reader role and a structured query builder ---------------

DB_PRODUCTS = {"herika": "dwemer", "lorkhan": "lorkhan", "stobe": "stobe", "dialectic": "dialectic", "reign": "reign"}
