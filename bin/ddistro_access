# Never listed into, searched, or read, at any depth (compared lower-case).
DENY_DIRS = {
    ".git": "vcs", ".svn": "vcs", ".hg": "vcs",
    "venv": "dependency", ".venv": "dependency", "node_modules": "dependency", "site-packages": "dependency",
    "dist-packages": "dependency", "__pycache__": "dependency", "vendor": "dependency", ".tox": "dependency",
    ".nox": "dependency", ".eggs": "dependency", ".mypy_cache": "runtime", ".pytest_cache": "runtime",
