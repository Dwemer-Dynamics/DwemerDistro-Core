    ".claude": "secret",
    "log": "runtime", "logs": "runtime", "cache": "runtime", "caches": "runtime", ".cache": "runtime",
    "soundcache": "runtime", "uploads": "runtime", "voices": "runtime", "tmp": "runtime", "temp": "runtime",
    "models": "runtime", "checkpoints": "runtime", "weights": "runtime", "backups": "runtime", "backup": "runtime",
