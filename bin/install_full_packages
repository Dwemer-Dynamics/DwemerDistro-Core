#!/bin/bash

set -euo pipefail

# Preserve the legacy command used by older launchers without reinstalling the
# historical full-distro package snapshot.
if [ ! -x /usr/local/bin/install_cuda_dependencies ]; then
    echo "The minimal CUDA installer is missing. Update DwemerDistro and retry."
    exit 23
fi

/usr/local/bin/install_cuda_dependencies 12.8

echo "Done. You can now install components that require an NVIDIA GPU."
