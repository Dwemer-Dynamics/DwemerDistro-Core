#!/bin/bash

set -euo pipefail

BASE_DIR="/home/dwemer"
REPO_DIR="$BASE_DIR/audio.cpp"
REPO_URL="https://github.com/Dwemer-Dynamics/audio.cpp"
CUDA_VERSION="${1:-12.8}"
BUILD_PARALLEL="${BUILD_PARALLEL:-2}"
CUDA_INSTALLER="/usr/local/bin/install_cuda_dependencies"

run_as_dwemer() {
    if [ "$(id -un)" = "dwemer" ]; then
        bash -lc "$1"
    else
        sudo -u dwemer bash -lc "$1"
    fi
}

resolve_cuda_home() {
    if [ -d "/usr/local/cuda-$CUDA_VERSION" ]; then
        echo "/usr/local/cuda-$CUDA_VERSION"
        return
    fi
    if [ "$CUDA_VERSION" = "13" ] && [ -d "/usr/local/cuda-13.0" ]; then
        echo "/usr/local/cuda-13.0"
        return
    fi
    if [ "$CUDA_VERSION" = "12.8" ] && [ -d "/usr/local/cuda-12.8" ]; then
        echo "/usr/local/cuda-12.8"
        return
    fi
    echo "/usr/local/cuda"
}

write_runtime_files() {
    local model_path="$1"

    cat > "$REPO_DIR/server.json" <<'JSON'
{
  "host": "127.0.0.1",
  "port": 8086,
  "backend": "cuda",
  "device": 0,
  "threads": 1,
  "models": [
    {
      "id": "pocket-tts",
      "family": "pocket_tts",
      "path": "__MODEL_PATH__",
      "task": "tts",
      "mode": "offline",
      "load_options": {
        "language": "english"
      },
      "session_options": {
        "language": "english",
        "pocket_tts.voice_state_cache_slots": 16
      },
      "default_voice_preset": {
        "voice_id": "alba"
      }
    }
  ]
}
JSON
    sed -i "s|__MODEL_PATH__|$model_path|" "$REPO_DIR/server.json"

    cat > "$REPO_DIR/start-audiocpp-pockettts.sh" <<'BASH'
#!/bin/bash
set -euo pipefail

cd /home/dwemer/audio.cpp

if [ -f "/home/dwemer/.cuda_config" ]; then
    source /home/dwemer/.cuda_config
fi

if [ -d "/usr/local/cuda-12.8" ]; then
    export CUDA_HOME="/usr/local/cuda-12.8"
elif [ -d "/usr/local/cuda-13.0" ]; then
    export CUDA_HOME="/usr/local/cuda-13.0"
elif [ -d "/usr/local/cuda" ]; then
    export CUDA_HOME="/usr/local/cuda"
fi

if [ -n "${CUDA_HOME:-}" ]; then
    export PATH="$CUDA_HOME/bin:$PATH"
fi

export LD_LIBRARY_PATH="/usr/lib/wsl/lib:${CUDA_HOME:-/usr/local/cuda}/lib64:${CUDA_HOME:-/usr/local/cuda}/targets/x86_64-linux/lib:${LD_LIBRARY_PATH:-}"

mkdir -p speakers
runtime/bin/audiocpp_server --config server.json >> server.log 2>&1 &
BASH

    cat > "$REPO_DIR/conf.sh" <<'BASH'
#!/bin/bash

REPO_DIR="/home/dwemer/audio.cpp"

clear
cat << EOF
PocketTTS audio.cpp

This configures the C++ PocketTTS runtime. Python is only used by the installer
to download the model; the running TTS server is runtime/bin/audiocpp_server.

EOF

if [ ! -x "$REPO_DIR/runtime/bin/audiocpp_server" ]; then
    echo "Error: audio.cpp is not built. Run /usr/local/bin/install_audiocpp_pockettts first."
    exit 1
fi

while true; do
    echo "Select an option from the list:"
    echo
    echo "1. Enable service"
    echo "0. Disable service"
    echo

    read -r -p "Select an option by picking the matching number: " selection

    case "$selection" in
        0)
            rm "$REPO_DIR/start.sh" &>/dev/null || true
            echo "[OK] PocketTTS audio.cpp disabled"
            exit 0
            ;;
        1)
            ln -sf "$REPO_DIR/start-audiocpp-pockettts.sh" "$REPO_DIR/start.sh"
            echo "[OK] PocketTTS audio.cpp enabled"
            exit 0
            ;;
        *)
            echo "Invalid selection. Enter 0 or 1."
            echo
            ;;
    esac
done
BASH

    chmod +x "$REPO_DIR/start-audiocpp-pockettts.sh" "$REPO_DIR/conf.sh"
    chown -R dwemer:dwemer "$REPO_DIR"
}

ensure_hf_token() {
    if [ -n "${HF_TOKEN:-}" ] || [ -n "${HUGGING_FACE_HUB_TOKEN:-}" ] || [ -f "$BASE_DIR/.cache/huggingface/token" ]; then
        return
    fi

    echo "PocketTTS model download requires a Hugging Face token with access to the gated model."
    read -r -s -p "HF token: " HF_TOKEN
    echo
    export HF_TOKEN

    sudo -u dwemer mkdir -p "$BASE_DIR/.cache/huggingface"
    sudo chmod 700 "$BASE_DIR/.cache/huggingface"
    printf '%s' "$HF_TOKEN" | sudo -u dwemer tee "$BASE_DIR/.cache/huggingface/token" >/dev/null
    sudo chmod 600 "$BASE_DIR/.cache/huggingface/token"
}

echo "Installing audio.cpp PocketTTS with CUDA $CUDA_VERSION"
sudo apt update
sudo apt-get -y install --no-install-recommends git cmake build-essential ninja-build python3-venv python3-pip

if [ ! -x "$CUDA_INSTALLER" ]; then
    echo "The minimal CUDA installer is missing at $CUDA_INSTALLER. Update DwemerDistro and retry."
    exit 23
fi
sudo "$CUDA_INSTALLER" "$CUDA_VERSION"

if [ ! -d "$REPO_DIR/.git" ]; then
    run_as_dwemer "cd '$BASE_DIR' && git clone --depth 1 '$REPO_URL'"
else
    run_as_dwemer "cd '$REPO_DIR' && git remote set-url origin '$REPO_URL' && git pull --ff-only"
fi

CUDA_HOME="$(resolve_cuda_home)"
if [ ! -x "$CUDA_HOME/bin/nvcc" ]; then
    echo "CUDA compiler not found at $CUDA_HOME/bin/nvcc."
    exit 1
fi

echo "Using CUDA compiler: $CUDA_HOME/bin/nvcc"
"$CUDA_HOME/bin/nvcc" --version | tail -n 1

BUILD_DIR="$(run_as_dwemer "mktemp -d '$BASE_DIR/.audio.cpp-build.XXXXXX'")"
MODEL_VENV=""
cleanup() {
    rm -rf "$BUILD_DIR"
    if [ -n "$MODEL_VENV" ]; then
        rm -rf "$MODEL_VENV"
    fi
}
trap cleanup EXIT

run_as_dwemer "cd '$REPO_DIR' && export CUDA_HOME='$CUDA_HOME' && export CUDACXX='$CUDA_HOME/bin/nvcc' && export PATH=\"\$CUDA_HOME/bin:\$PATH\" && cmake -S . -B '$BUILD_DIR' -DENGINE_ENABLE_CUDA=ON -DCMAKE_CUDA_COMPILER=\"\$CUDACXX\" -DCUDAToolkit_ROOT=\"\$CUDA_HOME\" && cmake --build '$BUILD_DIR' --parallel '$BUILD_PARALLEL' --target audiocpp_cli --target audiocpp_server"

RUNTIME_STAGE="$REPO_DIR/.runtime-new.$$"
rm -rf "$RUNTIME_STAGE"
install -d -o dwemer -g dwemer -m 0755 "$RUNTIME_STAGE/bin"
install -o dwemer -g dwemer -m 0755 "$BUILD_DIR/bin/audiocpp_cli" "$RUNTIME_STAGE/bin/audiocpp_cli"
install -o dwemer -g dwemer -m 0755 "$BUILD_DIR/bin/audiocpp_server" "$RUNTIME_STAGE/bin/audiocpp_server"

if LD_LIBRARY_PATH="/usr/lib/wsl/lib:$CUDA_HOME/lib64:$CUDA_HOME/targets/x86_64-linux/lib" \
    ldd "$RUNTIME_STAGE/bin/audiocpp_server" | grep -q 'not found'; then
    echo "The staged audio.cpp server has unresolved runtime libraries."
    rm -rf "$RUNTIME_STAGE"
    exit 1
fi

RUNTIME_PREVIOUS="$REPO_DIR/.runtime-previous.$$"
rm -rf "$RUNTIME_PREVIOUS"
if [ -d "$REPO_DIR/runtime" ]; then
    mv "$REPO_DIR/runtime" "$RUNTIME_PREVIOUS"
fi
if ! mv "$RUNTIME_STAGE" "$REPO_DIR/runtime"; then
    if [ -d "$RUNTIME_PREVIOUS" ]; then
        mv "$RUNTIME_PREVIOUS" "$REPO_DIR/runtime"
    fi
    exit 1
fi
rm -rf "$RUNTIME_PREVIOUS"

BUILD_COMPAT="$REPO_DIR/.build-compat.$$"
rm -rf "$BUILD_COMPAT"
install -d -o dwemer -g dwemer -m 0755 "$BUILD_COMPAT/bin"
ln -s ../../runtime/bin/audiocpp_cli "$BUILD_COMPAT/bin/audiocpp_cli"
ln -s ../../runtime/bin/audiocpp_server "$BUILD_COMPAT/bin/audiocpp_server"
chown -h dwemer:dwemer "$BUILD_COMPAT/bin/audiocpp_cli" "$BUILD_COMPAT/bin/audiocpp_server"

BUILD_PREVIOUS="$REPO_DIR/.build-previous.$$"
rm -rf "$BUILD_PREVIOUS"
if [ -d "$REPO_DIR/build" ]; then
    mv "$REPO_DIR/build" "$BUILD_PREVIOUS"
fi
if ! mv "$BUILD_COMPAT" "$REPO_DIR/build"; then
    if [ -d "$BUILD_PREVIOUS" ]; then
        mv "$BUILD_PREVIOUS" "$REPO_DIR/build"
    fi
    exit 1
fi
rm -rf "$BUILD_PREVIOUS"
rm -rf "$BUILD_DIR"

ensure_hf_token
MODEL_VENV="$(run_as_dwemer "mktemp -d '$BASE_DIR/.audiocpp-model-venv.XXXXXX'")"
run_as_dwemer "cd '$REPO_DIR' && python3 -m venv '$MODEL_VENV' && source '$MODEL_VENV/bin/activate' && pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir pyyaml safetensors numpy && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && python3 tools/model_manager.py install pocket_tts --overwrite"
rm -rf "$MODEL_VENV" "$REPO_DIR/model-venv"
MODEL_VENV=""

if [ -d "$REPO_DIR/models/PocketTTS-GGUF/english" ]; then
    MODEL_PATH="$REPO_DIR/models/PocketTTS-GGUF/english"
elif [ -d "$REPO_DIR/models/pocket-tts" ]; then
    MODEL_PATH="$REPO_DIR/models/pocket-tts"
else
    echo "Pocket-TTS model download completed without creating a supported model directory."
    exit 1
fi

write_runtime_files "$MODEL_PATH"

echo
echo "[OK] audio.cpp PocketTTS is installed."
echo "Run /home/dwemer/audio.cpp/conf.sh and enable the service, then restart DwemerDistro."
