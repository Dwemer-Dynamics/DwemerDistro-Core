# Port migration is intentionally not part of a normal repository update.
# The launcher invokes the provider-specific migration only after the selected
# service is healthy on its dedicated port. Existing ports are kept without a message.
# The DwemerDistro MCP update is intentionally skipped for now.

# System permission updates
print_header "RUNNING SYSTEM PERMISSION UPDATES"

if run_privileged_status /usr/local/bin/update_perms; then
    printf "${GREEN}[SUCCESS] System permissions updated${NC}\n"
else
    mark_component_failed "system permissions"
    print_warning "System permission update failed (update_perms)."
fi

# Install netcat only when missing; apt is slow and should not run on every update.
if ! command -v nc >/dev/null 2>&1; then
    if ! { run_privileged_status apt-get update && run_privileged_status apt-get -y install netcat-openbsd; }; then
        mark_component_failed "netcat"
        print_warning "netcat installation failed."
    fi
fi

# Final message
finish_update
