#!/bin/bash

# Simplified color palette - only red and green for specific cases
GREEN='\033[0;32m'
RED='\033[1;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Store password for sudo commands
PASSWORD="dwemer"
# Never read a password from an invisible terminal during launcher updates.
# A bad credential must fail the update instead of hanging or reporting success.
run_privileged() {
    if [ "$EUID" -eq 0 ]; then
        "$@" || exit $?
    else
        printf '%s\n' "$PASSWORD" | sudo -S -p '' "$@" || exit $?
    fi
}

# Keep separate launchers and direct invocations from updating shared files together.
if [ "${DWEMER_COMPONENT_UPDATE_LOCKED:-0}" != 1 ]; then
    flock -n -E 75 --close /home/dwemer/.dwemerdistro-components-update.lock \
        env DWEMER_COMPONENT_UPDATE_LOCKED=1 bash "$0" "$@"
    result=$?
    if [ "$result" -eq 75 ]; then
        printf 'Another shared components update is already running.\n' >&2
    fi
    exit "$result"
fi

MAINTENANCE_LOCK="/run/lock/dwemerdistro-maintenance.lock"

# Hold the common maintenance lock shared on fd 7. ddistro changes apply/rollback take it
# exclusively, so they never interleave with maintenance; shared holders (including nested
# helpers) still serialize through their own locks. Root creates the fixed root-owned file
# once; it is never replaced. Release with flock -u, which also covers services that
# inherited fd 7.
acquire_maintenance_lock() {
    local info=""
    if [ "$(id -u)" -eq 0 ] && [ ! -e "$MAINTENANCE_LOCK" ] && [ ! -L "$MAINTENANCE_LOCK" ]; then
        (umask 022; set -C; : > "$MAINTENANCE_LOCK") 2>/dev/null || true
    fi
    if [ -f "$MAINTENANCE_LOCK" ] && [ ! -L "$MAINTENANCE_LOCK" ] && exec 7<"$MAINTENANCE_LOCK"; then
        info="$(stat -L -c '%u %h %a' /proc/self/fd/7 2>/dev/null)"
    fi
    case "$info" in
        "0 1 644") ;;
        "0 1 "*) [ "$(id -u)" -eq 0 ] && chmod 0644 /proc/self/fd/7 || info="" ;;
        *) info="" ;;
    esac
    if [ -z "$info" ]; then
        exec 7<&-
        printf '%s is missing or unsafe. Start DwemerDistro or run the core update as root once, then retry.\n' "$MAINTENANCE_LOCK" >&2; exit 1
    fi
    if ! flock -s -w 30 7; then
        exec 7<&-
        printf 'Another DwemerDistro maintenance or ddistro changes operation is running.\n' >&2; exit 75
    fi
}

acquire_maintenance_lock
trap 'flock -u 7 2>/dev/null || true' EXIT

UPDATE_HERIKA=1
UPDATE_STOBE=1
UPDATE_DIALECTIC=1
UPDATE_REIGN=1
UPDATE_LORKHAN=1
DIALECTIC_UPDATE_FAILED=0
COMPONENT_UPDATE_FAILED=0
FAILED_COMPONENTS=""
CURRENT_SECTION="shared components"
# DDISTRO_PRESERVE_LOCAL_CHANGES=1 selects the update the Launcher runs before OS maintenance:
# nothing installed may be lost (see preserve_fast_forward). Any other value keeps the normal update.
PRESERVE_LOCAL_CHANGES=0
if [ "${DDISTRO_PRESERVE_LOCAL_CHANGES:-0}" = 1 ]; then
    PRESERVE_LOCAL_CHANGES=1
fi
PRESERVED_COMPONENTS=""

# Like run_privileged, but returns the command status instead of exiting, so the caller can report it.
run_privileged_status() {
    if [ "$EUID" -eq 0 ]; then
        "$@"
    else
        printf '%s\n' "$PASSWORD" | sudo -S -p '' "$@"
    fi
}

# Record a failed component by name (default: the current section) for the final summary.
mark_component_failed() {
    local name="${1:-$CURRENT_SECTION}"
    COMPONENT_UPDATE_FAILED=1
    case ", $FAILED_COMPONENTS, " in
        *", $name, "*) ;;
        *) FAILED_COMPONENTS="${FAILED_COMPONENTS:+$FAILED_COMPONENTS, }$name" ;;
    esac
}

# Record a component left exactly as installed to keep local changes. This is not a failure.
mark_component_preserved() {
    local name="$1"
    local reason="$2"
    case ", $PRESERVED_COMPONENTS, " in
        *", $name, "*) ;;
        *) PRESERVED_COMPONENTS="${PRESERVED_COMPONENTS:+$PRESERVED_COMPONENTS, }$name" ;;
    esac
    print_warning "$name was left as installed: $reason"
}

# Helper function for section headers
print_header() {
    local title="$1"
    local branch=""
    
    # Check if second parameter (branch) is provided
    if [ ! -z "$2" ]; then
        branch=" ($2)"
    fi
    
    CURRENT_SECTION="${title#UPDATING }"
    CURRENT_SECTION="${CURRENT_SECTION#INSTALLING }"
    CURRENT_SECTION="${CURRENT_SECTION#SETTING UP }"
    printf "${BOLD}== %s%s ==${NC}\n" "$title" "$branch"
}

# Helper function for completion messages
print_success() {
    printf "${GREEN}[SUCCESS] %s${NC}\n" "$1"
}

print_warning() {
    printf "${RED}[WARNING] %s${NC}\n" "$1"
}

# Move only known Dwemer-managed checkouts; leave custom forks untouched.
ensure_managed_remote() {
    local repo_path="$1"
    local target_remote="$2"
    shift 2
    local current_remote=""
    local normalized_current=""
    local allowed_remote=""
    local normalized_allowed=""

    if [ ! -d "$repo_path/.git" ]; then
        print_warning "Managed repository is missing: $repo_path"
        return 1
    fi

    current_remote=$(git -C "$repo_path" config --get remote.origin.url 2>/dev/null || true)
    normalized_current=$(printf '%s' "$current_remote" | sed -E \
        -e 's#^git@github.com:#https://github.com/#' \
        -e 's#^ssh://git@github.com/#https://github.com/#' \
        -e 's#^http://github.com/#https://github.com/#' \
        -e 's#\.git$##')

    for allowed_remote in "$target_remote" "$@"; do
        normalized_allowed=$(printf '%s' "$allowed_remote" | sed -E \
            -e 's#^git@github.com:#https://github.com/#' \
            -e 's#^ssh://git@github.com/#https://github.com/#' \
            -e 's#^http://github.com/#https://github.com/#' \
            -e 's#\.git$##')
        if [ "$normalized_current" = "$normalized_allowed" ]; then
            if [ "$current_remote" != "$target_remote" ]; then
                print_warning "Migrating $(basename "$repo_path") origin to $target_remote"
                git -C "$repo_path" remote set-url origin "$target_remote"
            fi
            return 0
        fi
    done

    print_warning "Refusing to replace unexpected origin for $repo_path: ${current_remote:-missing}"
    return 1
}

ensure_portable_pgvector() {
    local helper="/usr/local/bin/ensure_portable_pgvector"

    if [ ! -x "$helper" ]; then
        helper="/home/dwemer/dwemerdistro/bin/ensure_portable_pgvector"
    fi

    if [ ! -x "$helper" ]; then
        print_warning "Portable pgvector repair helper is unavailable."
        return 1
    fi

    if ! echo "$PASSWORD" | sudo -S -p '' "$helper"; then
        print_warning "Portable pgvector repair failed."
        return 1
    fi

    return 0
}

normalize_stobe_repo_path() {
    local canonical_path="/var/www/html/StobeServer"
    local legacy_path=""

    for legacy_path in /var/www/html/stobeserver /var/www/html/stoberser; do
        if [ -d "$legacy_path/.git" ] && [ ! -d "$canonical_path/.git" ]; then
            print_warning "Found legacy StobeServer path at $legacy_path. Migrating to $canonical_path."
            rm -rf "$canonical_path"
            if ! mv "$legacy_path" "$canonical_path"; then
                print_warning "Failed to migrate legacy StobeServer path from $legacy_path."
                return 1
            fi
            print_success "Migrated StobeServer repository to canonical path."
        fi
    done

    return 0
}

ensure_stobe_repo_exists() {
    local target_branch="${1:-stobe}"
    local repo_path="/var/www/html/StobeServer"

    mkdir -p /var/www/html >/dev/null 2>&1 || true

    if ! normalize_stobe_repo_path; then
        return 1
    fi

    if [ ! -d "$repo_path/.git" ]; then
        print_header "INSTALLING STOBE SERVER" "$target_branch"
        cd /var/www/html || {
            print_warning "Base path /var/www/html is missing and could not be accessed."
            return 1
        }

        rm -rf "$repo_path"
        printf ">> Cloning StobeServer repository...\n"
        if git clone -b "$target_branch" https://github.com/Dwemer-Dynamics/StobeServer.git StobeServer; then
            STOBE_INITIAL_INSTALL=1
        else
            print_warning "Failed to clone StobeServer repository."
            return 1
        fi
    fi

    if [ ! -d "$repo_path/.git" ]; then
        print_warning "StobeServer repository is not ready at $repo_path."
        return 1
    fi

    return 0
}

clear_stobe_initial_logs() {
    local log_dir="/var/www/html/StobeServer/log"
    local stobe_import_log="$log_dir/stobe_import.log"
    local stobeserver_log="$log_dir/stobeserver.log"

    mkdir -p "$log_dir" >/dev/null 2>&1 || true

    if ! : > "$stobe_import_log"; then
        print_warning "Failed to clear $stobe_import_log during initial install."
        return 1
    fi

    if ! : > "$stobeserver_log"; then
        print_warning "Failed to clear $stobeserver_log during initial install."
        return 1
    fi

    print_success "Cleared initial Stobe log files."
    return 0
}

ensure_stobe_database() {
    local server_root="/var/www/html/StobeServer"
    local schema_path="$server_root/data/schema.sql"
    local db_exists=""
    local schema_ready=""
    local bootstrap_output="/tmp/stobe_database_bootstrap.out"
    local bootstrap_log="$server_root/log/db_update_runner.log"

    print_header "ENSURING STOBE DATABASE"

    if [ ! -d "$server_root" ]; then
        print_warning "StobeServer directory not found; skipping database provisioning."
        return 1
    fi

    mkdir -p "$server_root/log" >/dev/null 2>&1 || true

    if ! ensure_portable_pgvector; then
        print_warning "Stobe database provisioning stopped before loading pgvector."
        return 1
    fi

    if ! pg_isready -d template1 -q; then
        printf ">> PostgreSQL is not running; starting it now...\n"
        echo "$PASSWORD" | sudo -S -p '' /etc/init.d/postgresql start >"$bootstrap_output" 2>&1 || true
        local postgres_ready=0
        local attempt
        for attempt in {1..15}; do
            if pg_isready -d template1 -q; then
                postgres_ready=1
                break
            fi
            sleep 1
        done
        if [ "$postgres_ready" -ne 1 ]; then
            cp "$bootstrap_output" "$bootstrap_log" 2>/dev/null || true
            print_warning "PostgreSQL did not start. See $bootstrap_log"
            return 1
        fi
    fi

    export PGPASSWORD=dwemer

    : > "$bootstrap_output"
    if ! db_exists=$(psql -h localhost -U dwemer -d dwemer -X -tAc "SELECT 1 FROM pg_database WHERE datname = 'stobe' LIMIT 1" 2>>"$bootstrap_output"); then
        printf '\nApplication database catalog probe failed; trying the PostgreSQL service account.\n' >> "$bootstrap_output"
        if ! db_exists=$(echo "$PASSWORD" | sudo -S -p '' -u postgres psql -d template1 -X -tAc "SELECT 1 FROM pg_database WHERE datname = 'stobe' LIMIT 1" 2>>"$bootstrap_output"); then
            cp "$bootstrap_output" "$bootstrap_log" 2>/dev/null || true
            print_warning "Failed to inspect the Stobe database. See $bootstrap_log"
            tail -n 8 "$bootstrap_output" | sed 's/^/  /'
            unset PGPASSWORD
            return 1
        fi
    fi
    db_exists=$(printf '%s' "$db_exists" | tr -d '[:space:]')
    if [ "$db_exists" != "1" ]; then
        printf ">> Creating stobe database...\n"
        if ! echo "$PASSWORD" | sudo -S -p '' -u postgres createdb --maintenance-db=template1 --owner=dwemer --encoding=UTF8 --locale=C --template=template0 stobe >"$bootstrap_output" 2>&1; then
            cp "$bootstrap_output" "$bootstrap_log" 2>/dev/null || true
            print_warning "Failed to create stobe database. See $bootstrap_log"
            tail -n 8 "$bootstrap_output" | sed 's/^/  /'
            unset PGPASSWORD
            return 1
        fi
        print_success "Database 'stobe' created."
    else
        print_success "Database 'stobe' already exists."
    fi

    if [ ! -f "$schema_path" ]; then
        print_warning "Stobe schema file missing: $schema_path"
        unset PGPASSWORD
        return 1
    fi

    : > "$bootstrap_output"
    if ! echo "$PASSWORD" | sudo -S -p '' -u postgres psql -d stobe -v ON_ERROR_STOP=1 -c "CREATE EXTENSION IF NOT EXISTS vector; ALTER DATABASE stobe OWNER TO dwemer;" >"$bootstrap_output" 2>&1; then
        cp "$bootstrap_output" "$bootstrap_log" 2>/dev/null || true
        print_warning "Failed to provision Stobe PostgreSQL extensions. See $bootstrap_log"
        tail -n 8 "$bootstrap_output" | sed 's/^/  /'
        unset PGPASSWORD
        return 1
    fi

    : > "$bootstrap_output"
    if ! schema_ready=$(psql -h localhost -U dwemer -d stobe -X -tAc "SELECT 1 FROM information_schema.tables WHERE table_schema='public' AND table_name='general_settings' LIMIT 1" 2>>"$bootstrap_output"); then
        cp "$bootstrap_output" "$bootstrap_log" 2>/dev/null || true
        print_warning "Failed to inspect the Stobe database schema. See $bootstrap_log"
        tail -n 8 "$bootstrap_output" | sed 's/^/  /'
        unset PGPASSWORD
        return 1
    fi
    schema_ready=$(printf '%s' "$schema_ready" | tr -d '[:space:]')
    if [ "$schema_ready" != "1" ]; then
        printf ">> Applying Stobe schema...\n"
        if ! psql -h localhost -U dwemer -d stobe -v ON_ERROR_STOP=1 -f "$schema_path" >"$bootstrap_output" 2>&1; then
            cp "$bootstrap_output" "$bootstrap_log" 2>/dev/null || true
            print_warning "Failed to apply Stobe schema. See $bootstrap_log"
            tail -n 8 "$bootstrap_output" | sed 's/^/  /'
            unset PGPASSWORD
            return 1
        fi
        print_success "Stobe schema applied."
    else
        print_success "Stobe schema already present."
    fi

    if [ -f /var/www/html/StobeServer/debug/run_db_updates.php ]; then
        printf ">> Running Stobe DB updates...\n"
        if ! php /var/www/html/StobeServer/debug/run_db_updates.php >"$bootstrap_output" 2>&1; then
            {
                printf "\n[%s] update_gws: run_db_updates.php failed\n" "$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
                cat "$bootstrap_output"
            } >> "$bootstrap_log"
            print_warning "StobeServer DB update trigger failed. See $bootstrap_log"
            rm -f "$bootstrap_output"
            unset PGPASSWORD
            return 1
        fi
        print_success "Stobe DB updates completed."
    else
        print_warning "Stobe DB update runner not found; skipping."
    fi

    rm -f "$bootstrap_output"
    unset PGPASSWORD
    return 0
}

restore_dialectic_runtime_state() {
    local backup_path="$1"
    local repo_path="/var/www/html/DialecticServer"
    local relative_path=""

    for relative_path in conf/conf.php conf/character_map.json; do
        if [ -e "$backup_path/$relative_path" ]; then
            mkdir -p "$repo_path/$(dirname "$relative_path")"
            cp -a "$backup_path/$relative_path" "$repo_path/$relative_path"
        fi
    done

    for relative_path in uploads data/voices soundcache log; do
        if [ -d "$backup_path/$relative_path" ]; then
            mkdir -p "$repo_path/$relative_path"
            cp -a "$backup_path/$relative_path/." "$repo_path/$relative_path/"
        fi
    done

    if [ -d "$backup_path/conf" ]; then
        find "$backup_path/conf" -maxdepth 1 -type f -name 'conf_*.php' -exec cp -a {} "$repo_path/conf/" \;
    fi
}

ensure_dialectic_runtime_permissions() {
    local helper="/usr/local/bin/ensure_dialectic_runtime_permissions"

    if [ ! -x "$helper" ]; then
        helper="/home/dwemer/dwemerdistro/bin/ensure_dialectic_runtime_permissions"
    fi

    if [ ! -x "$helper" ]; then
        print_warning "DialecticServer permission helper is unavailable."
        return 1
    fi

    if ! echo "$PASSWORD" | sudo -S -p '' "$helper" /var/www/html/DialecticServer; then
        print_warning "DialecticServer runtime permission repair failed."
        return 1
    fi

    return 0
}

ensure_dialectic_repo_exists() {
    local target_branch="${1:-dev}"
    local repo_path="/var/www/html/DialecticServer"
    local backup_path=""

    mkdir -p /var/www/html >/dev/null 2>&1 || true

    if [ -d "$repo_path" ] && [ ! -d "$repo_path/.git" ]; then
        backup_path="${repo_path}.pre-git-$(date -u '+%Y%m%d%H%M%S')"
        print_warning "Found a manually deployed DialecticServer. Moving it to $backup_path before installing the managed repository."
        if ! mv "$repo_path" "$backup_path"; then
            print_warning "Failed to back up the existing DialecticServer directory."
            return 1
        fi
    fi

    if [ ! -d "$repo_path/.git" ]; then
        print_header "INSTALLING DIALECTIC SERVER" "$target_branch"
        cd /var/www/html || return 1
        if ! git clone -b "$target_branch" https://github.com/Dwemer-Dynamics/DialecticServer.git DialecticServer; then
            print_warning "Failed to clone DialecticServer repository."
            rm -rf "$repo_path"
            if [ -n "$backup_path" ] && [ -d "$backup_path" ]; then
                mv "$backup_path" "$repo_path"
                print_warning "Restored the previous manually deployed DialecticServer."
            fi
            return 1
        fi
        DIALECTIC_INITIAL_INSTALL=1

        if [ -n "$backup_path" ] && [ -d "$backup_path" ]; then
            restore_dialectic_runtime_state "$backup_path"
            print_success "Restored DialecticServer configuration, voices, uploads, cache, and logs. Backup retained at $backup_path"
        fi
    fi

    [ -d "$repo_path/.git" ]
}

ensure_dialectic_database() {
    local server_root="/var/www/html/DialecticServer"
    local baseline="$server_root/data/database_default.sql"
    local utf8_migration="$server_root/tools/migrate-dialectic-db-utf8-wsl.sh"
    local db_exists=""
    local db_encoding=""
    local schema_ready=""
    local bootstrap_output="/tmp/dialectic_database_bootstrap.out"

    print_header "ENSURING DIALECTIC DATABASE"
    if [ ! -d "$server_root" ]; then
        print_warning "DialecticServer directory not found; skipping database provisioning."
        return 1
    fi

    if ! ensure_portable_pgvector; then
        print_warning "Dialectic database provisioning stopped before loading pgvector."
        return 1
    fi

    if ! pg_isready -d template1 -q; then
        printf ">> PostgreSQL is not running; starting it now...\n"
        echo "$PASSWORD" | sudo -S -p '' /etc/init.d/postgresql start >"$bootstrap_output" 2>&1 || true
        local postgres_ready=0
        local attempt
        for attempt in {1..15}; do
            if pg_isready -d template1 -q; then
                postgres_ready=1
                break
            fi
            sleep 1
        done
        if [ "$postgres_ready" -ne 1 ]; then
            mkdir -p "$server_root/log" >/dev/null 2>&1 || true
            cp "$bootstrap_output" "$server_root/log/db_update_runner.log" 2>/dev/null || true
            print_warning "PostgreSQL did not start. See $server_root/log/db_update_runner.log"
            return 1
        fi
    fi

    export PGPASSWORD=dwemer
    : > "$bootstrap_output"
    if ! db_exists=$(psql -h localhost -U dwemer -d dwemer -X -tAc "SELECT 1 FROM pg_database WHERE datname = 'dialectic' LIMIT 1" 2>>"$bootstrap_output"); then
        printf '\nApplication database catalog probe failed; trying the PostgreSQL service account.\n' >> "$bootstrap_output"
        if ! db_exists=$(echo "$PASSWORD" | sudo -S -p '' -u postgres psql -d template1 -X -tAc "SELECT 1 FROM pg_database WHERE datname = 'dialectic' LIMIT 1" 2>>"$bootstrap_output"); then
            mkdir -p "$server_root/log" >/dev/null 2>&1 || true
            cp "$bootstrap_output" "$server_root/log/db_update_runner.log" 2>/dev/null || true
            print_warning "Failed to inspect the Dialectic database. See $server_root/log/db_update_runner.log"
            tail -n 8 "$bootstrap_output" | sed 's/^/  /'
            unset PGPASSWORD
            return 1
        fi
    fi
    db_exists=$(printf '%s' "$db_exists" | tr -d '[:space:]')
    if [ "$db_exists" != "1" ]; then
        printf ">> Creating dialectic database...\n"
        if ! echo "$PASSWORD" | sudo -S -p '' -u postgres createdb --maintenance-db=template1 --owner=dwemer --encoding=UTF8 --locale=C --template=template0 dialectic >"$bootstrap_output" 2>&1; then
            mkdir -p "$server_root/log" >/dev/null 2>&1 || true
            cp "$bootstrap_output" "$server_root/log/db_update_runner.log" 2>/dev/null || true
            print_warning "Failed to create dialectic database. See $server_root/log/db_update_runner.log"
            unset PGPASSWORD
            return 1
        fi
    fi

    : > "$bootstrap_output"
    if ! db_encoding=$(psql -h localhost -U dwemer -d dwemer -X -tAc "SELECT pg_encoding_to_char(encoding) FROM pg_database WHERE datname = 'dialectic'" 2>>"$bootstrap_output"); then
        printf '\nApplication database encoding probe failed; trying the PostgreSQL service account.\n' >> "$bootstrap_output"
        if ! db_encoding=$(echo "$PASSWORD" | sudo -S -p '' -u postgres psql -d template1 -X -tAc "SELECT pg_encoding_to_char(encoding) FROM pg_database WHERE datname = 'dialectic'" 2>>"$bootstrap_output"); then
            mkdir -p "$server_root/log" >/dev/null 2>&1 || true
            cp "$bootstrap_output" "$server_root/log/db_update_runner.log" 2>/dev/null || true
            print_warning "Failed to inspect the Dialectic database encoding. See $server_root/log/db_update_runner.log"
            tail -n 8 "$bootstrap_output" | sed 's/^/  /'
            unset PGPASSWORD
            return 1
        fi
    fi
    db_encoding=$(printf '%s' "$db_encoding" | tr -d '[:space:]')
    if [ "$db_encoding" = "SQL_ASCII" ]; then
        if [ ! -f "$utf8_migration" ]; then
            print_warning "Dialectic database uses SQL_ASCII, but the UTF-8 migration tool is missing: $utf8_migration"
            unset PGPASSWORD
            return 1
        fi

        printf ">> Migrating the existing Dialectic database from SQL_ASCII to UTF8...\n"
        if ! echo "$PASSWORD" | sudo -S -p '' bash "$utf8_migration" >"$bootstrap_output" 2>&1; then
            mkdir -p "$server_root/log" >/dev/null 2>&1 || true
            cp "$bootstrap_output" "$server_root/log/db_utf8_migration.log" 2>/dev/null || true
            print_warning "Dialectic UTF-8 migration failed. The original database was retained. See $server_root/log/db_utf8_migration.log"
            unset PGPASSWORD
            return 1
        fi

        db_encoding=$(echo "$PASSWORD" | sudo -S -p '' -u postgres psql -d template1 -X -tAc "SELECT pg_encoding_to_char(encoding) FROM pg_database WHERE datname = 'dialectic'" 2>/dev/null | tr -d '[:space:]')
        if [ "$db_encoding" != "UTF8" ]; then
            print_warning "Dialectic database migration completed without producing UTF8 (reported encoding: ${db_encoding:-unknown})."
            unset PGPASSWORD
            return 1
        fi

        rm -f "$bootstrap_output"
        print_success "Dialectic database migrated to UTF8. A rollback database and safety dump were retained."
    elif [ "$db_encoding" != "UTF8" ]; then
        print_warning "Dialectic database uses unsupported encoding '${db_encoding:-unknown}'."
        unset PGPASSWORD
        return 1
    fi

    if ! echo "$PASSWORD" | sudo -S -p '' -u postgres psql -d dialectic -c "CREATE EXTENSION IF NOT EXISTS pg_trgm; CREATE EXTENSION IF NOT EXISTS vector; ALTER DATABASE dialectic OWNER TO dwemer;" >/dev/null 2>&1; then
        print_warning "Failed to provision Dialectic PostgreSQL extensions."
        unset PGPASSWORD
        return 1
    fi

    schema_ready=$(psql -h localhost -U dwemer -d dialectic -tAc "SELECT 1 FROM information_schema.tables WHERE table_schema='public' AND table_name='eventlog' LIMIT 1" 2>/dev/null | tr -d '[:space:]')
    if [ "$schema_ready" != "1" ]; then
        if [ ! -f "$baseline" ]; then
            print_warning "Dialectic database baseline is missing: $baseline"
            unset PGPASSWORD
            return 1
        fi
        printf ">> Importing Dialectic database baseline...\n"
        if ! psql -h localhost -U dwemer -d dialectic -f "$baseline" >"$bootstrap_output" 2>&1; then
            print_warning "Failed to import the Dialectic database baseline. See $bootstrap_output"
            unset PGPASSWORD
            return 1
        fi
    fi

    printf ">> Running Dialectic database migrations and seed verification...\n"
    if ! php "$server_root/tools/bootstrap-database.php" >"$bootstrap_output" 2>&1; then
        mkdir -p "$server_root/log" >/dev/null 2>&1 || true
        cp "$bootstrap_output" "$server_root/log/db_update_runner.log" 2>/dev/null || true
        print_warning "Dialectic database bootstrap failed. See $server_root/log/db_update_runner.log"
        unset PGPASSWORD
        return 1
    fi

    rm -f "$bootstrap_output"
    unset PGPASSWORD
    print_success "Dialectic database is ready."
    return 0
}

# Optional selective server updates.
while [ $# -gt 0 ]; do
    case "$1" in
        --skip-herika)
            UPDATE_HERIKA=0
            ;;
        --skip-stobe)
            UPDATE_STOBE=0
            ;;
        --skip-dialectic)
            UPDATE_DIALECTIC=0
            ;;
        --skip-lorkhan)
            UPDATE_LORKHAN=0
            ;;
        --skip-reign)
            UPDATE_REIGN=0
            ;;
        *)
            print_warning "Unknown option '$1' ignored"
            ;;
    esac
    shift
done

ensure_managed_remote \
    /home/dwemer/dwemerdistro \
    https://github.com/Dwemer-Dynamics/DwemerDistro-Core.git \
    https://github.com/abeiro/dwemerdistro.git || mark_component_failed "DwemerDistro-Core origin"

# Main title
printf "${BOLD}Shared components update${NC}\n"
if [ "$PRESERVE_LOCAL_CHANGES" -eq 1 ]; then
    printf "Keeping local changes: components are only fast-forwarded when nothing installed would be lost.\n"
fi

# Server updates are install-state aware. Missing products are never installed by
# the general updater; users install them explicitly from the launcher.
SERVER_MANAGER="/usr/local/bin/ddistro_server"
if [ ! -x "$SERVER_MANAGER" ]; then
    SERVER_MANAGER="/home/dwemer/dwemerdistro/bin/ddistro_server"
fi

update_installed_server() {
    local product="$1"
    local include="$2"
    local root="$3"
    local branch_choice="main"
    local current_branch=""
    local status_json=""

    # The launcher skips the servers it manages itself on every update; that is routine, not a warning.
    if [ "$include" -ne 1 ]; then
        return 0
    fi
    if [ ! -x "$SERVER_MANAGER" ]; then
        print_warning "Server manager is unavailable; skipping $product update."
        return 1
    fi

    if ! status_json=$("$SERVER_MANAGER" status "$product" --json); then
        print_warning "Could not inspect $product; update skipped."
        return 1
    fi
    # LORKHAN disable retains its source and database. Only explicit Repair re-enables it.
    if [ "$product" = lorkhan ] && printf '%s' "$status_json" | grep -q '"state":"needs-repair"'; then
        print_warning "LORKHAN is disabled or needs repair; use Repair in the launcher."
        return 0
    fi
    current_branch=$(git -c safe.directory="$root" -C "$root" branch --show-current 2>/dev/null || true)
    case "$current_branch" in
        dev|unstable) branch_choice="dev" ;;
    esac
    if { [ "$product" = reign ] || [ "$product" = lorkhan ]; } && [ "$current_branch" = unstable ]; then branch_choice="unstable"; fi
    if [ "$PRESERVE_LOCAL_CHANGES" -eq 1 ] && ! preserve_server_ready "$root" "$branch_choice" "$status_json"; then
        mark_component_preserved "$product" "$PRESERVE_DETAIL"
        return 0
    fi

    if printf '%s' "$status_json" | grep -q '"state":"needs-repair"' \
        && printf '%s' "$status_json" | grep -q '"repository_state":"legacy"'; then
        print_warning "$product uses a legacy deployment; adopting it with a retained backup before updating."
        if echo "$PASSWORD" | sudo -S -p '' "$SERVER_MANAGER" repair "$product" --branch "$branch_choice"; then
            print_success "$product legacy deployment adopted and updated successfully"
            return 0
        fi
        print_warning "$product legacy deployment could not be adopted."
        return 1
    fi
    # Older launchers clone selected servers before update_gws creates their databases.
    # Finish those installations without installing a product whose files are absent.
    if printf '%s' "$status_json" | grep -q '"state":"needs-repair"' \
        && printf '%s' "$status_json" | grep -q '"repository_state":"managed"'; then
        if echo "$PASSWORD" | sudo -S -p '' "$SERVER_MANAGER" repair "$product" --branch "$branch_choice"; then
            print_success "$product updated successfully"
            return 0
        fi
        print_warning "$product update failed."
        return 1
    fi
    if ! printf '%s' "$status_json" | grep -q '"state":"installed"'; then
        print_warning "$product is not installed; update skipped."
        return 0
    fi

    print_header "UPDATING ${product^^} SERVER" "$current_branch"
    # Legacy launchers run this script as dwemer without a visible sudo prompt.
    if echo "$PASSWORD" | sudo -S -p '' "$SERVER_MANAGER" update "$product" --branch "$branch_choice"; then
        print_success "$product updated successfully"
        return 0
    fi

    print_warning "$product update failed."
    return 1
}

# Preserve explicit legacy ports before service repositories gain dedicated
# port support. Fresh clones have no venv and therefore receive no marker;
# their installers will select the dedicated port.
preserve_legacy_tts_port() {
    local service_root="$1"
    local installed_path="$2"
    local port_file="$service_root/.dwemerdistro-port"

    # Preserve mode never writes through a link or over anything already at that path.
    if [ "$PRESERVE_LOCAL_CHANGES" -eq 1 ] && { [ -e "$port_file" ] || [ -L "$port_file" ]; }; then
        return 0
    fi
    if [ -e "$installed_path" ] && [ ! -f "$port_file" ]; then
        run_privileged bash -c 'printf "8020\n" > "$1"' _ "$port_file"
        run_privileged chown dwemer:dwemer "$port_file"
        run_privileged chmod 600 "$port_file"
        print_success "Preserved legacy port 8020 for $(basename "$service_root")."
    fi
}

# ---------------------------------------------------------------------------------------------
# Preserve-local-changes mode (DDISTRO_PRESERVE_LOCAL_CHANGES=1).
# A checkout is only moved forward on its own branch when Git proves nothing is lost: no tracked
# content edits or local commits, nothing on disk where the update adds a path, and no change to a
# file the component's installer handles. Mode-only differences (core.filemode=false), such as the
# chmod -R 755 of a normal update, are not edits. No reset, installer, pip run or recursive chown or
# chmod happens, so untracked and ignored settings, models and voices are never written. Anything
# that cannot be proven safe is left exactly as installed and reported; that is not a failure.

preserve_git() {
    git -c core.filemode=false -c safe.directory="$PRESERVE_REPO" -C "$PRESERVE_REPO" "$@"
}

# Check that moving PRESERVE_REPO from commit $1 to $2 loses nothing; further arguments are paths
# whose change needs the component installer. Fills PRESERVE_CHANGED (path -> "status old new mode").
# Returns 0 when safe, 2 when already current and 3 otherwise, with the reason in PRESERVE_DETAIL.
PRESERVE_DETAIL=""
declare -A PRESERVE_CHANGED=()
preserve_check() {
    local old="$1" new="$2" meta="" path="" om="" nm="" st="" prefix=""
    shift 2
    PRESERVE_CHANGED=()

    # Staged, unstaged and unmerged edits, and edits Git was told to hide, all count.
    if ! preserve_git diff --quiet HEAD -- || preserve_git ls-files -v | grep -q '^[[:lower:]S]'; then
        PRESERVE_DETAIL="it has local edits to tracked files"
        return 3
    fi
    [ "$old" != "$new" ] || return 2
    if ! preserve_git merge-base --is-ancestor "$old" "$new"; then
        PRESERVE_DETAIL="it has local commits that are not on origin"
        return 3
    fi
    while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
        read -r om nm _ _ st <<<"${meta#:}"
        PRESERVE_CHANGED[$path]="$st $om $nm"
        case " $* " in
            *" $path "*) PRESERVE_DETAIL="the update changes $path, which needs its installer"; return 3 ;;
        esac
        case "$om $nm" in
            *160000*) PRESERVE_DETAIL="it uses Git submodules"; return 3 ;;
        esac
        [ "$st" = A ] || continue
        # Git silently replaces ignored files, so anything already where a new path goes blocks it,
        # unless the update itself removes that tracked file (paths arrive sorted, parents first).
        prefix=$path
        while :; do
            if { [ -L "$PRESERVE_REPO/$prefix" ] || { [ -e "$PRESERVE_REPO/$prefix" ] \
                    && { [ "$prefix" = "$path" ] || [ ! -d "$PRESERVE_REPO/$prefix" ]; }; }; } \
                && [ "${PRESERVE_CHANGED[$prefix]%% *}" != D ]; then
                PRESERVE_DETAIL="the update adds $path, but a local $prefix is already there"
                return 3
            fi
            [ "$prefix" != "${prefix%/*}" ] || break
            prefix=${prefix%/*}
        done
    done < <(preserve_git diff --raw -z --no-renames --no-abbrev "$old" "$new" --)
    return 0
}

# Fast-forward one installed checkout: preserve_fast_forward REPO "INSTALLER PATHS" ORIGIN [LEGACY...].
# Returns 0 when updated, 2 when already current, 3 when left as installed and 1 on an error.
preserve_fast_forward() {
    local PRESERVE_REPO="$1" installer_paths="$2"
    local gitdir="" branch="" merge="" old="" new="" path="" parent="" st="" om="" nm="" mode="" owner="" result=0
    local -A saved=()
    shift 2

    if ! ensure_managed_remote "$PRESERVE_REPO" "$@"; then
        PRESERVE_DETAIL="it is not a Git checkout of a recognised Dwemer repository"
        return 3
    fi
    if ! branch=$(preserve_git symbolic-ref -q --short HEAD) \
        || [ "$(preserve_git config --get "branch.$branch.remote")" != origin ] \
        || ! merge=$(preserve_git config --get "branch.$branch.merge"); then
        PRESERVE_DETAIL="it is not on a branch that tracks origin"
        return 3
    fi
    # A fast-forward that cannot write Git's metadata could stop halfway.
    gitdir=$(preserve_git rev-parse --absolute-git-dir) || return 1
    if [ -n "$(find "$gitdir" -type d ! -writable -print -quit 2>/dev/null)" ] \
        || { [ -e "$gitdir/index" ] && [ ! -w "$gitdir/index" ]; }; then
        PRESERVE_DETAIL="its Git metadata is not writable by $(id -un)"
        return 3
    fi

    printf ">> Fetching %s...\n" "${merge#refs/heads/}"
    if ! preserve_git fetch --quiet origin "$merge" \
        || ! old=$(preserve_git rev-parse --verify -q 'HEAD^{commit}') \
        || ! new=$(preserve_git rev-parse --verify -q 'FETCH_HEAD^{commit}'); then
        PRESERVE_DETAIL="fetching origin failed"
        return 1
    fi
    # shellcheck disable=SC2086 # A space-separated list of plain repository paths.
    preserve_check "$old" "$new" $installer_paths
    result=$?
    [ "$result" -eq 0 ] || return "$result"

    for path in "${!PRESERVE_CHANGED[@]}"; do
        read -r st _ <<<"${PRESERVE_CHANGED[$path]}"
        # The nearest existing folder must accept the change, or Git could stop halfway.
        parent=$path
        while [ "$parent" != . ]; do
            case "$parent" in */*) parent=${parent%/*} ;; *) parent=. ;; esac
            [ ! -d "$PRESERVE_REPO/$parent" ] || break
        done
        if [ ! -w "$PRESERVE_REPO/$parent" ] || [ ! -x "$PRESERVE_REPO/$parent" ]; then
            PRESERVE_DETAIL="$parent is not writable by $(id -un)"
            return 3
        fi
        if [ "$st" != A ] && [ "$st" != D ] && [ -f "$PRESERVE_REPO/$path" ] && [ ! -L "$PRESERVE_REPO/$path" ]; then
            saved[$path]=$(stat -c '%a %u:%g' -- "$PRESERVE_REPO/$path") || return 1
        fi
    done

    printf ">> Fast-forwarding %s...\n" "$branch"
    if ! preserve_git merge --ff-only --quiet "$new"; then
        if [ "$(preserve_git rev-parse -q --verify HEAD)" = "$old" ]; then
            PRESERVE_DETAIL="Git refused the fast-forward to protect local files"
            return 3
        fi
        PRESERVE_DETAIL="the fast-forward stopped partway"
        return 1
    fi

    # Git rewrites an updated file with its default owner and mode. Put back the local ones (owner
    # first, as chown clears set-ID bits), plus an executable change the update itself makes.
    for path in "${!saved[@]}"; do
        [ -f "$PRESERVE_REPO/$path" ] && [ ! -L "$PRESERVE_REPO/$path" ] || continue
        read -r mode owner <<<"${saved[$path]}"
        read -r _ om nm <<<"${PRESERVE_CHANGED[$path]}"
        mode=$((8#$mode))
        case "$om>$nm" in
            "100644>100755") mode=$(( mode | ((mode & 0444) >> 2) )) ;;
            "100755>100644") mode=$(( mode & ~0111 )) ;;
        esac
        mode=$(printf '%o' "$mode")
        if [ "$(stat -c '%u:%g' -- "$PRESERVE_REPO/$path")" != "$owner" ]; then
            chown -- "$owner" "$PRESERVE_REPO/$path" 2>/dev/null \
                || run_privileged_status chown -- "$owner" "$PRESERVE_REPO/$path" || result=1
        fi
        chmod -- "$mode" "$PRESERVE_REPO/$path" 2>/dev/null \
            || run_privileged_status chmod -- "$mode" "$PRESERVE_REPO/$path" || result=1
    done
    if [ "$result" -ne 0 ]; then
        PRESERVE_DETAIL="it was updated, but some owners or modes could not be restored"
        return 1
    fi
    return 0
}

# Update one installed component: preserve_component LABEL REPO "INSTALLER PATHS" ORIGIN [LEGACY...].
preserve_component() {
    local label="$1" result=0
    shift

    if [ ! -e "$1" ] && [ ! -L "$1" ]; then
        printf "[SKIP] %s is not installed.\n" "$label"
        return 3
    fi
    print_header "UPDATING $label" "$(git -C "$1" branch --show-current 2>/dev/null)"
    preserve_fast_forward "$@"
    result=$?
    case "$result" in
        0) print_success "$label updated; local files and modes were kept" ;;
        2) print_success "$label is already current" ;;
        3) mark_component_preserved "$label" "$PRESERVE_DETAIL" ;;
        *)
            mark_component_failed "$label"
            print_warning "$label update failed${PRESERVE_DETAIL:+: $PRESERVE_DETAIL}."
            ;;
    esac
    return "$result"
}

# A server is only handed to ddistro_server update, which resets it to origin and re-applies its
# managed permissions, when that cannot lose local work: preserve_server_ready ROOT BRANCH STATUS_JSON.
preserve_server_ready() {
    local PRESERVE_REPO="$1" branch="$2" status_json="$3" current="" old="" new=""

    PRESERVE_DETAIL=""
    if printf '%s' "$status_json" | grep -q '"state":"needs-repair"'; then
        PRESERVE_DETAIL="it needs Repair from the launcher, which this update does not run"
        return 1
    fi
    printf '%s' "$status_json" | grep -q '"state":"installed"' || return 0
    [ "$branch" != main ] \
        || branch=$(printf '%s' "$status_json" | sed -n 's/.*"production_branch":"\([^"]*\)".*/\1/p')
    current=$(preserve_git symbolic-ref -q --short HEAD)
    if [ "$current" != "$branch" ]; then
        PRESERVE_DETAIL="it is on ${current:-a detached HEAD}, and the server update would switch it to $branch"
        return 1
    fi
    case "$(preserve_git remote get-url origin 2>/dev/null)" in
        https://github.com/Dwemer-Dynamics/*|git@github.com:Dwemer-Dynamics/*) ;;
        *) PRESERVE_DETAIL="its origin is not a Dwemer-Dynamics repository"; return 1 ;;
    esac
    # The same fetch ddistro_server update makes as root.
    if ! run_privileged_status git -c safe.directory="$PRESERVE_REPO" -C "$PRESERVE_REPO" fetch --quiet origin \
            "+refs/heads/$branch:refs/remotes/origin/$branch" \
        || ! old=$(preserve_git rev-parse --verify -q 'HEAD^{commit}') \
        || ! new=$(preserve_git rev-parse --verify -q "refs/remotes/origin/$branch^{commit}"); then
        PRESERVE_DETAIL="its origin could not be checked"
        return 1
    fi
    preserve_check "$old" "$new"
    [ "$?" -ne 3 ]
}

# A missing component is a new install, so it gets the normal initial owner and mode.
preserve_fresh_clone() {
    local label="$1" dir="$2" url="$3" owner="$4" mode="$5" branch="${6:-}"

    print_header "INSTALLING $label"
    if git clone ${branch:+-b "$branch"} "$url" "$dir" \
        && run_privileged_status chown -R "$owner" "$dir" \
        && run_privileged_status chmod -R "$mode" "$dir"; then
        print_success "$label installed"
        return 0
    fi
    mark_component_failed "$label"
    print_warning "$label install failed."
    return 1
}

run_preserved_updates() {
    local dashboard=/var/www/html/Dwemer-Dashboard

    if [ "$PHP_SECURITY_READY" -ne 1 ]; then
        print_warning "Dwemer Dashboard update skipped until the PHP security update succeeds."
    elif [ ! -e "$dashboard" ] && [ ! -L "$dashboard" ]; then
        preserve_fresh_clone "DWEMER DASHBOARD" "$dashboard" https://github.com/Dwemer-Dynamics/Dwemer-Dashboard.git dwemer:www-data 775
    else
        preserve_component "DWEMER DASHBOARD" "$dashboard" "" https://github.com/Dwemer-Dynamics/Dwemer-Dashboard.git
    fi

    # pip only runs in a normal update; an update that changes the requirements is left for it.
    preserve_component "MINI-ME & TXT2VEC" /home/dwemer/minime-t5 requirements.txt \
        https://github.com/Dwemer-Dynamics/minime-t5.git https://github.com/abeiro/minime-t5.git
    preserve_component "MELO-TTS" /home/dwemer/MeloTTS "" \
        https://github.com/Dwemer-Dynamics/MeloTTS.git https://github.com/abeiro/MeloTTS.git
    preserve_component "LOCALWHISPER" /home/dwemer/remote-faster-whisper "" \
        https://github.com/Dwemer-Dynamics/remote-faster-whisper.git https://github.com/abeiro/remote-faster-whisper.git

    if [ ! -e /home/dwemer/piper ] && [ ! -L /home/dwemer/piper ]; then
        preserve_fresh_clone "PIPER TTS" /home/dwemer/piper https://github.com/Dwemer-Dynamics/Piper-TTS-CHIM.git dwemer:dwemer 755 main
    else
        preserve_component "PIPER TTS" /home/dwemer/piper "" https://github.com/Dwemer-Dynamics/Piper-TTS-CHIM.git
    fi

    if [ -d /home/dwemer/xtts-api-server/.git ]; then
        preserve_component "CHIM XTTS" /home/dwemer/xtts-api-server "" \
            https://github.com/Dwemer-Dynamics/xtts-api-server.git https://github.com/abeiro/xtts-api-server.git
    else
        printf "[SKIP] CHIM XTTS repository not installed; skipping update.\n"
    fi

    if [ ! -e /home/dwemer/parakeet-api-server ] && [ ! -L /home/dwemer/parakeet-api-server ]; then
        preserve_fresh_clone "PARAKEET" /home/dwemer/parakeet-api-server https://github.com/Dwemer-Dynamics/parakeet-api-server dwemer:dwemer 755
    else
        preserve_component "PARAKEET" /home/dwemer/parakeet-api-server "" https://github.com/Dwemer-Dynamics/parakeet-api-server
    fi

    preserve_legacy_tts_port /home/dwemer/chatterbox /home/dwemer/chatterbox/venv
    preserve_legacy_tts_port /home/dwemer/pocket-tts /home/dwemer/pocket-tts/venv

    if [ ! -e /home/dwemer/chatterbox ] && [ ! -L /home/dwemer/chatterbox ]; then
        preserve_fresh_clone "CHATTERBOX" /home/dwemer/chatterbox https://github.com/Dwemer-Dynamics/chatterbox dwemer:dwemer 755
    else
        preserve_component "CHATTERBOX" /home/dwemer/chatterbox "" https://github.com/Dwemer-Dynamics/chatterbox
    fi

    if [ -d /home/dwemer/audio.cpp/.git ]; then
        preserve_component "audio.cpp" /home/dwemer/audio.cpp "" \
            https://github.com/Dwemer-Dynamics/audio.cpp.git https://github.com/abeiro/audio.cpp.git
    fi

    if [ ! -e /home/dwemer/pocket-tts ] && [ ! -L /home/dwemer/pocket-tts ]; then
        preserve_fresh_clone "pocket-tts" /home/dwemer/pocket-tts https://github.com/Dwemer-Dynamics/pocket-tts dwemer:dwemer 755
    else
        preserve_component "pocket-tts" /home/dwemer/pocket-tts "" https://github.com/Dwemer-Dynamics/pocket-tts
    fi

    # With its venv present, the normal update's installer run (dependencies and doctor skipped) only
    # repeats setup the install already did: folders, chmod -R of voices, models and config.json, and
    # the web link. Skipping it keeps those as they are. A missing venv, or an update that changes the
    # installer, is left for DwemerDistro Installed Components.
    if [ ! -d /home/dwemer/omnivoice-tts ]; then
        printf "[SKIP] OmniVoice TTS not installed; install it from DwemerDistro Installed Components.\n"
    elif [ ! -d /home/dwemer/omnivoice-tts/venv ]; then
        mark_component_preserved "OmniVoice TTS" "its setup is incomplete; finish it from DwemerDistro Installed Components"
    else
        preserve_component "OmniVoice TTS" /home/dwemer/omnivoice-tts ddistro_install.sh https://github.com/Dwemer-Dynamics/omnivoice-tts
    fi

    # update_perms chowns and chmods all of /var/www/html, which this mode must not do.
    print_warning "System permission updates (update_perms) skipped to keep installed owners and modes."

    if ! command -v nc >/dev/null 2>&1; then
        if ! { run_privileged_status apt-get update && run_privileged_status apt-get -y install netcat-openbsd; }; then
            mark_component_failed "netcat"
            print_warning "netcat installation failed."
        fi
    fi
}

finish_update() {
    if [ "$DIALECTIC_UPDATE_FAILED" -ne 0 ]; then
        mark_component_failed "DialecticServer"
    fi
    if [ -n "$PRESERVED_COMPONENTS" ]; then
        printf "${BOLD}Left as installed to keep local changes: %s${NC}\n" "$PRESERVED_COMPONENTS"
    fi
    if [ "$COMPONENT_UPDATE_FAILED" -ne 0 ]; then
        printf "${BOLD}${RED}[ERROR] Shared components update finished with errors: %s${NC}\n" "$FAILED_COMPONENTS"
        exit 1
    fi

    printf "${BOLD}${GREEN}Shared components updated.${NC}\n"
    exit 0
}

# Server and Dashboard updates deploy PHP code, so the shared PHP runtime must be fixed first.
# After update.sh this is a quick check without APT or network use.
PHP_SECURITY_READY=0
PHP_SECURITY_HELPER="/usr/local/bin/ensure_php_security"
if [ ! -x "$PHP_SECURITY_HELPER" ]; then
    PHP_SECURITY_HELPER="/home/dwemer/dwemerdistro/bin/ensure_php_security"
fi
print_header "VERIFYING PHP SECURITY UPDATE"
if [ -x "$PHP_SECURITY_HELPER" ] && echo "$PASSWORD" | sudo -S -p '' "$PHP_SECURITY_HELPER"; then
    PHP_SECURITY_READY=1
    print_success "PHP security update verified"
else
    mark_component_failed "PHP security update"
    print_warning "The PHP security update is incomplete; server and Dwemer Dashboard updates were skipped."
fi

if [ "$PHP_SECURITY_READY" -eq 1 ]; then
    update_installed_server herika "$UPDATE_HERIKA" /var/www/html/HerikaServer || mark_component_failed "HerikaServer"
    update_installed_server lorkhan "$UPDATE_LORKHAN" /opt/dwemerdistro/sources/LorkhanServer || mark_component_failed "LorkhanServer"
    update_installed_server stobe "$UPDATE_STOBE" /var/www/html/StobeServer || mark_component_failed "StobeServer"
    update_installed_server reign "$UPDATE_REIGN" /var/www/html/ReignServer || mark_component_failed "ReignServer"
    if ! update_installed_server dialectic "$UPDATE_DIALECTIC" /var/www/html/DialecticServer; then
        DIALECTIC_UPDATE_FAILED=1
    fi
fi

if [ "$PRESERVE_LOCAL_CHANGES" -eq 1 ]; then
    run_preserved_updates
    finish_update
fi

# Dwemer Dashboard update/install. Propagate failures without discarding local files.
if [ "$PHP_SECURITY_READY" -ne 1 ]; then
    print_warning "Dwemer Dashboard update skipped until the PHP security update succeeds."
elif (
    if [ ! -d /var/www/html/Dwemer-Dashboard/.git ]; then
        print_header "INSTALLING DWEMER DASHBOARD"
        printf ">> Cloning Dwemer Dashboard repository...\n"
        git clone https://github.com/Dwemer-Dynamics/Dwemer-Dashboard.git /var/www/html/Dwemer-Dashboard || exit 1
    else
        cd /var/www/html/Dwemer-Dashboard || exit 1
        BRANCH=$(git branch --show-current) || exit 1
        print_header "UPDATING DWEMER DASHBOARD" "$BRANCH"
        printf ">> Pulling latest changes...\n"
        # Runtime permissions differ from Git modes; content conflicts must still fail safely.
        # Capture stderr in the C locale so Git's diagnostic can be matched, then show it unchanged.
        { pull_errors=$(LC_ALL=C git -c core.filemode=false pull --ff-only 2>&1 >&3 3>&-); pull_status=$?; } 3>&1
        [ -z "$pull_errors" ] || printf '%s\n' "$pull_errors" >&2
        if [ "$pull_status" -ne 0 ]; then
            # Exit 3 only when Git refuses to overwrite local tracked or untracked files.
            case "$pull_errors" in
                *"would be overwritten by merge"*) exit 3 ;;
            esac
            exit 1
        fi
    fi

    echo "$PASSWORD" | sudo -S -p '' chown -R dwemer:www-data /var/www/html/Dwemer-Dashboard || exit 1
    echo "$PASSWORD" | sudo -S -p '' chmod -R 775 /var/www/html/Dwemer-Dashboard || exit 1
); then
    printf "${GREEN}[SUCCESS] Dwemer Dashboard updated successfully${NC}\n"
elif [ "$?" -eq 3 ]; then
    # The section header was printed in the subshell, so name the component explicitly.
    mark_component_failed "Dwemer Dashboard (local edits conflict)"
    print_warning "Dwemer Dashboard has local edits that conflict with this update; your local Dashboard edits were preserved. If this is a shared update, the database upgrade did not start. Move or undo the conflicting edits in /var/www/html/Dwemer-Dashboard (listed above), then run the update again from the launcher."
else
    mark_component_failed "Dwemer Dashboard"
    print_warning "Dwemer Dashboard update failed. Resolve the Git, network or permission error above and retry; local files were preserved."
fi

# MiniMe update
cd /home/dwemer/minime-t5
