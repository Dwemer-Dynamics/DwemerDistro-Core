#!/usr/bin/env python3
"""Local Assistant HTTP/SSE supervisor. Public clients cannot access the root Launcher relay."""
import argparse
import collections
import contextlib
import hashlib
import fcntl
import http.client
import http.server
import importlib.machinery
import importlib.util
import json
import os
import pwd
from pathlib import Path
import re
import secrets
import select
import signal
import socket
import socketserver
import sqlite3
import stat
import struct
import subprocess
import sys
import threading
import time
import uuid

ROOT = "/var/lib/dwemerdistro/assistant/api"
SOCKET = ROOT + "/control.sock"
HELPER = "/usr/local/bin/ddistro_agent"
SELF = "/usr/local/bin/ddistro_api"
LIFECYCLE = ROOT + "/lifecycle.lock"
API_VERSION = 1
PORT = 18423
MAX_BODY = 16 * 1024 * 1024  # Enclosing JSON may double escaping; the broker still enforces its own line limit.
MAX_EVENTS = 512
MAX_EVENT_BYTES = 8 * 1024 * 1024
MAX_SESSIONS = 4
MAX_QUEUE = 8
ID = re.compile(r"^[a-z0-9][a-z0-9_-]{0,47}$")
UUID = re.compile(r"^[0-9a-f-]{36}$")
TERMINAL = ("completed", "failed", "cancelled", "outcome_unknown")


class ApiError(Exception):
    def __init__(self, status, code):
        self.status, self.code = status, code


def load_agent():
    spec = importlib.util.spec_from_loader("ddistro_api_agent", importlib.machinery.SourceFileLoader("ddistro_api_agent", HELPER))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def prepare_root():
    if os.geteuid() != 0:
        raise ApiError(403, "root_required")
    # Check every ancestor; do not repair attacker-controlled state or follow symlinks.
    for path in ("/var", "/var/lib", "/var/lib/dwemerdistro", "/var/lib/dwemerdistro/assistant", ROOT):
        if path == ROOT and not os.path.lexists(path):
            os.mkdir(path, 0o700)
        info = os.lstat(path)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ApiError(503, "state_untrusted")
    if stat.S_IMODE(os.lstat(ROOT).st_mode) != 0o700:
        raise ApiError(503, "state_untrusted")


class Store:
    """Root-private durable ownership and idempotency records; transcripts stay in bounded event rings/runtime."""
    def __init__(self):
        self.lock = threading.RLock()
        path = ROOT + "/state.sqlite3"
        if os.path.lexists(path):
            info = os.lstat(path)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077 or info.st_nlink != 1:
                raise ApiError(503, "state_untrusted")
        self.db = sqlite3.connect(path, check_same_thread=False)
        os.chmod(path, 0o600)
        self.db.row_factory = sqlite3.Row
        self.db.executescript("""
          CREATE TABLE IF NOT EXISTS clients(id TEXT PRIMARY KEY, digest TEXT NOT NULL);
          CREATE TABLE IF NOT EXISTS conversations(id TEXT PRIMARY KEY, client TEXT NOT NULL, task TEXT NOT NULL,
            kind TEXT NOT NULL, thread TEXT, created REAL NOT NULL);
          CREATE TABLE IF NOT EXISTS requests(id TEXT PRIMARY KEY, conversation TEXT NOT NULL, client TEXT NOT NULL,
            idem TEXT NOT NULL, digest TEXT NOT NULL, state TEXT NOT NULL, answer TEXT NOT NULL DEFAULT '',
            UNIQUE(client,idem));
        """)
        self.db.commit()

    def rows(self, sql, args=()):
        with self.lock:
            return [dict(row) for row in self.db.execute(sql, args).fetchall()]

    def write(self, sql, args=()):
        with self.lock:
            result = self.db.execute(sql, args)
            self.db.commit()
            return result.rowcount


class Session:
    """One task-scoped broker worker; only the supervisor lends its singleton lock descriptor."""
    def __init__(self, app, conversation):
        self.app, self.conversation = app, conversation
        self.lock = threading.Condition(threading.RLock())
        self.write_lock = threading.Lock()
        self.events = collections.deque()
        self.event_bytes = 0
        self.seq = 0
        self.responses = {}
        self.seq_rpc = 0
        self.closed = False
        self.active = False
        self.jobs = set()
        self.turn_done = False
        self.last = time.monotonic()
        self.request_id = None
        self.answer = ""
        self.thread = conversation.get("thread")
        self.turn = None
        self.cancel_requested = False
        self.attached = False
        self.queued = False
        self.queue_cancel = False
        self.proc = subprocess.Popen([HELPER, "serve", "--task", conversation["task"], "--client-kind", conversation["kind"],
            "--api-owner-fd", str(app.owner.fd)], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, pass_fds=(app.owner.fd,), start_new_session=True, env={"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8"})
        threading.Thread(target=self.pump, daemon=True).start()

    def emit(self, message):
        data = json.dumps(message, separators=(",", ":"), ensure_ascii=True)
        with self.lock:
            self.seq += 1
            self.events.append((self.seq, data))
            self.event_bytes += len(data)
            while len(self.events) > MAX_EVENTS or self.event_bytes > MAX_EVENT_BYTES:
                self.event_bytes -= len(self.events.popleft()[1])
            self.lock.notify_all()

    def send(self, message):
        with self.write_lock:
            if self.closed:
                raise ApiError(503, "session_closed")
            self.proc.stdin.write((json.dumps(message) + "\n").encode())
            self.proc.stdin.flush()
            self.last = time.monotonic()

    def rpc(self, method, params, timeout=60):
        with self.lock:
            self.seq_rpc += 1
            key = "api:" + str(self.seq_rpc)
        self.send({"id": key, "method": method, "params": params})
        deadline = time.monotonic() + timeout
        with self.lock:
            while key not in self.responses:
                if self.closed or time.monotonic() >= deadline:
                    raise ApiError(503, "runtime_unavailable")
                self.lock.wait(min(1, deadline - time.monotonic()))
            reply = self.responses.pop(key)
        if "error" in reply:
            if method == "turn/start":
                self.turn_done, self.final_state = True, "failed"
                self.finish_if_safe()
            raise ApiError(409, "runtime_refused")
        return reply.get("result", {})

    def finish_if_safe(self):
        if self.active and self.turn_done and not self.jobs:
            self.active = False
            if self.request_id:
                self.app.store.write("UPDATE requests SET answer=?,state=? WHERE id=?",
                    (self.answer, self.final_state, self.request_id))
            self.app.release(self)

    def pump(self):
        try:
            while True:
                line = self.proc.stdout.readline(MAX_BODY + 1)
                if not line:
                    break
                if len(line) > MAX_BODY:
                    raise ValueError("large event")
                message = json.loads(line)
                method, params = message.get("method"), message.get("params") or {}
                with self.lock:
                    if str(message.get("id", "")).startswith("api:"):
                        self.responses[message["id"]] = message
                    if method == "turn/started":
                        self.turn = params.get("turn", {}).get("id")
                        if self.cancel_requested and self.thread and self.turn:
                            self.send({"id": "cancel:" + str(uuid.uuid4()), "method": "turn/interrupt",
                                "params": {"threadId": self.thread, "turnId": self.turn}})
                    if method == "item/agentMessage/delta" and self.request_id:
                        self.answer = (self.answer + params.get("delta", ""))[:65536]
                    if method == "ddistro/run/started":
                        self.jobs.add(params.get("jobId"))
                    if method == "ddistro/run/updated" and params.get("state") not in ("starting", "running"):
                        self.jobs.discard(params.get("jobId"))
                    if method == "turn/completed":
                        self.turn_done = True
                        status = params.get("turn", {}).get("status")
                        self.final_state = "completed" if status == "completed" else "cancelled" if status == "interrupted" else "failed"
                        self.finish_if_safe()
                    if "error" in message and self.active and not str(message.get("id", "")).startswith("api:"):
                        # Only a rejected turn/start may release the reservation; other RPC failures cannot.
                        if message.get("id") == getattr(self, "turn_rpc", None):
                            self.turn_done, self.final_state = True, "failed"
                            self.finish_if_safe()
                    self.finish_if_safe()
                    self.lock.notify_all()
                self.emit(message)
        except (OSError, ValueError, TypeError):
            pass
        finally:
            with self.lock:
                self.closed = True
                if self.request_id and self.active:
                    self.app.store.write("UPDATE requests SET state='outcome_unknown' WHERE id=?", (self.request_id,))
                self.lock.notify_all()
            # Broker EOF means cleanup is complete; never release a dead worker's jobs based on a guessed success.
            self.proc.wait()
            self.app.release(self)

    def close(self):
        with self.app.lock:
            if self.active or self.jobs or self.queued:
                raise ApiError(409, "request_running")
            self.closed = True
        with contextlib.suppress(OSError):
            self.proc.stdin.close()
        try:
            self.proc.wait(15)
        except subprocess.TimeoutExpired:
            raise ApiError(409, "session_still_closing")


class App:
    def __init__(self):
        self.generation = hashlib.sha256(Path(SELF).read_bytes()).hexdigest()
        self.agent = load_agent()
        self.owner = self.agent.SingletonLock()
        account = pwd.getpwnam("ddagent")
        if not os.path.lexists(self.agent.GAME_TASKS_ROOT):
            os.mkdir(self.agent.GAME_TASKS_ROOT, 0o710)
            os.chown(self.agent.GAME_TASKS_ROOT, 0, account.pw_gid)
            os.chmod(self.agent.GAME_TASKS_ROOT, 0o710)
        os.close(self.agent.open_tasks_root(account, game=True))
        self.store = Store()
        self.store.write("UPDATE requests SET state='outcome_unknown' WHERE state NOT IN ('completed','failed','cancelled','outcome_unknown')")
        self.lock = threading.Condition(threading.RLock())
        self.session_gate = threading.Lock()
        self.sessions = {}
        self.current = None
        self.queue = collections.deque()
        self.stopping = False

    def reap_idle(self):
        while True:
            time.sleep(10)
            with self.lock:
                idle = [session for session in self.sessions.values()
                        if not session.active and not session.jobs and not session.queued and not session.attached
                        and time.monotonic() - session.last > 900]
            for session in idle:
                with contextlib.suppress(ApiError, OSError):
                    session.close()

    def owned(self, conversation, client):
        rows = self.store.rows("SELECT * FROM conversations WHERE id=? AND client=?", (conversation, client))
        if not rows:
            raise ApiError(404, "not_found")
        return rows[0]

    def session(self, conversation):
        with self.session_gate:
            with self.lock:
                if self.stopping:
                    raise ApiError(503, "service_stopping")
                key = conversation["id"]
                existing = self.sessions.get(key)
                if existing and not existing.closed:
                    return existing
                for old_key, old in list(self.sessions.items()):
                    if old.closed:
                        del self.sessions[old_key]
                idle = sorted((old for old in self.sessions.values()
                    if not old.active and not old.jobs and not old.queued and not old.attached), key=lambda old: old.last)
                evict = idle[0] if len(self.sessions) >= MAX_SESSIONS and idle else None
            if evict:
                evict.close()
                with self.lock:
                    self.sessions.pop(evict.conversation["id"], None)
            with self.lock:
                if len(self.sessions) >= MAX_SESSIONS:
                    raise ApiError(429, "session_limit")
                self.sessions[key] = Session(self, conversation)
                return self.sessions[key]

    def release(self, session):
        with self.lock:
            if self.current is session:
                self.current = None
            self.lock.notify_all()

    def reserve(self, session, request_id=None, cancellable=False):
        with self.lock:
            if self.stopping or session.closed:
                raise ApiError(503, "session_closed")
            if session.active:
                raise ApiError(409, "request_running")
            if len(self.queue) >= MAX_QUEUE:
                raise ApiError(429, "queue_full")
            ticket = object()
            self.queue.append(ticket)
            try:
                deadline = time.monotonic() + 120
                while self.current is not None or self.queue[0] is not ticket:
                    if self.stopping or session.closed:
                        raise ApiError(503, "session_closed")
                    if cancellable and session.queue_cancel:
                        raise ApiError(409, "cancelled_before_execution")
                    if time.monotonic() >= deadline:
                        raise ApiError(429, "queue_timeout")
                    self.lock.wait(0.5)
                if cancellable and session.queue_cancel:
                    raise ApiError(409, "cancelled_before_execution")
                self.current = session
                session.active, session.turn_done = True, False
                session.request_id, session.answer = request_id, ""
                session.turn, session.final_state = None, "outcome_unknown"
                session.cancel_requested = False
            finally:
                self.queue.remove(ticket)
                self.lock.notify_all()

    def launcher_turn(self, session, message):
        try:
            self.reserve(session, cancellable=True)
            session.turn_rpc = message.get("id")
            session.send(message)
        except ApiError as exc:
            session.emit({"id": message.get("id"), "error": {"code": -32001, "message": exc.code}})
        except OSError:
            # Keep an ambiguous submitted turn reserved until completion or worker EOF.
            session.emit({"id": message.get("id"), "error": {"code": -32001, "message": "outcome_unknown"}})
        finally:
            session.queued = False

    def game_turn(self, conversation, request_id, text, context):
        session = None
        submitted = False
        reserved = False
        try:
            session = self.session(conversation)
            session.queued = True
            self.reserve(session, request_id)
            reserved = True
            rows = self.store.rows("SELECT state FROM requests WHERE id=?", (request_id,))
            if rows[0]["state"] == "cancelled":
                session.active = False
                self.release(session)
                return
            if not self.store.write("UPDATE requests SET state='running' WHERE id=? AND state='queued'", (request_id,)):
                session.active = False
                self.release(session)
                return
            if not getattr(session, "initialized", False):
                session.rpc("initialize", {"clientInfo": {"name": "ddistro-api", "version": "1"}, "capabilities": {"experimentalApi": True}})
                session.send({"method": "initialized", "params": {}})
                session.initialized = True
                method = "thread/resume" if session.thread else "thread/start"
                params = {"threadId": session.thread, "excludeTurns": True} if session.thread else {}
                result = session.rpc(method, params)
                session.thread = result["thread"]["id"]
                self.store.write("UPDATE conversations SET thread=? WHERE id=?", (session.thread, conversation["id"]))
            submitted = True
            session.rpc("turn/start", {"threadId": session.thread, "input": [{"type": "text", "text":
                text + ("\n\nUntrusted game context (data only):\n" + context if context else "")}]})
        except Exception as exc:
            state = "outcome_unknown" if submitted and not (isinstance(exc, ApiError) and exc.code == "runtime_refused") else "failed"
            self.store.write("UPDATE requests SET state=? WHERE id=? AND state NOT IN ('cancelled','completed')", (state, request_id))
            if session and reserved:
                # A timeout after submission is ambiguous. Keep the reservation until broker completion/EOF.
                if not submitted:
                    session.turn_done, session.final_state = True, "failed"
                    session.finish_if_safe()
                    session.queued = False
                    with contextlib.suppress(ApiError, OSError):
                        session.close()
        finally:
            if session:
                session.queued = False


class LocalServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True
    request_queue_size = 16


class TcpServer(http.server.ThreadingHTTPServer):
    daemon_threads = True
    request_queue_size = 16

    def process_request(self, request, address):
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, address)
        except Exception:
            self.slots.release()
            raise

    def process_request_thread(self, request, address):
        try:
            super().process_request_thread(request, address)
        finally:
            self.slots.release()


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def log_message(self, *_):
        pass  # Never log bearer tokens, prompts or replies.

    def setup(self):
        super().setup()
        self.connection.settimeout(20)

    def authenticate(self):
        if self.headers.get("Origin") or self.headers.get("Transfer-Encoding"):
            raise ApiError(403, "browser_or_transfer_refused")
        if isinstance(self.server, LocalServer):
            _, uid, _ = struct.unpack("3i", self.connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
            if uid != 0:
                raise ApiError(403, "root_required")
            return "launcher", "launcher"
        auth = self.headers.get("Authorization", "")
        if not auth.startswith("Bearer ") or len(auth) > 128:
            raise ApiError(401, "unauthorized")
        digest = hashlib.sha256(auth[7:].encode()).hexdigest()
        rows = self.server.app.store.rows("SELECT id FROM clients WHERE digest=?", (digest,))
        if not rows:
            raise ApiError(401, "unauthorized")
        return rows[0]["id"], "game"

    def reply(self, status, document):
        data = json.dumps(document, ensure_ascii=True).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(data)
        self.close_connection = True

    def do_GET(self):
        self.handle_api("GET")

    def do_POST(self):
        self.handle_api("POST")

    def handle_api(self, method):
        try:
            client, kind = self.authenticate()
            body = {}
            if method == "POST":
                raw = self.headers.get("Content-Length", "")
                limit = MAX_BODY if kind == "launcher" else 65536
                if not raw.isdigit() or not 0 < int(raw) <= limit:
                    raise ApiError(413, "body_limit")
                body = json.loads(self.rfile.read(int(raw)))
                if not isinstance(body, dict):
                    raise ApiError(400, "invalid_body")
            result = self.route(method, self.path.split("?", 1)[0], body, client, kind)
            if result is not None:
                self.reply(200, result)
        except ApiError as exc:
            self.reply(exc.status, {"error": exc.code})
        except (ValueError, KeyError, TypeError):
            self.reply(400, {"error": "invalid_request"})
        except (BrokenPipeError, ConnectionResetError, TimeoutError):
            pass
        except Exception:
            self.reply(503, {"error": "assistant_unavailable"})

    def route(self, method, path, body, client, kind):
        app = self.server.app
        if path == "/v1/admin/shutdown" and method == "POST":
            if kind != "launcher":
                raise ApiError(403, "permission_denied")
            with app.lock:
                if (app.current is not None or app.queue
                        or any(s.jobs or s.active or s.queued for s in app.sessions.values())
                        or app.store.rows("SELECT id FROM requests WHERE state IN ('queued','running') LIMIT 1")):
                    raise ApiError(409, "request_running")
                app.stopping = True
            def stop():
                for session in list(app.sessions.values()):
                    with contextlib.suppress(ApiError, OSError):
                        session.close()
                os._exit(0)
            threading.Timer(0.2, stop).start()
            return {"stopping": True}
        if path == "/v1/capabilities" and method == "GET":
            result = {"version": API_VERSION, "client": client, "kind": kind, "permissions":
                ["chat", "maintenance", "approvals", "launcher_memory"] if kind == "launcher" else ["chat"],
                "game_actions": False, "max_sessions": MAX_SESSIONS, "max_queue": MAX_QUEUE}
            if kind == "launcher":
                result.update(generation=app.generation, owner_pid=os.getpid(), runtime_active=app.current is not None,
                              queued=len(app.queue), workers=len(app.sessions))
            return result
        if path == "/v1/conversations":
            if method == "GET":
                return {"conversations": app.store.rows("SELECT id,created FROM conversations WHERE client=? ORDER BY created DESC LIMIT 100", (client,))}
            if kind != "game" or body:
                raise ApiError(400, "invalid_request")
            if len(app.store.rows("SELECT id FROM conversations WHERE client=? LIMIT 100", (client,))) >= 100:
                raise ApiError(429, "conversation_limit")
            cid, task = str(uuid.uuid4()), str(uuid.uuid4())
            # Empty game scratch contains no Launcher diagnostic snapshot, configuration or memory.
            account = pwd.getpwnam("ddagent")
            tasks_fd = app.agent.open_tasks_root(account, game=True)
            os.close(tasks_fd)
            directory = app.agent.GAME_TASKS_ROOT + "/" + task
            os.mkdir(directory, 0o710)
            os.chown(directory, 0, account.pw_gid)
            os.mkdir(directory + "/work", 0o700)
            os.chown(directory + "/work", account.pw_uid, account.pw_gid)
            with open(directory + "/task.json", "x") as handle:
                os.chmod(directory + "/task.json", 0o600)
                json.dump({"schema_version": 1, "task_id": task, "product": "game", "workspace": "In-game Assistant"}, handle)
            app.store.write("INSERT INTO conversations VALUES(?,?,?,?,NULL,?)", (cid, client, task, kind, time.time()))
            return {"id": cid}
        if path == "/v1/launcher/sessions" and method == "POST":
            if kind != "launcher":
                raise ApiError(403, "permission_denied")
            if set(body) != {"task"} or not UUID.fullmatch(body["task"]):
                raise ApiError(400, "invalid_request")
            # A game task may never be attached as a maintenance workspace.
            other = app.store.rows("SELECT id FROM conversations WHERE task=? AND kind='game'", (body["task"],))
            if other:
                raise ApiError(403, "permission_denied")
            _, fd = app.agent.load_task(body["task"], app.agent.agent_identity())
            os.close(fd)
            rows = app.store.rows("SELECT * FROM conversations WHERE client=? AND task=?", (client, body["task"]))
            if not rows:
                cid = str(uuid.uuid4())
                app.store.write("INSERT INTO conversations VALUES(?,?,?,?,NULL,?)", (cid, client, body["task"], kind, time.time()))
            else:
                cid = rows[0]["id"]
            existing = app.sessions.get(cid)
            if existing and not existing.closed:
                if existing.active or existing.jobs or existing.queued:
                    raise ApiError(409, "request_running_reconnect_after_completion")
                if existing.attached and time.monotonic() - existing.last < 30:
                    raise ApiError(409, "session_already_attached")
                existing.close()
            session = app.session(app.owned(cid, client))
            session.attached = True
            return {"id": cid, "cursor": session.seq}
        parts = path.strip("/").split("/")
        if len(parts) >= 3 and parts[:2] == ["v1", "conversations"]:
            conversation = app.owned(parts[2], client)
            if len(parts) == 4 and parts[3] == "requests" and method == "POST":
                if kind != "game" or set(body) - {"message", "context", "idempotency_key"}:
                    raise ApiError(400, "invalid_request")
                text, context, idem = body["message"], body.get("context", ""), body["idempotency_key"]
                if not isinstance(text, str) or not 0 < len(text) <= 16384 or not isinstance(context, str) or len(context) > 32768 or not isinstance(idem, str) or not ID.fullmatch(idem):
                    raise ApiError(400, "invalid_request")
                digest = hashlib.sha256(json.dumps([parts[2], text, context]).encode()).hexdigest()
                with app.lock:
                    existing = app.store.rows("SELECT * FROM requests WHERE client=? AND idem=?", (client, idem))
                    if existing:
                        if existing[0]["digest"] != digest:
                            raise ApiError(409, "idempotency_conflict")
                        return {"id": existing[0]["id"], "state": existing[0]["state"]}
                    pending = app.store.rows("SELECT id FROM requests WHERE state IN ('queued','running')")
                    if (len(pending) >= MAX_QUEUE or len(app.store.rows("SELECT id FROM requests WHERE client=? LIMIT 200", (client,))) >= 200
                            or len(app.store.rows("SELECT id FROM requests LIMIT 1000")) >= 1000):
                        raise ApiError(429, "request_limit")
                    if app.store.rows("SELECT id FROM requests WHERE conversation=? AND state IN ('queued','running')", (parts[2],)):
                        raise ApiError(409, "request_running")
                    rid = str(uuid.uuid4())
                    app.store.write("INSERT INTO requests(id,conversation,client,idem,digest,state) VALUES(?,?,?,?,?,'queued')", (rid, parts[2], client, idem, digest))
                    threading.Thread(target=app.game_turn, args=(conversation, rid, text, context), daemon=True).start()
                return {"id": rid, "state": "queued"}
            if kind != "launcher":
                raise ApiError(403, "permission_denied")
            session = app.sessions.get(conversation["id"])
            if not session or session.closed:
                raise ApiError(410, "session_closed")
            if len(parts) == 4 and parts[3] == "events" and method == "GET":
                session.last = time.monotonic()
                self.stream(session, raw=True)
                return None
            if len(parts) == 4 and parts[3] == "messages" and method == "POST":
                if set(body) != {"message"} or not isinstance(body["message"], dict):
                    raise ApiError(400, "invalid_request")
                message = body["message"]
                if message.get("method") == "turn/start":
                    with app.lock:
                        if session.active or session.queued:
                            raise ApiError(409, "request_running")
                        session.queued, session.queue_cancel = True, False
                        threading.Thread(target=app.launcher_turn, args=(session, message), daemon=True).start()
                    return {"accepted": True, "state": "queued"}
                if message.get("method") == "turn/interrupt" and session.queued and not session.active:
                    session.queue_cancel = True
                    if "id" in message:
                        session.emit({"id": message["id"], "result": {}})
                    return {"accepted": True}
                try:
                    session.send(message)
                except Exception:
                    # Do not retry ambiguous writes or release until worker EOF.
                    raise ApiError(503, "outcome_unknown")
                return {"accepted": True}
            if len(parts) == 4 and parts[3] == "detach" and method == "POST":
                session.attached = False
                session.queue_cancel = True
                session.close()
                return {"detached": True}
        if len(parts) >= 3 and parts[:2] == ["v1", "requests"]:
            rows = app.store.rows("SELECT * FROM requests WHERE id=? AND client=?", (parts[2], client))
            if not rows:
                raise ApiError(404, "not_found")
            request = rows[0]
            if len(parts) == 3 and method == "GET":
                return {key: request[key] for key in ("id", "conversation", "state", "answer")}
            conversation = app.owned(request["conversation"], client)
            session = app.sessions.get(conversation["id"])
            if len(parts) == 4 and parts[3] == "events" and method == "GET":
                if not session or session.request_id != request["id"]:
                    return {"state": request["state"], "answer": request["answer"], "events_available": False}
                self.stream(session, raw=False)
                return None
            if len(parts) == 4 and parts[3] == "cancel" and method == "POST":
                if request["state"] == "queued":
                    app.store.write("UPDATE requests SET state='cancelled' WHERE id=? AND state='queued'", (request["id"],))
                if session and session.request_id == request["id"] and session.active:
                    session.cancel_requested = True
                    if session.thread and session.turn:
                        session.rpc("turn/interrupt", {"threadId": session.thread, "turnId": session.turn})
                return {"id": request["id"], "cancellation_requested": request["state"] not in TERMINAL}
        raise ApiError(404, "not_found")

    def stream(self, session, raw):
        cursor = self.headers.get("Last-Event-ID", "0")
        if not cursor.isdigit():
            raise ApiError(400, "invalid_cursor")
        cursor = int(cursor)
        with session.lock:
            if cursor > session.seq or session.events and cursor < session.events[0][0] - 1:
                raise ApiError(409, "event_gap")
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            with session.lock:
                batch = [(seq, data) for seq, data in session.events if seq > cursor]
                if not batch and not session.closed:
                    session.lock.wait(1)
            for seq, data in batch:
                if not raw:
                    message = json.loads(data)
                    method = message.get("method")
                    if method == "item/agentMessage/delta":
                        data = json.dumps({"type": "text_delta", "text": message["params"].get("delta", "")})
                    elif method == "turn/completed":
                        data = json.dumps({"type": "state", "state": session.final_state})
                    else:
                        data = '{"type":"progress"}'
                self.wfile.write(("id: %d\ndata: %s\n\n" % (seq, data)).encode())
                cursor = seq
            self.wfile.write(b": heartbeat\n\n")
            self.wfile.flush()
            if session.closed or not raw and session.turn_done:
                break
        self.close_connection = True


class UnixConnection(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(SOCKET)


def local_call(method, path, body=None, headers=None):
    conn = UnixConnection("localhost", timeout=140)
    payload = json.dumps(body).encode() if body is not None else None
    conn.request(method, path, payload, {"Content-Type": "application/json", **(headers or {})})
    reply = conn.getresponse()
    if reply.status != 200:
        try:
            code = json.loads(reply.read()).get("error", "api_refused")
        except (ValueError, AttributeError):
            code = "api_refused"
        conn.close()
        raise ApiError(reply.status, code)
    return conn, reply


# Serialize startup against maintenance without replacing any lifetime lock inode.
@contextlib.contextmanager
def lifecycle(exclusive=False):
    prepare_root()
    fd = os.open(LIFECYCLE, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1 or info.st_mode & 0o077:
            raise ApiError(503, "state_untrusted")
        try:
            fcntl.flock(fd, (fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH) | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ApiError(409, "maintenance_running")
        yield
    finally:
        os.close(fd)


def ensure():
    with lifecycle():
        expected = hashlib.sha256(Path(SELF).read_bytes()).hexdigest()
        try:
            conn, reply = local_call("GET", "/v1/capabilities")
            document = json.load(reply)
            conn.close()
            if document.get("version") != API_VERSION or document.get("generation") != expected:
                raise ApiError(409, "api_update_required")
            return
        except (OSError, http.client.HTTPException):
            pass
        log = os.open(ROOT + "/service.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        with os.fdopen(log, "ab") as output:
            child = subprocess.Popen([SELF, "serve"], stdin=subprocess.DEVNULL, stdout=output, stderr=output,
                start_new_session=True, close_fds=True, env={"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8"})
        for _ in range(60):
            try:
                conn, reply = local_call("GET", "/v1/capabilities")
                document = json.load(reply)
                conn.close()
                if document.get("version") != API_VERSION or document.get("generation") != expected:
                    raise ApiError(409, "api_update_required")
                return
            except (OSError, http.client.HTTPException):
                if child.poll() is not None:
                    break
                time.sleep(0.1)
        raise ApiError(503, "api_start_failed_or_legacy_session_busy")


# Own the maintenance gate across shutdown, helper replacement and isolation probing.
# Busy requests are refused before running the supplied root maintenance command.
def maintenance(command):
    if not command:
        raise ApiError(400, "maintenance_command_required")
    restart = False
    with lifecycle(exclusive=True):
        try:
            conn, reply = local_call("POST", "/v1/admin/shutdown", {})
            reply.read()
            conn.close()
            restart = True
        except (FileNotFoundError, ConnectionRefusedError):
            pass
        # Workers inherit the singleton descriptor. Wait for graceful closure, never kill them.
        agent = load_agent()
        deadline = time.monotonic() + 15
        while True:
            try:
                owner = agent.SingletonLock()
                os.close(owner.fd)
                break
            except Exception as exc:
                if time.monotonic() >= deadline:
                    raise ApiError(409, "assistant_busy_retry") from exc
                time.sleep(0.1)
        result = subprocess.run(command, env={**os.environ, "DDISTRO_ASSISTANT_MAINTENANCE": "1"}, close_fds=True)
    if restart:
        # Use the installed helper after replacement. A failed probe keeps the runtime closed.
        subprocess.run([SELF, "ensure"], check=False, stdout=subprocess.DEVNULL)
    return result.returncode


def bridge(task):
    ensure()
    conn, reply = local_call("POST", "/v1/launcher/sessions", {"task": task})
    document = json.load(reply)
    conn.close()
    base, cursor = "/v1/conversations/" + document["id"], document["cursor"]
    stopped = threading.Event()
    errors = []

    def receive():
        nonlocal cursor
        try:
            while not stopped.is_set():
                conn, reply = local_call("GET", base + "/events", headers={"Last-Event-ID": str(cursor)})
                for raw in reply:
                    line = raw.decode().strip()
                    if line.startswith("id: "):
                        cursor = int(line[4:])
                    elif line.startswith("data: "):
                        sys.stdout.write(line[6:] + "\n")
                        sys.stdout.flush()
                conn.close()
        except Exception:
            errors.append(True)
            stopped.set()

    threading.Thread(target=receive, daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(SystemExit(0)))
    buffer = b""
    try:
        while not stopped.is_set():
            if not select.select([sys.stdin.buffer], [], [], 1)[0]:
                continue
            chunk = os.read(sys.stdin.fileno(), 65536)
            if not chunk:
                break
            buffer += chunk
            if len(buffer) > MAX_BODY:
                raise ApiError(413, "body_limit")
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                conn, reply = local_call("POST", base + "/messages", {"message": json.loads(line)})
                reply.read()
                conn.close()
    finally:
        stopped.set()
        # Closing a UI cannot stop another client's request. An active own request stays supervised.
        with contextlib.suppress(Exception):
            conn, reply = local_call("POST", base + "/detach", {})
            reply.read()
            conn.close()
    return 4 if errors else 0


def serve():
    prepare_root()
    with lifecycle():
        app = App()  # Startup cannot race the maintenance gate.
    # Acquire singleton before removing an obsolete socket, preserving another owner's endpoint.
    if os.path.lexists(SOCKET):
        info = os.lstat(SOCKET)
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != 0:
            raise ApiError(503, "state_untrusted")
        os.unlink(SOCKET)
    local = LocalServer(SOCKET, Handler)
    os.chmod(SOCKET, 0o600)
    local.app = app
    public = TcpServer(("127.0.0.1", PORT), Handler)
    public.slots = threading.BoundedSemaphore(32)
    public.app = app
    threading.Thread(target=local.serve_forever, daemon=True).start()
    threading.Thread(target=app.reap_idle, daemon=True).start()
    print(json.dumps({"event": "started", "port": PORT, "pid": os.getpid()}), flush=True)
    public.serve_forever()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest="command", required=True)
    subs.add_parser("serve")
    subs.add_parser("ensure")
    subs.add_parser("status")
    update = subs.add_parser("maintenance", help="root: safely drain, update, probe and reconnect")
    update.add_argument("argv", nargs=argparse.REMAINDER)
    subs.add_parser("protocol")
    register = subs.add_parser("register", help="root: provision a chat-only game client, token printed once")
    register.add_argument("client")
    revoke = subs.add_parser("revoke")
    revoke.add_argument("client")
    relay = subs.add_parser("bridge", help="root: trusted Launcher JSONL compatibility relay")
    relay.add_argument("--task", required=True)
    args = parser.parse_args()
    prepare_root()
    if args.command == "protocol":
        print(json.dumps({"version": API_VERSION}))
        return
    if args.command == "maintenance":
        return maintenance(args.argv)
    if args.command == "serve":
        return serve()
    if args.command == "bridge":
        return bridge(args.task)
    if args.command == "ensure":
        ensure()
        print('{"ready":true}')
    elif args.command == "status":
        conn, reply = local_call("GET", "/v1/capabilities")
        print(reply.read().decode())
        conn.close()
    else:
        if not ID.fullmatch(args.client) or args.client == "launcher":
            raise ApiError(400, "invalid_client")
        # Registration/revocation is a root-local administrative operation, never an HTTP capability.
        store = Store()
        if args.command == "register":
            if store.rows("SELECT id FROM clients WHERE id=?", (args.client,)):
                raise ApiError(409, "client_exists_revoke_first")
            if len(store.rows("SELECT id FROM clients")) >= 32:
                raise ApiError(429, "client_limit")
            token = secrets.token_urlsafe(32)
            store.write("INSERT INTO clients VALUES(?,?)", (args.client, hashlib.sha256(token.encode()).hexdigest()))
            print(json.dumps({"client": args.client, "token": token, "permissions": ["chat"]}))
        else:
            store.write("DELETE FROM clients WHERE id=?", (args.client,))
            print('{"revoked":true}')


if __name__ == "__main__":
    os.umask(0o077)
    try:
        sys.exit(main() or 0)
    except ApiError as exc:
        sys.stderr.write(json.dumps({"error": exc.code}) + "\n")
        sys.exit(75 if exc.code in ("request_running", "assistant_busy_retry", "maintenance_running") else 1)
