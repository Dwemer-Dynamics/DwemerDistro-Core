#!/usr/bin/env python3
"""Cut over the standard Debian 15/main cluster to a verified UTF8 17/dwemer cluster."""

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import signal
import stat
import subprocess
import sys
import tarfile
import tempfile
import uuid

ROOT = Path("/var/lib/dwemerdistro/pg17-maintenance")
STATE = ROOT / "state.json"
CONF = Path("/etc/postgresql")
DATA = Path("/var/lib/postgresql")
OLD = CONF / "15/main"
NEW = CONF / "17/dwemer"
OLD_DATA = DATA / "15/main"
NEW_DATA = DATA / "17/dwemer"
PG = Path("/usr/lib/postgresql/17/bin")
STAGER = "/usr/local/bin/ddistro_stage_pg17"
# A failure that repeats is deterministic (for example invalid SQL_ASCII bytes). Each attempt stops
# PG15, writes a full Windows backup and retains its staging copy, so stop retrying unattended.
AUTO_ATTEMPTS = 2


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def atomic(path, value, mode):
    temporary = path.with_name(path.name + ".pg17-" + uuid.uuid4().hex)
    with temporary.open("x") as stream:
        os.fchmod(stream.fileno(), mode)
        stream.write(value)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)
    sync_dir(path.parent)


def sync_dir(path):
    fd = os.open(path, os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def phase(state, name):
    state["phase"] = name
    atomic(STATE, json.dumps(state), 0o600)


def cluster(version, command):
    name = "main" if version == 15 else "dwemer"
    run(
        "pg_ctlcluster", "--skip-systemctl-redirect", str(version), name, command, stdout=log, stderr=log
    )


def pg(*args, **kwargs):
    return run("/usr/sbin/runuser", "-u", "postgres", "--", *args, **kwargs)


def postgres_env(socket, db="postgres"):
    return {
        "PATH": "/usr/bin:/bin",
        "LC_ALL": "C",
        "PGHOST": str(socket),
        "PGPORT": "5432",
        "PGDATABASE": db,
        "PGUSER": "postgres",
    }


def query(socket, statement):
    client = PG / "psql" if (PG / "psql").exists() else Path("/usr/lib/postgresql/15/bin/psql")
    return (
        pg(
            client,
            "-XqAt",
            "-v",
            "ON_ERROR_STOP=1",
            "-c",
            statement,
            env=postgres_env(socket),
            stdout=subprocess.PIPE,
            stderr=log,
        )
        .stdout.decode()
        .strip()
    )


def fingerprint(state):
    # Run the stopped candidate on a peer-only private socket. This fences application writes
    # throughout the comparison. Closed database data, sequences, globals and ACLs all count.
    work = Path(state["work"])
    pg_ctl = PG / "pg_ctl"
    private = work / "s17"
    options = (
        f"-c config_file={NEW}/postgresql.conf -c listen_addresses='' "
        f"-c unix_socket_directories={private} -c port=5432 -c hba_file={work}/hba "
        "-c autovacuum=off -c max_logical_replication_workers=0"
    )
    pg(
        pg_ctl,
        "-D",
        NEW_DATA,
        "-o",
        options,
        "-l",
        work / "fingerprint.log",
        "-w",
        "start",
        stdout=log,
        stderr=log,
    )
    try:
        pending = ROOT / (work.name + "-closed.json")
        if pending.exists():
            if cluster_id(17, NEW_DATA) != state["candidate_id"]:
                raise ValueError("Interrupted verification belongs to a different cluster")
            quoted = '"' + json.loads(pending.read_text()).replace('"', '""') + '"'
            query(private, "ALTER DATABASE " + quoted + " ALLOW_CONNECTIONS false")
            pending.unlink()
        names = json.loads(
            query(
                private,
                """select json_agg(json_build_array(datname,datallowconn)
                            order by datname collate "C") from pg_database""",
            )
        )
        # Format 2 skips the version header comments; the legacy digest covers every byte, as
        # baselines recorded before format 2 did.
        digest, legacy = hashlib.sha256(), hashlib.sha256()

        def update(data):
            digest.update(data)
            legacy.update(data)

        update(json.dumps(names).encode())
        for path in sorted([NEW_DATA / "postgresql.auto.conf", *NEW.rglob("*")]):
            if path != NEW / "start.conf" and path.is_file():
                update(json.dumps([str(path), hashlib.sha256(path.read_bytes()).hexdigest()]).encode())
        command = ["/usr/sbin/runuser", "-u", "postgres", "--"]
        for db, opened in [(None, True)] + names:
            quoted = '"' + (db or "").replace('"', '""') + '"'
            if not opened:
                atomic(pending, json.dumps(db), 0o600)
                query(private, "ALTER DATABASE " + quoted + " ALLOW_CONNECTIONS true")
            try:
                if db is not None:
                    membership = pg(
                        PG / "psql", "-XqAt", "-v", "ON_ERROR_STOP=1", "-c",
                        "select count(*) from pg_depend d join pg_class c on c.oid=d.objid "
                        "where d.classid='pg_class'::regclass and d.deptype='e' "
                        "and c.relkind in ('r','p','m','S','f')",
                        env=postgres_env(private, db), stdout=subprocess.PIPE, stderr=log,
                    )
                    if membership.stdout.strip() != b"0":
                        raise ValueError("Extension-managed relations require a mapped migration")
                tool = (
                    [PG / "pg_dumpall", "--globals-only"] if db is None else [PG / "pg_dump", "--create"]
                )
                with subprocess.Popen(
                    command + tool + ["--restrict-key=" + state["key"]],
                    env=postgres_env(private, db or "postgres"),
                    stdout=subprocess.PIPE,
                    stderr=log,
                ) as process:
                    # Package minor updates change only these header comments, not the data. Read
                    # the header with bounded lines, then hash fixed blocks so no row is held whole.
                    for _ in range(12):
                        line = process.stdout.readline(4096)
                        legacy.update(line)
                        if not (line.startswith(b"-- Dumped ") and line.endswith(b"\n")):
                            digest.update(line)
                        if not line.endswith(b"\n"):
                            break
                    for block in iter(lambda: process.stdout.read(1024 * 1024), b""):
                        update(block)
                    if process.wait():
                        raise ValueError("Could not verify rollback data")
            finally:
                if not opened:
                    query(private, "ALTER DATABASE " + quoted + " ALLOW_CONNECTIONS false")
                    pending.unlink()
        return digest.hexdigest(), legacy.hexdigest()
    finally:
        pg(pg_ctl, "-D", NEW_DATA, "-m", "fast", "-w", "stop", stdout=log, stderr=log)


def controldata(version, directory):
    control = run(
        f"/usr/lib/postgresql/{version}/bin/pg_controldata",
        directory,
        env=dict(os.environ, LC_ALL="C"),
        stdout=subprocess.PIPE,
        text=True,
    ).stdout
    return dict((part.strip() for part in line.split(":", 1)) for line in control.splitlines() if ":" in line)


def cluster_id(version, directory):
    return controldata(version, directory)["Database system identifier"]


def seal():
    # PostgreSQL records production state in pg_control before it accepts any connection, and every
    # later shutdown writes a new checkpoint. An unchanged clean shutdown proves no client wrote to PG17.
    control = controldata(17, NEW_DATA)
    keys = ("Database system identifier", "Latest checkpoint location", "Latest checkpoint's REDO location",
            "Time of latest checkpoint", "Database cluster state")
    return [control[key] for key in keys]


def running(version, directory):
    # pg_ctl checks the postmaster process, so a pid file left by power loss reads as stopped.
    status = subprocess.run(
        ["/usr/sbin/runuser", "-u", "postgres", "--", f"/usr/lib/postgresql/{version}/bin/pg_ctl",
         "-D", directory, "status"],
        stdout=log, stderr=log,
    )
    if status.returncode not in (0, 3):
        raise ValueError(f"Could not determine PG{version} cluster status")
    return status.returncode == 0


def restore_old(state):
    if cluster_id(15, OLD_DATA) != state["donor_id"]:
        raise ValueError("PG15 recovery cluster identity differs from the saved donor")
    if NEW.exists():
        atomic(NEW / "start.conf", "disabled\n", 0o644)
    atomic(OLD / "start.conf", "manual\n", 0o644)
    if not running(15, OLD_DATA):
        cluster(15, "start")
    verify_active(15, OLD_DATA)
    atomic(OLD / "start.conf", state["old_start"], 0o644)
    phase(state, "rolled-back")


def verify_active(major, path):
    actual = query(
        "/var/run/postgresql",
        "select current_setting('server_version_num')::int / 10000 || '|' || current_setting('data_directory')",
    )
    if actual != f"{major}|{path}":
        raise ValueError("Unexpected PostgreSQL version or data directory on the application socket")


def ensure_packages():
    needed = (PG / "pg_ctl", PG / "pg_dump", Path("/usr/share/postgresql/17/extension/vector.control"))
    if all(p.is_file() for p in needed):
        return
    os_info = dict(
        line.split("=", 1) for line in Path("/etc/os-release").read_text().splitlines() if "=" in line
    )
    suite = os_info.get("VERSION_CODENAME", "").strip('"')
    if os_info.get("ID", "").strip('"') != "debian" or suite not in ("bookworm", "trixie"):
        raise ValueError("Package provisioning supports Debian Bookworm and Trixie")
    # Restrict this install to signed Debian sources and the upstream PostgreSQL repository on Bookworm.
    # Isolated APT lists leave the customer's configured package sources and normal update policy intact.
    with tempfile.TemporaryDirectory(prefix="ddistro-pg17-") as temp:
        scratch = Path(temp)
        scratch.chmod(0o755)
        sources = [
            f"deb https://deb.debian.org/debian {suite} main",
            f"deb https://deb.debian.org/debian-security {suite}-security main",
        ]
        if suite == "bookworm":
            key = scratch / "postgresql.asc"
            run(
                "curl",
                "--fail",
                "--silent",
                "--show-error",
                "--location",
                "--proto",
                "=https",
                "https://www.postgresql.org/media/keys/ACCC4CF8.asc",
                "-o",
                key,
                stderr=log,
            )
            info = run(
                "gpg", "--batch", "--with-colons", "--show-keys", key, stdout=subprocess.PIPE, stderr=log
            ).stdout
            fingerprints = [
                line.split(b":")[9] for line in info.splitlines() if line.startswith(b"fpr:")
            ]
            if (
                not fingerprints
                or fingerprints[0] != b"B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8"
                or info.count(b"pub:") != 1
            ):
                raise ValueError("PostgreSQL repository key fingerprint mismatch")
            key.chmod(0o644)
            sources.append(
                f"deb [signed-by={key}] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main"
            )
        source_list = scratch / "sources.list"
        source_list.write_text("\n".join(sources) + "\n")
        source_list.chmod(0o644)
        lists = scratch / "lists"
        lists.mkdir(mode=0o755)
        apt = [
            "apt-get",
            "-o",
            "Dir::Etc::sourcelist=" + str(source_list),
            "-o",
            "Dir::Etc::sourceparts=-",
            "-o",
            "Dir::State::lists=" + str(lists),
            "-o",
            "Dpkg::Options::=--force-confold",
        ]
        environment = dict(os.environ, DEBIAN_FRONTEND="noninteractive", NEEDRESTART_MODE="l")
        print("Installing the PostgreSQL 17 server, client and pgvector.", flush=True)
        run(*apt, "update", env=environment, stdout=log, stderr=log, umask=0o022)
        run(
            *apt,
            "install",
            "--no-remove",
            "--no-install-recommends",
            "-y",
            "postgresql-17",
            "postgresql-client-17",
            "postgresql-17-pgvector",
            env=environment,
            stdout=log,
            stderr=log,
            umask=0o022,
        )
    if not all(p.is_file() for p in needed):
        raise ValueError("PostgreSQL 17 prerequisites are incomplete")


def allow_retry():
    state = json.loads(STATE.read_text())
    state["retry_auto"] = True
    phase(state, "rolled-back")


def upgrade(backup, automatic=False):
    attempts = 0
    if STATE.exists():
        previous = json.loads(STATE.read_text())
        if previous["phase"] == "rolled-back":
            if automatic:
                attempts = previous.get("auto_attempts", 0)
            verify_active(15, OLD_DATA)
            tag = Path(previous["work"]).name
            if not re.fullmatch(r"dwemer-stage-[0-9a-f]{32}", tag):
                raise ValueError("Unrecognized previous maintenance identity")
            if (NEW_DATA / "postmaster.pid").exists():
                raise ValueError("The retained PG17 cluster is running")
            if NEW_DATA.exists() and cluster_id(17, NEW_DATA) != previous.get("candidate_id"):
                raise ValueError("Destination no longer matches the retained PG17 cluster")
            if NEW.exists() and not (NEW / "dwemer-maintenance-id").read_text().strip() == tag:
                raise ValueError("Destination configuration no longer matches the retained PG17 cluster")
            # Preserve the previous run for recovery; never reuse or overwrite its files.
            if NEW.exists():
                NEW.rename(ROOT / (tag + "-config"))
            if NEW_DATA.exists():
                NEW_DATA.rename(DATA / (tag + "-retained17"))
            STATE.rename(ROOT / (tag + ".json"))
    if STATE.exists() or NEW.exists() or NEW_DATA.exists():
        raise ValueError(
            "Previous maintenance state or PG17 destination exists; retained copies were preserved"
        )
    if not backup or not backup.is_dir() or not str(backup.resolve()).startswith("/mnt/"):
        raise ValueError("Select a Windows backup directory outside this distro")
    mount_type = run(
        "findmnt", "-n", "-o", "FSTYPE", "-T", backup, stdout=subprocess.PIPE, text=True
    ).stdout.strip()
    if mount_type not in ("drvfs", "9p"):
        raise ValueError("The backup directory must be on a mounted Windows volume")
    if not Path(STAGER).is_file():
        raise ValueError("The distro is missing its verified PG17 staging tool")
    verify_active(15, OLD_DATA)
    for setting, expected in (
        ("config_file", OLD / "postgresql.conf"),
        ("hba_file", OLD / "pg_hba.conf"),
        ("ident_file", OLD / "pg_ident.conf"),
    ):
        if query("/var/run/postgresql", "show " + setting) != str(expected):
            raise ValueError("Custom PostgreSQL configuration paths require a mapped migration")
    if OLD.is_symlink() or OLD_DATA.is_symlink() or any(x.is_symlink() for tree in (OLD, OLD_DATA) for x in tree.rglob("*")) or any((OLD_DATA / "pg_tblspc").iterdir()):
        raise ValueError("Linked configuration or external tablespaces require a mapped backup")
    auto = OLD_DATA / "postgresql.auto.conf"
    if auto.exists() and any(
        line.strip() and not line.lstrip().startswith("#") for line in auto.read_text().splitlines()
    ):
        raise ValueError("Review ALTER SYSTEM settings before upgrading")
    source_size = int(run("du", "-sb", OLD_DATA, stdout=subprocess.PIPE).stdout.split()[0])
    if (
        shutil.disk_usage(backup).free < source_size * 1.1
        or shutil.disk_usage(DATA).free < source_size * 4
    ):
        raise ValueError("Insufficient space for the backup and staging copies")
    token = uuid.uuid4().hex
    work = DATA / ("dwemer-stage-" + token)
    state = {
        "work": str(work),
        "backup": str(backup / ("Dwemer-PG15-" + token + ".tar")),
        "old_start": (OLD / "start.conf").read_text(),
        "key": secrets.token_hex(32),
        "donor_id": query("/var/run/postgresql", "select system_identifier from pg_control_system()"),
        "auto_attempts": attempts + 1 if automatic else 0,
    }
    phase(state, "staging")
    try:
        atomic(OLD / "start.conf", "manual\n", 0o644)
        cluster(15, "stop")
        atomic(OLD / "start.conf", "disabled\n", 0o644)
        archive = Path(state["backup"])
        paths = [str(OLD_DATA.relative_to("/")), str(OLD.relative_to("/"))]
        print("Saving and comparing the stopped PostgreSQL 15 backup.", flush=True)
        # Bind the archive checksum in the root-owned journal so donor removal can later detect a
        # replaced or damaged Windows copy. The sidecar copy is informational only.
        digest = hashlib.sha256()
        with archive.open("xb") as out, subprocess.Popen(
            ["tar", "-C", "/", "-b", "2048", "-cf", "-", *paths], stdout=subprocess.PIPE, stderr=log
        ) as process:
            for block in iter(lambda: process.stdout.read(1024 * 1024), b""):
                digest.update(block)
                out.write(block)
            if process.wait():
                raise ValueError("Could not write the PG15 backup")
            out.flush()
            os.fsync(out.fileno())
        state["backup_sha256"] = digest.hexdigest()
        state["backup_bytes"] = archive.stat().st_size
        phase(state, "staging")
        run("tar", "-C", "/", "--compare", "-f", archive, stdout=log, stderr=log)
        with archive.with_suffix(".recovery.json").open("x") as meta:
            json.dump(
                {
                    "postgres_major": 15,
                    "data": str(OLD_DATA),
                    "config": str(OLD),
                    "system_identifier": state["donor_id"],
                    "original_start_conf": state["old_start"],
                    "sha256": state["backup_sha256"],
                    "bytes": state["backup_bytes"],
                },
                meta,
            )
            meta.flush()
            os.fsync(meta.fileno())
        ensure_packages()
        # The archive captured disabled startup while the original remains fenced.
        print("Restoring and verifying all databases as UTF8.", flush=True)
        pg("python3", STAGER, OLD_DATA, work, stdout=log, stderr=log)
        if not (work / "verified.json").is_file():
            raise ValueError("Missing verified candidate")
        if not NEW_DATA.parent.exists():
            NEW_DATA.parent.mkdir()
            NEW_DATA.parent.chmod(0o755)
        state["candidate_id"] = cluster_id(17, work / "pg17")
        phase(state, "staging")
        (work / "pg17").rename(NEW_DATA)
        if not NEW.parent.exists():
            NEW.parent.mkdir()
            NEW.parent.chmod(0o755)
        # Mark the directory before copying so an interrupted copy is still recognized as ours.
        NEW.mkdir()
        atomic(NEW / "dwemer-maintenance-id", work.name, 0o600)
        shutil.copytree(OLD, NEW, dirs_exist_ok=True)
        for item in (NEW, *NEW.rglob("*")):
            if item.name == "dwemer-maintenance-id":
                continue
            original = (OLD / item.relative_to(NEW)).stat()
            os.chown(item, original.st_uid, original.st_gid)
        for key, value in (
            ("data_directory", str(NEW_DATA)),
            ("hba_file", str(NEW / "pg_hba.conf")),
            ("ident_file", str(NEW / "pg_ident.conf")),
            ("external_pid_file", "/var/run/postgresql/17-dwemer.pid"),
            ("port", "5432"),
        ):
            run("pg_conftool", "17", "dwemer", "set", key, value, stdout=log, stderr=log)
        state["baseline"], _ = fingerprint(state)
        state["baseline_format"] = 2
        state["seal"] = seal()
        if state["seal"][-1] != "shut down":
            raise ValueError("PG17 candidate did not shut down cleanly after verification")
        phase(state, "publishing")
        atomic(NEW / "start.conf", "manual\n", 0o644)
        cluster(17, "start")
        verify_active(17, NEW_DATA)
        atomic(NEW / "start.conf", state["old_start"], 0o644)
        state.pop("seal")
        phase(state, "active")
        print("PostgreSQL 17 is serving on port 5432. Original cluster and external backup retained.")
    except BaseException:
        if state["phase"] == "staging":
            state["retry_auto"] = True
            restore_old(state)
        elif state["phase"] == "publishing":
            # PG15 is fenced and PG17 failed to come up; do not leave both clusters down. Journal the
            # retry first so an interrupted rollback still resumes as a failed automatic attempt.
            state["retry_auto"] = True
            phase(state, "publishing")
            rollback()
        raise


def rollback():
    state = json.loads(STATE.read_text())
    if state["phase"] == "rolled-back":
        verify_active(15, OLD_DATA)
        return
    # Refuse before fencing PG17: without the donor, rollback would leave both clusters down.
    if removal(state) is not None:
        raise ValueError(
            "The PG15 data directory was removed after its Windows backup was verified, so PostgreSQL 17 "
            f"keeps serving. Restore PG15 by hand from {state['backup']} and its recovery JSON if needed"
        )
    if not (OLD_DATA / "PG_VERSION").is_file():
        raise ValueError(
            "The PG15 data directory is missing, so rollback changed nothing. Restore it from "
            f"{state['backup']} and its recovery JSON before rolling back"
        )
    if state["phase"] in ("active", "publishing", "checking"):
        if (
            cluster_id(17, NEW_DATA) != state["candidate_id"]
            or (NEW / "dwemer-maintenance-id").read_text().strip() != Path(state["work"]).name
        ):
            raise ValueError("The PG17 cluster differs from the maintenance journal")
        is_running = running(17, NEW_DATA)
        if state["phase"] != "active" and "seal" in state and not is_running and seal() == state["seal"]:
            # Never started since the verified shutdown, so it accepted no writes. Starting it to
            # compare could itself fail and strand PG15, so retain it untouched.
            atomic(NEW / "start.conf", "disabled\n", 0o644)
            restore_old(state)
            print("PostgreSQL 15 is serving on port 5432. The unpublished PG17 candidate was retained.")
            return
        if is_running:
            private = Path(state["work"]) / "s17"
            if (private / ".s.PGSQL.5432").is_socket():
                if query(private, "select system_identifier from pg_control_system()") != state["candidate_id"]:
                    raise ValueError("Unexpected cluster on private verification socket")
                pg(PG / "pg_ctl", "-D", NEW_DATA, "-m", "fast", "-w", "stop", stdout=log, stderr=log)
            else:
                verify_active(17, NEW_DATA)
                cluster(17, "stop")
        atomic(NEW / "start.conf", "disabled\n", 0o644)
        phase(state, "checking")
        try:
            current, legacy = fingerprint(state)
            if (current if state.get("baseline_format") == 2 else legacy) != state["baseline"]:
                raise ValueError(
                    "PG17 data or permissions changed. Rollback refused to preserve those writes."
                )
        except BaseException:
            if (ROOT / (Path(state["work"]).name + "-closed.json")).exists():
                raise ValueError(
                    "Verification interrupted; recover the recorded database restriction before restart"
                )
            try:
                atomic(NEW / "start.conf", "manual\n", 0o644)
                cluster(17, "start")
                verify_active(17, NEW_DATA)
            except Exception:
                raise ValueError(
                    "PG17 may hold accepted writes but could not be verified or restarted, so PostgreSQL 15 "
                    "stays stopped. Review the log and the retained clusters before restoring PG15 by hand "
                    "or from the external backup"
                ) from None
            atomic(NEW / "start.conf", state["old_start"], 0o644)
            state.pop("seal", None)
            state.pop("retry_auto", None)
            phase(state, "active")
            raise
    elif state["phase"] != "staging":
        raise ValueError("Unknown migration state")
    restore_old(state)
    print("PostgreSQL 15 is serving on port 5432. PG17 was retained.")


def settled():
    return not STATE.exists() or json.loads(STATE.read_text())["phase"] in ("active", "rolled-back")


def recover():
    # An abrupt stop mid-maintenance can leave both clusters fenced, so update.sh runs this before
    # it starts PostgreSQL or needs SQL. Settled journals are left alone without any cluster access.
    if settled():
        return False
    state = json.loads(STATE.read_text())
    work = Path(state["work"])
    if work.parent != DATA or not re.fullmatch(r"dwemer-stage-[0-9a-f]{32}", work.name):
        raise ValueError("Unrecognized interrupted maintenance identity")
    # An interrupted upgrade counts as a failed automatic attempt; an interrupted explicit rollback stays held.
    retry = state["phase"] in ("staging", "publishing") or state.get("retry_auto")
    try:
        rollback()
    except Exception:
        # A candidate that changed after publication keeps serving; its writes are the newer data.
        if json.loads(STATE.read_text())["phase"] == "active":
            verify_active(17, NEW_DATA)
            print("Recovered interrupted maintenance. PostgreSQL 17 accepted writes and keeps serving.")
            return True
        raise
    if retry:
        allow_retry()
    return True


def automatic_status():
    if STATE.exists():
        state = json.loads(STATE.read_text())
        if state["phase"] == "active":
            verify_active(17, NEW_DATA)
            return "current" if state.get("cleaned") else "needed"
        if state["phase"] == "rolled-back":
            verify_active(15, OLD_DATA)
            # Held means an operator chose PG15. Exhausted retries stay a failure until one decides.
            if not state.get("retry_auto"):
                return "held"
            if state.get("auto_attempts", 0) >= AUTO_ATTEMPTS:
                raise ValueError(
                    f"The automatic PostgreSQL 17 upgrade failed {AUTO_ATTEMPTS} times and PostgreSQL 15 "
                    "is serving. Review the log, then in Settings > Database Maintenance choose Upgrade "
                    "to try again or Roll back to stay on PostgreSQL 15"
                )
        return "needed"
    if not (OLD_DATA / "PG_VERSION").is_file():
        return "unsupported"
    verify_active(15, OLD_DATA)
    return "needed"


def automatic_upgrade(backup):
    if automatic_status() != "needed":
        return
    if recover():
        raise ValueError("Recovered interrupted maintenance; retry the update")
    state = json.loads(STATE.read_text()) if STATE.exists() else {}
    if state.get("phase") != "active":
        upgrade(backup, automatic=True)
        state = json.loads(STATE.read_text())
    verify_active(17, NEW_DATA)
    work = Path(state["work"])
    if work.parent != DATA or not re.fullmatch(r"dwemer-stage-[0-9a-f]{32}", work.name) or work.is_symlink():
        raise ValueError("Unexpected staging path")
    if cluster_id(17, NEW_DATA) != state["candidate_id"] or (NEW / "dwemer-maintenance-id").read_text().strip() != work.name:
        raise ValueError("Unexpected PG17 cleanup target")
    if not (work / "verified.json").is_file() or not Path(state["backup"]).is_file():
        raise ValueError("Verified migration or recovery archive is missing")
    # Keep the original PG15 cluster, external backup, private verification socket and peer HBA for rollback.
    for item in work.iterdir():
        if item.name == "source-copy":
            shutil.rmtree(item)
        elif item.name == "globals.sql" or re.fullmatch(r"[0-9]+\.dump", item.name):
            item.unlink()
    state["cleaned"] = True
    phase(state, "active")


def quarantine_path(state):
    return OLD_DATA.with_name("." + Path(state["work"]).name + "-pg15-removing")


def mounts_within(path):
    target = str(path)
    with open("/proc/self/mountinfo") as table:
        points = [
            re.sub(r"\\([0-7]{3})", lambda code: chr(int(code.group(1), 8)), line.split()[4])
            for line in table
        ]
    return [point for point in points if point == target or point.startswith(target + "/")]


def cluster_dirs():
    listing = run("pg_lsclusters", "--no-header", stdout=subprocess.PIPE, stderr=log, text=True).stdout
    for line in listing.splitlines():
        fields = line.split()
        if len(fields) < 6:
            raise ValueError("Could not read the PostgreSQL cluster list")
        yield fields[0], fields[1], Path(os.path.realpath(fields[5]))


def donor_tree(root, label="PG15 data directory"):
    # Map every entry below root to its lstat. Links, special files and other devices stop removal,
    # because deleting them could reach data that the backup does not hold.
    top = os.lstat(root)
    if not stat.S_ISDIR(top.st_mode):
        raise ValueError(f"The {label} is missing or linked")
    entries, pending = {"": top}, [""]
    while pending:
        relative = pending.pop()
        with os.scandir(os.path.join(root, relative)) as listing:
            for entry in listing:
                name = os.path.join(relative, entry.name)
                info = entry.stat(follow_symlinks=False)
                if info.st_dev != top.st_dev or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
                    raise ValueError(f"The {label} holds links, special files or mounts")
                entries[name] = info
                if stat.S_ISDIR(info.st_mode):
                    pending.append(name)
    return entries


def config_tree():
    # The archive's configuration members are the only PG15 settings left to restore with the donor gone.
    if OLD.is_symlink() or Path(os.path.realpath(OLD)) != OLD:
        raise ValueError("The retained PG15 configuration is missing or linked")
    config = donor_tree(OLD, "retained PG15 configuration")
    if any(
        name not in config or not stat.S_ISREG(config[name].st_mode)
        for name in ("postgresql.conf", "pg_hba.conf", "pg_ident.conf", "start.conf")
    ):
        raise ValueError("The retained PG15 configuration is incomplete")
    return config


def allocated_bytes(entries):
    # Allocated blocks, not apparent size. A hard-linked file frees space only when every link goes.
    links, total = {}, 0
    for info in entries.values():
        key = (info.st_dev, info.st_ino)
        links[key] = links.get(key, 0) + 1
        if links[key] == (info.st_nlink if stat.S_ISREG(info.st_mode) else 1):
            total += info.st_blocks * 512
    return total


class Hashed:
    def __init__(self, raw):
        self.raw, self.digest, self.size = raw, hashlib.sha256(), 0

    def read(self, size=-1):
        data = self.raw.read(size)
        self.digest.update(data)
        self.size += len(data)
        return data


def file_digest(path):
    with open(path, "rb") as raw:
        source = Hashed(raw)
        for _ in iter(lambda: source.read(1024 * 1024), b""):
            pass
    return source.digest.hexdigest(), source.size


def verify_archive(state, entries, config):
    """Return the archive SHA-256 and size after comparing it with the donor and its configuration."""
    # One streaming pass compares every stopped donor and retained configuration entry with the
    # archive, so archives written before checksums were journaled are still checked in full.
    trees = (
        (str(OLD_DATA.relative_to("/")), OLD_DATA, entries, set()),
        (str(OLD.relative_to("/")), OLD, config, set()),
    )

    def differs():
        return ValueError("The PG15 data directory or configuration differs from its Windows backup")

    try:
        with open(state["backup"], "rb") as raw:
            source = Hashed(raw)
            with tarfile.open(fileobj=source, mode="r|") as archive:
                for member in archive:
                    name = member.name.rstrip("/")
                    if os.path.normpath(name) != name:
                        raise ValueError("The Windows backup holds an unexpected path")
                    for prefix, root, tree, seen in trees:
                        if name == prefix or name.startswith(prefix + "/"):
                            relative = name[len(prefix) + 1:]
                            break
                    else:
                        raise ValueError("The Windows backup holds files outside the PG15 cluster")
                    info = tree.get(relative)
                    if info is None or relative in seen:
                        raise differs()
                    seen.add(relative)
                    if (member.mode & 0o7777, member.uid, member.gid) != (
                        stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid
                    ):
                        raise differs()
                    if member.isdir() and stat.S_ISDIR(info.st_mode):
                        continue
                    if not (member.isreg() and stat.S_ISREG(info.st_mode) and member.size == info.st_size):
                        raise differs()
                    stored = archive.extractfile(member)
                    path = os.path.join(str(root), relative)
                    with open(path, "rb", opener=lambda p, f: os.open(p, f | os.O_NOFOLLOW)) as disk:
                        for block in iter(lambda: stored.read(1024 * 1024), b""):
                            if disk.read(len(block)) != block:
                                raise differs()
                        if disk.read(1):
                            raise differs()
            for _ in iter(lambda: source.read(1024 * 1024), b""):
                pass
    except tarfile.TarError:
        raise ValueError("The Windows backup is damaged") from None
    if "backup_sha256" in state and (source.digest.hexdigest(), source.size) != (
        state["backup_sha256"], state["backup_bytes"]
    ):
        raise ValueError("The Windows backup changed since it was created")
    if any(set(tree) != seen for _, _, tree, seen in trees):
        raise ValueError("The Windows backup does not hold the whole PG15 cluster and configuration")
    return source.digest.hexdigest(), source.size


def removal(state, repair=False):
    """Return the journaled donor removal once its quarantine rename may have happened, else None."""
    record = state.get("donor_removal")
    if record is None:
        return None
    quarantine = Path(record["quarantine"])
    if (
        quarantine != quarantine_path(state)
        or record["stage"] not in ("quarantine", "removing", "removed")
        or not {"inode", "backup_sha256", "backup_bytes"} <= record.keys()
    ):
        raise ValueError("Unrecognized PG15 removal journal")
    if record["stage"] == "removed":
        return record
    if os.path.lexists(quarantine):
        info = os.lstat(quarantine)
        if (
            os.path.lexists(OLD_DATA)
            or not stat.S_ISDIR(info.st_mode)
            or [info.st_dev, info.st_ino] != record["inode"]
        ):
            raise ValueError("The PG15 quarantine does not match the removal journal; nothing was removed")
        return record
    if record["stage"] == "removing":
        return record
    # Journaled but interrupted before the rename: the donor is still intact.
    info = os.lstat(OLD_DATA) if os.path.lexists(OLD_DATA) else None
    if info is None or [info.st_dev, info.st_ino] != record["inode"]:
        raise ValueError("The PG15 data directories do not match the removal journal")
    if repair:
        state.pop("donor_removal")
        phase(state, state["phase"])
    return None


def check_pg17(state):
    if state.get("phase") != "active":
        raise ValueError("PostgreSQL 17 is not the active migrated cluster")
    work = Path(state["work"])
    if work.parent != DATA or not re.fullmatch(r"dwemer-stage-[0-9a-f]{32}", work.name):
        raise ValueError("Unrecognized maintenance identity")
    verify_active(17, NEW_DATA)
    if (
        query("/var/run/postgresql", "select system_identifier from pg_control_system()") != state["candidate_id"]
        or cluster_id(17, NEW_DATA) != state["candidate_id"]
        or (NEW / "dwemer-maintenance-id").read_text().strip() != work.name
        or not (work / "verified.json").is_file()
    ):
        raise ValueError("PostgreSQL 17 does not match the verified migration")


def check_backup(state, record=None):
    archive = Path(state["backup"])
    sidecar = archive.with_suffix(".recovery.json")
    if (
        not str(archive).startswith("/mnt/")
        or archive.is_symlink()
        or not archive.is_file()
        or not sidecar.is_file()
    ):
        raise ValueError("The Windows backup or its recovery JSON is missing")
    mount_type = run(
        "findmnt", "-n", "-o", "FSTYPE", "-T", archive, stdout=subprocess.PIPE, text=True
    ).stdout.strip()
    if mount_type not in ("drvfs", "9p"):
        raise ValueError("The Windows backup is not on a mounted Windows volume")
    meta = json.loads(sidecar.read_text())
    if (
        meta.get("postgres_major"), meta.get("system_identifier"), meta.get("data"), meta.get("config"),
        meta.get("original_start_conf"),
    ) != (15, state["donor_id"], str(OLD_DATA), str(OLD), state["old_start"]):
        raise ValueError("The recovery JSON does not describe this donor")
    size = archive.stat().st_size
    if "backup_sha256" in state and (
        size != state["backup_bytes"] or meta.get("sha256") != state["backup_sha256"]
    ):
        raise ValueError("The Windows backup changed since it was created")
    if record is not None and size != record["backup_bytes"]:
        raise ValueError("The Windows backup changed since it was verified")


def check_removal(state):
    check_pg17(state)
    if OLD_DATA.is_symlink() or not OLD_DATA.is_dir() or Path(os.path.realpath(OLD_DATA)) != OLD_DATA:
        raise ValueError("The PG15 data directory is missing or linked")
    if (OLD_DATA / "PG_VERSION").read_text().strip() != "15":
        raise ValueError("The PG15 data directory holds another PostgreSQL version")
    if (
        (OLD / "start.conf").read_text().strip() != "disabled"
        or (OLD_DATA / "postmaster.pid").exists()
        or running(15, OLD_DATA)
    ):
        raise ValueError("PostgreSQL 15 is not stopped and disabled")
    control = controldata(15, OLD_DATA)
    if (control["Database system identifier"], control["Database cluster state"]) != (state["donor_id"], "shut down"):
        raise ValueError("PostgreSQL 15 is not the cleanly stopped donor recorded for this migration")
    # Bind mounts keep the device number, so consult the mount table as well.
    if mounts_within(OLD_DATA) or os.lstat(OLD_DATA).st_dev != os.lstat(OLD_DATA.parent).st_dev:
        raise ValueError("The PG15 data directory is or contains a mount point")
    owners = []
    for version, name, path in cluster_dirs():
        if path == OLD_DATA or OLD_DATA in path.parents or path in OLD_DATA.parents:
            owners.append((version, name, path))
    if owners != [("15", "main", OLD_DATA)]:
        raise ValueError("Another cluster shares the PG15 data directory, or 15/main uses a different one")
    entries, config = donor_tree(OLD_DATA), config_tree()
    check_backup(state)
    return entries, config


def check_resume(state, record):
    # The journal alone does not prove that PG17 still serves or that the backup is still in place.
    check_pg17(state)
    check_backup(state, record)
    quarantine = Path(record["quarantine"])
    if not os.path.lexists(quarantine):
        return {}
    # Something may have been mounted below the quarantine since the rename, so check again.
    if mounts_within(quarantine) or os.lstat(quarantine).st_dev != os.lstat(quarantine.parent).st_dev:
        raise ValueError("The PG15 quarantine is or contains a mount point; it was kept")
    return donor_tree(quarantine, "PG15 quarantine")


def cleanup_preview():
    state = json.loads(STATE.read_text()) if STATE.exists() else {}
    if state.get("phase") != "active":
        return False, 0, "PostgreSQL 17 is not the active migrated cluster"
    record = removal(state)
    if record is not None:
        if record["stage"] == "removed":
            return False, 0, "The PG15 data directory was already removed"
        return True, allocated_bytes(check_resume(state, record)), "An interrupted PG15 removal will finish"
    entries, _ = check_removal(state)
    return True, allocated_bytes(entries), (
        "Removes only the stopped PG15 data directory after verifying the whole Windows backup again. "
        "This frees space inside the distro filesystem; the Windows VHDX file keeps its size until compacted"
    )


def cleanup_pg15():
    """Remove the verified PG15 donor and return the bytes this call freed."""
    if not STATE.exists():
        raise ValueError("PostgreSQL 17 is not the active migrated cluster")
    state = json.loads(STATE.read_text())
    if state["phase"] != "active":
        raise ValueError("PostgreSQL 17 is not the active migrated cluster")
    record = removal(state, repair=True)
    if record is None:
        entries, config = check_removal(state)
        digest, size = verify_archive(state, entries, config)
        quarantine = quarantine_path(state)
        if os.path.lexists(quarantine):
            raise ValueError("The PG15 quarantine path already exists")
        top = entries[""]
        # Bind every verified archive, including ones written before checksums were journaled, so a
        # resumed removal can prove the backup unchanged without a donor left to compare against.
        record = {
            "stage": "quarantine",
            "quarantine": str(quarantine),
            "inode": [top.st_dev, top.st_ino],
            "bytes": allocated_bytes(entries),
            "backup_sha256": digest,
            "backup_bytes": size,
        }
        # Journal before the rename, so any interruption either resumes or proves the donor intact.
        state["donor_removal"] = record
        phase(state, "active")
        os.rename(OLD_DATA, quarantine)
        sync_dir(OLD_DATA.parent)
        left = entries
    elif record["stage"] == "removed":
        return 0
    else:
        left = check_resume(state, record)
        if file_digest(state["backup"]) != (record["backup_sha256"], record["backup_bytes"]):
            raise ValueError("The Windows backup changed since it was verified")
    if record["stage"] == "quarantine":
        record["stage"] = "removing"
        phase(state, "active")
    quarantine = Path(record["quarantine"])
    if os.path.lexists(quarantine):
        if mounts_within(quarantine) or not shutil.rmtree.avoids_symlink_attacks:
            raise ValueError("The PG15 quarantine cannot be removed safely; it was kept")
        shutil.rmtree(quarantine)
        sync_dir(quarantine.parent)
    record["stage"] = "removed"
    phase(state, "active")
    return allocated_bytes(left)


def lock_distro():
    # Share Core's existing Unix maintenance lock with update.sh and lifecycle operations.
    path = "/run/lock/dwemerdistro-maintenance.lock"
    try:
        fd = os.open(path, os.O_RDONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
        os.fchmod(fd, 0o644)
    except FileExistsError:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    info = os.fstat(fd)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid
        or info.st_nlink != 1
        or stat.S_IMODE(info.st_mode) != 0o644
    ):
        os.close(fd)
        raise ValueError("Invalid distro maintenance lock")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise ValueError("Another distro maintenance operation is running") from None
    return os.fdopen(fd, "rb")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "action", choices=["status", "auto", "upgrade", "rollback", "recover", "cleanup-preview", "cleanup-pg15"]
    )
    parser.add_argument("backup", nargs="?", type=Path)
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error("root required")
    os.umask(0o077)
    # Every update calls recover while other maintenance may hold the shared lock; skip settled journals.
    if args.action == "recover" and settled():
        sys.exit(0)

    def interrupted(signum, frame):
        raise KeyboardInterrupt("maintenance interrupted")

    # Closing the launcher must run the PG15 recovery path rather than leave it fenced.
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (ROOT / "lock").open("a") as lock, (ROOT / "maintenance.log").open("ab") as log:
        try:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise ValueError("Another PostgreSQL maintenance operation is running") from None
            with lock_distro():
                if args.action == "status":
                    print(automatic_status())
                elif args.action == "auto":
                    automatic_upgrade(args.backup)
                elif args.action == "upgrade":
                    upgrade(args.backup)
                elif args.action == "recover":
                    recover()
                elif args.action == "cleanup-preview":
                    eligible, size, reason = cleanup_preview()
                    print(json.dumps({"eligible": eligible, "bytes": size, "reason": reason}))
                elif args.action == "cleanup-pg15":
                    print(json.dumps({"freed_bytes": cleanup_pg15()}))
                else:
                    rollback()
                    state = json.loads(STATE.read_text())
                    state.pop("retry_auto", None)
                    phase(state, "rolled-back")
        except Exception as error:
            if args.action == "cleanup-preview":
                print(json.dumps({"eligible": False, "bytes": 0, "reason": str(error)}))
                sys.exit(0)
            print(f"Maintenance stopped: {error}. See {ROOT}/maintenance.log", file=sys.stderr)
            sys.exit(1)
