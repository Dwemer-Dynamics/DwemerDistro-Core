#!/usr/bin/env python3
"""Root-only prepared file changes for DwemerDistro servers, run through `ddistro changes`.

stdout is exactly one JSON document {"schema_version", "ok", "data", "error"} whose error
code and process exit code follow bin/ddistro; stderr carries short progress lines. Task
state is root-only under STATE_ROOT. The workspace holds copies of explicitly selected text
files owned by the agent account. Nothing here runs repository code or hooks as root.
See ASSISTANT.md for the command contract.

Schema 1 tasks edit one product from PRODUCT_ROOTS and keep their original code path. Schema 2
tasks (checkout, rollback-preview, undo) edit files from several roots, but only roots the
code-owned access policy (ddistro_access) marks change: True; this file holds no v2 root paths.
"""
import contextlib
import difflib
import errno
import fcntl
import grp
import hashlib
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import time
import uuid
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

SCHEMA_VERSION = 1
STATE_ROOT = "/var/lib/dwemerdistro/assistant/tasks"
MAINTENANCE_LOCK = "/run/lock/dwemerdistro-maintenance.lock"
CLI_PATH = "/usr/local/bin/ddistro"  # foundation sanitizer, status, and log reader
ACCESS_PATH = "/usr/local/bin/ddistro_access"  # code-owned root policy; the only source of v2 change roots
PHP = "/usr/bin/php"
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Only HerikaServer is editable so far; other products are refused rather than guessed.
PRODUCT_ROOTS = {"herika": "/var/www/html/HerikaServer"}
KNOWN_PRODUCTS = ("herika", "lorkhan", "stobe", "dialectic", "reign")
ALIASES = {"chim": "herika", "skyrim": "herika", "kenshi": "stobe", "fnv": "dialectic", "ttw": "dialectic"}
SCRATCH_USERS = ("ddagent", "dwemer")
AGENT_USER = "ddagent"  # assistant runtime account; its group may search task folders (ASSISTANT_RUNTIME.md)
TRAVERSE_MODE = 0o710
LINT_USER = "nobody"
MAX_FILE_BYTES = 1024 * 1024
MAX_FILES = 200
MAX_BATCH_BYTES = 8 * 1024 * 1024
MAX_PATH_CHARS = 512
MAX_STATE_BYTES = 4 * 1024 * 1024
DIFF_LIMIT = 8 * 1024 * 1024  # bytes of the JSON-encoded diff string
LINT_TIMEOUT = 30
LIST_LIMIT = 200
CONTEXT_DIR = ".ddistro-context"
TASK_V2 = 2
ROOT_ID = re.compile(r"^[a-z][a-z0-9]{0,31}\Z")
# v2 edits are limited to source and plain-text types; config-like names are refused even when a root allows changes.
EDIT_NAME = re.compile(r"(?i)^[^.].*\.(php|py|js|mjs|cjs|ts|css|html?|md|txt|json|xml|csv|sh|lua|sql)\Z")
CONFIG_NAME = re.compile(r"(?i)^((config|configuration|settings|conf|secrets?)(\..*)?|.*\.(ini|cfg|conf|toml|ya?ml|env|properties))\Z")

ERRORS = {"failed": 1, "internal_error": 1, "partial": 10, "conflict": 11, "rollback": 12,
          "invalid_argument": 64, "not_found": 66, "unsupported": 69, "busy": 75,
          "permission_denied": 77, "unsafe_path": 77}
TASK_ID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\Z")
SHA256 = re.compile(r"^[0-9a-f]{64}\Z")
PATH_PART = re.compile(r"^[A-Za-z0-9._@+=,-][A-Za-z0-9._@+=, -]{0,254}\Z")
CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")

# Never selectable, even explicitly: Git metadata, runtime data, and likely credential files.
EXCLUDED_PARTS = {".git", "log", "logs", "cache", "caches", "soundcache", "uploads", "voices", "tmp"}
SECRET_NAME = re.compile(r"(?i)^(\.env(\..*)?|.*\.env|\.htpasswd|\.netrc|\.pgpass|id_(rsa|dsa|ecdsa|ed25519).*"
                         r"|.*\.(pem|key|p12|pfx|crt|kdbx|sqlite3?|db)|.*(secret|credential|passw|token|api_?key).*)\Z")
PRODUCT_EXCLUDES = {"herika": re.compile(r"^(conf/conf\.php|conf/conf_(?!loader\.php\Z|schema\.php\Z).*"
                                         r"|conf/character_map\.json|data/CurrentModel_.*|data/pictures/gallery/.*)\Z")}

NOFOLLOW = os.O_NOFOLLOW | os.O_CLOEXEC
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | NOFOLLOW


class ChangeError(Exception):
    def __init__(self, code, message, details=None):
        super().__init__(message)
        self.code, self.message, self.details = code, message, details or {}


def progress(message):
    print("[INFO] " + message[:300], file=sys.stderr, flush=True)


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def digest(data):
    return hashlib.sha256(data).hexdigest()


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()


def write_all(fd, data):
    view = memoryview(data)
    while view:
        view = view[os.write(fd, view):]


def read_fd(fd, limit):
    chunks, size = [], 0
    while size <= limit:
        chunk = os.read(fd, min(65536, limit + 1 - size))
        if not chunk:
            break
        chunks.append(chunk)
        size += len(chunk)
    return b"".join(chunks)


def link_error(error, path):
    if error.errno in (errno.ELOOP, errno.ENOTDIR, errno.EMLINK):
        return ChangeError("unsafe_path", f"{path} goes through a symbolic link or non-folder; it was not used.",
                           {"path": path, "reason": "link"})
    return ChangeError("failed", f"{path} could not be opened.",
                       {"path": path, "reason": errno.errorcode.get(error.errno, "error")})


# --- Root-only state ------------------------------------------------------------------

def check_state_dir(info, path):
    sticky_root = info.st_uid == 0 and info.st_mode & stat.S_ISVTX
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or (info.st_mode & 0o022 and not sticky_root):
        raise ChangeError("unsafe_path", f"{path} is not a root-owned folder only root can change.",
                          {"path": path, "reason": "untrusted"})


def agent_gid():
    """ddagent's group when it is dedicated: named ddagent, no members, nobody else's primary group."""
    try:
        entry = pwd.getpwnam(AGENT_USER)
        group = grp.getgrgid(entry.pw_gid)
    except KeyError:
        return None
    if entry.pw_gid == 0 or group.gr_name != AGENT_USER or group.gr_mem or any(
            other.pw_gid == entry.pw_gid and other.pw_name != AGENT_USER for other in pwd.getpwall()):
        return None
    return entry.pw_gid


def private_dir(info):
    """Root-only, or root:ddagent 0710 so the runtime's sandbox can reach work/ without listing anything."""
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0:
        return False
    mode = stat.S_IMODE(info.st_mode)
    return not mode & 0o077 or (mode == TRAVERSE_MODE and info.st_gid == agent_gid())


def ensure_state_root(create):
    """Walk STATE_ROOT from / without following links; create missing parts root-only."""
    current = "/"
    parts = STATE_ROOT.strip("/").split("/")
    for index, part in enumerate(parts):
        current = os.path.join(current, part)
        try:
            info = os.lstat(current)
        except FileNotFoundError:
            if not create:
                raise ChangeError("not_found", "No ddistro changes tasks exist yet.", {"path": STATE_ROOT})
            os.mkdir(current, 0o700)
            fd = os.open(current, DIR_FLAGS)
            try:
                os.fchown(fd, 0, 0)
                os.fchmod(fd, 0o700 if index == len(parts) - 1 else 0o755)
            finally:
                os.close(fd)
            info = os.lstat(current)
        check_state_dir(info, current)
    if not private_dir(info):
        raise ChangeError("unsafe_path", f"{STATE_ROOT} is not a private root-owned folder.",
                          {"path": STATE_ROOT, "reason": "untrusted"})


def fsync_dir(path):
    fd = os.open(path, DIR_FLAGS)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_state(path, data, exclusive=False):
    """Atomic fsynced 0600 write; exclusive never replaces an existing fact."""
    directory, name = os.path.split(path)
    tmp = os.path.join(directory, f".{name}.{uuid.uuid4().hex}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600)
    try:
        write_all(fd, data)
        os.fchmod(fd, 0o600)
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        if exclusive:
            os.link(tmp, path)
        else:
            os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
    fsync_dir(directory)


def make_state_dir(path):
    os.mkdir(path, 0o700)
    fd = os.open(path, DIR_FLAGS)
    try:
        os.fchown(fd, 0, 0)
        os.fchmod(fd, 0o700)
    finally:
        os.close(fd)
    fsync_dir(os.path.dirname(path))


def read_state(path, limit=MAX_STATE_BYTES):
    fd = os.open(path, os.O_RDONLY | NOFOLLOW)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
            raise ChangeError("unsafe_path", "Task state is not a root-owned plain file.", {"path": path})
        data = read_fd(fd, limit)
    finally:
        os.close(fd)
    if len(data) > limit:
        raise ChangeError("failed", "Task state is larger than expected.", {"path": path})
    return data


def read_json_state(path):
    try:
        return json.loads(read_state(path).decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        raise ChangeError("failed", "Task state is not valid JSON.", {"path": path, "reason": "state_integrity"})


def optional_json(path):
    try:
        return read_json_state(path)
    except FileNotFoundError:
        return None


def task_dir(task_id):
    if type(task_id) is not str or not TASK_ID.match(task_id):
        raise ChangeError("invalid_argument", "TASK must be a lowercase task UUID from ddistro changes prepare.")
    ensure_state_root(create=False)
    path = os.path.join(STATE_ROOT, task_id)
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        raise ChangeError("not_found", "No ddistro changes task has that ID.", {"task_id": task_id})
    if not private_dir(info):
        raise ChangeError("unsafe_path", "The task folder is not root-only.", {"task_id": task_id})
    return path


def load_task(path):
    try:
        task = read_json_state(os.path.join(path, "task.json"))
    except FileNotFoundError:
        raise ChangeError("failed", "The task was never completely prepared; prepare a new task.",
                          {"reason": "incomplete"})
    if type(task) is not dict or task.get("schema_version") != 1 or task.get("task_id") != os.path.basename(path) \
            or task.get("product") not in PRODUCT_ROOTS or type(task.get("paths")) is not list:
        raise ChangeError("failed", "task.json is not a valid schema 1 task.", {"reason": "state_integrity"})
    return task


@contextlib.contextmanager
def task_lock(path):
    fd = os.open(os.path.join(path, "lock"), os.O_RDWR | os.O_CREAT | NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ChangeError("busy", "Another ddistro changes command is using this task.")
        yield
    finally:
        os.close(fd)


def task_busy(path):
    try:
        fd = os.open(os.path.join(path, "lock"), os.O_RDONLY | NOFOLLOW)
    except FileNotFoundError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        return False
    except BlockingIOError:
        return True
    finally:
        os.close(fd)


@contextlib.contextmanager
def maintenance_exclusive():
    """Hold the fixed root-owned maintenance lock exclusively; maintenance scripts hold it shared."""
    try:
        fd = os.open(MAINTENANCE_LOCK, os.O_RDONLY | os.O_CREAT | NOFOLLOW, 0o644)
    except OSError as error:
        raise ChangeError("unsafe_path", f"{MAINTENANCE_LOCK} could not be opened safely; it was not replaced.",
                          {"path": MAINTENANCE_LOCK, "reason": errno.errorcode.get(error.errno, "error")})
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
            raise ChangeError("unsafe_path", f"{MAINTENANCE_LOCK} is not a root-owned plain file; it was not replaced. "
                              "Restart DwemerDistro so it can be recreated.", {"path": MAINTENANCE_LOCK})
        if stat.S_IMODE(info.st_mode) != 0o644:
            os.fchmod(fd, 0o644)  # same inode; unprivileged maintenance opens it read-only
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ChangeError("busy", "A DwemerDistro update, repair, or other change is running. "
                              "Try again when it finishes.")
        yield
    finally:
        os.close(fd)


# --- Product files --------------------------------------------------------------------

def normalize_path(raw, product):
    if len(raw) > MAX_PATH_CHARS or raw.startswith("/") or "\\" in raw:
        raise ChangeError("invalid_argument", "Each --path must be a relative file path inside the product.")
    parts = raw.split("/")
    if any(part in ("", ".", "..") or not PATH_PART.match(part) for part in parts):
        raise ChangeError("invalid_argument", "Each --path must be a plain relative path without . or .. parts.",
                          {"path": CONTROL.sub("?", raw)})
    rel = "/".join(parts)
    if parts[0] == CONTEXT_DIR:
        reason = "this name is reserved for workspace diagnostics"
    elif any(part.lower() in EXCLUDED_PARTS for part in parts):
        reason = "Git metadata, logs, caches, uploads, and voice files are never edited here"
    elif SECRET_NAME.match(parts[-1]) or (product in PRODUCT_EXCLUDES and PRODUCT_EXCLUDES[product].match(rel)):
        reason = "it may hold credentials or user configuration; edit it directly if you must"
    else:
        return rel
    raise ChangeError("invalid_argument", f"{rel} cannot be selected: {reason}.", {"path": rel, "reason": "excluded"})


def check_text(data, rel):
    if b"\0" in data:
        raise ChangeError("invalid_argument", f"{rel} is binary; only UTF-8 text files can be changed.", {"path": rel})
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        raise ChangeError("invalid_argument", f"{rel} is not UTF-8 text.", {"path": rel})


def check_product_dir(info, owner, path):
    if not stat.S_ISDIR(info.st_mode) or info.st_uid not in (0, owner) or info.st_mode & 0o002:
        raise ChangeError("unsafe_path", f"{path} is not a trusted product folder.", {"path": path})


def open_product_root(product, root=None):
    """Open the product root (or a v2 policy root) from / without following links; returns (fd, owner uid)."""
    root = root or PRODUCT_ROOTS[product]
    fd, infos = os.open("/", DIR_FLAGS), []
    try:
        for part in root.strip("/").split("/"):
            try:
                child = os.open(part, DIR_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                raise ChangeError("not_found", f"{product} is not installed at {root}. Install it from the launcher "
                                  "first.", {"product": product, "root": root})
            except OSError as error:
                raise link_error(error, root)
            os.close(fd)
            fd = child
            infos.append(os.fstat(fd))
        owner = infos[-1].st_uid
        for info in infos[:-1]:
            if not stat.S_ISDIR(info.st_mode) or info.st_uid not in (0, owner) \
                    or (info.st_mode & 0o022 and not (info.st_uid == 0 and info.st_mode & stat.S_ISVTX)):
                raise ChangeError("unsafe_path", f"A folder above {root} can be changed by other users.",
                                  {"root": root})
        check_product_dir(infos[-1], owner, root)
        return fd, owner
    except BaseException:
        os.close(fd)
        raise


def open_parent(root_fd, rel, owner):
    """Open the existing trusted parent folder of rel without following links."""
    fd = os.dup(root_fd)
    try:
        for part in rel.split("/")[:-1]:
            try:
                child = os.open(part, DIR_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                raise ChangeError("invalid_argument", f"The folder for {rel} does not exist; new files can only be "
                                  "created in existing folders.", {"path": rel, "reason": "parent_missing"})
            except OSError as error:
                raise link_error(error, rel)
            os.close(fd)
            fd = child
            check_product_dir(os.fstat(fd), owner, rel)
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_file(dir_fd, name, rel, owner_uid=None):
    """Read one regular, single-link text file without following links; (None, None) if absent."""
    try:
        info = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None, None
    if stat.S_ISLNK(info.st_mode):
        raise ChangeError("unsafe_path", f"{rel} is a symbolic link; links are never followed.", {"path": rel})
    if not stat.S_ISREG(info.st_mode):
        raise ChangeError("invalid_argument", f"{rel} is not a regular file; select files, not folders.",
                          {"path": rel})
    if info.st_nlink != 1 or info.st_mode & 0o7000 or (owner_uid is not None and info.st_uid != owner_uid):
        raise ChangeError("unsafe_path", f"{rel} is hard-linked, has special mode bits, or has an unexpected owner.",
                          {"path": rel})
    if info.st_size > MAX_FILE_BYTES:
        raise ChangeError("invalid_argument", f"{rel} is larger than {MAX_FILE_BYTES} bytes.", {"path": rel})
    fd = os.open(name, os.O_RDONLY | os.O_NONBLOCK | NOFOLLOW, dir_fd=dir_fd)
    try:
        opened = os.fstat(fd)
        if (opened.st_ino, opened.st_dev) != (info.st_ino, info.st_dev):
            raise ChangeError("conflict", f"{rel} changed while it was being read.", {"path": rel})
        data = read_fd(fd, MAX_FILE_BYTES)
    finally:
        os.close(fd)
    if len(data) > MAX_FILE_BYTES:
        raise ChangeError("invalid_argument", f"{rel} is larger than {MAX_FILE_BYTES} bytes.", {"path": rel})
    check_text(data, rel)
    return data, opened


def file_meta(info):
    return {"uid": info.st_uid, "gid": info.st_gid, "mode": stat.S_IMODE(info.st_mode)}


def mismatch(data, info, expect):
    """Why a live file differs from the expected {"sha256", "meta"} state, or None."""
    if expect["sha256"] is None:
        return None if data is None else "exists"
    if data is None:
        return "missing"
    if digest(data) != expect["sha256"]:
        return "changed"
    if file_meta(info) != expect["meta"]:
        return "metadata"
    return None


def live_file(root_fd, owner, rel):
    parent = open_parent(root_fd, rel, owner)
    try:
        return read_file(parent, rel.rsplit("/", 1)[-1], rel)
    finally:
        os.close(parent)


def replace_file(root_fd, owner, rel, expect, data, meta):
    """Recheck one live file, then atomically write data (or delete it when data is None).

    New files take the parent's owner and group with a non-executable mode. Returns the
    metadata written, or None for a delete."""
    parent = open_parent(root_fd, rel, owner)
    name = rel.rsplit("/", 1)[-1]
    try:
        current, info = read_file(parent, name, rel)
        reason = mismatch(current, info, expect)
        if reason:
            raise ChangeError("conflict", f"{rel} changed before it could be written ({reason}).",
                              {"path": rel, "reason": reason})
        if data is None:
            os.unlink(name, dir_fd=parent)
            os.fsync(parent)
            return None
        if meta is None:
            folder = os.fstat(parent)
            meta = {"uid": folder.st_uid, "gid": folder.st_gid, "mode": 0o664 if folder.st_mode & 0o020 else 0o644}
        tmp = f".ddistro-{uuid.uuid4().hex[:16]}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600, dir_fd=parent)
        try:
            write_all(fd, data)
            os.fchown(fd, meta["uid"], meta["gid"])
            os.fchmod(fd, meta["mode"])
            os.fsync(fd)
            written = os.fstat(fd)
            if expect["sha256"] is None:
                os.link(tmp, name, src_dir_fd=parent, dst_dir_fd=parent, follow_symlinks=False)
            else:
                os.rename(tmp, name, src_dir_fd=parent, dst_dir_fd=parent)
        finally:
            os.close(fd)
            with contextlib.suppress(FileNotFoundError):
                os.unlink(tmp, dir_fd=parent)
        landed = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if (landed.st_ino, landed.st_dev) != (written.st_ino, written.st_dev):
            raise ChangeError("failed", f"{rel} was replaced by another process while it was written.", {"path": rel})
        os.fsync(parent)
        return meta
    finally:
        os.close(parent)


# --- Workspace ------------------------------------------------------------------------

def scratch_account():
    for name in SCRATCH_USERS:
        try:
            entry = pwd.getpwnam(name)
        except KeyError:
            continue
        return name, entry.pw_uid, entry.pw_gid
    raise ChangeError("unsupported", "Neither the ddagent nor the dwemer account exists for the workspace.")


def scratch_parent(work_fd, rel, uid, gid):
    """Open, creating as the workspace owner, the workspace folder that holds rel; never follows links."""
    fd = os.dup(work_fd)
    try:
        for part in rel.split("/")[:-1]:
            created = False
            with contextlib.suppress(FileExistsError):
                os.mkdir(part, 0o700, dir_fd=fd)
                created = True
            child = os.open(part, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = child
            if created:
                os.fchown(fd, uid, gid)
                os.fchmod(fd, 0o700)
        return fd
    except BaseException:
        os.close(fd)
        raise


def scratch_write(work_fd, rel, data, uid, gid):
    parts, fd = rel.split("/"), scratch_parent(work_fd, rel, uid, gid)
    try:
        out =os.open(parts[-1], os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600, dir_fd=fd)
        try:
            write_all(out, data)
            os.fchown(out, uid, gid)
            os.fchmod(out, 0o600)
        finally:
            os.close(out)
    finally:
        os.close(fd)


def scratch_read(work_fd, rel, uid):
    """Edited bytes from the workspace, or None when the file (or its folder) was removed."""
    parts, fd = rel.split("/"), os.dup(work_fd)
    try:
        for part in parts[:-1]:
            try:
                child = os.open(part, DIR_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                return None
            except OSError as error:
                raise link_error(error, "workspace " + rel)
            os.close(fd)
            fd = child
        return read_file(fd, parts[-1], rel, owner_uid=uid)[0]
    finally:
        os.close(fd)


def open_work(path, task):
    work = os.path.join(path, "work")
    try:
        fd = os.open(work, DIR_FLAGS)
    except OSError as error:
        raise link_error(error, work)
    info = os.fstat(fd)
    if info.st_uid != task["scratch_uid"]:
        os.close(fd)
        raise ChangeError("unsafe_path", "The workspace folder has an unexpected owner.", {"workspace": work})
    return fd


def load_trusted(name, path):
    """Load a root-controlled helper module (the ddistro CLI or the access policy) after checking ownership."""
    info, parent = os.lstat(path), os.stat(os.path.dirname(path))
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 \
            or parent.st_uid != 0 or parent.st_mode & 0o022:
        raise ChangeError("unsupported", f"{os.path.basename(path)} is not a trusted root-owned file.")
    spec = spec_from_loader(name, SourceFileLoader(name, path))
    module = module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def diagnostics(product):
    """Sanitized status and recent log lines for a task with no selected files."""
    try:
        cli = load_trusted("ddistro_cli", CLI_PATH)
    except (ChangeError, OSError, SyntaxError):
        return {"status.json": canonical({"available": False, "reason": "ddistro unavailable"})}
    files = {}
    try:
        record = cli.helper_status(product)[0]
        keep = ("product", "state", "repository_state", "database_present", "branch", "version")
        files["status.json"] = canonical({key: record[key] for key in keep})
    except cli.CliError as error:
        files["status.json"] = canonical({"available": False, "reason": error.code})
    try:
        data, _ = cli.cmd_logs({"target": product, "lines": 100}, {})
        files["recent.log"] = ("\n".join(data["lines"]) + "\n").encode("utf-8")
    except cli.CliError as error:
        files["recent.log"] = f"log unavailable: {error.code}\n".encode()
    return files


# --- Commands -------------------------------------------------------------------------

def cmd_prepare(opts):
    product = opts["product"]
    if product not in PRODUCT_ROOTS:
        raise ChangeError("unsupported", f"File changes are available only for {', '.join(PRODUCT_ROOTS)} so far.",
                          {"product": product})
    rels = list(dict.fromkeys(normalize_path(raw, product) for raw in opts["paths"]))
    if len(rels) > MAX_FILES:
        raise ChangeError("invalid_argument", f"At most {MAX_FILES} files can be selected.")
    account, uid, gid = scratch_account()
    # A chat-only workspace works before any game server is installed. Live file
    # selection still requires the same trusted product root and ownership checks.
    root_fd, owner = open_product_root(product) if rels else (None, None)
    records, contents, total = [], {}, 0
    try:
        for rel in rels:
            data, info = live_file(root_fd, owner, rel)
            record = {"path": rel, "exists": data is not None, "sha256": None, "meta": None, "size": 0, "ino": None}
            if data is not None:
                total += len(data)
                record.update(sha256=digest(data), meta=file_meta(info), size=len(data), ino=info.st_ino)
                contents[rel] = data
            records.append(record)
    finally:
        if root_fd is not None:
            os.close(root_fd)
    if total > MAX_BATCH_BYTES:
        raise ChangeError("invalid_argument", f"The selected files exceed {MAX_BATCH_BYTES} bytes together.")
    ensure_state_root(create=True)
    task_id = str(uuid.uuid4())
    path = os.path.join(STATE_ROOT, task_id)
    make_state_dir(path)
    make_state_dir(os.path.join(path, "base"))
    for data in contents.values():
        with contextlib.suppress(FileExistsError):
            write_state(os.path.join(path, "base", digest(data)), data, exclusive=True)
    work = os.path.join(path, "work")
    os.mkdir(work, 0o700)
    work_fd = os.open(work, DIR_FLAGS)
    try:
        os.fchown(work_fd, uid, gid)
        os.fchmod(work_fd, 0o700)
        for rel, data in contents.items():
            scratch_write(work_fd, rel, data, uid, gid)
        if not rels:
            progress("No paths selected; preparing a diagnostic-only workspace.")
            for name, data in diagnostics(product).items():
                scratch_write(work_fd, f"{CONTEXT_DIR}/{name}", data, uid, gid)
    finally:
        os.close(work_fd)
    task = {"schema_version": SCHEMA_VERSION, "task_id": task_id, "product": product, "workspace": work,
            "product_root": PRODUCT_ROOTS[product], "created": now(), "scratch_user": account,
            "scratch_uid": uid, "scratch_gid": gid, "diagnostic_only": not rels, "paths": records}
    write_state(os.path.join(path, "task.json"), json.dumps(task, indent=1, sort_keys=True).encode(), exclusive=True)
    gid = agent_gid() if account == AGENT_USER else None
    if gid is not None:
        # Search only, so the runtime can bind work/; task.json, base/ and later state stay root-only.
        fd = os.open(path, DIR_FLAGS)
        try:
            os.fchown(fd, 0, gid)
            os.fchmod(fd, TRAVERSE_MODE)
        finally:
            os.close(fd)
    progress(f"Prepared task {task_id} with {len(rels)} selected files.")
    return {"task_id": task_id, "workspace": work, "product": product, "diagnostic_only": not rels,
            "scratch_user": account, "files": [{"path": r["path"], "exists": r["exists"]} for r in records]}


def text_lines(data):
    return data.decode("utf-8").splitlines(keepends=True) if data is not None else []


def build_manifest(path, task):
    """Compare workspace bytes with the prepared baseline; returns (manifest, blobs, diff)."""
    work_fd = open_work(path, task)
    files, blobs, chunks, total = [], {}, [], 0
    try:
        for record in task["paths"]:
            rel = record["path"]
            new = scratch_read(work_fd, rel, task["scratch_uid"])
            if (new is None and not record["exists"]) or (new is not None and digest(new) == record["sha256"]):
                continue
            base = read_state(os.path.join(path, "base", record["sha256"])) if record["exists"] else None
            if base is not None and digest(base) != record["sha256"]:
                raise ChangeError("failed", "A prepared baseline copy was altered.", {"reason": "state_integrity"})
            if new is None:
                action = "delete"
            else:
                action = "modify" if record["exists"] else "create"
                total += len(new)
                blobs[digest(new)] = new
            files.append({"path": rel, "action": action, "base_sha256": record["sha256"], "base_meta": record["meta"],
                          "new_sha256": digest(new) if new is not None else None})
            chunks.extend(difflib.unified_diff(text_lines(base), text_lines(new),
                                               "a/" + rel if base is not None else "/dev/null",
                                               "b/" + rel if new is not None else "/dev/null"))
            if chunks and not chunks[-1].endswith("\n"):
                chunks[-1] += "\n\\ No newline at end of file\n"
    finally:
        os.close(work_fd)
    if total > MAX_BATCH_BYTES:
        raise ChangeError("invalid_argument", f"The edited files exceed {MAX_BATCH_BYTES} bytes together.")
    manifest = {"schema_version": SCHEMA_VERSION, "task_id": task["task_id"], "product": task["product"],
                "product_root": task["product_root"], "files": files}
    return manifest, blobs, "".join(chunks)


def change_summary(task_id, manifest, diff):
    """diff_truncated is true only for a diff preview; stage refuses rather than freeze an unreviewable diff."""
    size, cut = len(json.dumps(diff)), len(diff)
    while len(json.dumps(diff[:cut])) > DIFF_LIMIT:
        cut = cut * DIFF_LIMIT // size * 9 // 10
    return {"task_id": task_id, "manifest_sha256": digest(canonical(manifest)),
            "diff": diff[:cut], "diff_truncated": cut < len(diff),
            "files": [{key: entry[key] for key in ("path", "action", "base_sha256", "new_sha256")}
                      for entry in manifest["files"]]}


def lint(manifest, blobs):
    """JSON parse and php -n -l on the frozen bytes, unprivileged; never repository tests or hooks."""
    errors, warnings = [], []
    try:
        lint_user = pwd.getpwnam(LINT_USER)
    except KeyError:
        lint_user = None
    for entry in manifest["files"]:
        if entry["new_sha256"] is None:
            continue
        data, rel = blobs[entry["new_sha256"]], entry.get("scratch", entry["path"])
        if rel.endswith(".json"):
            try:
                json.loads(data.decode("utf-8"))
            except ValueError as error:
                errors.append({"path": rel, "message": f"JSON: {error}"[:300]})
        elif rel.endswith(".php"):
            if lint_user is None or not os.access(PHP, os.X_OK):
                warnings.append(f"PHP syntax was not checked for {rel}: php or the {LINT_USER} account is missing.")
                continue
            try:
                done = subprocess.run([PHP, "-n", "-l"], input=data, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                      env={"PATH": SAFE_PATH, "LANG": "C.UTF-8"}, cwd="/", timeout=LINT_TIMEOUT,
                                      user=lint_user.pw_uid, group=lint_user.pw_gid, extra_groups=[])
            except subprocess.TimeoutExpired:
                errors.append({"path": rel, "message": "PHP syntax check timed out."})
                continue
            if done.returncode != 0:
                lines = [CONTROL.sub("?", line)[:300] for line in done.stdout.decode("utf-8", "replace").splitlines()
                         if line.strip()][:3]
                errors.append({"path": rel, "message": " ".join(lines) or "PHP syntax check failed."})
    return errors, warnings


def load_stage(stage, manifest_sha256, task_id):
    try:
        raw = read_state(os.path.join(stage, "manifest.json"))
    except FileNotFoundError:
        raise ChangeError("invalid_argument", "No staged manifest has that hash; run ddistro changes stage first.")
    if digest(raw) != manifest_sha256:
        raise ChangeError("failed", "The staged manifest was altered; nothing was applied.",
                          {"reason": "stage_integrity"})
    manifest = json.loads(raw.decode("utf-8"))
    if manifest.get("task_id") != task_id or type(manifest.get("files")) is not list:
        raise ChangeError("failed", "The staged manifest belongs to another task.", {"reason": "stage_integrity"})
    blobs = {}
    for entry in manifest["files"]:
        sha = entry["new_sha256"]
        if sha is not None:
            blobs[sha] = read_state(os.path.join(stage, "blobs", sha), MAX_FILE_BYTES)
            if digest(blobs[sha]) != sha:
                raise ChangeError("failed", f"Staged bytes for {entry['path']} were altered; nothing was applied.",
                                  {"reason": "stage_integrity", "path": entry["path"]})
    return manifest, blobs


def freeze_stage(stages, manifest_sha256, manifest, blobs, task_id):
    """Store a manifest and its bytes root-only under stages/<sha> and lint the stored copy; returns warnings."""
    with contextlib.suppress(FileExistsError):
        make_state_dir(stages)
    final = os.path.join(stages, manifest_sha256)
    if os.path.lexists(final):
        manifest, frozen = load_stage(final, manifest_sha256, task_id)
        errors, warnings = lint(manifest, frozen)
        if errors:
            raise ChangeError("failed", "Validation now fails for this already staged batch; do not apply it.",
                              {"reason": "validation", "errors": errors})
        return warnings
    tmp = os.path.join(stages, ".tmp-" + uuid.uuid4().hex)
    make_state_dir(tmp)
    try:
        make_state_dir(os.path.join(tmp, "blobs"))
        for sha, data in blobs.items():
            write_state(os.path.join(tmp, "blobs", sha), data)
        write_state(os.path.join(tmp, "manifest.json"), canonical(manifest))
        # Validate the bytes read back from root-only storage, not the editable workspace.
        manifest, frozen = load_stage(tmp, manifest_sha256, task_id)
        errors, warnings = lint(manifest, frozen)
        if errors:
            raise ChangeError("failed", "Validation failed; nothing was staged.",
                              {"reason": "validation", "errors": errors})
        os.rename(tmp, final)
        fsync_dir(stages)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return warnings


def cmd_diff(opts):
    path = task_dir(opts["task_id"])
    task = read_task(path)
    if task["schema_version"] == TASK_V2:
        return diff_v2(path, task)
    manifest, _, diff = build_manifest(path, task)
    return dict(change_summary(task["task_id"], manifest, diff), state=derive_state(path)[0])


def cmd_stage(opts):
    path = task_dir(opts["task_id"])
    task = read_task(path)
    if task["schema_version"] == TASK_V2:
        return stage_v2(path)
    with task_lock(path):
        if os.path.lexists(os.path.join(path, "apply")):
            raise ChangeError("conflict", "This task was already applied; prepare a new task for more changes.")
        manifest, blobs, diff = build_manifest(path, task)
        summary = change_summary(task["task_id"], manifest, diff)
        if summary["diff_truncated"]:
            raise ChangeError("invalid_argument", f"The diff exceeds {DIFF_LIMIT} bytes and cannot be reviewed in "
                              "full; nothing was staged. Split the change into smaller tasks.",
                              {"reason": "diff_too_large", "diff_limit": DIFF_LIMIT})
        warnings = freeze_stage(os.path.join(path, "stages"), summary["manifest_sha256"], manifest, blobs,
                                task["task_id"])
    progress(f"Staged {len(summary['files'])} changed files as {summary['manifest_sha256']}.")
    return dict(summary, warnings=warnings, state="staged")


def apply_result(task_id, receipt, replayed=False):
    return {"task_id": task_id, "state": receipt["state"], "receipt": receipt, "files": receipt["files"],
            "replayed": replayed}


def journal_files(path, kind):
    """Per-file states from an apply or rollback journal that has no receipt."""
    states = {}
    try:
        lines = read_state(os.path.join(path, kind, "journal.jsonl")).decode("utf-8", "replace").splitlines()
    except FileNotFoundError:
        lines = []
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            continue  # torn final write
        if event.get("event") in ("intent", "done", "failed"):
            states[event["path"]] = {"intent": "unknown", "done": "written", "failed": "failed"}[event["event"]]
    return [{"path": rel, "state": state} for rel, state in states.items()]


def open_targets(task, plan):
    """Open each live root a plan touches once: the v1 product root (key None) or v2 policy roots, rechecked now."""
    opened = {}
    try:
        for step in plan:
            key = step.get("root")
            if key not in opened:
                if key is None:
                    opened[key] = open_product_root(task["product"])
                else:
                    opened[key] = open_product_root(key, change_spec(key, step["root_path"])[1]["path"])
    except BaseException:
        for fd, _ in opened.values():
            os.close(fd)
        raise
    return opened


def run_writes(path, kind, task, manifest_sha256, plan, directory=None, extra=None):
    """Write each planned file with an fsynced intent/done journal and record one immutable receipt."""
    directory = directory or os.path.join(path, kind)
    journal =os.open(os.path.join(directory, "journal.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_EXCL
                      | NOFOLLOW, 0o600)

    def record(**event):
        write_all(journal, canonical(dict(event, at=now())) + b"\n")
        os.fsync(journal)

    started, files, failure = now(), [], None
    roots = open_targets(task, plan)
    try:
        record(event="begin", manifest_sha256=manifest_sha256)
        for step in plan:
            entry = {key: step[key] for key in ("path", "action", "base_sha256", "new_sha256")}
            entry.update((key, step[key]) for key in ("root", "scratch", "new_size") if key in step)
            root_fd, owner = roots[step.get("root")]
            if failure:
                files.append(dict(entry, state="pending"))
                continue
            label = step.get("scratch", step["path"])  # v2 journals name root/path
            record(event="intent", path=label, action=step["action"])
            try:
                meta = replace_file(root_fd, owner, step["path"], step["expect"], step["data"], step["meta"])
            except (ChangeError, OSError) as error:
                failure = error
                reason = error.message if isinstance(error, ChangeError) else errno.errorcode.get(error.errno, "error")
                record(event="failed", path=label, reason=reason)
                files.append(dict(entry, state="failed", reason=reason))
                continue
            record(event="done", path=label, meta=meta)
            files.append(dict(entry, state="written", meta=meta))
    finally:
        for fd, _ in roots.values():
            os.close(fd)
        os.close(journal)
    written = sum(1 for item in files if item["state"] == "written")
    if failure is None:
        state = "applied" if kind == "apply" else "rolled_back"
    elif written:
        state = "partial" if kind == "apply" else "rollback_partial"
    else:
        state = "failed" if kind == "apply" else "rollback_failed"
    receipt = dict(extra or {}, schema_version=task["schema_version"], task_id=task["task_id"], kind=kind,
                   state=state, manifest_sha256=manifest_sha256, started=started, finished=now(), files=files)
    write_state(os.path.join(directory, "receipt.json"), canonical(receipt), exclusive=True)
    result = apply_result(task["task_id"], receipt)
    if state in ("partial", "rollback_partial"):
        raise ChangeError("partial", f"Only {written} of {len(files)} files were written; see the receipt.", result)
    if failure is not None:
        raise ChangeError("failed", "No file was written; see the receipt.", result)
    return result


def stale_files(task, plan):
    roots, stale = open_targets(task, plan), []
    try:
        for step in plan:
            data, info = live_file(*roots[step.get("root")], step["path"])
            reason = mismatch(data, info, step["expect"])
            if reason:
                stale.append(dict({"path": step["path"], "reason": reason},
                                  **({"root": step["root"]} if "root" in step else {})))
            step["live"] = data
    finally:
        for fd, _ in roots.values():
            os.close(fd)
    return stale


def cmd_apply(opts):
    manifest_sha256 = opts["manifest_sha256"]
    if not SHA256.match(manifest_sha256):
        raise ChangeError("invalid_argument", "--manifest-sha256 must be 64 lowercase hex characters.")
    path = task_dir(opts["task_id"])
    task = read_task(path)
    if task["schema_version"] == TASK_V2:
        return apply_v2(path, manifest_sha256)
    with maintenance_exclusive(), task_lock(path):
        receipt = optional_json(os.path.join(path, "apply", "receipt.json"))
        if receipt is not None:
            if receipt.get("manifest_sha256") != manifest_sha256:
                raise ChangeError("conflict", "This task already applied a different manifest.",
                                  {"task_id": task["task_id"], "applied_manifest_sha256": receipt.get("manifest_sha256")})
            return apply_result(task["task_id"], receipt, replayed=True)
        if os.path.lexists(os.path.join(path, "apply")):
            raise ChangeError("partial", "An earlier apply was interrupted; its outcome is unknown and nothing was "
                              "repeated. Inspect the listed files.", {"task_id": task["task_id"], "state": "interrupted",
                                                                       "files": journal_files(path, "apply")})
        manifest, blobs = load_stage(os.path.join(path, "stages", manifest_sha256), manifest_sha256, task["task_id"])
        if not manifest["files"]:
            return {"task_id": task["task_id"], "state": "no_changes", "receipt": None, "files": [], "replayed": False}
        plan = [{"path": entry["path"], "action": entry["action"], "base_sha256": entry["base_sha256"],
                 "new_sha256": entry["new_sha256"], "data": blobs.get(entry["new_sha256"]), "meta": entry["base_meta"],
                 "expect": {"sha256": entry["base_sha256"], "meta": entry["base_meta"]}} for entry in manifest["files"]]
        stale = stale_files(task, plan)
        if stale:
            raise ChangeError("conflict", "Live files changed since prepare; nothing was written. Prepare a new task.",
                              {"task_id": task["task_id"], "stale": stale})
        make_state_dir(os.path.join(path, "apply"))
        make_state_dir(os.path.join(path, "apply", "backups"))
        for step in plan:
            if step["live"] is not None:
                with contextlib.suppress(FileExistsError):
                    write_state(os.path.join(path, "apply", "backups", step["base_sha256"]), step["live"], exclusive=True)
        progress(f"Applying {len(plan)} files.")
        return run_writes(path, "apply", task, manifest_sha256, plan)


INVERSE = {"create": "delete", "delete": "create", "modify": "modify"}


def cmd_rollback(opts):
    path = task_dir(opts["task_id"])
    task = read_task(path)
    if task["schema_version"] == TASK_V2:
        raise ChangeError("invalid_argument", "Multi-root changes are undone only through rollback-preview and an "
                          "approved undo --preview-sha256.", {"reason": "preview_required"})
    with maintenance_exclusive(), task_lock(path):
        done = optional_json(os.path.join(path, "rollback", "receipt.json"))
        if done is not None:
            return apply_result(task["task_id"], done, replayed=True)
        if os.path.lexists(os.path.join(path, "rollback")):
            raise ChangeError("rollback", "An earlier rollback was interrupted; nothing was repeated.",
                              {"task_id": task["task_id"], "state": "rollback_interrupted",
                               "files": journal_files(path, "rollback")})
        receipt = optional_json(os.path.join(path, "apply", "receipt.json"))
        if receipt is None:
            if os.path.lexists(os.path.join(path, "apply")):
                raise ChangeError("rollback", "The apply was interrupted; its outcome is unknown, so nothing was "
                                  "rolled back.", {"task_id": task["task_id"], "state": "interrupted",
                                                   "files": journal_files(path, "apply")})
            return {"task_id": task["task_id"], "state": "not_applied", "receipt": None, "files": [],
                    "replayed": False}
        stage = os.path.join(path, "stages", receipt["manifest_sha256"])
        base_meta = {item["path"]: item["base_meta"]
                     for item in load_stage(stage, receipt["manifest_sha256"], task["task_id"])[0]["files"]}
        plan = []
        # Undo only files the receipt shows as written, newest first, with their original metadata.
        for entry in reversed([item for item in receipt["files"] if item["state"] == "written"]):
            backup = None
            if entry["action"] != "create":
                backup = read_state(os.path.join(path, "apply", "backups", entry["base_sha256"]), MAX_FILE_BYTES)
                if digest(backup) != entry["base_sha256"]:
                    raise ChangeError("failed", "A backup was altered; nothing was rolled back.",
                                      {"reason": "state_integrity", "path": entry["path"]})
            plan.append({"path": entry["path"], "action": INVERSE[entry["action"]], "base_sha256": entry["new_sha256"],
                         "new_sha256": entry["base_sha256"], "data": backup, "meta": base_meta[entry["path"]],
                         "expect": {"sha256": entry["new_sha256"], "meta": entry["meta"]}})
        if not plan:
            return {"task_id": task["task_id"], "state": "nothing_written", "receipt": receipt, "files": [],
                    "replayed": False}
        stale = stale_files(task, plan)
        if stale:
            raise ChangeError("rollback", "Files changed after apply; rollback was refused and nothing was written.",
                              {"task_id": task["task_id"], "stale": stale})
        progress(f"Rolling back {len(plan)} files.")
        make_state_dir(os.path.join(path, "rollback"))
        return run_writes(path, "rollback", task, receipt["manifest_sha256"], plan)


def derive_state(path, busy=None):
    """(state, receipt, files) from the task's (or a v2 round's) immutable records; never repairs anything."""
    busy = task_busy(path) if busy is None else busy
    for kind, interrupted in (("rollback", "rollback_interrupted"), ("apply", "interrupted")):
        receipt = optional_json(os.path.join(path, kind, "receipt.json"))
        if receipt is not None:
            return receipt["state"], receipt, receipt["files"]
        if os.path.lexists(os.path.join(path, kind)):
            return ("in_progress" if busy else interrupted), None, journal_files(path, kind)
    stages = os.path.join(path, "stages")
    staged = os.path.isdir(stages) and any(SHA256.match(name) for name in os.listdir(stages))
    return ("staged" if staged else "prepared"), None, []


def cmd_status(opts):
    path = task_dir(opts["task_id"])
    task = read_task(path)
    if task["schema_version"] == TASK_V2:
        return status_v2(path, task)
    state, receipt, files = derive_state(path)
    stages = os.path.join(path, "stages")
    staged = sorted(name for name in os.listdir(stages) if SHA256.match(name)) if os.path.isdir(stages) else []
    return {"task_id": task["task_id"], "state": state, "product": task["product"], "workspace": task["workspace"],
            "created": task["created"], "diagnostic_only": task["diagnostic_only"], "staged_manifests": staged,
            "selected": [record["path"] for record in task["paths"]], "receipt": receipt, "files": files}


def cmd_list(opts):
    try:
        ensure_state_root(create=False)
        names = [name for name in os.listdir(STATE_ROOT) if TASK_ID.match(name)]
    except ChangeError as error:
        if error.code != "not_found":
            raise
        names = []
    tasks = []
    for name in names:
        try:
            path = task_dir(name)
            task = read_task(path)
            if task["schema_version"] == TASK_V2:
                with contextlib.suppress(ChangeError):
                    settle(path, task)
                state, count = state_v2(path, task)[0], len(records(task))
            else:
                state, count = derive_state(path)[0], len(task["paths"])
            tasks.append({"task_id": name, "product": task["product"], "created": task["created"],
                          "state": state, "files": count})
        except ChangeError:
            tasks.append({"task_id": name, "product": None, "created": None, "state": "incomplete", "files": 0})
    tasks.sort(key=lambda item: item["created"] or "", reverse=True)
    return {"tasks": tasks[:LIST_LIMIT], "total": len(tasks)}


# --- Schema 2: multi-root tasks ------------------------------------------------------
# Policy seam: ddistro_access.ACCESS_ROOTS[id] must carry change: True and an absolute "path", and
# ddistro_access.deny_reason(spec, parts, is_dir) must return None for the file. Nothing else grants a root.

_ACCESS = []


def load_access():
    """The code-owned access policy module, loaded once per process after the root-ownership check."""
    if not _ACCESS:
        try:
            _ACCESS.append(load_trusted("ddistro_access", ACCESS_PATH))
        except (OSError, SyntaxError):
            raise ChangeError("unsupported", "The assistant access policy is not installed; no root can be changed.",
                              {"reason": "policy_unavailable"})
    return _ACCESS[0]


def change_spec(root_id, recorded_path=None):
    """(access module, policy row) for a root the policy explicitly allows changing; recorded_path must still match."""
    access = load_access()
    roots = getattr(access, "ACCESS_ROOTS", None)
    valid_id = isinstance(root_id, str) and ROOT_ID.match(root_id) is not None
    spec = roots.get(root_id) if valid_id and isinstance(roots, dict) else None
    path = spec.get("path") if isinstance(spec, dict) else None
    if not isinstance(path, str) or spec.get("change") is not True or spec.get("unsupported") \
            or not path.startswith("/") or path == "/" or os.path.normpath(path) != path \
            or not callable(getattr(access, "deny_reason", None)):
        raise ChangeError("unsupported", f"{CONTROL.sub('?', str(root_id))[:40]} is not a root the assistant may "
                          "change.", {"root": root_id if valid_id else None, "reason": "not_changeable"})
    if recorded_path is not None and path != recorded_path:
        raise ChangeError("conflict", f"The approved {root_id} folder changed since checkout; nothing was written.",
                          {"root": root_id, "reason": "root_moved"})
    return access, spec


def change_path(access, root_id, spec, raw):
    """A relative file path in a change root that passes the legacy rules, the shared policy, and the v2 type rules."""
    rel = normalize_path(raw, root_id)
    parts = rel.split("/")
    reason = access.deny_reason(spec, parts, False)
    if reason is None and CONFIG_NAME.match(parts[-1]):
        reason = "config"
    elif reason is None and not EDIT_NAME.match(parts[-1]):
        reason = "unsupported_type"
    if reason:
        raise ChangeError("invalid_argument", f"{root_id}/{rel} cannot be changed by the assistant ({reason}).",
                          {"root": root_id, "path": rel, "reason": "excluded", "policy": str(reason)[:40]})
    return rel


def refuse_inline_secret(data, root_id, rel):
    """Refuse bytes the shared policy redactor would rewrite (or cannot decode); None means absent. Bytes are never
    sanitized here: a file holding a credential is refused whole, and no content goes into the error."""
    if data is None:
        return
    access = load_access()
    decode, redact = getattr(access, "decode_text", None), getattr(access, "redact_text", None)
    if not callable(decode) or not callable(redact):
        raise ChangeError("unsupported", "The assistant access policy has no redactor; no file can be changed.",
                          {"reason": "policy_unavailable"})
    text = decode(data)
    if text is None or redact(text)[1]:
        raise ChangeError("invalid_argument", f"{root_id}/{rel} contains what looks like an inline credential; the "
                          "assistant cannot read or write it. Move the value into protected configuration.",
                          {"root": root_id, "path": rel, "reason": "inline_secret"})


def check_v2(path, task):
    """Validate a schema 2 task.json; scratch paths are always <root>/<path>, so roots never collide."""
    good = type(task) is dict and task.get("schema_version") == TASK_V2 \
        and task.get("task_id") == os.path.basename(path) and type(task.get("targets")) is list \
        and type(task.get("round")) is int and task["round"] >= 1 and type(task.get("undone")) is list \
        and type(task.get("scratch_uid")) is int and type(task.get("scratch_gid")) is int \
        and isinstance(task.get("workspace"), str)
    for target in task["targets"] if good else []:
        good = good and type(target) is dict and ROOT_ID.match(str(target.get("root"))) is not None \
            and isinstance(target.get("root_path"), str) and type(target.get("files")) is list \
            and all(type(record) is dict and isinstance(record.get("path"), str)
                    and record.get("scratch") == f"{target['root']}/{record['path']}" for record in target["files"])
    if not good:
        raise ChangeError("failed", "task.json is not a valid schema 2 task.", {"reason": "state_integrity"})
    return task


def read_task(path):
    """v1 tasks through the unchanged load_task; v2 tasks through check_v2."""
    try:
        raw = read_json_state(os.path.join(path, "task.json"))
    except FileNotFoundError:
        return load_task(path)
    if type(raw) is dict and raw.get("schema_version") == TASK_V2:
        return check_v2(path, raw)
    return load_task(path)


def save_task(path, task):
    write_state(os.path.join(path, "task.json"), json.dumps(task, indent=1, sort_keys=True).encode())


def upgrade_task(path):
    """The v2 task for checkout. Only a fresh, empty diagnostic v1 task is upgraded, in place: the same work/
    folder and its context files stay. A v1 task with selected files or stage/apply history is left untouched."""
    task = read_task(path)
    if task["schema_version"] == TASK_V2:
        return task, False
    fresh = task.get("diagnostic_only") is True and not task["paths"] \
        and not any(os.path.lexists(os.path.join(path, name)) for name in ("stages", "apply", "rollback", "rounds"))
    if not fresh:
        raise ChangeError("unsupported", "This chat's change task uses the older single-server format and already has "
                          "selected files or changes, so it was left unchanged. Start a fresh chat to change files "
                          "across servers.", {"task_id": task["task_id"], "reason": "legacy_task",
                                              "hint": "fresh_chat"})
    task = dict(task, schema_version=TASK_V2, upgraded_from=1, targets=[], round=1, undone=[])
    task.pop("paths")
    save_task(path, task)
    return task, True


def round_dir(path, number):
    return os.path.join(path, "rounds", str(number))


def records(task):
    return {(target["root"], record["path"]): record for target in task["targets"] for record in target["files"]}


def fold(task, receipt):
    """Point each written file's baseline at what the receipt says is now live."""
    index = records(task)
    for entry in receipt["files"]:
        if entry.get("state") != "written":
            continue
        record = index.get((entry.get("root"), entry["path"]))
        if record is None:
            raise ChangeError("failed", "A receipt names a file outside this task.", {"reason": "state_integrity"})
        record.update(exists=entry["new_sha256"] is not None, sha256=entry["new_sha256"], meta=entry.get("meta"),
                      size=entry.get("new_size", 0))


def settle(path, task):
    """Fold finished undo and apply receipts into the task's baselines, in order; True when task changed.

    Interrupted rounds (a journal without a receipt) are reported, never guessed or repaired."""
    changed = False
    for number in range(1, task["round"]):
        rollback = os.path.join(round_dir(path, number), "rollback")
        if number in task["undone"] or not os.path.lexists(rollback):
            continue
        receipt = optional_json(os.path.join(rollback, "receipt.json"))
        if receipt is None:
            raise ChangeError("rollback", "An earlier undo was interrupted; nothing was repeated.",
                              {"task_id": task["task_id"], "state": "rollback_interrupted", "round": number,
                               "files": journal_files(round_dir(path, number), "rollback")})
        fold(task, receipt)
        task["undone"].append(number)
        changed = True
    while True:
        apply = os.path.join(round_dir(path, task["round"]), "apply")
        receipt = optional_json(os.path.join(apply, "receipt.json"))
        if receipt is None:
            if os.path.lexists(apply):
                raise ChangeError("partial", "An earlier apply was interrupted; its outcome is unknown and nothing was "
                                  "repeated. Inspect the listed files.",
                                  {"task_id": task["task_id"], "state": "interrupted", "round": task["round"],
                                   "files": journal_files(round_dir(path, task["round"]), "apply")})
            return changed
        fold(task, receipt)
        task["round"] += 1
        changed = True


@contextlib.contextmanager
def locked_v2(path, maintenance=False):
    """Hold the task lock (and the maintenance lock for live writes), then yield the settled v2 task."""
    with (maintenance_exclusive() if maintenance else contextlib.nullcontext()), task_lock(path):
        task = read_task(path)
        if task["schema_version"] != TASK_V2:
            raise ChangeError("invalid_argument", "This command needs a multi-root task; run checkout first.")
        if settle(path, task):
            save_task(path, task)
        yield task


def split_lines(data):
    if data is None:
        return []
    lines = data.decode("utf-8").split("\n")
    return [line + "\n" for line in lines[:-1]] + ([lines[-1]] if lines[-1] else [])


def unified(base, new, label):
    """Complete unified diff lines for one file; every line lacking a final newline is marked, as git does."""
    old_name = "a/" + label if base is not None else "/dev/null"
    new_name = "b/" + label if new is not None else "/dev/null"
    out = [line if line.endswith("\n") else line + "\n\\ No newline at end of file\n"
           for line in difflib.unified_diff(split_lines(base), split_lines(new), old_name, new_name)]
    return out or [f"--- {old_name}\n", f"+++ {new_name}\n"]  # an empty file created or deleted


def build_manifest_v2(path, task):
    """Every changed checked-out file against its current baseline; returns (manifest, blobs, diff). No truncation."""
    work_fd = open_work(path, task)
    files, blobs, chunks, total = [], {}, [], 0
    try:
        for target in task["targets"]:
            for record in target["files"]:
                new = scratch_read(work_fd, record["scratch"], task["scratch_uid"])
                if (new is None and not record["exists"]) or (new is not None and digest(new) == record["sha256"]):
                    continue
                refuse_inline_secret(new, target["root"], record["path"])  # before any diff text is built
                base = read_state(os.path.join(path, "base", record["sha256"]), MAX_FILE_BYTES) \
                    if record["exists"] else None
                if base is not None and digest(base) != record["sha256"]:
                    raise ChangeError("failed", "A baseline copy was altered.", {"reason": "state_integrity"})
                if new is not None:
                    total += len(new)
                    blobs[digest(new)] = new
                files.append({"root": target["root"], "root_path": target["root_path"], "path": record["path"],
                              "scratch": record["scratch"],
                              "action": "delete" if new is None else "modify" if record["exists"] else "create",
                              "base_sha256": record["sha256"], "base_meta": record["meta"],
                              "new_sha256": digest(new) if new is not None else None,
                              "new_size": len(new) if new is not None else 0})
                chunks.extend(unified(base, new, record["scratch"]))
    finally:
        os.close(work_fd)
    if total > MAX_BATCH_BYTES:
        raise ChangeError("invalid_argument", f"The edited files exceed {MAX_BATCH_BYTES} bytes together.")
    manifest = {"schema_version": TASK_V2, "task_id": task["task_id"], "round": task["round"], "files": files}
    return manifest, blobs, "".join(chunks)


def summary_v2(task, manifest, diff):
    summary = change_summary(task["task_id"], manifest, diff)
    summary.update(round=manifest["round"], diff_lines=diff.count("\n"),
                   files=[{key: entry[key] for key in ("root", "path", "scratch", "action", "base_sha256",
                                                       "new_sha256")} for entry in manifest["files"]])
    return summary


def scratch_replace(work_fd, rel, expect_sha, data, uid, gid):
    """Replace (or delete, when data is None) one workspace file only while it still holds expect_sha
    (None = absent); returns False, touching nothing, when the agent edited it meanwhile."""
    name, fd = rel.rsplit("/", 1)[-1], scratch_parent(work_fd, rel, uid, gid)
    try:
        current = read_file(fd, name, rel, owner_uid=uid)[0]
        if (digest(current) if current is not None else None) != expect_sha:
            return False
        if data is None:
            if current is not None:
                os.unlink(name, dir_fd=fd)
            return True
        tmp = f".ddistro-{uuid.uuid4().hex[:16]}.tmp"
        out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600, dir_fd=fd)
        try:
            write_all(out, data)
            os.fchown(out, uid, gid)
            os.fchmod(out, 0o600)
            os.rename(tmp, name, src_dir_fd=fd, dst_dir_fd=fd)
        finally:
            os.close(out)
            with contextlib.suppress(FileNotFoundError):
                os.unlink(tmp, dir_fd=fd)
        return True
    finally:
        os.close(fd)


def cmd_checkout(opts):
    """Copy live files from approved change roots into the task workspace as <root>/<path> (workspace only).

    A new file is copied; an already checked-out file whose workspace copy is unedited is refreshed from live;
    an edited workspace copy is kept when live is unchanged and is a conflict otherwise. Nothing is written
    unless every requested file passes validation (policy, links, size, inline credentials, conflicts). This is not
    write-atomic: a failure mid-copy can leave earlier workspace copies written but unrecorded in task.json."""
    path = task_dir(opts["task_id"])
    requests = []
    for root_id, raws in opts["targets"]:
        access, spec = change_spec(root_id)
        requests.extend((root_id, spec["path"], change_path(access, root_id, spec, raw)) for raw in raws)
    requests, live = list(dict.fromkeys(requests)), {}
    for root_id, root_path, rel in requests:  # refuse links and oversize files before touching the task
        root_fd, owner = open_product_root(root_id, root_path)
        try:
            live[(root_id, rel)] = live_file(root_fd, owner, rel)
        finally:
            os.close(root_fd)
        refuse_inline_secret(live[(root_id, rel)][0], root_id, rel)
    with task_lock(path):
        task, upgraded = upgrade_task(path)
        if settle(path, task):
            save_task(path, task)
        index = records(task)
        if len(index) + sum(1 for root_id, _, rel in requests if (root_id, rel) not in index) > MAX_FILES:
            raise ChangeError("invalid_argument", f"A task can hold at most {MAX_FILES} files.")
        uid, gid = task["scratch_uid"], task["scratch_gid"]
        work_fd = open_work(path, task)
        try:
            plan, conflicts = [], []
            for root_id, root_path, rel in requests:
                data, info = live[(root_id, rel)]
                scratch, record = f"{root_id}/{rel}", index.get((root_id, rel))
                current = scratch_read(work_fd, scratch, uid)
                have = digest(current) if current is not None else None
                want = {"sha256": digest(data) if data is not None else None,
                        "meta": file_meta(info) if data is not None else None}
                if record is None:
                    state = "checked_out" if current is None or have == want["sha256"] else "conflict"
                elif have != record["sha256"]:
                    state = "kept_modified" if mismatch(data, info, record) is None else "conflict"
                else:
                    state = "unchanged" if mismatch(data, info, record) is None else "refreshed"
                if state == "conflict":
                    conflicts.append({"root": root_id, "path": rel, "scratch": scratch,
                                      "reason": "workspace_edited" if record else "workspace_file_exists"})
                plan.append((root_id, root_path, rel, scratch, record, data, want, have, state))
            if conflicts:
                raise ChangeError("conflict", "Workspace copies have edits that a fresh checkout would overwrite; "
                                  "nothing was changed. Stage or revert those edits first.",
                                  {"task_id": task["task_id"], "conflicts": conflicts})
            sizes = {key: record.get("size", 0) for key, record in index.items()}
            sizes.update(((step[0], step[2]), len(step[5] or b"")) for step in plan
                         if step[8] in ("checked_out", "refreshed"))
            if sum(sizes.values()) > MAX_BATCH_BYTES:
                raise ChangeError("invalid_argument", f"The task's files would exceed {MAX_BATCH_BYTES} bytes together.")
            results = []
            for root_id, root_path, rel, scratch, record, data, want, have, state in plan:
                if state in ("checked_out", "refreshed"):
                    if data is not None:
                        with contextlib.suppress(FileExistsError):
                            write_state(os.path.join(path, "base", want["sha256"]), data, exclusive=True)
                    if have != want["sha256"] and not scratch_replace(work_fd, scratch, have, data, uid, gid):
                        raise ChangeError("conflict", f"{scratch} was edited during checkout; it was kept. Try again.",
                                          {"task_id": task["task_id"], "scratch": scratch})
                    fresh = {"path": rel, "scratch": scratch, "exists": data is not None, "sha256": want["sha256"],
                             "meta": want["meta"], "size": len(data or b""), "checked_out": now()}
                    if record is None:
                        target = next((item for item in task["targets"] if item["root"] == root_id), None)
                        if target is None:
                            target = {"root": root_id, "root_path": root_path, "files": []}
                            task["targets"].append(target)
                        target["files"].append(fresh)
                        index[(root_id, rel)] = record = fresh
                    else:
                        record.update(fresh)
                results.append({"root": root_id, "path": rel, "scratch": scratch, "exists": record["exists"]
                                if record else data is not None, "state": state,
                                "base_sha256": record["sha256"] if record else want["sha256"]})
        finally:
            os.close(work_fd)
        task["diagnostic_only"] = not index
        save_task(path, task)
    progress(f"Checked out {len(results)} files into task {task['task_id']}.")
    return {"task_id": task["task_id"], "schema_version": TASK_V2, "upgraded": upgraded,
            "workspace": task["workspace"], "round": task["round"], "files": results}


def diff_v2(path, task):
    settle(path, task)  # in memory only; diff never writes task state
    manifest, _, diff = build_manifest_v2(path, task)
    return dict(summary_v2(task, manifest, diff), state=state_v2(path, task)[0])


def stage_v2(path):
    with locked_v2(path) as task:
        manifest, blobs, diff = build_manifest_v2(path, task)
        summary = summary_v2(task, manifest, diff)
        if summary["diff_truncated"]:
            raise ChangeError("invalid_argument", f"The diff exceeds {DIFF_LIMIT} bytes and cannot be reviewed in "
                              "full; nothing was staged. Split the change into smaller rounds.",
                              {"reason": "diff_too_large", "diff_limit": DIFF_LIMIT})
        for folder in (os.path.join(path, "rounds"), round_dir(path, task["round"])):
            with contextlib.suppress(FileExistsError):
                make_state_dir(folder)
        warnings = freeze_stage(os.path.join(round_dir(path, task["round"]), "stages"), summary["manifest_sha256"],
                                manifest, blobs, task["task_id"])
    progress(f"Staged {len(summary['files'])} changed files as {summary['manifest_sha256']}.")
    return dict(summary, warnings=warnings, state="staged")


def recheck_policy(entries):
    """Every target root and path must still pass the current policy before any live write."""
    for entry in entries:
        access, spec = change_spec(entry["root"], entry["root_path"])
        if change_path(access, entry["root"], spec, entry["path"]) != entry["path"]:
            raise ChangeError("failed", "A staged path no longer normalizes the same way.", {"reason": "state_integrity"})


def apply_v2(path, manifest_sha256):
    """Apply the staged round only while the workspace and baselines still produce exactly manifest_sha256."""
    with locked_v2(path, maintenance=True) as task:
        if task["round"] > 1:
            last = optional_json(os.path.join(round_dir(path, task["round"] - 1), "apply", "receipt.json"))
            if last is not None and last.get("manifest_sha256") == manifest_sha256:
                return dict(apply_result(task["task_id"], last, replayed=True), round=task["round"] - 1)
        manifest, _, _ = build_manifest_v2(path, task)
        current = digest(canonical(manifest))
        if current != manifest_sha256:
            raise ChangeError("conflict", "The workspace or live baseline changed since this change was staged; "
                              "nothing was written. Stage again and review the new diff.",
                              {"task_id": task["task_id"], "reason": "stale_stage", "current_manifest_sha256": current})
        if not manifest["files"]:
            return {"task_id": task["task_id"], "state": "no_changes", "receipt": None, "files": [],
                    "replayed": False, "round": task["round"]}
        here = round_dir(path, task["round"])
        manifest, blobs = load_stage(os.path.join(here, "stages", manifest_sha256), manifest_sha256, task["task_id"])
        recheck_policy(manifest["files"])
        plan = [dict({key: entry[key] for key in ("root", "root_path", "path", "scratch", "action", "base_sha256",
                                                  "new_sha256", "new_size")},
                     data=blobs.get(entry["new_sha256"]), meta=entry["base_meta"],
                     expect={"sha256": entry["base_sha256"], "meta": entry["base_meta"]}) for entry in manifest["files"]]
        stale = stale_files(task, plan)
        if stale:
            raise ChangeError("conflict", "Live files changed since checkout; nothing was written. Check the files out "
                              "again.", {"task_id": task["task_id"], "stale": stale})
        for step in plan:  # current redactor over both the live bytes about to be replaced and the staged bytes
            refuse_inline_secret(step["live"], step["root"], step["path"])
            refuse_inline_secret(step["data"], step["root"], step["path"])
        apply = os.path.join(here, "apply")
        make_state_dir(apply)
        make_state_dir(os.path.join(apply, "backups"))
        for step in plan:
            if step["live"] is not None:
                with contextlib.suppress(FileExistsError):
                    write_state(os.path.join(apply, "backups", step["base_sha256"]), step["live"], exclusive=True)
            if step["data"] is not None:  # the next round's baseline
                with contextlib.suppress(FileExistsError):
                    write_state(os.path.join(path, "base", step["new_sha256"]), step["data"], exclusive=True)
        progress(f"Applying {len(plan)} files in round {task['round']}.")
        number = task["round"]
        try:
            return dict(run_writes(path, "apply", task, manifest_sha256, plan, apply, {"round": number}), round=number)
        finally:
            with contextlib.suppress(ChangeError):
                if settle(path, task):
                    save_task(path, task)


def latest_written(path, task):
    """(round, raw receipt bytes) of the newest apply that wrote anything, or (None, None)."""
    for number in range(task["round"] - 1, 0, -1):
        raw = read_state(os.path.join(round_dir(path, number), "apply", "receipt.json"))
        if any(entry.get("state") == "written" for entry in json.loads(raw.decode("utf-8"))["files"]):
            return number, raw
    return None, None


def plan_step(plan, scratch):
    return next(step for step in plan if step["scratch"] == scratch)


def undo_plan(path, task):
    """The exact reverse of the newest applied round, checked against live files and the workspace.

    Returns (round, receipt, plan, preview, diff), or None when nothing can be undone. preview is the record
    hashed into preview_sha256: the receipt, every live, target and workspace hash, and the full diff."""
    number, raw = latest_written(path, task)
    if number is None or number in task["undone"]:
        return None
    receipt, here = json.loads(raw.decode("utf-8")), round_dir(path, number)
    base_meta = {(entry["root"], entry["path"]): entry["base_meta"] for entry in
                 load_stage(os.path.join(here, "stages", receipt["manifest_sha256"]), receipt["manifest_sha256"],
                            task["task_id"])[0]["files"]}
    roots = {target["root"]: target["root_path"] for target in task["targets"]}
    plan = []
    for entry in reversed([item for item in receipt["files"] if item["state"] == "written"]):
        backup = None
        if entry["action"] != "create":
            backup = read_state(os.path.join(here, "apply", "backups", entry["base_sha256"]), MAX_FILE_BYTES)
            if digest(backup) != entry["base_sha256"]:
                raise ChangeError("failed", "A backup was altered; nothing can be undone.",
                                  {"reason": "state_integrity", "path": entry["scratch"]})
        plan.append({"root": entry["root"], "root_path": roots[entry["root"]], "path": entry["path"],
                     "scratch": entry["scratch"], "action": INVERSE[entry["action"]],
                     "base_sha256": entry["new_sha256"], "new_sha256": entry["base_sha256"],
                     "new_size": len(backup or b""), "data": backup, "meta": base_meta[(entry["root"], entry["path"])],
                     "expect": {"sha256": entry["new_sha256"], "meta": entry["meta"]}})
    recheck_policy(plan)
    stale = stale_files(task, plan)
    if stale:
        raise ChangeError("conflict", "Files changed after the change was applied; undo was refused and nothing was "
                          "written.", {"task_id": task["task_id"], "round": number, "stale": stale})
    work_fd = open_work(path, task)
    try:
        pending = []
        for step in plan:
            data = scratch_read(work_fd, step["scratch"], task["scratch_uid"])
            if (digest(data) if data is not None else None) != step["base_sha256"]:
                pending.append(step["scratch"])
    finally:
        os.close(work_fd)
    if pending:
        raise ChangeError("conflict", "The workspace has newer edits to files this undo would restore; nothing was "
                          "written. Apply or revert those edits first.",
                          {"task_id": task["task_id"], "round": number, "pending": pending})
    diff = "".join(line for step in plan for line in unified(step["live"], step["data"], step["scratch"]))
    preview = {"kind": "file_undo", "task_id": task["task_id"], "round": number, "apply_receipt_sha256": digest(raw),
               "diff_sha256": digest(diff.encode("utf-8")),
               "files": [{"root": step["root"], "path": step["path"], "action": step["action"],
                          "live_sha256": step["base_sha256"], "target_sha256": step["new_sha256"],
                          "scratch_sha256": step["base_sha256"]} for step in plan]}
    return number, receipt, plan, preview, diff


def cmd_rollback_preview(opts):
    """Read-only: the full reverse diff of the newest applied round and the preview_sha256 that undo must quote."""
    path = task_dir(opts["task_id"])
    task = read_task(path)
    if task["schema_version"] != TASK_V2:
        raise ChangeError("invalid_argument", "This task uses the older format; use ddistro changes rollback.")
    settle(path, task)  # in memory only
    found = undo_plan(path, task)
    if found is None:
        return {"task_id": task["task_id"], "state": "nothing_to_undo", "preview_sha256": None, "diff": "",
                "diff_lines": 0, "files": []}
    number, receipt, _, preview, diff = found
    if len(json.dumps(diff)) > DIFF_LIMIT:
        raise ChangeError("invalid_argument", f"The undo diff exceeds {DIFF_LIMIT} bytes and cannot be reviewed in "
                          "full.", {"reason": "diff_too_large", "diff_limit": DIFF_LIMIT})
    return {"task_id": task["task_id"], "state": "undo_available", "round": number,
            "preview_sha256": digest(canonical(preview)), "applied_manifest_sha256": receipt["manifest_sha256"],
            "diff": diff, "diff_lines": diff.count("\n"), "files": preview["files"]}


def cmd_undo(opts):
    """Undo the newest applied round only while it still matches the reviewed rollback-preview hash exactly."""
    preview_sha256 = opts["preview_sha256"]
    if not SHA256.match(preview_sha256):
        raise ChangeError("invalid_argument", "--preview-sha256 must be 64 lowercase hex characters.")
    path = task_dir(opts["task_id"])
    with locked_v2(path, maintenance=True) as task:
        if task["undone"]:
            number = max(task["undone"])
            done = optional_json(os.path.join(round_dir(path, number), "rollback", "receipt.json"))
            if done is not None and done.get("preview_sha256") == preview_sha256:
                return dict(apply_result(task["task_id"], done, replayed=True), round=number)
        found = undo_plan(path, task)
        if found is None:
            raise ChangeError("conflict", "There is no applied change left to undo.",
                              {"task_id": task["task_id"], "reason": "nothing_to_undo"})
        number, receipt, plan, preview, _ = found
        if digest(canonical(preview)) != preview_sha256:
            raise ChangeError("conflict", "Live files, the workspace, or the applied change differ from the reviewed "
                              "undo preview; nothing was written. Preview the undo again.",
                              {"task_id": task["task_id"], "reason": "stale_preview"})
        rollback = os.path.join(round_dir(path, number), "rollback")
        make_state_dir(rollback)
        progress(f"Undoing {len(plan)} files from round {number}.")
        failure, result = None, None
        try:
            result = run_writes(path, "rollback", task, receipt["manifest_sha256"], plan, rollback,
                                {"round": number, "preview_sha256": preview_sha256})
        except ChangeError as error:
            failure = error
        written = optional_json(os.path.join(rollback, "receipt.json")) or {"files": []}
        # Return each restored workspace copy to the restored bytes, unless the agent edited it meanwhile.
        scratch, work_fd = [], open_work(path, task)
        try:
            for entry in written["files"]:
                if entry["state"] == "written":
                    step = plan_step(plan, entry["scratch"])
                    same = scratch_replace(work_fd, step["scratch"], step["base_sha256"], step["data"],
                                           task["scratch_uid"], task["scratch_gid"])
                    scratch.append({"scratch": step["scratch"], "state": "restored" if same else "kept_edited"})
        finally:
            os.close(work_fd)
            with contextlib.suppress(ChangeError):
                if settle(path, task):
                    save_task(path, task)
        if failure is not None:
            if isinstance(failure.details, dict):
                failure.details.update(round=number, scratch=scratch)
            raise failure
        return dict(result, round=number, scratch=scratch)


def state_v2(path, task):
    """(state, receipt, files) for the open round, or the newest finished round when nothing is staged."""
    busy = task_busy(path)
    state, receipt, files = derive_state(round_dir(path, task["round"]), busy)
    if state == "prepared" and task["round"] > 1:
        state, receipt, files = derive_state(round_dir(path, task["round"] - 1), busy)
    return state, receipt, files


def status_v2(path, task):
    with contextlib.suppress(ChangeError):
        settle(path, task)  # in memory; an interrupted round is then reported by state_v2
    state, receipt, files = state_v2(path, task)
    stages = os.path.join(round_dir(path, task["round"]), "stages")
    staged = sorted(name for name in os.listdir(stages) if SHA256.match(name)) if os.path.isdir(stages) else []
    return {"task_id": task["task_id"], "schema_version": TASK_V2, "state": state, "product": task["product"],
            "workspace": task["workspace"], "created": task["created"], "diagnostic_only": not records(task),
            "round": task["round"], "staged_manifests": staged,
            "selected": [record["scratch"] for record in records(task).values()],
            "targets": [{"root": target["root"],
                         "files": [{key: record[key] for key in ("path", "scratch", "exists", "sha256")}
                                   for record in target["files"]]} for target in task["targets"]],
            "receipt": receipt, "files": files}


COMMANDS = {"prepare": cmd_prepare, "diff": cmd_diff, "stage": cmd_stage, "apply": cmd_apply,
            "status": cmd_status, "rollback": cmd_rollback, "list": cmd_list, "checkout": cmd_checkout,
            "rollback-preview": cmd_rollback_preview, "undo": cmd_undo}
TASK_OPTION = ("checkout", "rollback-preview", "undo")  # newer verbs name the task with --task


def parse(argv):
    if not argv or argv[0] not in COMMANDS:
        raise ChangeError("invalid_argument", "Expected one of: " + ", ".join(COMMANDS) + ".")
    command, args, opts = argv[0], argv[1:], {"paths": [], "targets": []}
    valued = {"prepare": ("--product", "--path"), "apply": ("--manifest-sha256",),
              "checkout": ("--task", "--root", "--path"), "rollback-preview": ("--task",),
              "undo": ("--task", "--preview-sha256")}.get(command, ())
    positional, index = [], 0
    while index < len(args):
        token = args[index]
        if token in valued and index + 1 < len(args):
            if token == "--root":
                if not ROOT_ID.match(args[index + 1]):
                    raise ChangeError("invalid_argument", "--root must be a root ID from ddistro access roots.")
                opts["targets"].append((args[index + 1], []))
            elif token == "--path" and command == "checkout":
                if not opts["targets"]:
                    raise ChangeError("invalid_argument", "Each --path must follow the --root it belongs to.")
                opts["targets"][-1][1].append(args[index + 1])
                if sum(len(paths) for _, paths in opts["targets"]) > MAX_FILES:
                    raise ChangeError("invalid_argument", f"At most {MAX_FILES} files can be selected.")
            elif token == "--path":
                opts["paths"].append(args[index + 1])
                if len(opts["paths"]) > MAX_FILES:
                    raise ChangeError("invalid_argument", f"At most {MAX_FILES} files can be selected.")
            elif token[2:].replace("-", "_") in opts:
                raise ChangeError("invalid_argument", f"{token} was given more than once.")
            else:
                opts[token[2:].replace("-", "_")] = args[index + 1]
            index += 2
            continue
        if token.startswith("-"):
            raise ChangeError("invalid_argument", f"Unsupported option or missing value for {command}: {token[:40]}")
        positional.append(token)
        index += 1
    needs_task = command not in ("prepare", "list") + TASK_OPTION
    if len(positional) != int(needs_task):
        raise ChangeError("invalid_argument", f"Wrong number of arguments for {command}.")
    if needs_task:
        opts["task_id"] = positional[0]
    if command in TASK_OPTION:
        if "task" not in opts:
            raise ChangeError("invalid_argument", f"{command} requires --task with the task ID.")
        opts["task_id"] = opts.pop("task")
    if command == "checkout" and (not opts["targets"] or any(not paths for _, paths in opts["targets"])):
        raise ChangeError("invalid_argument", "checkout requires --root ROOT followed by at least one --path.")
    if command == "undo" and "preview_sha256" not in opts:
        raise ChangeError("invalid_argument", "undo requires --preview-sha256 from rollback-preview.")
    if command == "prepare":
        opts["product"] = ALIASES.get(opts.get("product"), opts.get("product"))
        if opts["product"] not in KNOWN_PRODUCTS:
            raise ChangeError("invalid_argument", "prepare requires --product with a product ID such as herika.")
    if command == "apply" and "manifest_sha256" not in opts:
        raise ChangeError("invalid_argument", "apply requires --manifest-sha256 from stage.")
    return command, opts


def main(argv):
    data, failure = None, None
    try:
        if os.geteuid() != 0:
            raise ChangeError("permission_denied", "ddistro_changes must run as root; it never elevates by itself.")
        command, opts = parse(argv)
        data = COMMANDS[command](opts)
    except ChangeError as error:
        failure = error
    except OSError as error:
        failure = ChangeError("failed", "A file operation failed.",
                              {"reason": errno.errorcode.get(error.errno, "error")})
    except Exception as error:  # report the type only; never echo file content
        failure = ChangeError("internal_error", "ddistro_changes hit an unexpected internal error.",
                              {"type": type(error).__name__})
    error = None
    if failure is not None:
        error = {"code": failure.code, "message": failure.message, "details": failure.details}
    sys.stdout.write(json.dumps({"schema_version": SCHEMA_VERSION, "ok": failure is None, "data": data,
                                 "error": error}, ensure_ascii=True) + "\n")
    sys.stdout.flush()
    return ERRORS[failure.code] if failure else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
