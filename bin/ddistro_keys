#!/usr/bin/env python3
"""Local CHIM 4 shared-key adapter. Never synchronizes or rewrites legacy credentials."""
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

ROOT = Path('/opt/ChimServer')
BRIDGE = Path('/usr/local/lib/dwemerdistro/keys.php')
ENV_FILES = ('/etc/chim4-s5.env', '/etc/chim4-dialogue.env', '/etc/chim4-tts.env')
OPERATIONS = frozenset(('status', 'create', 'edit', 'test', 'delete', 'bind', 'import-environment'))


class Refusal(Exception):
    pass


def trusted_file(path):
    """Configuration/executable files must be regular, root-owned and not writable by other accounts."""
    st = Path(path).lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022 or st.st_size > 1048576:
        raise Refusal('Shared key configuration is not trusted')


def environment():
    """Read the same literal assignments as chim4 without executing shell config or inheriting caller env."""
    result = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'}
    for path in ENV_FILES:
        if not Path(path).exists():
            continue
        trusted_file(path)
        for line in Path(path).read_text().splitlines():
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            match = re.fullmatch(r'\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)', line)
            if not match:
                raise Refusal('Invalid shared key configuration')
            name, value = match.groups()
            if name.startswith('CHIM_'):
                if len(value) >= 2 and value[0] in ('"', "'") and value.rstrip().endswith(value[0]):
                    value = value.rstrip()[1:-1]
                result[name] = value
    return result


def run(verb, payload):
    if verb == 'sync':
        # Older updater hooks remain valid. Shared references resolve at call time; copying is retired.
        return {'ok': True, 'outcome': 'references_only', 'warnings': []}
    if verb not in OPERATIONS or not isinstance(payload, dict):
        raise Refusal('Unsupported operation; update the launcher')
    trusted_file(BRIDGE)
    if not (ROOT / 'Core/ApiKeyManager/ApiKeyManager.php').is_file():
        raise Refusal('CHIM 4 shared key service is not installed')
    result = subprocess.run(['/usr/sbin/runuser', '-u', 'www-data', '-p', '--', '/usr/bin/php', str(BRIDGE), str(ROOT), verb],
                            input=json.dumps(payload), text=True, capture_output=True, timeout=40, env=environment())
    if len(result.stdout) > 262144:
        raise Refusal('Invalid shared key response')
    try:
        response = json.loads(result.stdout)
    except ValueError:
        raise Refusal('Shared key service is unavailable') from None
    if not isinstance(response, dict) or not isinstance(response.get('ok'), bool):
        raise Refusal('Invalid shared key response')
    return response


def main(argv):
    try:
        if os.geteuid() != 0 or len(argv) != 2:
            raise Refusal('Root-local operation required')
        raw = sys.stdin.buffer.read(16385) if argv[1] not in ('status', 'sync') else b'{}'
        if len(raw) > 16384:
            raise Refusal('Request too large')
        response = run(argv[1], json.loads(raw))
    except (Refusal, OSError, ValueError, subprocess.TimeoutExpired):
        # Never echo input, SQL, environment or process diagnostics containing credentials.
        response = {'ok': False, 'error': 'Shared API Keys is unavailable or the request was refused. Existing keys and assignments are preserved.'}
    print(json.dumps(response))
    return 0 if response['ok'] else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
