def cmd_products(opts, ctx):
    products = [{"id": key, "name": value["name"], "aliases": value["aliases"], "branches": value["branches"],
                 "logs": LOG_SOURCES[key][1]} for key, value in PRODUCTS.items()]
    human = "\n".join(f"{p['id']:<10} {p['name']:<28} aliases: {', '.join(p['aliases']) or '-'}" for p in products)
    return {"products": products}, human


def cmd_status(opts, ctx):
    records = helper_status(opts.get("product"))
    servers = [{key: record[key] for key in ("product", "state", "repository_state", "database_present",
                                              "branch", "version")} for record in records]
    data = {"user": current_user(), "is_root": os.geteuid() == 0, "servers": servers}
    return data, human_status(records)


def cmd_server_status(opts, ctx):
    records = helper_status(opts.get("product"))
    return {"servers": records}, human_status(records)


def postgres_log_name(root):
    try:
        versions = [int(match.group(1)) for match in map(POSTGRES_LOG.match, os.listdir(root)) if match]
    except FileNotFoundError:
        return None
    except PermissionError:
        raise CliError("permission_denied", "The PostgreSQL log folder is not readable by this user.",
                       {"path": root, "read_as": current_user()})
    return f"postgresql-{max(versions)}-main.log" if versions else None


# logs --query and --since filter the same bounded tail; nothing older than it is ever read. A query is literal text,
# matched case-insensitively against the redacted line. A line's time comes only from these fixed prefixes; a line
# without one belongs to the dated line above it (a continuation); undated lines before the first dated one, and lines
# with an invalid time, are excluded from a since filter, counted, and make it incomplete, as do times that go
# backwards. Times without a zone are read in the distro's local time.
LOG_QUERY_CHARS = 200
SINCE = re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\Z")
MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
STAMP_ISO = re.compile(r'^(?:\[|\{"(?:time|timestamp|ts)"\s*:\s*")?([0-9]{4})-([0-9]{2})-([0-9]{2})[T ]([0-9]{2}):([0-9]{2}):'
                       r'([0-9]{2})(?:[.,][0-9]{1,9})?\s?(Z|UTC|[+-][0-9]{2}:?[0-9]{2})?')
STAMP_APACHE = re.compile(r"^\[(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun) (" + "|".join(MONTHS) + r") ([ 0-9][0-9]) ([0-9]{2}):([0-9]{2}):"
                          r"([0-9]{2})(?:\.[0-9]{1,9})? ([0-9]{4})\]")
STAMP_COMMON = re.compile(r"\[([0-9]{2})/(" + "|".join(MONTHS) + r")/([0-9]{4}):([0-9]{2}):([0-9]{2}):([0-9]{2}) ([+-][0-9]{4})\]")


def log_stamp(row):
    """(epoch seconds, has_zone) from a fixed timestamp prefix, None without one, or False for a prefix that is not a
    valid time (bad date or zone offset). Only the first 200 characters are examined."""
    head = row[:200]
    try:
        match = STAMP_ISO.match(head)
        if match:
            year, month, day, hour, minute, second = (int(value) for value in match.groups()[:6])
            zone = match.group(7)
        elif (match := STAMP_APACHE.match(head)):
            month, day = MONTHS.index(match.group(1)) + 1, int(match.group(2))
            hour, minute, second, year = (int(value) for value in match.groups()[2:])
            zone = None
        elif (match := STAMP_COMMON.search(head)):
            day, month, year = int(match.group(1)), MONTHS.index(match.group(2)) + 1, int(match.group(3))
            hour, minute, second = (int(value) for value in match.groups()[3:6])
            zone = match.group(7)
        else:
            return None
        fields = (year, month, day, hour, minute, second, 0, 0, -1)
        time.strptime("%04d-%02d-%02d %02d:%02d:%02d" % fields[:6], "%Y-%m-%d %H:%M:%S")
        if zone is None:
            return int(time.mktime(fields)), False
        offset = 0
        if zone not in ("Z", "UTC"):
            digits = zone.replace(":", "")
            if int(digits[1:3]) > 14 or int(digits[3:5]) > 59:
                return False
            offset = (1 if digits[0] == "+" else -1) * (int(digits[1:3]) * 3600 + int(digits[3:5]) * 60)
        return calendar.timegm(fields) - offset, True
    except (ValueError, OverflowError):
        return False


def filter_rows(rows, query, since, whole_file):
    """The rows a query/since filter keeps, oldest first, and what the filter covered."""
    needle = query.casefold() if query else None
    cutoff = calendar.timegm(time.strptime(since, "%Y-%m-%dT%H:%M:%SZ")) if since else None
    kept, stamp, first, dated, naive, excluded, disordered = [], None, None, 0, False, 0, False
    for row in rows:
        found = log_stamp(row)
        if found is False:
            stamp = None  # an invalid time and its continuation lines have an unknown time
        elif found is not None:
            disordered = disordered or (stamp is not None and found[0] < stamp)
            stamp, dated = found[0], dated + 1
            naive = naive or not found[1]
            first = stamp if first is None else first
        if cutoff is not None:
            if stamp is None:
                excluded += 1
                continue
            if stamp < cutoff:
                continue
        text = clean_line(row)
        if needle is None or needle in text.casefold():
            kept.append(text)
    # The tail covers a since window only if it starts at the file's beginning or at a dated line before the cutoff,
    # every line in it has a known time, and those times never go backwards (otherwise the cutoff is uncertain).
    # A query alone never covers what lies before the tail.
    since_covered = None if cutoff is None else (
        (whole_file or (first is not None and first < cutoff)) and not excluded and not disordered)
    info = {"query": query, "since": since, "scanned_lines": len(rows), "dated_lines": dated,
            "undated_lines": len(rows) - dated, "excluded_undated": excluded, "matched": len(kept),
            "whole_file": whole_file, "since_covered": since_covered, "out_of_order": disordered,
            "naive_timestamps": "distro_local_time" if naive else None,
            "local_utc_offset": time.strftime("%z")}
    info["complete"] = bool(since_covered) if cutoff is not None else whole_file
    return kept, info


def read_tail_rows(path):
    """(rows, start offset, fstat) of the last MAX_LOG_BYTES of a regular file, opened without following a link.
    Rows are raw text (not cleaned or redacted); a partial first row is dropped."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_CLOEXEC", 0)
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise CliError("unsafe_path", "The log is not a regular file.", {"path": path})
        start = max(0, info.st_size - MAX_LOG_BYTES)
        os.lseek(fd, start, os.SEEK_SET)
        raw = bytearray()
        while len(raw) < MAX_LOG_BYTES:
            chunk = os.read(fd, MAX_LOG_BYTES - len(raw))
            if not chunk:
                break
            raw += chunk
    finally:
        os.close(fd)
    rows = bytes(raw).decode("utf-8", "replace").replace("\r", "").split("\n")
    if rows and rows[-1] == "":
        rows.pop()
    if start > 0 and len(rows) > 1:
        rows.pop(0)  # partial first line
    return rows, start, info


def read_tail(path, lines, query=None, since=None):
    rows, start, info = read_tail_rows(path)
    search = None
    if query or since:
        rows, search = filter_rows(rows, query, since, start == 0)
    truncated = start > 0 or len(rows) > lines
    output, size = [], 0
    for row in reversed(rows[-lines:]):
        row = clean_line(row) if search is None else row
        size += len(row.encode("utf-8")) + 1
        if size > MAX_LOG_BYTES:
            truncated = True
            break
        output.append(row)
    output.reverse()
    result = {"size_bytes": info.st_size, "modified": int(info.st_mtime), "truncated": truncated, "lines": output}
    if search is not None:
        # Older matches left out by --lines or the byte bound also make the result incomplete.
        search["returned"] = len(output)
        search["complete"] = search["complete"] and len(output) == len(rows)
        search["tail_bytes"] = MAX_LOG_BYTES
        result["filter"] = search
    return result


def cmd_logs(opts, ctx):
    target = opts["target"]
    root, names = LOG_SOURCES[target]
    name = opts.get("log") or names[0]
    if name not in names:
        raise CliError("invalid_argument", f"Unknown log for {target}. Expected one of: {', '.join(names)}.")
    data = {"target": target, "log": name, "read_as": current_user(), "available": False, "reason": None,
            "lines": []}
    try:
        root_info = os.lstat(root)
    except FileNotFoundError:
        root_info = None
    except PermissionError:
        raise CliError("permission_denied", "The log folder is not readable by this user.",
                       {"path": root, "read_as": data["read_as"]})
    if root_info is not None and (not stat.S_ISDIR(root_info.st_mode) or os.path.realpath(root) != root):
        raise CliError("unsafe_path", "The log folder is redirected; it was not read.", {"path": root})
    filename = name if target != "postgres" else (postgres_log_name(root) if root_info else None)
    data["path"] = os.path.join(root, filename) if filename else root
    try:
        if root_info is None or filename is None:
            raise FileNotFoundError
        data.update(read_tail(data["path"], opts.get("lines", DEFAULT_LOG_LINES), opts.get("query"), opts.get("since")),
                    available=True)
    except FileNotFoundError:
        data["reason"] = "missing"
    except PermissionError:
        raise CliError("permission_denied", "The log is not readable by this user.",
                       {"path": data["path"], "read_as": data["read_as"]})
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise CliError("unsafe_path", "The log is a symbolic link; it was not read.", {"path": data["path"]})
        raise CliError("failed", "The log could not be read.",
                       {"path": data["path"], "reason": errno.errorcode.get(error.errno, "error")})
    if not data["available"]:
        return data, f"{data['path']}: not present (no log written yet)."
    header = f"== {data['path']} ({len(data['lines'])} lines" + (", truncated" if data["truncated"] else "") + ")"
    if data.get("filter"):
        search = data["filter"]
        header += (f" filtered: {search['matched']} of {search['scanned_lines']} tail lines matched"
                   + ("" if search["complete"] else "; INCOMPLETE: only the last "
                      f"{MAX_LOG_BYTES // 1024} KiB were searched or older matches were left out"))
    return data, "\n".join([header] + data["lines"])


def parse_blocker(line, product, code):
    """Validate the one-line DDISTRO_UPDATE_BLOCKED payload; anything unexpected is ignored."""
    try:
        doc = json.loads(line[len(BLOCKED_PREFIX):].decode("utf-8"), parse_constant=reject_constant)
    except (ValueError, TypeError, AttributeError):
        return None
    valid = (type(doc) is dict and set(doc) == BLOCKER_KEYS and type(doc["schema_version"]) is int
             and doc["schema_version"] == 1 and doc["reason"] == BLOCKER_REASONS[code]
             and doc["product"] == product and type(doc["branch"]) is str and len(doc["branch"]) <= 255
             and type(doc["total"]) is int and doc["total"] >= 0 and type(doc["files"]) is list
             and len(doc["files"]) <= min(20, doc["total"])
             and all(type(path) is str and len(path) <= 4096 for path in doc["files"]))
    if not valid:
        return None
    return dict(doc, files=[CONTROL.sub("?", path) for path in doc["files"]])


def cmd_server_update(opts, ctx):
    product, branch, force = opts["product"], opts.get("branch"), opts.get("force", False)
    if not branch:
        raise CliError("invalid_argument", "server update requires --branch.")
    if branch not in PRODUCTS[product]["branches"]:
        raise CliError("invalid_argument",
                       f"Unsupported branch for {product}. Expected one of: {', '.join(PRODUCTS[product]['branches'])}.")
    if os.geteuid() != 0:
        raise CliError("permission_denied", "server update must run as root. ddistro never elevates by itself.")
    ctx["operation_id"] = str(uuid.uuid4())
    before = helper_status(product)[0]
    if before["state"] == "not-installed":
        raise CliError("not_found", f"{product} is not installed. Update never installs missing products.",
                       {"product": product, "state": before["state"]})
    args = ["update", product, "--branch", branch] + (["--force"] if force else [])
    code, out, err = run_helper(args, UPDATE_TIMEOUT, OUTPUT_TAIL_BYTES, echo=not ctx["json"], watch_blocker=True)
    details = {"product": product, "branch": branch, "force": force, "helper_exit": code,
               "stdout_tail": tail_lines(out.data), "stderr_tail": tail_lines(err.data)}
    if code in BLOCKER_REASONS:
        details["blocker"] = parse_blocker(out.blocker, product, code) if out.blocker else None
        details["force_may_resolve"] = code == 79
        if code == 79:
            raise CliError("update_blocked_tracked", f"Local edits to tracked {product} files block this update. "
                           "Re-run with --force only if discarding them is intended.", details)
        raise CliError("update_blocked_untracked",
                       f"Untracked {product} files are in the way of this update. Move them, then update again.",
                       details)
    mapped = {75: "busy", 64: "invalid_argument", 130: "cancelled", 143: "cancelled"}.get(code)
    if code != 0:
        raise CliError(mapped or "helper_failed", f"ddistro_server update failed (exit {code}).", details)
    data = {"product": product, "branch": branch, "force": force, "before": before,
            "stdout_tail": details["stdout_tail"], "stderr_tail": details["stderr_tail"]}
    try:
        data["after"] = helper_status(product)[0]
    except CliError as error:
        data["after"] = None
        ctx["warnings"].append(f"Post-update status unavailable: {error.code}.")
    return data, f"Updated {product} on branch {branch}."


# ddistro changes: the root-only ddistro_changes helper does the work; this layer checks
# arguments and the helper's trust, then passes its one JSON result through unchanged.
CHANGES_SPEC = {
    "prepare": {"flags": ["--product", "--path"], "mutates": False},
    "diff": {"arguments": ["TASK"], "mutates": False},
    "stage": {"arguments": ["TASK"], "mutates": False},
    "apply": {"arguments": ["TASK"], "flags": ["--manifest-sha256"], "mutates": True},
    "status": {"arguments": ["TASK"], "mutates": False},
    "rollback": {"arguments": ["TASK"], "mutates": True},
    "list": {"mutates": False},
    # Schema 2 tasks (ddistro_changes CONTRACT) name the task with --task. checkout writes only the task's scratch
    # workspace, never a live root; undo writes live files back to the state its rollback-preview hash reviewed.
    "checkout": {"flags": ["--task", "--root", "--path"], "mutates": False, "writes": "scratch_workspace"},
    "rollback-preview": {"flags": ["--task"], "mutates": False},
    "undo": {"flags": ["--task", "--preview-sha256"], "mutates": True},
}
CHANGES_ROOT = re.compile(r"^[a-z][a-z0-9]{0,31}\Z")  # a root id as ddistro_changes and ddistro_access accept it
TASK_ID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\Z")
HASH = re.compile(r"^[0-9a-f]{64}\Z")


def changes_result(code, out):
    """Validate the helper's single JSON document and its exit code; anything else is helper_protocol."""
    if out.total > CHANGES_STDOUT_LIMIT:
        raise CliError("helper_protocol", "ddistro_changes returned too much output.")
    try:
        doc = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        doc = None
    if type(doc) is dict and set(doc) == {"schema_version", "ok", "data", "error"}             and type(doc["schema_version"]) is int and doc["schema_version"] == 1:
        error = doc["error"]
        if doc["ok"] is True and code == 0 and type(doc["data"]) is dict and error is None:
            return doc["data"]
        if doc["ok"] is False and doc["data"] is None and type(error) is dict \
                and set(error) == {"code", "message", "details"} and error["code"] in ERRORS \
                and ERRORS[error["code"]] == code and code != 0 and type(error["message"]) is str \
                and type(error["details"]) is dict:
            raise CliError(error["code"], error["message"][:4096], error["details"])
    raise CliError("helper_protocol", "ddistro_changes returned an unexpected result.", {"helper_exit": code})


def changes_human(name, data):
    if name == "prepare":
        return f"Prepared task {data['task_id']} for {data['product']}.\nWorkspace: {data['workspace']}"
    if name in ("diff", "stage"):
        return (data["diff"] or "(no changes)\n") + f"manifest-sha256: {data['manifest_sha256']}"
    if name == "checkout":
        return "\n".join([f"Task {data['task_id']} round {data.get('round')}: workspace {data.get('workspace')}"]
                         + [f"  {f.get('state')}: {f.get('root')}:{f.get('path')}" for f in data.get("files") or []])
    if name == "rollback-preview":
        if not data.get("preview_sha256"):
            return f"{data['task_id']}: nothing to undo"
        return (data.get("diff") or "") + f"preview-sha256: {data['preview_sha256']}"
    if name == "list":
        return "\n".join(f"{t['task_id']}  {t['state']:<20} {t['product'] or '-'}" for t in data["tasks"])
    return f"{data['task_id']}: {data['state']} ({len(data.get('files') or [])} files)"


def cmd_changes(opts, ctx):
    name = ctx["command"].split(" ", 1)[1]
    if os.geteuid() != 0:
        raise CliError("permission_denied", "ddistro changes must run as root (for example with sudo). "
                       "ddistro never elevates by itself.")
    if name in ("apply", "rollback", "undo"):
        ctx["operation_id"] = str(uuid.uuid4())
    args = [name]
    if name in ("checkout", "rollback-preview", "undo"):
        args += ["--task", opts["task"]]
        for root, paths in opts["targets"]:
            args += ["--root", root]
            for path in paths:
                args += ["--path", path]
        if name == "undo":
            args += ["--preview-sha256", opts["preview-sha256"]]
    elif name == "prepare":
        args += ["--product", opts["product"]]
        for path in opts["paths"]:
            args += ["--path", path]
    elif name != "list":
        args.append(opts["task"])
    if name == "apply":
        args += ["--manifest-sha256", opts["manifest-sha256"]]
    code, out, _ = run_helper(args, CHANGES_TIMEOUT, CHANGES_STDOUT_LIMIT + 1, echo=not ctx["json"],
                              helper=CHANGES_HELPER, echo_stdout=False)
    data = changes_result(code, out)
    warnings = data.get("warnings", [])
    if type(warnings) is not list or len(warnings) > 400 or any(type(w) is not str for w in warnings):
        raise CliError("helper_protocol", "ddistro_changes returned malformed warnings.", {"helper_exit": code})
    if name == "stage" and data.get("diff_truncated") is not False:
        raise CliError("helper_protocol", "ddistro_changes staged a diff that is not complete.", {"helper_exit": code})
    for warning in dict.fromkeys(redact(w[:300]) for w in warnings):
        ctx["warnings"].append(warning)
    return data, changes_human(name, data)


def parse_changes(rest, ctx):
    if len(rest) < 2 or rest[1] not in CHANGES_SPEC:
        raise CliError("invalid_argument", "Expected changes " + "|".join(CHANGES_SPEC) + ".")
    name = rest[1]
    ctx["command"] = "changes " + name
    flags = CHANGES_SPEC[name].get("flags", [])
    opts, positional, args, index = {"paths": [], "targets": []}, [], rest[2:], 0
    while index < len(args):
        token = args[index]
        if token in flags:
            if index + 1 >= len(args):
                raise CliError("invalid_argument", f"{token} needs a value.")
            if token == "--root":
                if not CHANGES_ROOT.match(args[index + 1]):
                    raise CliError("invalid_argument", "--root must be a root id from ddistro access roots.")
                opts["targets"].append((args[index + 1], []))
            elif token == "--path" and name == "checkout":
                if not opts["targets"]:
                    raise CliError("invalid_argument", "Each --path must follow the --root it belongs to.")
                opts["targets"][-1][1].append(args[index + 1])
            elif token == "--path":
                opts["paths"].append(args[index + 1])
            elif token[2:] in opts:
                raise CliError("invalid_argument", f"{token} was given more than once.")
            else:
                opts[token[2:]] = args[index + 1]
            index += 2
            continue
        if token.startswith("-"):
            raise CliError("invalid_argument", f"Unsupported option for changes {name}: {token[:40]}")
        positional.append(token)
        index += 1
    if len(positional) != len(CHANGES_SPEC[name].get("arguments", [])):
        raise CliError("invalid_argument", f"Wrong number of arguments for changes {name}.\n" + USAGE)
    if positional:
        if not TASK_ID.match(positional[0]):
            raise CliError("invalid_argument", "TASK must be a lowercase task UUID from changes prepare.")
        opts["task"] = positional[0]
    if name == "prepare":
        if "product" not in opts:
            raise CliError("invalid_argument", "changes prepare requires --product.")
        opts["product"] = resolve_product(opts["product"])
        if len(opts["paths"]) > 200 or any(len(path) > 512 or "\0" in path for path in opts["paths"]):
            raise CliError("invalid_argument", "At most 200 --path values of up to 512 characters are allowed.")
    if name in ("checkout", "rollback-preview", "undo") and not TASK_ID.match(opts.get("task", "")):
        raise CliError("invalid_argument", f"changes {name} requires --task with the lowercase task UUID.")
    if name == "checkout":
        paths = [path for _, group in opts["targets"] for path in group]
        if not opts["targets"] or any(not group for _, group in opts["targets"]):
            raise CliError("invalid_argument", "changes checkout requires --root ROOT followed by at least one --path.")
        if len(paths) > 200 or any(not path or len(path) > 512 or "\0" in path for path in paths):
            raise CliError("invalid_argument", "At most 200 --path values of 1 to 512 characters are allowed.")
    if name == "undo" and not HASH.match(opts.get("preview-sha256", "")):
        raise CliError("invalid_argument", "changes undo requires --preview-sha256 with the 64-hex hash from rollback-preview.")
    if name == "apply" and not HASH.match(opts.get("manifest-sha256", "")):
        raise CliError("invalid_argument", "changes apply requires --manifest-sha256 with the 64-hex hash from stage.")
    return opts


# ddistro agent: the ddistro_agent helper owns the runtime, sandbox, and attestation. status and
# probe are validated into the normal envelope; serve replaces this process with the helper.
AGENT_STATUS_KEYS = {"installed", "probe_passed", "provider", "version", "reason"}
AGENT_TOKEN = re.compile(r"^[a-z][a-z0-9_]{0,63}\Z")  # status reasons and probe check names


def agent_helper_trusted():
    try:
        check_helper(AGENT_HELPER)
        return True
    except CliError:
        return False


FOUNDATION_HELPERS = (("agent", AGENT_HELPER), ("changes", CHANGES_HELPER), ("exec", EXEC_HELPER))
FOUNDATION_COMMANDS = ("exec", "changes checkout", "changes undo", "operations targets", "operations preview",
                       "operations apply")


def foundations_ready(access_available):
    """(features.assistant_foundations, reason): every helper trusted, the commands present here, and agent status
    reporting the runtime installed with a passing probe. Only agent status runs; never a probe or a model."""
    if not access_available:
        return False, "access_helper_untrusted"
    for name, path in FOUNDATION_HELPERS:
        try:
            check_helper(path)
        except CliError:
            return False, name + "_helper_untrusted"
    if not all(name in COMMANDS for name in FOUNDATION_COMMANDS):
        return False, "commands_missing"
    try:
        status = agent_status()
    except CliError as error:
        return False, "agent_status_" + error.code
    if not (status["installed"] and status["probe_passed"]):
        return False, status["reason"]
    # probe_passed can mean the legacy session only; managed exec needs its own attested canary.
    attested, reason = managed_exec_attested()
    if not attested:
        return False, reason
    return True, status["reason"]


# The root-owned probe attestation ddistro_agent writes (0644). Its optional managed exec canary counts only when it
# is bound to the helper bytes installed now, the CLI included, so replacing any of them needs a new probe.
ATTESTATION_FILE = "/var/lib/dwemerdistro/assistant/agent/attestation.json"
ATTESTATION_LIMIT = 64 * 1024
CLI_PATH = "/usr/local/bin/ddistro"
ATTESTED_HELPERS = (("access", ACCESS_MODULE), ("changes", CHANGES_HELPER), ("exec", EXEC_HELPER), ("cli", CLI_PATH))
ATTESTED_HELPER_LIMIT = 4 * 1024 * 1024


def read_root_file(path, limit):
    """Bytes of a root-owned, single-link regular file that only root can change, reached from / through root-owned
    directories only root can change, never following a link. Raises CliError with reason missing, untrusted or
    too_large."""
    def refuse(reason):
        return CliError("unsafe_path", f"{os.path.basename(path)} is not a trusted root-owned file.",
                        {"path": path, "reason": reason})

    def root_only(info):
        return info.st_uid == HELPER_OWNER_UID and not info.st_mode & 0o022

    parts = path.strip("/").split("/")
    directory = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    fd = os.open("/", directory)
    try:
        for index, part in enumerate(parts):
            last = index == len(parts) - 1
            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC if last else directory
            try:
                child = os.open(part, flags, dir_fd=fd)
            except FileNotFoundError:
                raise refuse("missing")
            except OSError:
                raise refuse("untrusted")
            os.close(fd)
            fd = child
            info = os.fstat(fd)
            if not root_only(info):
                raise refuse("untrusted")
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise refuse("untrusted")
        if info.st_size > limit:
            raise refuse("too_large")
        raw = bytearray()
        while len(raw) <= limit:
            chunk = os.read(fd, limit + 1 - len(raw))
            if not chunk:
                break
            raw += chunk
        if len(raw) > limit:
            raise refuse("too_large")
        return bytes(raw)
    finally:
        os.close(fd)


def managed_exec_attested():
    """(True, None) only when the attestation passed, records managed_exec_isolation true, and binds sha256 digests
    equal to the access, changes, exec and CLI files installed now; otherwise (False, reason)."""
    try:
        raw = read_root_file(ATTESTATION_FILE, ATTESTATION_LIMIT)
    except CliError as error:
        return False, "attestation_" + error.details["reason"]
    try:
        doc = json.loads(raw.decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        doc = None
    if type(doc) is not dict or doc.get("passed") is not True:
        return False, "attestation_invalid"
    optional = doc.get("optional_checks")
    if type(optional) is not dict or optional.get("managed_exec_isolation") is not True:
        return False, "managed_exec_unverified"
    bound = doc.get("managed_helpers")
    if type(bound) is not dict:
        return False, "attestation_helpers_missing"
    for name, path in ATTESTED_HELPERS:
        digest = bound.get(name)
        if type(digest) is not str or not HASH.match(digest):
            return False, name + "_digest_missing"
        try:
            current = hashlib.sha256(read_root_file(path, ATTESTED_HELPER_LIMIT)).hexdigest()
        except CliError:
            return False, name + "_helper_untrusted"
        if not hmac.compare_digest(current, digest):
            return False, name + "_digest_stale"
    return True, None


def live_run_ready(foundations):
    """(features.live_run, reason): the foundations are on, ddistro_run is a trusted root-owned file, and the passing
    attestation records its live_run_isolation canary for exactly the bytes installed now."""
    if not foundations:
        return False, "foundations_unavailable"
    try:
        current = hashlib.sha256(read_root_file(RUN_HELPER, ATTESTED_HELPER_LIMIT)).hexdigest()
    except CliError as error:
        return False, "run_helper_" + error.details.get("reason", "untrusted")
    try:
        doc = json.loads(read_root_file(ATTESTATION_FILE, ATTESTATION_LIMIT).decode("utf-8"),
                         parse_constant=reject_constant)
    except (CliError, ValueError):
        return False, "attestation_invalid"
    optional = doc.get("optional_checks") if type(doc) is dict and doc.get("passed") is True else None
    if type(optional) is not dict or optional.get("live_run_isolation") is not True:
        return False, "live_run_unverified"
    bound = doc.get("managed_helpers")
    digest = bound.get("run") if type(bound) is dict else None
    if type(digest) is not str or not hmac.compare_digest(current, digest):
        return False, "run_digest_stale"
    return True, None


def agent_document(out, keys):
    if out.total > AGENT_STDOUT_LIMIT:
        raise CliError("helper_protocol", "ddistro_agent returned too much output.")
    try:
        doc = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        doc = None
    if type(doc) is not dict or set(doc) != keys:
        raise CliError("helper_protocol", "ddistro_agent returned an unexpected result.")
    return doc


def agent_status():
    code, out, _ = run_helper(["status"], AGENT_STATUS_TIMEOUT, AGENT_STDOUT_LIMIT + 1, helper=AGENT_HELPER)
    doc = agent_document(out, AGENT_STATUS_KEYS)
    valid = (code == 0 and type(doc["installed"]) is bool and type(doc["probe_passed"]) is bool
             and (doc["installed"] or not doc["probe_passed"]) and doc["provider"] == "codex"
             and (doc["version"] is None or type(doc["version"]) is str and len(doc["version"]) <= 64)
             and type(doc["reason"]) is str and AGENT_TOKEN.match(doc["reason"]))
    if not valid:
        raise CliError("helper_protocol", "ddistro_agent returned an unexpected status.", {"helper_exit": code})
    return doc


def agent_human(data):
    return f"{data['provider']} {data['version'] or '-'}: {data['reason']}"


def cmd_agent_status(opts, ctx):
    data = agent_status()
    return data, agent_human(data)


def probe_diagnostics(value):
    """Bounded per-step exit status and redacted stderr lines; anything else is dropped."""
    steps = {}
    for name, step in list(value.items())[:8] if type(value) is dict else []:
        if not AGENT_TOKEN.match(name) or type(step) is not dict:
            continue
        clean = {}
        if type(step.get("exit")) is int:
            clean["exit"] = step["exit"]
        for key in ("failure", "error"):
            if type(step.get(key)) is str:
                clean[key] = clean_line(step[key][:64])
        lines = step.get("stderr")
        if type(lines) is list:
            clean["stderr"] = [clean_line(line[:300]) for line in lines[:20] if type(line) is str]
        steps[name] = clean
    return steps


def cmd_agent_probe(opts, ctx):
    if os.geteuid() != 0:
        raise CliError("permission_denied", "agent probe must run as root. ddistro never elevates by itself.")
    ctx["operation_id"] = str(uuid.uuid4())
    # The persistent API owns serve.lock even when idle; drain it before probing.
    api = "/usr/local/bin/ddistro_api"
    if os.environ.get("DDISTRO_ASSISTANT_MAINTENANCE") != "1" and os.path.isfile(api):
        code, out, _ = run_helper(["maintenance", AGENT_HELPER, "probe"], AGENT_PROBE_TIMEOUT,
                                  AGENT_STDOUT_LIMIT + 1, helper=api)
    else:
        code, out, _ = run_helper(["probe"], AGENT_PROBE_TIMEOUT, AGENT_STDOUT_LIMIT + 1, helper=AGENT_HELPER)
    if code == 75:
        raise CliError("busy", "Assistant work is running. Wait for it to finish, then try the isolation check again.")
    doc = agent_document(out, {"passed", "checks", "diagnostics"})
    checks = doc["checks"]
    if type(checks) is not dict or len(checks) > 64 or not all(
            type(name) is str and AGENT_TOKEN.match(name) and type(value) is bool for name, value in checks.items()):
        raise CliError("helper_protocol", "ddistro_agent returned malformed probe checks.", {"helper_exit": code})
    if type(doc["passed"]) is not bool or code != (0 if doc["passed"] else 1) or doc["passed"] != (
            bool(checks) and all(checks.values())):
        raise CliError("helper_protocol", "ddistro_agent returned an inconsistent probe result.", {"helper_exit": code})
    # Failed checks first, so a short list still shows what is wrong.
    rows = sorted(({"name": name, "passed": value} for name, value in checks.items()), key=lambda row: row["passed"])
    data = {"passed": doc["passed"], "checks": rows, "diagnostics": probe_diagnostics(doc["diagnostics"])}
    data.update(agent_status())
    human = "\n".join([("Isolation check passed." if data["passed"] else "Isolation check failed.") + " " + agent_human(data)]
                      + [f"  {'ok  ' if row['passed'] else 'FAIL'} {row['name']}" for row in rows])
    return data, human


HOME_CONFIG_KEYS = {"state", "reason", "file", "sha256", "size", "receipt"}
HOME_CONFIG_STATES = ("clean", "repairable", "refused", "busy", "repaired")


def agent_home_config(args, repair):
    """Validated ddistro_agent home-config document: the status (a dry run with its proposal) or a repair result."""
    code, out, _ = run_helper(args, AGENT_STATUS_TIMEOUT, AGENT_STDOUT_LIMIT + 1, helper=AGENT_HELPER)
    doc = agent_document(out, HOME_CONFIG_KEYS)
    state, receipt = doc["state"], doc["receipt"]
    # Exit status per state: a refusal before inspection (root, identity, layout) exits 1 even for a status.
    if state == "busy":
        codes = (75,)
    elif state == "refused":
        codes = (1,) if repair else (0, 1)
    elif state == "repaired":
        codes = (0,) if repair else ()
    else:
        codes = (0,)
    valid = (state in HOME_CONFIG_STATES and code in codes and doc["file"] == "config.toml"
             and (doc["reason"] is None or type(doc["reason"]) is str and bool(AGENT_TOKEN.match(doc["reason"])))
             and (doc["sha256"] is None or type(doc["sha256"]) is str and bool(HASH.match(doc["sha256"])))
             and (state != "repairable" or doc["sha256"] is not None)
             and (doc["size"] is None or type(doc["size"]) is int and 0 <= doc["size"] <= 64 * 1024)
             and (receipt is None or type(receipt) is dict and set(receipt) == {"id", "path"}
                  and all(type(value) is str and len(value) <= 256 for value in receipt.values())))
    if not valid:
        raise CliError("helper_protocol", "ddistro_agent returned an unexpected home-config result.", {"helper_exit": code})
    if doc["state"] == "busy":
        raise CliError("busy", "An assistant session or isolation check is running. Close it before repairing.")
    if repair and doc["state"] != "repaired":
        raise CliError("refused", "The account-home config was not repaired.", {"reason": doc["reason"]})
    return doc


def home_config_human(data):
    if data["state"] == "repairable":
        return f"config.toml holds only the known workspace trust entry; repair with --sha256 {data['sha256']}"
    if data["state"] == "repaired":
        return f"config.toml moved to quarantine {data['receipt']['path']}"
    return f"account home config: {data['state']}" + (f" ({data['reason']})" if data["reason"] else "")


def cmd_agent_home_config(opts, ctx):
    if os.geteuid() != 0:
        raise CliError("permission_denied", "agent home-config must run as root. ddistro never elevates by itself.")
    data = agent_home_config(["home-config"], False)
    return data, home_config_human(data)


def cmd_agent_home_config_repair(opts, ctx):
    if os.geteuid() != 0:
        raise CliError("permission_denied", "agent home-config-repair must run as root. ddistro never elevates by itself.")
    ctx["operation_id"] = str(uuid.uuid4())
    data = agent_home_config(["home-config", "--repair", "--sha256", opts["sha256"]], True)
    return data, home_config_human(data)


def serve_refusal(error, reason, exit_code):
    """agent serve owns stdout for JSONL, so its own refusals are one JSON line on stderr only."""
    try:
        sys.stderr.write(json.dumps({"error": error, "reason": reason}) + "\n")
        sys.stderr.flush()
    except OSError:
        pass
    return exit_code


def agent_serve(args):
    """Exactly agent serve --task TASK: validated here, then this process becomes the root helper."""
    if len(args) != 2 or args[0] != "--task" or not TASK_ID.match(args[1]):
        return serve_refusal("invalid_argument", "usage: agent serve --task TASK (no other options)", 64)
    if os.geteuid() != 0:
        return serve_refusal("assistant_unavailable", "requires_root", 3)
    try:
        api = "/usr/local/bin/ddistro_api"
        check_helper(api)
        os.chdir("/")
        os.execve(api, [api, "bridge", "--task", args[1]],
                  {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"})
    except CliError:
        return serve_refusal("assistant_unavailable", "helper_unavailable", 3)
    except OSError:
        return serve_refusal("assistant_unavailable", "helper_unavailable", 3)


# ddistro models herika: the CHIM connector assigned to each role of each configured profile,
# read-only from the local dwemer database as the postgres superuser over the Unix socket.
# Only fixed, explicitly public-qualified SQL built from the constants below ever runs; there
# are no SQL, schema, or database arguments, no PHP, and no secret-bearing columns are read.
MODELS_RUNUSER = "/usr/sbin/runuser"
MODELS_PSQL = "/usr/bin/psql"
MODELS_SOCKET = "/var/run/postgresql"
MODELS_DATABASE = "dwemer"
# Model settings (options, preview, readback, apply, undo) always use the production socket and port: the write and
# every read it is checked against reach the same database, whatever DDISTRO_POSTGRES_PORT says.
MODEL_SETTINGS_PORT = "5432"
MODELS_TIMEOUT = 30
MODELS_MAX = 200
MODELS_STRING_CHARS = 256
MODELS_FIELD_CHARS = 512  # clipped in SQL, before redaction and the final 256-character bound
MODELS_STDOUT_LIMIT = 4 * 1024 * 1024
# (role, core_profiles field), in HerikaServer's order; roles whose field is missing are skipped.
MODELS_ROLES = (("standard", "llm_primary_id"), ("fast", "llm_secondary_id"), ("powerful", "llm_tertiary_id"),
                ("experimental", "llm_quaternary_id"), ("formatter", "llm_formatter_id"),
                ("fallback", "llm_fallback_id"), ("diary", "diary_connector_id"))
MODELS_REQUIRED = {"core_profiles.id", "core_profiles.label", "core_llm_connector.id", "core_llm_connector.label",
                   "core_llm_connector.model", "core_llm_connector.provider", "core_llm_connector.driver"}
MODELS_COLUMNS = MODELS_REQUIRED | {"core_profiles." + field for _, field in MODELS_ROLES}


def check_system_binary(path):
    """check_helper, also accepting one root-owned symlink hop (Debian's psql links to pg_wrapper)."""
    try:
        info = os.lstat(path)
    except OSError:
        info = None
    if info is not None and stat.S_ISLNK(info.st_mode):
        parent = os.stat(os.path.dirname(path))
        if info.st_uid != HELPER_OWNER_UID or parent.st_uid != HELPER_OWNER_UID or parent.st_mode & 0o022:
            raise CliError("helper_unavailable", "untrusted link", {"helper": path, "reason": "untrusted"})
        path = os.path.normpath(os.path.join(os.path.dirname(path), os.readlink(path)))
    check_helper(path)


def models_psql(sql, keep, timeout=MODELS_TIMEOUT, appname="ddistro-models", port=None):
    """Run one fixed read-only query; returns (exit code, stdout bytes). stderr is never returned.
    Without port, the port is DDISTRO_POSTGRES_PORT when valid (the read-only models listing), else 5432."""
    if port is None:
        port = os.environ.get("DDISTRO_POSTGRES_PORT", "")
        port = port if re.match(r"^[0-9]{1,5}\Z", port) and 0 < int(port) < 65536 else "5432"
    env = {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PGCONNECT_TIMEOUT": "5",
           "PGAPPNAME": appname, "PGTZ": "UTC",
           "PGOPTIONS": "-c default_transaction_read_only=on -c statement_timeout=10000 -c lock_timeout=2000 "
                        "-c idle_in_transaction_session_timeout=10000 -c search_path=pg_catalog"}
    args = ["-u", "postgres", "--", MODELS_PSQL, "-X", "-A", "-t", "-q", "--no-password", "-v", "ON_ERROR_STOP=1",
            "-h", MODELS_SOCKET, "-p", port, "-d", MODELS_DATABASE, "-1",
            "-c", "SET TRANSACTION READ ONLY", "-c", sql]
    code, out, _ = run_helper(args, timeout, keep + 1, helper=MODELS_RUNUSER, env=env)
    if code == 0 and out.total > keep:
        raise CliError("helper_protocol", "output too large", {"reason": "unexpected_output"})
    return code, bytes(out.data)


def models_columns():
    names = ", ".join(f"'{name.split('.')[1]}'" for name in sorted(MODELS_COLUMNS))
    code, raw = models_psql("SELECT table_name || '.' || column_name FROM information_schema.columns "
                            "WHERE table_schema = 'public' AND table_name IN ('core_profiles', 'core_llm_connector') "
                            f"AND column_name IN ({names})", 64 * 1024)
    if code != 0:
        return code, None
    # Intersected with the allowlist, so only our own constants are ever put into SQL.
    return 0, MODELS_COLUMNS & set(raw.decode("utf-8", "replace").split("\n"))


def models_text(value):
    if value is None:
        return ""
    # clean_line keeps tabs and newlines (log rows are already split); one-line values here.
    return clean_line(re.sub(r"[\t\r\n]", " ", value[:MODELS_FIELD_CHARS]))[:MODELS_STRING_CHARS]


def models_rows(raw, roles):
    rows = []
    for line in raw.decode("utf-8").split("\n"):
        if not line:
            continue
        row = json.loads(line, parse_constant=reject_constant)
        if type(row) is not list or len(row) != 8 or type(row[0]) is not int or type(row[3]) is not int \
                or row[2] not in roles or any(row[i] is not None and type(row[i]) is not str for i in (1, 4, 5, 6, 7)):
            raise ValueError("row")
        rows.append({"profile_id": row[0], "profile": models_text(row[1]), "role": row[2], "connector_id": row[3],
                     "connector": models_text(row[4]), "model": models_text(row[5]),
                     "provider": models_text(row[6]), "driver": models_text(row[7])})
    return rows


def models_query():
    """Returns (assignments, truncated, reason); reason is empty only when the read succeeded."""
    if os.geteuid() != 0:
        return [], False, "requires_root"
    try:
        check_system_binary(MODELS_PSQL)
        pwd.getpwnam("postgres")
    except (CliError, KeyError, OSError):
        return [], False, "helper_unavailable"
    try:
        code, columns = models_columns()
        if code == 0 and not MODELS_REQUIRED <= columns:
            return [], False, "schema_missing"
        roles = [(order, role, field) for order, (role, field) in enumerate(MODELS_ROLES)
                 if "core_profiles." + field in (columns or ())]
        if code == 0 and not roles:
            return [], False, "schema_missing"
        if code == 0:
            values = ", ".join(f"({order}, '{role}', p.{field})" for order, role, field in roles)
            text = ", ".join(f"left({column}::text, {MODELS_FIELD_CHARS})"
                             for column in ("c.label", "c.model", "c.provider", "c.driver"))
            code, raw = models_psql(
                f"SELECT json_build_array(p.id, left(p.label::text, {MODELS_FIELD_CHARS}), r.role, c.id, {text}) "
                f"FROM public.core_profiles AS p CROSS JOIN LATERAL (VALUES {values}) AS r(ord, role, connector_id) "
                "JOIN public.core_llm_connector AS c ON c.id = r.connector_id "
                f"ORDER BY p.id, r.ord LIMIT {MODELS_MAX + 1}", MODELS_STDOUT_LIMIT)
    except CliError as error:
        if error.code == "cancelled":
            raise
        return [], False, {"timeout": "timeout", "helper_protocol": "unexpected_output"}.get(
            error.code, "helper_unavailable")
    if code != 0:
        # psql exits 2 when it cannot connect (server down, database missing); other failures are generic.
        return [], False, "database_unavailable" if code == 2 else "query_failed"
    try:
        rows = models_rows(raw, {role for _, role, _ in roles})
    except ValueError:
        return [], False, "unexpected_output"
    return rows[:MODELS_MAX], len(rows) > MODELS_MAX, ""


def cmd_models(opts, ctx):
    product = opts["product"]
    if product != "herika":
        raise CliError("unsupported", "ddistro models currently supports only herika (chim, skyrim).",
                       {"product": product})
    captured_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    assignments, truncated, reason = models_query()
    data = {"product": product, "available": not reason, "scope": "configured_profiles", "captured_at": captured_at,
            "assignments": assignments, "truncated": truncated, "reason": reason}
    if reason:
        return data, f"herika model assignments unavailable: {reason}"
    lines = ["Configured CHIM profile model assignments (not necessarily the active NPC profile):"]
    lines += [f"  {a['profile_id']:>4} {a['profile'] or '-':<24} {a['role']:<12} {a['model'] or '-'} "
              f"({a['provider'] or '-'}/{a['driver'] or '-'}, connector {a['connector_id']} {a['connector'] or '-'})"
              for a in assignments] or ["  (none)"]
    if truncated:
        lines.append(f"  ... truncated to {MODELS_MAX} assignments")
    return data, "\n".join(lines)


# --- Model assignment settings ---------------------------------------------------------
# ddistro models options|preview|apply|rollback-preview|rollback herika: the one setting the Assistant can change.
# A change points one MODELS_ROLES field of one CHIM profile (public.core_profiles) at an existing
# public.core_llm_connector id. Connector rows (model, URL, keys), conf.php and every other column are never written.
# SQL is fixed: only a field from MODELS_ROLES, validated integers and xmin digits are formatted into it, and labels
# and models are only read. A preview writes nothing to the database. It stores a root-private receipt with the exact
# before and after values and both rows' versions (xmin, which every committed UPDATE changes), and apply and rollback
# use them as compare-and-swap conditions in one transaction, so any edit in between, even one that restores the
# same value, is a conflict and is never overwritten. Receipts hold ids, labels, models and versions, never whole rows.
MODEL_RECEIPTS_DIR_NAME = "model-receipts"
MODEL_RECEIPTS_LOCK = "receipts.lock"
MODEL_RECEIPT_ID = re.compile(r"^[0-9a-f]{32}\Z")
MODEL_ID_TEXT = re.compile(r"^[1-9][0-9]{0,9}\Z")
MODEL_VERSION = re.compile(r"^[0-9]{1,10}\Z")
MODEL_ID_MAX = 2147483647
MODEL_VALUE_MAX = 2 ** 63 - 1
MODEL_PREVIEW_SECONDS = 120
MODEL_RECEIPT_DAYS = 30
MODEL_RECEIPTS_MAX = 200
# The receipt directory holds at most this many entries of any kind (receipts, the lock, leftover temporaries);
# more means it was not written by us, so the whole store is refused rather than partly read.
MODEL_RECEIPTS_ENTRIES = 4 * MODEL_RECEIPTS_MAX
# A write that may be in progress or whose outcome is unknown: its receipt is never dropped to make room.
MODEL_RECEIPTS_PROTECTED = ("applying", "rolling_back", "unknown")
MODEL_RECEIPT_BYTES = 16 * 1024
MODEL_LOCK_WAIT = 5.0
MODEL_INTEGER_TYPES = ("integer", "smallint", "bigint")
MODEL_ROLE_FIELDS = dict(MODELS_ROLES)
MODEL_SUBCOMMANDS = ("options", "preview", "apply", "rollback-preview", "rollback")
MODEL_RECEIPT_STATES = ("previewed", "applying", "applied", "conflict", "not_executed", "unknown", "rolling_back",
                        "rolled_back")
MODEL_RECEIPT_KEYS = {"schema", "id", "kind", "product", "created_at", "expires_at", "task_id", "thread_id", "profile",
                      "role", "field", "before", "after", "versions", "plan_sha256", "state", "applied", "rollback"}
# Write sessions get the same bounds as reads, without read-only. psql exits 0 only when COMMIT succeeded; any other
# ending is resolved from a fresh read (model_settle), never guessed.
MODEL_WRITE_OPTIONS = ("-c statement_timeout=10000 -c lock_timeout=2000 -c idle_in_transaction_session_timeout=10000 "
                       "-c search_path=pg_catalog")


def model_untrusted(what):
    return CliError("unsafe_path", f"The model change receipts {what} is not private to root; nothing was read or "
                    "changed.", {"reason": "receipts_untrusted", "location": what})


def model_settings_ready():
    if os.geteuid() != 0:
        raise CliError("permission_denied", "ddistro model changes must run as root. ddistro never elevates by itself.")
    try:
        check_system_binary(MODELS_PSQL)
        pwd.getpwnam("postgres")
    except (CliError, KeyError, OSError):
        raise CliError("helper_unavailable", "psql or the postgres account is not available.",
                       {"reason": "helper_unavailable"})


def model_psql_ok(code):
    if code == 2:
        raise CliError("failed", "The CHIM database is not reachable.", {"reason": "database_unavailable"})
    if code != 0:
        raise CliError("failed", "The CHIM database read failed.", {"reason": "query_failed"})


def model_read(sql):
    """One read-only query that returns a single JSON object."""
    code, raw = models_psql(sql, MODELS_STDOUT_LIMIT, appname="ddistro-model-settings", port=MODEL_SETTINGS_PORT)
    model_psql_ok(code)
    try:
        doc = json.loads(raw.decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        doc = None
    if type(doc) is not dict:
        raise CliError("helper_protocol", "The CHIM database returned an unexpected result.", {"reason": "unexpected_output"})
    return doc


def model_fields():
    """[(role, field)] whose field exists with an integer type; the profile and connector tables must exist."""
    names = ", ".join(f"'{name.split('.')[1]}'" for name in sorted(MODELS_COLUMNS))
    code, raw = models_psql("SELECT table_name || '.' || column_name || ':' || data_type FROM information_schema.columns "
                            "WHERE table_schema = 'public' AND table_name IN ('core_profiles', 'core_llm_connector') "
                            f"AND column_name IN ({names})", 64 * 1024, appname="ddistro-model-settings",
                            port=MODEL_SETTINGS_PORT)
    model_psql_ok(code)
    types = {}
    for line in raw.decode("utf-8", "replace").split("\n"):
        name, _, kind = line.partition(":")
        if name in MODELS_COLUMNS:
            types[name] = kind
    if not MODELS_REQUIRED <= set(types) or any(types[key] not in MODEL_INTEGER_TYPES
                                                for key in ("core_profiles.id", "core_llm_connector.id")):
        raise CliError("unsupported", "This CHIM database does not have the expected profile and connector tables.",
                       {"reason": "schema_missing"})
    return [(role, field) for role, field in MODELS_ROLES if types.get("core_profiles." + field) in MODEL_INTEGER_TYPES]


def model_field(role):
    field = dict(model_fields()).get(role)
    if field is None:
        raise CliError("unsupported", f"This CHIM database has no {role} role field that can be set.",
                       {"reason": "role_unsupported", "role": role})
    return field


def model_sql_value(value):
    """An integer or NULL for SQL, from a value already typed as int or None; anything else is an internal error."""
    if value is None:
        return "NULL"
    if type(value) is not int or abs(value) > MODEL_VALUE_MAX:
        raise CliError("internal_error", "invalid model value")
    return "%d" % value


def model_sql_version(version):
    if type(version) is not str or not MODEL_VERSION.match(version):
        raise CliError("internal_error", "invalid row version")
    return version


def model_connector_sql(alias):
    text = ", ".join(f"'{name}', left({alias}.{name}::text, {MODELS_FIELD_CHARS})"
                     for name in ("label", "model", "provider", "driver"))
    return f"json_build_object('id', {alias}.id, {text}, 'version', {alias}.xmin::text)"


def model_connector(value, versioned=False):
    """The displayed, non-secret fields of one connector row; None for null; anything else is unexpected output."""
    if value is None:
        return None
    keys = {"id", "label", "model", "provider", "driver", "version"}
    if (type(value) is not dict or set(value) != keys or type(value["id"]) is not int
            or any(value[key] is not None and type(value[key]) is not str for key in keys - {"id"})
            or type(value["version"]) is not str or not MODEL_VERSION.match(value["version"])):
        raise CliError("helper_protocol", "The CHIM database returned an unexpected connector.", {"reason": "unexpected_output"})
    view = {"id": value["id"], "label": models_text(value["label"]), "model": models_text(value["model"]),
            "provider": models_text(value["provider"]), "driver": models_text(value["driver"])}
    if versioned:
        view["version"] = value["version"]
    return view


def model_snapshot(field, profile_id, connector_id):
    """The profile's role value and row version, the connector it uses now, and connector_id's row (if any), read in
    one read-only snapshot. profile is None when there is no such profile."""
    p = model_sql_value(profile_id)
    doc = model_read(
        "SELECT json_build_object("
        f"'profile', (SELECT json_build_object('id', p.id, 'label', left(p.label::text, {MODELS_FIELD_CHARS}), "
        f"'value', p.{field}, 'version', p.xmin::text) FROM public.core_profiles AS p WHERE p.id = {p}), "
        f"'current', (SELECT {model_connector_sql('c')} FROM public.core_profiles AS p "
        f"JOIN public.core_llm_connector AS c ON c.id = p.{field} WHERE p.id = {p}), "
        f"'target', (SELECT {model_connector_sql('c')} FROM public.core_llm_connector AS c "
        f"WHERE c.id = {model_sql_value(connector_id)}))")
    profile = doc.get("profile")
    if set(doc) != {"profile", "current", "target"} or profile is not None and (
            type(profile) is not dict or set(profile) != {"id", "label", "value", "version"} or profile["id"] != profile_id
            or profile["label"] is not None and type(profile["label"]) is not str
            or profile["value"] is not None and (type(profile["value"]) is not int or abs(profile["value"]) > MODEL_VALUE_MAX)
            or type(profile["version"]) is not str or not MODEL_VERSION.match(profile["version"])):
        raise CliError("helper_protocol", "The CHIM database returned an unexpected profile.", {"reason": "unexpected_output"})
    if profile is not None:
        profile = dict(profile, label=models_text(profile["label"]))
    return {"profile": profile, "current": model_connector(doc["current"], True),
            "target": model_connector(doc["target"], True)}


def model_assign(field, profile_id, expected, value, profile_version, connector=None):
    """The one database write. In one transaction it sets one role field of one profile to value, only while the
    profile row is still exactly profile_version with the expected value and, when connector (id, version) is given,
    that connector row is still exactly that version, share-locked against change or deletion until commit.
    Returns ("committed", new row version), ("conflict", None) or ("error", None); the caller resolves an error."""
    if field not in MODEL_ROLE_FIELDS.values() or type(profile_id) is not int or not 0 < profile_id <= MODEL_ID_MAX:
        raise CliError("internal_error", "invalid model change")
    guard, prefix = "", "WITH "
    if connector is not None:
        prefix = (f"WITH target AS (SELECT c.id FROM public.core_llm_connector AS c WHERE c.id = "
                  f"{model_sql_value(connector[0])} AND c.xmin::text = '{model_sql_version(connector[1])}' FOR SHARE), ")
        guard = " AND EXISTS (SELECT 1 FROM target)"
    sql = (prefix + f"changed AS (UPDATE public.core_profiles AS p SET {field} = {model_sql_value(value)} "
           f"WHERE p.id = {profile_id} AND p.xmin::text = '{model_sql_version(profile_version)}' "
           f"AND p.{field} IS NOT DISTINCT FROM {model_sql_value(expected)}{guard} RETURNING p.xmin::text AS version) "
           "SELECT json_build_object('updated', (SELECT count(*) FROM changed), 'version', (SELECT min(version) FROM changed))")
    env = {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PGCONNECT_TIMEOUT": "5",
           "PGAPPNAME": "ddistro-model-settings", "PGTZ": "UTC", "PGOPTIONS": MODEL_WRITE_OPTIONS}
    args = ["-u", "postgres", "--", MODELS_PSQL, "-X", "-A", "-t", "-q", "--no-password", "-v", "ON_ERROR_STOP=1",
            "-h", MODELS_SOCKET, "-p", MODEL_SETTINGS_PORT, "-d", MODELS_DATABASE, "-1", "-c", sql]
    try:
        code, out, _ = run_helper(args, MODELS_TIMEOUT, 4096, helper=MODELS_RUNUSER, env=env)
    except CliError as error:
        if error.code == "cancelled":
            raise
        return "error", None
    try:
        doc = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant) if code == 0 else None
    except ValueError:
        doc = None
    if type(doc) is dict and doc.get("updated") == 0 and doc.get("version") is None:
        return "conflict", None
    if type(doc) is dict and doc.get("updated") == 1 and type(doc.get("version")) is str and MODEL_VERSION.match(doc["version"]):
        return "committed", doc["version"]
    return "error", None


def model_settle(field, profile_id, expected, version, value, outcome):
    """The state of one attempted write: verified or unverified (committed; a fresh read does or does not show value),
    conflict (the compare-and-swap matched nothing), not_executed (an error, and a fresh read proves nothing was
    committed to the row since: same version and value), or unknown."""
    kind, new_version = outcome
    if kind == "conflict":
        return "conflict", None
    try:
        fresh = model_snapshot(field, profile_id, None)["profile"]
    except CliError as error:
        if error.code == "cancelled":
            raise
        fresh = None
    if kind == "committed":
        verified = fresh is not None and fresh["value"] == value and type(fresh["value"]) is type(value)
        return ("verified" if verified else "unverified"), new_version
    if fresh is not None and fresh["version"] == version and fresh["value"] == expected:
        return "not_executed", None
    return "unknown", None


def model_plan_sha256(receipt, rollback=None):
    """The confirmation for exactly one previewed write: the receipt id, row, field, both values and versions, expiry."""
    if rollback is None:
        plan = ["apply", receipt["id"], receipt["profile"]["id"], receipt["field"], receipt["before"]["value"],
                receipt["after"]["value"], receipt["versions"], receipt["expires_at"]]
    else:
        plan = ["rollback", receipt["id"], receipt["profile"]["id"], receipt["field"], receipt["after"]["value"],
                receipt["before"]["value"], receipt["applied"]["version"], rollback["connector_version"],
                rollback["expires_at"]]
    return hashlib.sha256(json.dumps(plan, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def model_receipt_valid(receipt, receipt_id):
    def side(value):
        return (type(value) is dict and set(value) == {"value", "connector"}
                and (value["value"] is None or type(value["value"]) is int)
                and (value["connector"] is None or type(value["connector"]) is dict))
    return (type(receipt) is dict and set(receipt) == MODEL_RECEIPT_KEYS and receipt["schema"] == 1
            and receipt["id"] == receipt_id and receipt["kind"] == "model_assignment" and receipt["product"] == "herika"
            and type(receipt["created_at"]) is int and type(receipt["expires_at"]) is int
            and receipt["state"] in MODEL_RECEIPT_STATES and MODEL_ROLE_FIELDS.get(receipt["role"]) == receipt["field"]
            and type(receipt["profile"]) is dict and type(receipt["profile"].get("id")) is int
            and side(receipt["before"]) and side(receipt["after"]) and type(receipt["after"]["value"]) is int
            and type(receipt["versions"]) is dict and type(receipt["plan_sha256"]) is str
            and (receipt["applied"] is None or type(receipt["applied"]) is dict)
            and (receipt["rollback"] is None or type(receipt["rollback"]) is dict))


class ModelReceipts:
    """The root-private receipt directory, held under its own lock file for every read-check-write.

    The directory is root's with mode 0700 below root-owned parents (memory_directory's checks), each receipt is a
    root-owned 0600 single-link regular file opened without following links, and writes replace it atomically."""

    # Subclasses (OperationReceipts) override these four to keep a separate store with its own receipt shape.
    DIR_NAME, MAX_BYTES = MODEL_RECEIPTS_DIR_NAME, MODEL_RECEIPT_BYTES
    BUSY = "Another model change is being prepared or applied. Try again."
    untrusted, valid = staticmethod(model_untrusted), staticmethod(model_receipt_valid)

    def __init__(self, create):
        self.create = create
        self.directory = None
        self.lock = None

    def __enter__(self):
        old_umask = os.umask(0o077)
        try:
            self.directory = memory_directory(self.create, name=self.DIR_NAME, untrusted=self.untrusted)
            if self.directory is None:
                return self
            try:
                self.lock = os.open(self.directory + "/" + MODEL_RECEIPTS_LOCK,
                                    os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
            except OSError:
                raise self.untrusted("lock file")
            if not memory_file_ok(os.fstat(self.lock)):
                raise self.untrusted("lock file")
            deadline = time.monotonic() + MODEL_LOCK_WAIT
            while True:
                try:
                    fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() > deadline:
                        raise CliError("busy", self.BUSY)
                    time.sleep(0.1)
            # The lock only serializes writers if every one locked the same file: the path must still name it.
            held = os.fstat(self.lock)
            try:
                named = os.lstat(self.directory + "/" + MODEL_RECEIPTS_LOCK)
            except OSError:
                raise self.untrusted("lock file")
            if (named.st_dev, named.st_ino) != (held.st_dev, held.st_ino) or not memory_file_ok(held):
                raise self.untrusted("lock file")
            return self
        except BaseException:
            self.__exit__(None, None, None)
            raise
        finally:
            os.umask(old_umask)

    def __exit__(self, *exc):
        if self.lock is not None:
            os.close(self.lock)
            self.lock = None
        return False

    def path(self, receipt_id):
        return f"{self.directory}/{receipt_id}.json"

    def load(self, receipt_id):
        if self.directory is None or not MODEL_RECEIPT_ID.match(receipt_id):
            return None
        try:
            fd = os.open(self.path(receipt_id), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        except FileNotFoundError:
            return None
        except OSError:
            raise self.untrusted("receipt")
        try:
            if not memory_file_ok(os.fstat(fd)):
                raise self.untrusted("receipt")
            raw = os.read(fd, self.MAX_BYTES + 1)
        finally:
            os.close(fd)
        try:
            receipt = json.loads(raw.decode("utf-8"), parse_constant=reject_constant) if len(raw) <= self.MAX_BYTES else None
        except ValueError:
            receipt = None
        if not self.valid(receipt, receipt_id):
            raise self.untrusted("receipt")
        return receipt

    def save(self, receipt):
        data = json.dumps(receipt, sort_keys=True, separators=(",", ":")).encode("utf-8")
        if len(data) > self.MAX_BYTES:
            raise CliError("internal_error", "receipt too large")
        temporary = f"{self.directory}/.{receipt['id']}.{os.getpid()}.tmp"
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        try:
            try:
                view = memoryview(data)
                while view:
                    view = view[os.write(fd, view):]
                os.fsync(fd)
            finally:
                os.close(fd)
            os.replace(temporary, self.path(receipt["id"]))
        except BaseException:
            try:
                os.unlink(temporary)
            except OSError:
                pass
            raise
        directory = os.open(self.directory, INVENTORY_DIR_FLAGS)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)

    def receipts(self):
        """Every receipt, newest first; a file that is not a valid receipt, or a directory with more than
        MODEL_RECEIPTS_ENTRIES entries, stops the scan as untrusted, so no receipt is ever silently left out."""
        names = []
        with os.scandir(self.directory) as entries:
            for count, entry in enumerate(entries):
                if count >= MODEL_RECEIPTS_ENTRIES:
                    raise self.untrusted("receipt directory")
                if entry.name.endswith(".json") and MODEL_RECEIPT_ID.match(entry.name[:-5]):
                    names.append(entry.name[:-5])
        found = [self.load(name) for name in sorted(names)]
        return sorted((r for r in found if r is not None), key=lambda r: (r["created_at"], r["id"]), reverse=True)

    def next_write(self):
        """The sequence number for a write starting now: one past every write recorded in the store. It is taken while
        the store lock is held, and writes are also serialized by the maintenance lock, so no two writes share one and
        a later write always has the larger, whatever the clock or the receipt ids say."""
        return 1 + max((model_write_order(r) or 0 for r in self.receipts()), default=0)

    def prune(self, now):
        """Makes room for one new receipt. Drops unused previews once expired and finished receipts after
        MODEL_RECEIPT_DAYS, then, past MODEL_RECEIPTS_MAX, the oldest that are not protected. A receipt whose write may be
        in progress (applying, rolling_back) is never dropped by age, and no protected receipt (those two and unknown) is
        dropped for room: when they alone fill the store, nothing is deleted and the new preview is refused."""
        kept = []
        for receipt in self.receipts():
            unused = receipt["state"] in ("previewed", "conflict", "not_executed") and receipt["expires_at"] < now
            old = receipt["created_at"] < now - MODEL_RECEIPT_DAYS * 86400 and receipt["state"] not in ("applying", "rolling_back")
            if unused or old:
                os.unlink(self.path(receipt["id"]))
            else:
                kept.append(receipt)
        excess = len(kept) - (MODEL_RECEIPTS_MAX - 1)
        if excess <= 0:
            return
        # kept is newest first, so the oldest removable receipts are taken from its end.
        removable = [r for r in reversed(kept) if r["state"] not in MODEL_RECEIPTS_PROTECTED][:excess]
        if len(removable) < excess:
            raise CliError("busy", "Too many model changes are unfinished or have an unknown outcome to record another. "
                           "No model setting was changed.", {"reason": "receipts_full"})
        for receipt in removable:
            os.unlink(self.path(receipt["id"]))


def model_write_order(receipt):
    """The store sequence of the receipt's latest write attempt (its apply, or its undo once that started), or None for
    a receipt saved before sequences were recorded. It lives in the receipt's applied and rollback metadata."""
    orders = [part.get("seq") for part in (receipt["applied"], receipt["rollback"]) if type(part) is dict]
    orders = [order for order in orders if type(order) is int and order > 0]
    return max(orders) if orders else None


def model_last_change(receipts):
    """The latest write among one task's and thread's receipts, by store sequence only: never by preview time, which
    has whole-second ties and is not apply order, and never by the random receipt id. With more than one candidate, any
    receipt without a sequence (an older receipt) or a repeated sequence makes the order unknowable, so it is refused."""
    if len(receipts) < 2:
        return receipts[0] if receipts else None
    orders = [model_write_order(r) for r in receipts]
    if None in orders or len(set(orders)) != len(orders):
        raise CliError("refused", "The order of this conversation's model changes is not known, so its last change "
                       "cannot be picked safely. Nothing was prepared.", {"reason": "history_ambiguous"})
    return max(zip(orders, receipts), key=lambda pair: pair[0])[1]


def model_change_view(receipt, undo=False):
    """The exact change a receipt makes (or, with undo, reverses): profile, role and both assignments, plus plain diff lines."""
    before, after = (receipt["after"], receipt["before"]) if undo else (receipt["before"], receipt["after"])

    def line(sign, side):
        connector, value = side["connector"], side["value"]
        if value is None:
            return f"{sign} unset (no connector)"
        if connector is None:
            return f"{sign} connector {value}: no such connector"
        return (f"{sign} connector {value}: {connector['label'] or '-'} ({connector['model'] or '-'}; "
                f"{connector['provider'] or '-'}/{connector['driver'] or '-'})")
    profile = receipt["profile"]
    return {"profile": {"id": profile["id"], "label": profile["label"]}, "role": receipt["role"], "field": receipt["field"],
            "before": before, "after": after,
            "diff": [f"CHIM profile {profile['id']} ({profile['label'] or '-'}), {receipt['role']} role ({receipt['field']})",
                     line("-", before), line("+", after)]}


def model_stamp(epoch):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def cmd_models_options(opts, ctx):
    model_settings_ready()
    roles = model_fields()
    if not roles:
        raise CliError("unsupported", "This CHIM database has no role field that can be set.", {"reason": "schema_missing"})
    pairs = ", ".join(f"'{role}', p.{field}" for role, field in roles)
    fields = ", ".join(field for _, field in roles)
    doc = model_read(
        "SELECT json_build_object("
        f"'profiles', (SELECT coalesce(json_agg(json_build_object('id', p.id, 'label', left(p.label::text, "
        f"{MODELS_FIELD_CHARS}), 'roles', json_build_object({pairs})) ORDER BY p.id), '[]'::json) "
        f"FROM (SELECT id, label, {fields} FROM public.core_profiles ORDER BY id LIMIT {MODELS_MAX + 1}) AS p), "
        f"'connectors', (SELECT coalesce(json_agg({model_connector_sql('c')} ORDER BY c.id), '[]'::json) "
        f"FROM (SELECT id, label, model, provider, driver, xmin FROM public.core_llm_connector ORDER BY id "
        f"LIMIT {MODELS_MAX + 1}) AS c))")
    profiles, connectors = doc.get("profiles"), doc.get("connectors")
    names = [role for role, _ in roles]
    if type(profiles) is not list or type(connectors) is not list or any(
            type(p) is not dict or set(p) != {"id", "label", "roles"} or type(p["id"]) is not int
            or p["label"] is not None and type(p["label"]) is not str or type(p["roles"]) is not dict
            or list(p["roles"]) != names or any(v is not None and type(v) is not int for v in p["roles"].values())
            for p in profiles):
        raise CliError("helper_protocol", "The CHIM database returned an unexpected result.", {"reason": "unexpected_output"})
    data = {"product": "herika", "available": True, "scope": "configured_profiles",
            "captured_at": model_stamp(time.time()), "roles": names,
            "profiles": [{"id": p["id"], "label": models_text(p["label"]), "roles": p["roles"]} for p in profiles[:MODELS_MAX]],
            "connectors": [model_connector(c) for c in connectors[:MODELS_MAX]],
            "truncated": {"profiles": len(profiles) > MODELS_MAX, "connectors": len(connectors) > MODELS_MAX}}
    lines = ["CHIM profiles (role: connector id):"]
    lines += [f"  {p['id']:>4} {p['label'] or '-'}: " + ", ".join(f"{role} {value if value is not None else '-'}"
                                                             for role, value in p["roles"].items()) for p in data["profiles"]]
    lines += ["LLM connectors:"] + [f"  {c['id']:>4} {c['label'] or '-'} ({c['model'] or '-'}; {c['provider'] or '-'}/"
                                    f"{c['driver'] or '-'})" for c in data["connectors"]]
    return data, "\n".join(lines)


def cmd_models_preview(opts, ctx):
    model_settings_ready()
    role, profile_id, connector_id = opts["role"], opts["profile"], opts["connector"]
    field = model_field(role)
    state = model_snapshot(field, profile_id, connector_id)
    profile, target = state["profile"], state["target"]
    if profile is None:
        raise CliError("not_found", f"There is no CHIM profile with id {profile_id}.", {"reason": "profile_not_found"})
    if target is None:
        raise CliError("not_found", f"There is no CHIM LLM connector with id {connector_id}.", {"reason": "connector_not_found"})
    if profile["value"] == connector_id:
        raise CliError("refused", f"Profile {profile_id} already uses connector {connector_id} for its {role} role; "
                       "nothing to change.", {"reason": "no_change"})
    now = int(time.time())
    current = state["current"]
    receipt = {"schema": 1, "id": secrets.token_hex(16), "kind": "model_assignment", "product": "herika",
               "created_at": now, "expires_at": now + MODEL_PREVIEW_SECONDS,
               "task_id": opts.get("task"), "thread_id": opts.get("thread"),
               "profile": {"id": profile_id, "label": profile["label"]}, "role": role, "field": field,
               "before": {"value": profile["value"],
                          "connector": {k: v for k, v in current.items() if k != "version"} if current else None},
               "after": {"value": connector_id, "connector": {k: v for k, v in target.items() if k != "version"}},
               "versions": {"profile": profile["version"], "connector": target["version"]},
               "state": "previewed", "applied": None, "rollback": None}
    receipt["plan_sha256"] = model_plan_sha256(receipt)
    with ModelReceipts(True) as store:
        store.prune(now)
        store.save(receipt)
    data = dict(model_change_view(receipt), product="herika", receipt_id=receipt["id"],
                plan_sha256=receipt["plan_sha256"], expires_at=model_stamp(receipt["expires_at"]), state="previewed")
    return data, "\n".join(data["diff"] + [f"Apply within {MODEL_PREVIEW_SECONDS} seconds: ddistro models apply herika "
                                           f"--receipt {receipt['id']} --plan-sha256 {receipt['plan_sha256']}"])


def model_confirm(receipt, rollback, expected_sha):
    """The receipt's plan is still pending, unexpired and confirmed by exactly its sha256; raises otherwise."""
    plan = rollback if rollback is not None else receipt
    if plan.get("state") != "previewed":
        raise CliError("refused", "This preview was already used or ended; preview again.", {"reason": "not_pending"})
    if type(plan.get("expires_at")) is not int or int(time.time()) > plan["expires_at"]:
        raise CliError("expired", "This preview expired; nothing was changed. Preview again.", {"reason": "expired"})
    if (type(plan.get("plan_sha256")) is not str or not hmac.compare_digest(plan["plan_sha256"], expected_sha)
            or plan["plan_sha256"] != model_plan_sha256(receipt, rollback)):
        raise CliError("refused", "The confirmation does not match this preview; nothing was changed.",
                       {"reason": "plan_mismatch"})


def model_result(receipt, state, undo, saved=True):
    executed = {"verified": True, "unverified": True, "conflict": False, "not_executed": False}.get(state)
    data = dict(model_change_view(receipt, undo), product="herika", receipt_id=receipt["id"],
                action="rollback" if undo else "apply", state=state, executed=executed, verified=state == "verified",
                verification="database_assignment", checked_at=model_stamp(time.time()),
                undo_available=saved and not undo and state in ("verified", "unverified"))
    if not saved:
        data["receipt_saved"] = False
    return data


def model_execute(opts, ctx, undo):
    """apply and rollback: maintenance lock, the confirmed pending plan, the prestate saved before the write, then the
    write, its fresh resolution and the final receipt state. A receipt that cannot be saved after the write is unknown."""
    model_settings_ready()
    ctx["operation_id"] = str(uuid.uuid4())
    lock = maintenance_exclusive_fd()
    try:
        with ModelReceipts(False) as store:
            receipt = store.load(opts["receipt"])
            if receipt is None:
                raise CliError("not_found", "There is no model change receipt with that id.", {"reason": "receipt_not_found"})
            rollback = receipt["rollback"] if undo else None
            if undo and (receipt["state"] != "applied" or rollback is None or type(receipt["applied"]) is not dict):
                raise CliError("refused", "Preview the undo first: ddistro models rollback-preview herika --receipt ID.",
                               {"reason": "not_pending"})
            model_confirm(receipt, rollback, opts["plan-sha256"])
            if model_field(receipt["role"]) != receipt["field"]:
                raise CliError("unsupported", "The CHIM database role fields changed; nothing was changed.",
                               {"reason": "role_unsupported"})
            # The write's place in apply order, taken under the store lock and saved with the prestate below, so an
            # unknown outcome keeps its place too.
            seq = store.next_write()
            if undo:
                expected, value = receipt["after"]["value"], receipt["before"]["value"]
                version = receipt["applied"]["version"]
                connector = (value, rollback["connector_version"]) if rollback["connector_version"] else None
                receipt["state"], rollback["state"], rollback["seq"] = "rolling_back", "used", seq
            else:
                expected, value = receipt["before"]["value"], receipt["after"]["value"]
                version = receipt["versions"]["profile"]
                connector = (value, receipt["versions"]["connector"])
                receipt["state"], receipt["applied"] = "applying", {"seq": seq}
            # Saved before the write: if this process ends during it, the receipt stays applying (outcome unknown).
            store.save(receipt)
            outcome = model_assign(receipt["field"], receipt["profile"]["id"], expected, value, version, connector)
            state, new_version = model_settle(receipt["field"], receipt["profile"]["id"], expected, version, value, outcome)
            if state == "unknown":
                receipt["state"] = "unknown"
            elif undo:
                receipt["state"] = "rolled_back" if state in ("verified", "unverified") else "applied"
                if receipt["state"] == "applied":
                    del rollback["seq"]  # nothing was written, so the apply stays this receipt's latest write
            elif state in ("verified", "unverified"):
                receipt["state"], receipt["applied"] = "applied", {"at": int(time.time()), "version": new_version,
                                                                  "verified": state == "verified", "seq": seq}
            else:
                receipt["state"], receipt["applied"] = state, None
            if undo:
                rollback.update(result=state, at=int(time.time()))
            try:
                store.save(receipt)
            except (OSError, CliError):
                return model_result(receipt, "unknown", undo, saved=False)
            return model_result(receipt, state, undo)
    finally:
        os.close(lock)


def model_human(data):
    words = {"verified": "done; a fresh database read shows the new assignment",
             "unverified": "written, but a fresh read did not show it", "not_executed": "not changed",
             "conflict": "not changed: the profile or connector changed since the preview",
             "unknown": "outcome unknown: check the profile before trying again"}
    return "\n".join(data["diff"] + [f"{data['action']}: {words.get(data['state'], data['state'])}"])


def cmd_models_apply(opts, ctx):
    data = model_execute(opts, ctx, False)
    return data, model_human(data)


def cmd_models_rollback(opts, ctx):
    data = model_execute(opts, ctx, True)
    return data, model_human(data)


def cmd_models_rollback_preview(opts, ctx):
    """The exact undo of one applied change: by --receipt, or the latest write of --task/--thread by store sequence (the
    Assistant's own last applied change; model_last_change). It must still be the profile's latest write and the original connector must still exist."""
    model_settings_ready()
    with ModelReceipts(False) as store:
        if store.directory is None:
            receipt = None
        elif "receipt" in opts:
            receipt = store.load(opts["receipt"])
        else:
            receipt = model_last_change([r for r in store.receipts() if r["task_id"] == opts["task"]
                                         and r["thread_id"] == opts["thread"] and r["state"] in
                                         ("applied", "applying", "unknown", "rolling_back", "rolled_back")])
        if receipt is None:
            raise CliError("not_found", "There is no applied model change to undo.", {"reason": "nothing_to_undo"})
        if receipt["state"] == "rolled_back":
            raise CliError("refused", "That change was already undone.", {"reason": "already_undone"})
        if receipt["state"] != "applied" or type(receipt["applied"]) is not dict:
            raise CliError("refused", "That change's outcome is not known, so it cannot be undone automatically. Check the "
                           "profile in CHIM.", {"reason": "outcome_unknown"})
        if model_field(receipt["role"]) != receipt["field"]:
            raise CliError("unsupported", "The CHIM database role fields changed; nothing was prepared.",
                           {"reason": "role_unsupported"})
        before = receipt["before"]["value"]
        state = model_snapshot(receipt["field"], receipt["profile"]["id"], before)
        profile, original = state["profile"], state["target"]
        if (profile is None or profile["version"] != receipt["applied"]["version"]
                or profile["value"] != receipt["after"]["value"]):
            raise CliError("conflict", "The profile changed after this change was applied; undoing it would overwrite "
                           "that edit, so nothing was prepared.", {"reason": "changed_since"})
        if receipt["before"]["connector"] is not None and original is None:
            raise CliError("conflict", "The original connector no longer exists, so the change cannot be undone exactly.",
                           {"reason": "original_missing"})
        now = int(time.time())
        rollback = {"state": "previewed", "expires_at": now + MODEL_PREVIEW_SECONDS,
                    "connector_version": original["version"] if original else None}
        rollback["plan_sha256"] = model_plan_sha256(receipt, rollback)
        receipt["rollback"] = rollback
        if original is not None:
            receipt["before"]["connector"] = {k: v for k, v in original.items() if k != "version"}
        store.save(receipt)
    data = dict(model_change_view(receipt, True), product="herika", receipt_id=receipt["id"],
                plan_sha256=rollback["plan_sha256"], expires_at=model_stamp(rollback["expires_at"]), state="previewed")
    return data, "\n".join(data["diff"] + [f"Undo within {MODEL_PREVIEW_SECONDS} seconds: ddistro models rollback herika "
                                           f"--receipt {receipt['id']} --plan-sha256 {rollback['plan_sha256']}"])


def parse_models(rest, ctx):
    """models herika, or models <subcommand> herika with exactly that subcommand's typed flags."""
    if len(rest) == 2 and rest[1] not in MODEL_SUBCOMMANDS:
        ctx["command"] = "models"
        return {"product": resolve_product(rest[1])}
    if len(rest) < 3 or rest[1] not in MODEL_SUBCOMMANDS:
        ctx["command"] = "models"
        raise CliError("invalid_argument", "Expected models herika or models " + "|".join(MODEL_SUBCOMMANDS) + " herika.")
    name = rest[1]
    ctx["command"] = "models " + name
    if resolve_product(rest[2]) != "herika":
        raise CliError("unsupported", "Model settings support only herika (chim, skyrim).", {"product": rest[2][:40]})
    flags = {"options": (), "preview": ("--profile", "--role", "--connector", "--task", "--thread"),
             "apply": ("--receipt", "--plan-sha256"), "rollback": ("--receipt", "--plan-sha256"),
             "rollback-preview": ("--receipt", "--task", "--thread")}[name]
    opts, args, index = {}, rest[3:], 0
    while index < len(args):
        token = args[index]
        if token not in flags or index + 1 >= len(args):
            raise CliError("invalid_argument", f"Unsupported or incomplete argument for models {name}.")
        if token[2:] in opts:
            raise CliError("invalid_argument", f"{token} was given more than once.")
        opts[token[2:]] = args[index + 1]
        index += 2
    for key in ("profile", "connector"):
        if key in opts:
            if not MODEL_ID_TEXT.match(opts[key]) or int(opts[key]) > MODEL_ID_MAX:
                raise CliError("invalid_argument", f"--{key} must be a positive whole number id.")
            opts[key] = int(opts[key])
    if "role" in opts and opts["role"] not in MODEL_ROLE_FIELDS:
        raise CliError("invalid_argument", "--role must be one of " + ", ".join(MODEL_ROLE_FIELDS) + ".")
    if "receipt" in opts and not MODEL_RECEIPT_ID.match(opts["receipt"]):
        raise CliError("invalid_argument", "--receipt must be the 32-hex receipt id from the preview.")
    if "plan-sha256" in opts and not HASH.match(opts["plan-sha256"]):
        raise CliError("invalid_argument", "--plan-sha256 must be the 64-hex hash from the preview.")
    if "task" in opts and not TASK_ID.match(opts["task"]) or "thread" in opts and not THREAD_ID.match(opts["thread"]):
        raise CliError("invalid_argument", "--task must be a task UUID and --thread a thread id.")
    if ("task" in opts) != ("thread" in opts):
        raise CliError("invalid_argument", "--task and --thread go together.")
    required = {"options": (), "preview": ("profile", "role", "connector"), "apply": ("receipt", "plan-sha256"),
                "rollback": ("receipt", "plan-sha256"), "rollback-preview": ()}[name]
    if any(key not in opts for key in required):
        raise CliError("invalid_argument", f"models {name} needs " + ", ".join("--" + key for key in required) + ".")
    if name == "rollback-preview" and ("receipt" in opts) == ("task" in opts):
        raise CliError("invalid_argument", "models rollback-preview needs --receipt, or --task and --thread.")
    return opts


# ddistro update-check [product]: what on this machine would stop a server update, read-only and local only. It never
# fetches, updates, forces, discards or cleans anything and reads no file content: git reports only which tracked paths
# differ and which untracked paths exist. Without the remote it cannot know whether an update exists or would touch
# those paths, so a clean result is no_local_blockers, never ready or up to date.
UPDATE_CHECK_ROOTS = {"herika": "/var/www/html/HerikaServer", "lorkhan": "/opt/dwemerdistro/sources/LorkhanServer",
                      "stobe": "/var/www/html/StobeServer", "dialectic": "/var/www/html/DialecticServer",
                      "reign": "/var/www/html/ReignServer"}
UPDATE_CHECK_GIT = "/usr/bin/git"
UPDATE_CHECK_STATUS_TIMEOUT = 30
UPDATE_CHECK_GIT_TIMEOUT = 20
UPDATE_CHECK_STDOUT = 4 * 1024 * 1024
UPDATE_CHECK_PATHS = 20
UPDATE_CHECK_PATH_CHARS = 200
UPDATE_CHECK_ASSESSMENTS = ("no_local_blockers", "blocked", "unknown", "not_installed")
# An unfinished git operation: an update would stop on it.
UPDATE_CHECK_IN_PROGRESS = ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge", "rebase-apply")
# Command-line config outranks the repository's own: no fsmonitor command, hooks, pager, colour or untracked cache.
# System and global config are not read, and --no-optional-locks keeps status from rewriting the index.
UPDATE_CHECK_GIT_ARGS = ("--no-pager", "--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null",
                         "-c", "core.untrackedCache=false", "-c", "core.attributesFile=/dev/null", "-c", "core.pager=cat",
                         "-c", "color.ui=false", "-c", "core.quotePath=false")
UPDATE_CHECK_GIT_ENV = {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": "/", "GIT_CONFIG_NOSYSTEM": "1",
                        "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0",
                        "GIT_ATTR_NOSYSTEM": "1", "GIT_NO_REPLACE_OBJECTS": "1"}


def update_check_args(root):
    """The hardened git arguments for root: its own .git and root itself, given explicitly, so neither repository
    discovery nor a core.worktree or GIT_DIR-style redirect in the repository config can point git anywhere else."""
    return list(UPDATE_CHECK_GIT_ARGS) + ["-c", "safe.directory=" + root, "--git-dir=" + root + "/.git",
                                          "--work-tree=" + root, "-C", root]


def update_check_filters(root):
    """Refuses before status when any filter driver is configured for root. status can run a configured clean or
    process filter on a path .gitattributes assigns to it, so filter.* keys are never allowed. git itself resolves
    the repository config with its includes and conditional includes, under the same hardened arguments and environment
    as status; with --name-only only key names are printed, never values (filter commands). Exit 1 with no output (no
    such key) is the only pass; anything else, including output cut short, is a refusal or a failure."""
    args = update_check_args(root) + ["config", "--null", "--name-only", "--get-regexp", r"^filter\."]
    code, out, _ = run_helper(args, UPDATE_CHECK_GIT_TIMEOUT, 64, helper=UPDATE_CHECK_GIT, env=dict(UPDATE_CHECK_GIT_ENV))
    if code == 1 and out.total == 0:
        return
    if code == 0:
        raise CliError("refused", "The repository configures a git filter.", {"reason": "git_filter_configured"})
    raise CliError("helper_failed", "git config failed.", {"reason": "git_config_failed"})


def update_check_git(root):
    """(tracked paths, untracked paths, complete) from one bounded, read-only git status of root, run only after
    update_check_filters found no filter that status could execute."""
    check_system_binary(UPDATE_CHECK_GIT)
    update_check_filters(root)
    args = update_check_args(root) + ["status", "--porcelain=v1", "-z",
                                          "--untracked-files=all", "--ignore-submodules=all", "--no-renames"]
    code, out, _ = run_helper(args, UPDATE_CHECK_GIT_TIMEOUT, UPDATE_CHECK_STDOUT + 1, helper=UPDATE_CHECK_GIT,
                              env=dict(UPDATE_CHECK_GIT_ENV))
    if code != 0:
        raise CliError("helper_failed", "git status failed.", {"reason": "git_failed"})
    complete = out.total <= UPDATE_CHECK_STDOUT
    tracked, untracked = [], []
    entries = bytes(out.data).split(b"\0")
    for entry in entries if complete else entries[1:-1]:
        if not entry:
            continue
        if len(entry) < 4 or entry[2:3] != b" ":
            if complete:
                raise CliError("helper_protocol", "git status returned an unexpected entry.", {"reason": "git_output"})
            continue
        path = CONTROL.sub("?", entry[3:].decode("utf-8", "replace"))[:UPDATE_CHECK_PATH_CHARS]
        if entry[:2] == b"??":
            untracked.append(path)
        elif entry[:2] != b"!!":
            tracked.append(path)
    return tracked, untracked, complete


def update_check_product(record):
    product = record["product"]
    root = UPDATE_CHECK_ROOTS[product]
    result = {"product": product, "state": record["state"], "repository_state": record["repository_state"],
              "branch": record["branch"], "version": record["version"], "assessment": "unknown", "reasons": [],
              "inspected": False, "tracked_changes": None, "untracked_files": None, "tracked_paths": [],
              "untracked_paths": [], "paths_truncated": False}
    if record["state"] == "not-installed" or record["repository_state"] == "absent":
        result.update(assessment="not_installed", inspected=True)
        return result
    if record["repository_state"] != "managed":
        result["reasons"].append("unmanaged_install")
        return result
    if record["root"] != root:
        result["reasons"].append("unexpected_root")
        return result
    try:
        for path, wanted in ((root, stat.S_ISDIR), (root + "/.git", stat.S_ISDIR), (root + "/.git/config", stat.S_ISREG)):
            st = os.lstat(path)
            if not wanted(st.st_mode) or st.st_mode & 0o022 and path.endswith("config"):
                result["reasons"].append("unexpected_repository_layout")
                return result
        # A linked worktree's commondir would take the config and objects from another repository.
        if os.path.lexists(root + "/.git/commondir"):
            result["reasons"].append("unexpected_repository_layout")
            return result
        busy = os.path.lexists(root + "/.git/index.lock")
        in_progress = [name for name in UPDATE_CHECK_IN_PROGRESS if os.path.lexists(root + "/.git/" + name)]
    except FileNotFoundError:
        result["reasons"].append("repository_missing")
        return result
    except OSError:
        result["reasons"].append("repository_unreadable")
        return result
    if busy:
        result["reasons"].append("git_busy")
        return result
    try:
        tracked, untracked, complete = update_check_git(root)
    except CliError as error:
        if error.code == "cancelled":
            raise
        reason = {"timeout": "git_timeout", "helper_unavailable": "git_unavailable"}.get(error.code, "git_failed")
        if error.details.get("reason") in ("git_filter_configured", "git_config_failed"):
            reason = error.details["reason"]
        result["reasons"].append(reason)
        return result
    result.update(inspected=complete, tracked_changes=len(tracked), untracked_files=len(untracked),
                  tracked_paths=tracked[:UPDATE_CHECK_PATHS], untracked_paths=untracked[:UPDATE_CHECK_PATHS],
                  paths_truncated=not complete or len(tracked) > UPDATE_CHECK_PATHS or len(untracked) > UPDATE_CHECK_PATHS)
    if tracked:
        result["reasons"].append("tracked_changes")
    if in_progress:
        result["reasons"].append("git_operation_in_progress")
    if untracked:
        result["reasons"].append("untracked_files")
    if not complete:
        result["reasons"].append("status_truncated")
    if tracked or in_progress:
        result["assessment"] = "blocked"
    elif not untracked and complete:
        result["assessment"] = "no_local_blockers"
    return result


def cmd_update_check(opts, ctx):
    product = opts.get("product")
    captured_at = model_stamp(time.time())
    try:
        records = helper_status(product, UPDATE_CHECK_STATUS_TIMEOUT)
        products = [update_check_product(record) for record in records]
    except CliError as error:
        if error.code == "cancelled":
            raise
        products = [{"product": key, "assessment": "unknown", "reasons": ["status_unavailable"], "inspected": False}
                    for key in ([product] if product else PRODUCTS)]
    summary = {name: sum(1 for p in products if p["assessment"] == name) for name in UPDATE_CHECK_ASSESSMENTS}
    data = {"scope": "local_only", "captured_at": captured_at, "network_queried": False, "remote_changes_checked": False,
            "conflicts": "unknown", "changed_anything": False, "products": products, "summary": summary,
            "complete": all(p["inspected"] for p in products),
            "note": "Local files only: whether an update exists, or would touch these paths, was not checked."}
    lines = [f"{p['product']:<10} {p['assessment']}" + (" (" + ", ".join(p["reasons"]) + ")" if p["reasons"] else "")
             for p in products]
    return data, "\n".join(lines + [data["note"]])


# ddistro inventory: one fresh, read-only snapshot of what is installed, for the launcher's assistant.
# It only reports presence: no repository or plugin code runs, no file content is read, no link is
# followed, and nothing says whether an extension is enabled or healthy or a component is running.
INVENTORY_STATUS_TIMEOUT = 20
INVENTORY_MODS_TIMEOUT = 10
INVENTORY_MODS_HELPER = "/usr/local/bin/ddistro_custom_mod"
INVENTORY_MODS_STDOUT_LIMIT = 1024 * 1024
INVENTORY_MAX_ENTRIES = 200  # per extension folder, sorted by name
INVENTORY_SCAN_LIMIT = 4096  # directory entries examined per folder before giving up
INVENTORY_MAX_MODS = 100
INVENTORY_STRING_CHARS = 128
# Products whose repositories load add-ons from an ext/ folder; the others have no known root.
INVENTORY_EXTENSION_ROOTS = {"herika": "/var/www/html/HerikaServer", "dialectic": "/var/www/html/DialecticServer"}
# The shared component catalog (identity and presence rules only; contract in ASSISTANT.md, Component catalog).
# It is data from one fixed root-owned file: a closed set of path predicates, never a command, expression,
# environment value, port, or log path. Missing or invalid means unavailable, never a built-in fallback list.
COMPONENT_CATALOG = "/etc/dwemerdistro-components.json"
CATALOG_SCHEMA = 1
CATALOG_MAX_BYTES = 64 * 1024
CATALOG_MAX_ENTRIES = 48
CATALOG_MAX_STARTUP = 32  # rows in the legacy components section; older launchers accept at most 32
CATALOG_MAX_ALIASES = 4
CATALOG_MAX_LEAVES = 4
CATALOG_MAX_SEGMENTS = 10
CATALOG_GLOB_SCAN = 256  # directory entries examined for the one glob segment
CATALOG_LINK_HOPS = 8
CATALOG_ROOTS = ("/home/dwemer/", "/var/www/html/", "/usr/")
CATALOG_ROLES = ("llm", "embeddings", "tts", "stt", "mcp", "dashboard", "gpu_runtime")
CATALOG_LEAVES = ("exists", "file", "dir", "glob", "which")
CATALOG_STATES = ("present", "absent", "unknown")
CATALOG_UNKNOWN = ("unreadable", "unsafe", "unsafe_redirect", "redirect_limit", "scan_limit")
CATALOG_REASONS = ("catalog_missing", "catalog_unreadable", "catalog_unsafe", "catalog_invalid")
# which: a program name from this closed set, looked up in this fixed PATH (never the caller's) and never run.
CATALOG_WHICH = ("nvcc",)
CATALOG_WHICH_PATH = ("/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin", "/usr/local/cuda/bin")
CATALOG_ITEM_KEYS = {"id", "aliases", "name", "role", "listed", "installed", "startup"}
CATALOG_ID = re.compile(r"^[a-z][a-z0-9_]{1,31}\Z")
CATALOG_VERSION = re.compile(r"^[0-9A-Za-z][0-9A-Za-z._-]{0,31}\Z")
CATALOG_SEGMENT = re.compile(r"^[A-Za-z0-9._+-]{1,64}\Z")
CATALOG_LABEL_CHARS = 64
INVENTORY_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._+()@,=~-]{0,127}\Z")
INVENTORY_MOD_ID = re.compile(r"^[a-z][a-z0-9-]{1,30}[a-z0-9]\Z")
INVENTORY_COMMIT = re.compile(r"^(?:[0-9a-f]{40})?\Z")
INVENTORY_DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
INVENTORY_ERRNO = {errno.ENOENT: "absent", errno.ELOOP: "redirected", errno.ENOTDIR: "not_directory",
                   errno.EACCES: "unreadable", errno.EPERM: "unreadable"}


def inventory_reason(error):
    if error.code == "cancelled":
        raise error
    return error.code if error.code in ("helper_unavailable", "helper_failed", "helper_protocol", "timeout") else "failed"


def inventory_step(fd, name):
    """Opens the folder name below fd without following a link; returns (fd, "") or (None, state).

    Linux may refuse a link opened with O_DIRECTORY|O_NOFOLLOW with ENOTDIR rather than ELOOP, so
    any failure other than a plain absence is classified by a no-follow stat of the same name under
    the same fd: a link is redirected, a non-folder is not_directory. Nothing is ever followed."""
    try:
        return os.open(name, INVENTORY_DIR_FLAGS, dir_fd=fd), ""
    except OSError as error:
        if error.errno in (errno.ENOENT, errno.ELOOP):
            return None, INVENTORY_ERRNO[error.errno]
        failure = error.errno
    try:
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
    except OSError as error:
        # It changed after the open failed, so it is not provably absent.
        return None, "unreadable" if error.errno == errno.ENOENT else INVENTORY_ERRNO.get(error.errno, "unreadable")
    if stat.S_ISLNK(info.st_mode):
        return None, "redirected"
    if not stat.S_ISDIR(info.st_mode):
        return None, "not_directory"
    return None, INVENTORY_ERRNO.get(failure, "unreadable") if failure in (errno.EACCES, errno.EPERM) else "unreadable"


def inventory_open_dir(path):
    """Opens a fixed absolute folder from / one name at a time, refusing a link at every step.

    Returns (fd, "") or (None, state) for the first name that could not be opened."""
    fd = os.open("/", INVENTORY_DIR_FLAGS)
    for name in path.strip("/").split("/"):
        next_fd, state = inventory_step(fd, name)
        os.close(fd)
        if next_fd is None:
            return None, state
        fd = next_fd
    return fd, ""


def inventory_marker(path):
    parent, name = path.rsplit("/", 1)
    try:
        fd, state = inventory_open_dir(parent)
        if fd is None:
            # A plain file where a folder should be means the marker cannot exist; a link stays redirected.
            return "absent" if state == "not_directory" else state
        try:
            info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        finally:
            os.close(fd)
    except OSError as error:
        return INVENTORY_ERRNO.get(error.errno, "unreadable")
    if stat.S_ISLNK(info.st_mode):
        return "redirected"
    return "present" if stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode) else "unreadable"


def inventory_component(component_id, name, role, mode, markers):
    states = [inventory_marker(path) for path in markers]
    if (all if mode == "all" else any)(state == "present" for state in states):
        state = "present"
    else:
        state = next((s for s in states if s not in ("present", "absent")), "absent")
    return {"id": component_id, "name": name, "role": role, "state": state}


def catalog_label(value):
    """A display label only (never a path or token): printable, trimmed, short, and unchanged by redaction."""
    return (type(value) is str and 0 < len(value) <= CATALOG_LABEL_CHARS and value == value.strip()
            and value.isprintable() and redact(value) == value)


def catalog_path(value, glob=False):
    """A normalized absolute path below an allowlisted root; glob paths have exactly one '*' in one segment."""
    if (type(value) is not str or len(value) > 255 or not value.startswith(CATALOG_ROOTS) or value.endswith("/")
            or "//" in value or "\\" in value or value.count("*") != (1 if glob else 0)):
        return False
    parts = value[1:].split("/")
    if len(parts) > CATALOG_MAX_SEGMENTS:
        return False
    for part in parts:
        prefix, star, suffix = part.partition("*")
        if part in (".", "..") or not CATALOG_SEGMENT.match(prefix) or prefix.startswith(".") and star:
            return False
        if star and suffix and not CATALOG_SEGMENT.match(suffix):
            return False
    return True


def catalog_predicate(value, startup):
    """A leaf, or all/any over 1..CATALOG_MAX_LEAVES leaves (no nesting); startup uses exists leaves only."""
    if type(value) is not dict or len(value) != 1:
        raise ValueError("predicate")
    (key, inner), = value.items()
    leaves = inner if key in ("all", "any") else [value]
    if type(leaves) is not list or not 1 <= len(leaves) <= CATALOG_MAX_LEAVES:
        raise ValueError("predicate")
    for leaf in leaves:
        if type(leaf) is not dict or len(leaf) != 1:
            raise ValueError("leaf")
        (kind, arg), = leaf.items()
        if kind not in CATALOG_LEAVES or startup and kind != "exists":
            raise ValueError("leaf")
        if not (arg in CATALOG_WHICH if kind == "which" else catalog_path(arg, kind == "glob")):
            raise ValueError("leaf")
    return ("any" if key == "any" else "all"), [next(iter(leaf.items())) for leaf in leaves]


def catalog_parse(raw):
    """Validated catalog entries from the raw file bytes; ValueError for anything outside the contract."""
    if len(raw) > CATALOG_MAX_BYTES:
        raise ValueError("size")

    def unique(pairs):
        if len({key for key, _ in pairs}) != len(pairs):
            raise ValueError("duplicate key")
        return dict(pairs)
    doc = json.loads(raw.decode("utf-8"), object_pairs_hook=unique, parse_constant=reject_constant)
    if (type(doc) is not dict or set(doc) != {"schema_version", "catalog_version", "components"}
            or type(doc["schema_version"]) is not int or doc["schema_version"] != CATALOG_SCHEMA
            or type(doc["catalog_version"]) is not str or not CATALOG_VERSION.match(doc["catalog_version"])
            or type(doc["components"]) is not list or not 1 <= len(doc["components"]) <= CATALOG_MAX_ENTRIES):
        raise ValueError("document")
    seen, items = set(), []
    for item in doc["components"]:
        if type(item) is not dict or not CATALOG_ITEM_KEYS - {"startup"} <= set(item) <= CATALOG_ITEM_KEYS:
            raise ValueError("entry keys")
        aliases = item["aliases"]
        if type(aliases) is not list or len(aliases) > CATALOG_MAX_ALIASES:
            raise ValueError("aliases")
        for name in [item["id"]] + aliases:
            if type(name) is not str or not CATALOG_ID.match(name) or name in seen:
                raise ValueError("id")
            seen.add(name)
        if not catalog_label(item["name"]) or item["role"] not in CATALOG_ROLES or type(item["listed"]) is not bool:
            raise ValueError("entry")
        items.append({"id": item["id"], "aliases": list(aliases), "name": item["name"], "role": item["role"],
                      "listed": item["listed"], "installed": catalog_predicate(item["installed"], False),
                      "startup": catalog_predicate(item["startup"], True) if "startup" in item else None})
    if sum(item["startup"] is not None for item in items) > CATALOG_MAX_STARTUP:
        raise ValueError("startup")
    return {"catalog_version": doc["catalog_version"], "items": items}


def catalog_read():
    """(bytes, "") or (None, reason) for COMPONENT_CATALOG, opened from / without following a link.

    "/", every folder, and the file must be root-owned and not group/other writable; the file must be a
    regular file of at most CATALOG_MAX_BYTES before and after a non-blocking open. 0644 lets any user read it."""
    parent, name = COMPONENT_CATALOG.rsplit("/", 1)
    file_flags = (os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NOCTTY", 0)
                  | getattr(os, "O_CLOEXEC", 0))

    def trusted(info):
        return info.st_uid == 0 and not info.st_mode & 0o022
    fd = file_fd = None
    try:
        fd = os.open("/", INVENTORY_DIR_FLAGS)
        for part in [p for p in parent.split("/") if p]:
            if not trusted(os.fstat(fd)):
                return None, "catalog_unsafe"
            next_fd, state = inventory_step(fd, part)
            os.close(fd)
            fd = next_fd
            if fd is None:
                return None, {"absent": "catalog_missing", "unreadable": "catalog_unreadable"}.get(state, "catalog_unsafe")
        if not trusted(os.fstat(fd)):
            return None, "catalog_unsafe"
        try:
            info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        except OSError as error:
            return None, "catalog_missing" if error.errno == errno.ENOENT else "catalog_unreadable"
        if not stat.S_ISREG(info.st_mode) or not trusted(info):
            return None, "catalog_unsafe"
        if info.st_size > CATALOG_MAX_BYTES:
            return None, "catalog_invalid"
        file_fd = os.open(name, file_flags, dir_fd=fd)
        opened = os.fstat(file_fd)
        if (not stat.S_ISREG(opened.st_mode) or not trusted(opened)
                or (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino)):
            return None, "catalog_unsafe"
        raw = b""
        while len(raw) <= CATALOG_MAX_BYTES:
            chunk = os.read(file_fd, CATALOG_MAX_BYTES + 1 - len(raw))
            if not chunk:
                break
            raw += chunk
        return (raw, "") if len(raw) <= CATALOG_MAX_BYTES else (None, "catalog_invalid")
    except OSError as error:
        return None, "catalog_unsafe" if error.errno == errno.ELOOP else "catalog_unreadable"
    finally:
        for handle in (file_fd, fd):
            if handle is not None:
                os.close(handle)


def catalog_load():
    """(catalog or None, reason, sha256 of the bytes read or "")."""
    raw, reason = catalog_read()
    if raw is None:
        return None, reason, ""
    digest = hashlib.sha256(raw).hexdigest()
    try:
        return catalog_parse(raw), "", digest
    except (ValueError, UnicodeDecodeError, RecursionError):
        return None, "catalog_invalid", digest


# Installed presence is metadata only (lstat, readlink, and listing the one glob folder; no file content). A link
# is followed only within its zone: a system link (under /usr, /etc/alternatives, or a top-level /bin, /sbin, /lib*)
# may point into the system zone, and a link inside /home/dwemer/<name> or /var/www/html/<name> may point into that
# same folder or the system zone (a venv's bin/python -> /usr/bin/python3). Anything else, more than
# CATALOG_LINK_HOPS links, an other-writable entry, or an owner outside the zone's owners is unknown, never present.
def catalog_lstat(path):
    return os.lstat(path)


def catalog_readlink(path):
    return os.readlink(path)


def catalog_listdir(path, limit):
    names = []
    with os.scandir(path) as scan:
        for entry in scan:
            if len(names) >= limit:
                return names, True
            names.append(entry.name)
    return names, False


def catalog_uid(account):
    try:
        return pwd.getpwnam(account).pw_uid
    except KeyError:
        return None


def catalog_zone(parts):
    if parts[:1] == ["usr"] or parts[:2] == ["etc", "alternatives"] or len(parts) == 1 and parts[0] in (
            "bin", "sbin", "lib", "lib32", "lib64"):
        return ("system",)
    if parts[:2] == ["home", "dwemer"] and len(parts) > 2:
        return ("home", parts[2])
    if parts[:3] == ["var", "www", "html"] and len(parts) > 3:
        return ("www", parts[3])
    return None


def catalog_owners(parts):
    if parts[:2] == ["home", "dwemer"]:
        return {0, catalog_uid("dwemer")}
    if parts[:3] == ["var", "www", "html"]:
        return {0, catalog_uid("dwemer"), catalog_uid("www-data")}
    return {0}


def catalog_walk(path):
    """("present", stat) or (state, reason) for a fixed absolute path, one name at a time from /."""
    pending, done, hops = path.strip("/").split("/"), [], 0
    try:
        info = catalog_lstat("/")
    except OSError:
        return "unknown", "unreadable"
    if info.st_uid != 0 or info.st_mode & 0o002:
        return "unknown", "unsafe"
    while pending:
        current = done + [pending.pop(0)]
        try:
            info = catalog_lstat("/" + "/".join(current))
        except OSError as error:
            if error.errno in (errno.ENOENT, errno.ENOTDIR):
                return "absent", ""
            return "unknown", "unreadable"
        if stat.S_ISLNK(info.st_mode):
            hops += 1
            if hops > CATALOG_LINK_HOPS:
                return "unknown", "redirect_limit"
            if info.st_uid not in catalog_owners(current):
                return "unknown", "unsafe"
            try:
                target = catalog_readlink("/" + "/".join(current))
            except OSError:
                return "unknown", "unreadable"
            resolved = [] if target.startswith("/") else list(done)
            for part in target.split("/"):
                if part == "..":
                    if not resolved:
                        return "unknown", "unsafe_redirect"
                    resolved.pop()
                elif part not in ("", "."):
                    resolved.append(part)
            zone = catalog_zone(current)
            if (zone is None or len(resolved) > 32 or not resolved
                    or catalog_zone(resolved) not in (("system",), zone)):
                return "unknown", "unsafe_redirect"
            pending, done = resolved + pending, []
            continue
        if info.st_mode & 0o002 or info.st_uid not in catalog_owners(current):
            return "unknown", "unsafe"
        if pending and not stat.S_ISDIR(info.st_mode):
            return "absent", ""
        done = current
    return "present", info


def catalog_leaf_path(kind, path):
    state, detail = catalog_walk(path)
    if state != "present":
        return state, detail
    mode = detail.st_mode
    found = {"exists": True, "file": stat.S_ISREG(mode), "dir": stat.S_ISDIR(mode),
             "program": stat.S_ISREG(mode) and bool(mode & 0o111)}[kind]
    return ("present", "") if found else ("absent", "")


def catalog_combine(mode, results):
    """Three-valued all/any: a deciding leaf wins, otherwise the first unknown leaf, otherwise the other value."""
    deciding = "absent" if mode == "all" else "present"
    if any(state == deciding for state, _ in results):
        return deciding, ""
    unknown = next((result for result in results if result[0] == "unknown"), None)
    if unknown:
        return unknown
    return ("present" if mode == "all" else "absent"), ""


def catalog_glob(path):
    parts = path.strip("/").split("/")
    index = next(i for i, part in enumerate(parts) if "*" in part)
    prefix, _, suffix = parts[index].partition("*")
    parent = "/" + "/".join(parts[:index])
    state, detail = catalog_walk(parent)
    if state != "present":
        return state, detail
    if not stat.S_ISDIR(detail.st_mode):
        return "absent", ""
    try:
        names, truncated = catalog_listdir(parent, CATALOG_GLOB_SCAN)
    except OSError:
        return "unknown", "unreadable"
    results = [catalog_leaf_path("exists", "/".join([parent, name] + parts[index + 1:]))
               for name in sorted(names) if CATALOG_SEGMENT.match(name) and name not in (".", "..")
               and len(name) >= len(prefix) + len(suffix) and name.startswith(prefix) and name.endswith(suffix)]
    return catalog_combine("any", results + ([("unknown", "scan_limit")] if truncated else []))


def catalog_installed(predicate):
    mode, leaves = predicate
    results = []
    for kind, arg in leaves:
        if kind == "which":
            results.append(catalog_combine("any", [catalog_leaf_path("program", folder + "/" + arg)
                                                   for folder in CATALOG_WHICH_PATH]))
        elif kind == "glob":
            results.append(catalog_glob(arg))
        else:
            results.append(catalog_leaf_path(kind, arg))
    return catalog_combine(mode, results)


def catalog_checks(component_id):
    """What the assistant can check for a component, from the code-owned health tables only."""
    def owned(table):
        return any(HEALTH_COMPONENT_CATALOG_IDS.get(key, key) == component_id for key in table)
    return ["presence"] + (["port"] if owned(HEALTH_COMPONENT_PORTS) else []) + (
        ["http"] if owned(HEALTH_COMPONENT_HTTP) else [])


def catalog_legacy_id(item):
    return (item["aliases"] or [item["id"]])[0]


def catalog_legacy_ids():
    """(legacy component ids, reason) from the catalog metadata only: startup entries, in catalog order."""
    loaded, reason, _ = catalog_load()
    return ([catalog_legacy_id(item) for item in loaded["items"] if item["startup"]] if loaded else []), reason


def catalog_components(catalog):
    """(legacy startup-marker rows, catalog rows) for a loaded catalog."""
    legacy, rows = [], []
    for item in catalog["items"] if catalog else []:
        installed, installed_reason = catalog_installed(item["installed"])
        startup, startup_reason = "n/a", ""
        if item["startup"]:
            mode, leaves = item["startup"]
            row = inventory_component(catalog_legacy_id(item), item["name"], item["role"], mode,
                                      [path for _, path in leaves])
            legacy.append(row)
            startup = row["state"] if row["state"] in ("present", "absent") else "unknown"
            startup_reason = "" if startup != "unknown" else row["state"]
        rows.append({"id": item["id"], "aliases": item["aliases"], "name": item["name"], "role": item["role"],
                     "listed": item["listed"], "installed": installed, "installed_reason": installed_reason,
                     "startup": startup, "startup_reason": startup_reason, "checks": catalog_checks(item["id"])})
    return legacy, rows


def inventory_extensions(product, root):
    """Names of the entries directly in <root>/ext, never followed or opened; links are reported as links."""
    result = {"product": product, "root": "ext", "state": "listed", "total": 0, "truncated": False, "skipped": 0,
              "entries": []}
    try:
        root_fd, state = inventory_open_dir(root)
        if root_fd is None:
            result["state"] = "product_absent" if state == "absent" else state
            return result
        try:
            ext_fd, state = inventory_step(root_fd, "ext")
        finally:
            os.close(root_fd)
    except OSError as error:
        ext_fd, state = None, INVENTORY_ERRNO.get(error.errno, "unreadable")
    if ext_fd is None:
        result["state"] = state
        return result
    entries = []
    try:
        with os.scandir(ext_fd) as scan:
            for entry in scan:
                result["total"] += 1
                if result["total"] > INVENTORY_SCAN_LIMIT:
                    result["total"], result["truncated"] = INVENTORY_SCAN_LIMIT, True
                    break
                if not INVENTORY_NAME.match(entry.name) or redact(entry.name) != entry.name:
                    result["skipped"] += 1
                    continue
                kind = ("link" if entry.is_symlink() else "dir" if entry.is_dir(follow_symlinks=False)
                        else "file" if entry.is_file(follow_symlinks=False) else "other")
                entries.append({"name": entry.name, "kind": kind})
    except OSError as error:
        return dict(result, state=INVENTORY_ERRNO.get(error.errno, "unreadable"), total=0, skipped=0)
    finally:
        os.close(ext_fd)
    entries.sort(key=lambda item: (item["name"].lower(), item["name"]))
    result["truncated"] = result["truncated"] or len(entries) > INVENTORY_MAX_ENTRIES
    result["entries"] = entries[:INVENTORY_MAX_ENTRIES]
    return result


def inventory_text(value, limit=INVENTORY_STRING_CHARS):
    return clean_line(re.sub(r"[\t\r\n]", " ", value[:limit * 2]))[:limit] if type(value) is str else ""


def inventory_custom_mods():
    """Registry entries from ddistro_custom_mod status (no health check, no network); a few fields only."""
    section = {"available": False, "reason": "", "truncated": False, "items": []}
    try:
        code, out, _ = run_helper(["status", "--json"], INVENTORY_MODS_TIMEOUT, INVENTORY_MODS_STDOUT_LIMIT + 1,
                                  helper=INVENTORY_MODS_HELPER)
    except CliError as error:
        section["reason"] = inventory_reason(error)
        return section
    if code != 0:
        section["reason"] = "helper_failed"
        return section
    try:
        if out.total > INVENTORY_MODS_STDOUT_LIMIT:
            raise ValueError("size")
        doc = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant)
        if type(doc) is not dict or doc.get("schema_version") != 1 or type(doc.get("mods")) is not list:
            raise ValueError("shape")
        items = []
        for mod in doc["mods"]:
            if type(mod) is not dict or type(mod.get("id")) is not str or not INVENTORY_MOD_ID.match(mod["id"]):
                raise ValueError("mod")
            state, commit = mod.get("state"), mod.get("commit", "")
            items.append({"id": mod["id"], "name": inventory_text(mod.get("name")),
                          "state": state if type(state) is str and STATE_TOKEN.match(state) else "unknown",
                          "branch": inventory_text(mod.get("branch")),
                          "commit": commit if type(commit) is str and INVENTORY_COMMIT.match(commit) else ""})
    except (ValueError, UnicodeDecodeError):
        section["reason"] = "helper_protocol"
        return section
    section.update(available=True, truncated=len(items) > INVENTORY_MAX_MODS, items=items[:INVENTORY_MAX_MODS])
    return section


def cmd_inventory(opts, ctx):
    captured_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    servers = {"available": False, "reason": "", "items": []}
    try:
        records = helper_status(timeout=INVENTORY_STATUS_TIMEOUT)
        servers.update(available=True, items=[
            {"product": r["product"], "state": r["state"], "repository_state": r["repository_state"],
             "database_present": r["database_present"], "branch": inventory_text(r["branch"]),
             "version": inventory_text(r["version"])} for r in records])
    except CliError as error:
        servers["reason"] = inventory_reason(error)
    extensions = {"items": [inventory_extensions(product, root) for product, root in INVENTORY_EXTENSION_ROOTS.items()],
                  "no_known_root": [product for product in PRODUCTS if product not in INVENTORY_EXTENSION_ROOTS]}
    loaded, reason, digest = catalog_load()
    legacy, rows = catalog_components(loaded)
    # components keeps its older shape (legacy ids, startup markers) for older launchers; catalog is the full list.
    components = {"basis": "startup_markers", "items": legacy}
    catalog = {"available": loaded is not None, "reason": reason, "schema_version": CATALOG_SCHEMA if loaded else None,
               "catalog_version": loaded["catalog_version"] if loaded else "", "sha256": digest,
               "basis": "installed_markers", "items": rows}
    custom_mods = inventory_custom_mods()
    complete = (servers["available"] and custom_mods["available"] and not custom_mods["truncated"]
                and catalog["available"]
                and all(item["state"] in ("listed", "absent", "product_absent") and not item["truncated"]
                        and not item["skipped"] for item in extensions["items"])
                and all(item["state"] in ("present", "absent") for item in components["items"])
                and all(item["installed"] != "unknown" for item in rows))
    data = {"captured_at": captured_at, "scope": "presence_only", "read_as": current_user(), "complete": complete,
            "servers": servers, "extensions": extensions, "components": components, "catalog": catalog,
            "custom_mods": custom_mods}
    lines = [f"DwemerDistro inventory at {captured_at} (presence only; not enabled, running, or healthy state)"]
    lines += ["Servers:"] + ([f"  {r['product']:<10} {r['state']:<15} branch={r['branch'] or '-'} "
                             f"version={r['version'] or '-'} database={DATABASE_WORDS[r['database_present']]}"
                             for r in servers["items"]] or [f"  unavailable: {servers['reason']}"])
    for item in extensions["items"]:
        names = ", ".join(e["name"] + ("/" if e["kind"] == "dir" else "") for e in item["entries"]) or "-"
        lines.append(f"{item['product']} ext ({item['state']}{', truncated' if item['truncated'] else ''}"
                     f"{', %d names skipped' % item['skipped'] if item['skipped'] else ''}): {names}")
    lines.append("Components: " + ", ".join(f"{c['id']}={c['state']}" for c in components["items"]))
    lines.append(f"Component catalog {catalog['catalog_version']} (installed presence only): " + (", ".join(
        f"{c['id']}={c['installed']}" + (f"({c['installed_reason']})" if c["installed_reason"] else "") for c in rows)
        or "-") if catalog["available"] else f"Component catalog: unavailable: {reason}")
    lines.append("Custom mods: " + (", ".join(f"{m['id']} ({m['state']})" for m in custom_mods["items"]) or "-")
                 if custom_mods["available"] else f"Custom mods: unavailable: {custom_mods['reason']}")
    return data, "\n".join(lines)


# ddistro health: bounded local checks with fresh evidence. A check is passed, failed, or skipped (with a
# reason); there is no overall verdict, nothing is repaired, and no provider or in-game path is exercised.
HEALTH_STATUS_TIMEOUT = 30
HEALTH_CONNECT_TIMEOUT = 1.5
HEALTH_SERVICES_CONF = "/etc/dwemerdistro_services.conf"
HEALTH_DISK_MIN_BYTES = 2 * 1024 ** 3
HEALTH_READ_LIMIT = 4096
# Component -> (services.conf key or None, default port, per-component port file); defaults as in ddistro_doctor.
HEALTH_COMPONENT_PORTS = {
    "xtts": ("XTTS_PORT", 8020, None),
    "omnivoice": ("OMNIVOICE_PORT", 8021, None),
    "parakeet": ("PARAKEET_PORT", 8022, None),
    "chatterbox": (None, 8020, "/home/dwemer/chatterbox/.dwemerdistro-port"),
    "pocket_tts": (None, 8020, "/home/dwemer/pocket-tts/.dwemerdistro-port"),
    "pockettts_audiocpp": ("POCKETTTS_AUDIOCPP_PORT", 8086, None),
}
# The health tables use the legacy inventory ids; these are the catalog ids they belong to (others are the same).
HEALTH_COMPONENT_CATALOG_IDS = {"pocket_tts": "pockettts", "pockettts_audiocpp": "audiocpp"}
# Fixed local application contracts, each defined by the service's own source and already relied on by DwemerDistro:
# DialecticServer/health.php and StobeServer/health.php ({"service", "status": "ok"|...}), OmniVoice GET /health
# ({"status": "ok"|"no_voices"}), and the TTS identity GET /provider_info ({"provider"}) that ddistro_doctor checks.
# Nothing else is requested; servers and components without one are reported skipped, never passed.
HEALTH_HTTP_TIMEOUT = 2.0
HEALTH_HTTP_LIMIT = 64 * 1024
HEALTH_SERVER_HTTP = {"dialectic": ("/DialecticServer/health.php", "DialecticServer"),
                      "stobe": ("/StobeServer/health.php", "StobeServer")}
HEALTH_COMPONENT_HTTP = {"omnivoice": "/health", "xtts": "/provider_info", "chatterbox": "/provider_info",
                         "pocket_tts": "/provider_info"}
HEALTH_PROVIDERS = {"xtts": ("xtts", "xtts-fastapi"), "chatterbox": ("chatterbox",),
                    "pocket_tts": ("pockettts", "pocket_tts", "pocket-tts")}
HEALTH_SCOPE_LIMITS = [
    "A port check proves only that something accepts TCP on 127.0.0.1, not which service or that it answers correctly.",
    "HTTP checks request only fixed local endpoints the services define (Dialectic and Stobe health.php, OmniVoice "
    "/health, the TTS /provider_info identity); other servers and components get no application check (skipped).",
    "Database checks report presence as seen by ddistro_server status; tables, credentials, and queries are not checked.",
    "Components without a known local port are skipped; marker presence alone is never reported as passed.",
    "No external provider, model, network, or in-game path is tested, and nothing is repaired.",
]


def health_port_value(text):
    text = text.strip().strip("\"'")
    return int(text) if re.match(r"^[0-9]{1,5}\Z", text) and 0 < int(text) < 65536 else None


def health_owners(dwemer):
    """Accounts trusted to own a health config file and its folders: root, plus dwemer for its own files."""
    try:
        return (0, pwd.getpwnam("dwemer").pw_uid) if dwemer else (0,)
    except KeyError:
        return (0,)


def health_read_small(path, owners):
    """Up to HEALTH_READ_LIMIT bytes of a fixed small config file; None when absent, unsafe, or too large.

    The path is walked from / one name at a time without following a link (as inventory does); "/", every
    folder, and the file must be owned by one of owners and not group/other writable. The file must be a
    regular file before and after a non-blocking open, so a FIFO, device, or swapped name never blocks or
    redirects the read."""
    parent, name = path.rsplit("/", 1)
    file_flags = (os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NOCTTY", 0)
                  | getattr(os, "O_CLOEXEC", 0))

    def trusted(info):
        return info.st_uid in owners and not info.st_mode & 0o022
    fd = fd_file = None
    try:
        fd = os.open("/", INVENTORY_DIR_FLAGS)
        for part in [p for p in parent.split("/") if p]:
            if not trusted(os.fstat(fd)):
                return None
            next_fd = os.open(part, INVENTORY_DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        if not trusted(os.fstat(fd)):
            return None
        before = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if not stat.S_ISREG(before.st_mode) or before.st_size > HEALTH_READ_LIMIT:
            return None
        fd_file = os.open(name, file_flags, dir_fd=fd)
        info = os.fstat(fd_file)
        if ((info.st_dev, info.st_ino) != (before.st_dev, before.st_ino) or not stat.S_ISREG(info.st_mode)
                or info.st_size > HEALTH_READ_LIMIT or not trusted(info)):
            return None
        data = os.read(fd_file, HEALTH_READ_LIMIT + 1)
        return None if len(data) > HEALTH_READ_LIMIT else data.decode("utf-8", "replace")
    except OSError:
        return None
    finally:
        for handle in (fd_file, fd):
            if handle is not None:
                os.close(handle)


def health_services_conf():
    """Plain NAME=port lines of a root-owned services.conf; it is never sourced."""
    text = health_read_small(HEALTH_SERVICES_CONF, health_owners(False)) or ""
    return {match.group(1): port for match in re.finditer(r"(?m)^\s*([A-Z_]{1,40})=(\S+)\s*$", text)
            if (port := health_port_value(match.group(2)))}


def health_connect(port):
    started = time.monotonic()
    try:
        socket.create_connection(("127.0.0.1", port), timeout=HEALTH_CONNECT_TIMEOUT).close()
        return True, f"tcp 127.0.0.1:{port} accepted in {int((time.monotonic() - started) * 1000)} ms"
    except OSError as error:
        return False, f"tcp 127.0.0.1:{port} {errno.errorcode.get(error.errno, 'timeout') if error.errno else 'timeout'}"


def health_http_get(port, path):
    """GET a fixed path on 127.0.0.1 within HEALTH_HTTP_TIMEOUT in total and HEALTH_HTTP_LIMIT bytes.

    Returns (status code or None, JSON object or None, problem or None); never raises for network failures."""
    deadline = time.monotonic() + HEALTH_HTTP_TIMEOUT
    data = bytearray()
    try:
        sock = socket.create_connection(("127.0.0.1", port), timeout=HEALTH_HTTP_TIMEOUT)
    except OSError as error:
        return None, None, "connect " + (errno.errorcode.get(error.errno, "timeout") if error.errno else "timeout")
    try:
        sock.sendall(b"GET " + path.encode("ascii") + b" HTTP/1.0\r\nHost: 127.0.0.1\r\nAccept: application/json\r\n"
                     b"Connection: close\r\n\r\n")
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None, None, f"no complete answer within {HEALTH_HTTP_TIMEOUT:g} s"
            sock.settimeout(remaining)
            chunk = sock.recv(16384)
            if not chunk:
                break
            data += chunk
            if len(data) > HEALTH_HTTP_LIMIT:
                return None, None, f"answer over {HEALTH_HTTP_LIMIT // 1024} KiB"
    except socket.timeout:
        return None, None, f"no complete answer within {HEALTH_HTTP_TIMEOUT:g} s"
    except OSError as error:
        return None, None, "read " + errno.errorcode.get(error.errno or 0, "error")
    finally:
        sock.close()
    head, _, body = bytes(data).partition(b"\r\n\r\n")
    match = re.match(rb"^HTTP/1\.[01] ([0-9]{3})", head)
    if not match:
        return None, None, "not an HTTP answer"
    status = int(match.group(1))
    if b"transfer-encoding: chunked" in head.lower():
        return status, None, f"HTTP {status} with a chunked body (not read)"
    try:
        document = json.loads(body.decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        document = None
    if type(document) is not dict:
        return status, None, f"HTTP {status} without a JSON object"
    return status, document, None


def health_word(document, key):
    value = document.get(key)
    return clean_line(value[:64]) if type(value) is str else None


def health_server_matches(document, service):
    """Accept the two published Dialectic health labels, without accepting another product on its port."""
    accepted = (service, "DIALECTIC Server") if service == "DialecticServer" else (service,)
    return type(document.get("service")) is str and document["service"] in accepted


def cmd_health(opts, ctx):
    product = opts.get("product")
    captured_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    checks = []

    def add(check_id, component, result, evidence, reason=None):
        checks.append({"id": check_id, "component": component, "result": result, "evidence": evidence,
                       "reason": reason, "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())})

    def port_check(check_id, component, port, source):
        passed, evidence = health_connect(port)
        add(check_id, component, "passed" if passed else "failed", f"{evidence} (port from {source})")
        return passed

    def http_check(check_id, component, port, path, judge):
        """One fixed GET; judge(status, document) gives (result, evidence[, reason]) for an answer with a JSON object."""
        if path is None:
            add(check_id, component, "skipped", "no application check", "no known local health contract")
            return
        status, document, problem = health_http_get(port, path)
        where = f"GET 127.0.0.1:{port}{path}"
        if document is None:
            add(check_id, component, "failed", f"{where}: {problem}")
            return
        result, evidence, *reason = judge(status, document)
        add(check_id, component, result, f"{where}: HTTP {status}, {evidence}", *reason)

    def server_health(service):
        def judge(status, document):
            if not health_server_matches(document, service):
                return "failed", f"answered, but not as {service}"
            facts = "".join(f", {key} {str(document[key]).lower()}" for key in
                            ("database", "schema", "database_schema_ready", "background_processor")
                            if type(document.get(key)) is bool)
            state = health_word(document, "status") or "unknown"
            return ("passed" if status == 200 and state == "ok" else "failed"), f"status {state}{facts}"
        return judge

    def omnivoice_health(status, document):
        state = health_word(document, "status") or "unknown"
        return ("passed" if status == 200 and state == "ok" else "failed"), f"status {state}"

    def provider_identity(component_id):
        def judge(status, document):
            provider = (health_word(document, "provider") or "").lower()
            if status == 404 and not provider:
                return "skipped", "no provider_info endpoint", "older releases predate provider_info"
            if status != 200:
                # A failing answer is unhealthy even when it names the right service.
                return "failed", f"provider {provider or 'not given'}", f"expected HTTP 200, got HTTP {status}"
            if provider in HEALTH_PROVIDERS[component_id]:
                return "passed", f"provider {provider}"
            if provider:
                return "failed", f"answered as provider {provider}; another service owns this port"
            return "skipped", "no provider field", "service did not identify itself; older releases predate provider_info"
        return judge

    try:
        records = helper_status(product, timeout=HEALTH_STATUS_TIMEOUT)
    except CliError as error:
        if error.code == "cancelled":
            raise
        records = None
        add("servers.status", "ddistro_server", "failed", "ddistro_server status: " + error.code)
    for record in records or []:
        name, state = record["product"], record["state"]
        if state == "not-installed":
            add(f"server.{name}.installed", name, "skipped", "state not-installed", "not installed")
            continue
        add(f"server.{name}.installed", name, "passed" if state == "installed" else "failed",
            f"state {state}, repository {record['repository_state']}")
        if port_check(f"server.{name}.port", name, record["port"], "ddistro_server status"):
            path, service = HEALTH_SERVER_HTTP.get(name, (None, None))
            http_check(f"server.{name}.http", name, record["port"], path, server_health(service))
        present = record["database_present"]
        add(f"server.{name}.database", name, {True: "passed", False: "failed", None: "skipped"}[present],
            f"database {DATABASE_WORDS[present]}", None if present is not None else "PostgreSQL not ready for status")
    pg_port = health_port_value(os.environ.get("DDISTRO_POSTGRES_PORT", "")) or 5432
    port_check("postgres.port", "postgres", pg_port, "DDISTRO_POSTGRES_PORT" if pg_port != 5432 else "default")
    if product is None:
        conf = health_services_conf()
        loaded, reason, _ = catalog_load()
        if loaded is None:
            add("component.catalog", "components", "skipped", "component catalog unavailable", reason)
        for item in loaded["items"] if loaded else []:
            if not item["startup"]:
                # No startup marker means no known local port contract; installed presence is reported as evidence.
                installed, why = catalog_installed(item["installed"])
                add(f"component.{item['id']}.port", item["id"], "skipped",
                    f"installed {installed}" + (f" ({why})" if why else ""), "no known local port contract")
                continue
            mode, leaves = item["startup"]
            component_id = (item["aliases"] or [item["id"]])[0]
            state = inventory_component(component_id, item["name"], item["role"], mode,
                                        [path for _, path in leaves])["state"]
            if state != "present":
                add(f"component.{component_id}.port", component_id, "skipped", f"startup marker {state}",
                    "startup not configured" if state == "absent" else "marker could not be checked")
                continue
            if component_id not in HEALTH_COMPONENT_PORTS:
                add(f"component.{component_id}.port", component_id, "skipped", "startup marker present",
                    "no known local port contract")
                continue
            key, port, port_file = HEALTH_COMPONENT_PORTS[component_id]
            source = "default"
            if key and key in conf:
                port, source = conf[key], HEALTH_SERVICES_CONF
            saved = health_port_value(health_read_small(port_file, health_owners(True)) or "") if port_file else None
            if saved:
                port, source = saved, port_file
            if port_check(f"component.{component_id}.port", component_id, port, source):
                judge = omnivoice_health if component_id == "omnivoice" else provider_identity(component_id)
                http_check(f"component.{component_id}.http", component_id, port, HEALTH_COMPONENT_HTTP.get(component_id),
                           judge)
    for path in ("/", "/var/lib/postgresql", "/home/dwemer"):
        try:
            usage = shutil.disk_usage(path)
        except OSError:
            add(f"disk.{path}", "disk", "skipped", path + " not present", "path absent or unreadable")
            continue
        low = usage.free < HEALTH_DISK_MIN_BYTES or usage.free * 20 < usage.total
        add(f"disk.{path}", "disk", "failed" if low else "passed",
            f"{usage.free // 1024 ** 2} MiB free of {usage.total // 1024 ** 2} MiB (minimum 2048 MiB and 5%)")
    summary = {result: sum(c["result"] == result for c in checks) for result in ("passed", "failed", "skipped")}
    data = {"captured_at": captured_at, "scope": "local_bounded", "product": product,
            "read_as": current_user(), "summary": summary, "checks": checks, "scope_limits": HEALTH_SCOPE_LIMITS}
    lines = [f"DwemerDistro health at {data['captured_at']}: {summary['passed']} passed, {summary['failed']} failed, "
             f"{summary['skipped']} skipped (local checks only)"]
    lines += [f"  {c['result']:<7} {c['id']:<32} {c['evidence']}" + (f" ({c['reason']})" if c["reason"] else "")
              for c in checks]
    return data, "\n".join(lines)


# ddistro performance: bounded local timings captured now. Each measurement is measured, failed, or skipped (with a
# reason); durations are whole wall-clock milliseconds seen by ddistro, never provider latency, and nothing is judged
# fast or slow. It sends only the fixed local health requests health already makes, one read-only SELECT 1, reads
# kernel counters, and parses HerikaServer's [PERF] records from the bounded chim.log tail; no other log, provider,
# model, or configuration is read, and nothing is changed (trace logging is never turned on).
PERFORMANCE_DEADLINE = 15.0
PERFORMANCE_PSQL_TIMEOUT = 10
PERFORMANCE_MAX = 64
PERFORMANCE_MEMINFO = ("MemTotal", "MemAvailable", "SwapTotal", "SwapFree")
PERFORMANCE_PRESSURE = ("cpu", "memory", "io")
PERFORMANCE_SCOPE_LIMITS = [
    "Durations are wall-clock milliseconds measured by ddistro now, not LLM, TTS, or in-game latency, and are not judged.",
    "HTTP timings use only the fixed local health requests health makes (Dialectic and Stobe health.php); other "
    "servers have no local health contract and are skipped. A port or TCP answer is not health.",
    "The PostgreSQL timing is one read-only SELECT 1 through runuser and psql, so it includes process start, connection "
    "setup, and up to 100 ms of polling; it is not query performance.",
    "Host load, memory, and pressure come from /proc as seen by the distro's Linux kernel (WSL); they are not Windows, "
    "game, or GPU figures. Missing counters are skipped.",
    "Herika request timings come only from HerikaServer's [PERF] request records in the bounded tail of chim.log, when "
    "the installed version writes them; only fixed numeric fields are returned. Older versions write none and it is "
    "skipped. Legacy START/END or audit elapsed times are not read.",
    "Herika's llm_complete stage is all of call_llm() after prompt_ready: local connector work, generation, line "
    "output (which may include TTS synthesis and player TTS), and any fallback retry. It is not provider latency, time "
    "to first token, or a TTS timing; none of those is available separately.",
]
# HerikaServer request timing (lib/request_performance.php): at the end of each request it writes, via Logger::trace,
# one line "[<ISO 8601 time with offset>] [trace] [PERF] <JSON>" to log/chim.log. The JSON has total_ms, sql_ms,
# peak_memory_mb and phases [{name, delta_ms, total_ms}] (plus run_id, request_type and status, which are never
# returned). Only the fixed numeric fields and the known stage names below are kept; any other key, a phase name not
# listed, the line, the run id and the request type are discarded. A record must be status "complete", carry a time
# with a zone, be no larger than the line bound, and have finite, non-negative numbers within the bounds.
PERFORMANCE_HERIKA_LOG = "chim.log"
PERFORMANCE_HERIKA_WINDOW = 900  # seconds: records from the last 15 minutes
PERFORMANCE_HERIKA_SAMPLES = 32  # newest records kept
PERFORMANCE_HERIKA_LINE_CHARS = 16384
PERFORMANCE_HERIKA_MAX_PHASES = 64
PERFORMANCE_HERIKA_MAX_MS = 86400000.0
PERFORMANCE_HERIKA_MAX_MB = 1048576.0
PERFORMANCE_HERIKA_FUTURE = 60  # seconds a record may be ahead of the clock
PERFORMANCE_HERIKA_LINE = re.compile(r"^\[[^\]\n]{1,40}\] \[trace\] \[PERF\] (\{.*\})\Z")
PERFORMANCE_HERIKA_FIELDS = (("total_ms", "total_request_ms", PERFORMANCE_HERIKA_MAX_MS),
                             ("sql_ms", "sql_ms", PERFORMANCE_HERIKA_MAX_MS),
                             ("peak_memory_mb", "peak_memory_mb", PERFORMANCE_HERIKA_MAX_MB))
PERFORMANCE_HERIKA_STAGES = ("request_parsed", "lock_ready", "profile_ready", "context_history_ready", "memory_ready",
                             "oghma_ready", "prompt_ready", "llm_complete")


def performance_herika_number(value, bound):
    """A finite number in [0, bound] (bool is not a number), else None."""
    if type(value) not in (int, float) or not 0 <= value <= bound:  # NaN fails both comparisons
        return None
    return float(value)


def performance_herika_record(row):
    """(epoch seconds, metrics, stage deltas) for one valid [PERF] line, None for another line, or a skip reason."""
    if "[PERF]" not in row[:120]:
        return None
    if len(row) > PERFORMANCE_HERIKA_LINE_CHARS:
        return "oversize"
    match = PERFORMANCE_HERIKA_LINE.match(row)
    if not match:
        return "malformed"
    stamp = log_stamp(row)
    if not stamp:
        return "invalid_time" if stamp is False else "malformed"
    if not stamp[1]:
        return "time_without_zone"
    try:
        doc = json.loads(match.group(1), parse_constant=reject_constant)
    except (ValueError, TypeError, RecursionError):
        return "malformed"
    if type(doc) is not dict:
        return "malformed"
    if doc.get("status") != "complete":
        return "not_complete"
    metrics = {}
    for field, name, bound in PERFORMANCE_HERIKA_FIELDS:
        metrics[name] = performance_herika_number(doc.get(field), bound)
        if metrics[name] is None:
            return "invalid_number" if field in doc else "missing_field"
    phases = doc.get("phases")
    if type(phases) is not list or len(phases) > PERFORMANCE_HERIKA_MAX_PHASES:
        return "malformed"
    stages = {}
    for phase in phases:
        name = phase.get("name") if type(phase) is dict else None
        if name not in PERFORMANCE_HERIKA_STAGES or name in stages:
            continue  # unknown names are never returned; a repeated mark keeps the first
        delta = performance_herika_number(phase.get("delta_ms"), PERFORMANCE_HERIKA_MAX_MS)
        if delta is None:
            return "invalid_number"
        stages[name] = delta
    return stamp[0], metrics, stages


def performance_herika_stats(values):
    ordered = sorted(values)
    middle = len(ordered) // 2
    median = ordered[middle] if len(ordered) % 2 else (ordered[middle - 1] + ordered[middle]) / 2
    return {"count": len(ordered), "median": round(median, 2), "max": round(ordered[-1], 2)}


def performance_herika():
    """(result, values, reason) from recent HerikaServer [PERF] records in the bounded tail of chim.log."""
    root = LOG_SOURCES["herika"][0]
    path = os.path.join(root, PERFORMANCE_HERIKA_LOG)
    try:
        root_info = os.lstat(root)
        if not stat.S_ISDIR(root_info.st_mode) or os.path.realpath(root) != root:
            return "skipped", None, "log folder redirected; not read"
        rows, start, _ = read_tail_rows(path)
    except FileNotFoundError:
        return "skipped", None, "chim.log not present"
    except PermissionError:
        return "skipped", None, "chim.log not readable by this user"
    except CliError:
        return "skipped", None, "chim.log is not a regular file; not read"
    except OSError as error:
        if error.errno == errno.ELOOP:
            return "skipped", None, "chim.log is a symbolic link; not read"
        return "skipped", None, "chim.log could not be read"
    now = time.time()
    cutoff = now - PERFORMANCE_HERIKA_WINDOW
    samples, skipped, seen, older, limited = [], {}, 0, 0, False
    first = next((found[0] for found in map(log_stamp, rows) if found), None)
    for row in reversed(rows):
        found = performance_herika_record(row)
        if found is None:
            continue
        seen += 1
        if isinstance(found, str):
            skipped[found] = skipped.get(found, 0) + 1
        elif found[0] < cutoff:
            older += 1
        elif found[0] > now + PERFORMANCE_HERIKA_FUTURE:
            skipped["future_time"] = skipped.get("future_time", 0) + 1
        elif len(samples) >= PERFORMANCE_HERIKA_SAMPLES:
            limited = True
        else:
            samples.append(found)
    # The whole window is covered only if the tail starts at the file's beginning or at a dated line before the cutoff,
    # and no in-window record was left out by the sample limit.
    covered = (start == 0 or (first is not None and first < cutoff)) and not limited
    values = {"window_seconds": PERFORMANCE_HERIKA_WINDOW, "tail_bytes": MAX_LOG_BYTES,
              "perf_records_in_tail": seen, "older_than_window": older,
              "skipped_records": dict(sorted(skipped.items())), "samples": len(samples),
              "sample_limit": PERFORMANCE_HERIKA_SAMPLES, "sample_limit_reached": limited,
              "window_covered": covered}
    if not seen:
        return "skipped", values, "no [PERF] records in the chim.log tail (version may not write them)"
    if not samples:
        return "skipped", values, ("no valid [PERF] records in the last 15 minutes" if skipped
                                   else "no [PERF] records in the last 15 minutes")
    stamps = [sample[0] for sample in samples]
    values.update({
        "newest_age_seconds": max(0, int(now - max(stamps))), "oldest_age_seconds": max(0, int(now - min(stamps))),
        **{name: performance_herika_stats([s[1][name] for s in samples]) for _, name, _ in PERFORMANCE_HERIKA_FIELDS},
        "stage_delta_ms": {stage: performance_herika_stats([s[2][stage] for s in samples if stage in s[2]])
                           for stage in PERFORMANCE_HERIKA_STAGES if any(stage in s[2] for s in samples)},
        "llm_complete_scope": "connector_generation_output_tts_and_retry_not_provider_latency_or_ttft"})
    return "measured", values, None if covered else "partial: the bounded tail or sample limit did not cover 15 minutes"


def performance_numbers(text, pattern):
    """Named numeric fields of a small /proc file; None when the text does not have the expected shape."""
    found = {}
    for match in re.finditer(pattern, text or ""):
        try:
            found[match.group(1)] = float(match.group(2))
        except ValueError:
            return None
    return found or None


def performance_host():
    """(id, result, values, reason) for load, memory and each PSI pressure file, from fixed /proc paths only."""
    results = []
    load = (health_read_small("/proc/loadavg", (0,)) or "").split()
    try:
        values = {"load_1m": float(load[0]), "load_5m": float(load[1]), "load_15m": float(load[2]),
                  "cpu_count": os.cpu_count()}
        results.append(("host.load", "measured", values, None))
    except (IndexError, ValueError):
        results.append(("host.load", "skipped", None, "/proc/loadavg unavailable or not in the expected format"))
    meminfo = performance_numbers(health_read_small("/proc/meminfo", (0,)),
                                  r"(?m)^(" + "|".join(PERFORMANCE_MEMINFO) + r"):\s+([0-9]{1,15}) kB$")
    if meminfo and {"MemTotal", "MemAvailable"} <= set(meminfo):
        values = {name.lower() + "_mib": int(meminfo[name]) // 1024 for name in PERFORMANCE_MEMINFO if name in meminfo}
        results.append(("host.memory", "measured", values, None))
    else:
        results.append(("host.memory", "skipped", None, "/proc/meminfo unavailable or not in the expected format"))
    for name in PERFORMANCE_PRESSURE:
        text = health_read_small(f"/proc/pressure/{name}", (0,))
        found = performance_numbers(text, r"(?m)^(some|full) avg10=([0-9]{1,3}\.[0-9]{1,2}) ")
        if found:
            results.append((f"host.pressure.{name}", "measured",
                            {f"{kind}_avg10_percent": value for kind, value in found.items()}, None))
        else:
            results.append((f"host.pressure.{name}", "skipped", None,
                            "pressure stall information unavailable" if text is None else "unexpected format"))
    return results


def performance_postgres(timeout):
    """(result, duration ms, reason) of one read-only SELECT 1 through the models psql path."""
    if os.geteuid() != 0:
        return "skipped", None, "requires_root"
    try:
        check_system_binary(MODELS_PSQL)
        pwd.getpwnam("postgres")
    except (CliError, KeyError, OSError):
        return "skipped", None, "helper_unavailable"
    started = time.monotonic()
    try:
        code, raw = models_psql("SELECT 1", 64, timeout=timeout, appname="ddistro-performance")
    except CliError as error:
        if error.code == "cancelled":
            raise
        return "failed", None, {"timeout": "timeout", "helper_protocol": "unexpected_output"}.get(
            error.code, "helper_unavailable")
    elapsed = int((time.monotonic() - started) * 1000)
    if code != 0:
        return "failed", elapsed, "database_unavailable" if code == 2 else "query_failed"
    if raw.strip() != b"1":
        return "failed", elapsed, "unexpected_output"
    return "measured", elapsed, None


def cmd_performance(opts, ctx):
    product = opts.get("product")
    captured_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    deadline = time.monotonic() + PERFORMANCE_DEADLINE
    measurements = []
    deadline_hit = False

    def add(measurement_id, component, result, duration_ms=None, values=None, reason=None):
        if len(measurements) < PERFORMANCE_MAX:
            measurements.append({"id": measurement_id, "component": component, "result": result,
                                 "duration_ms": duration_ms, "values": values, "reason": reason})

    def left(needed):
        """Seconds left before the deadline when at least needed remain; otherwise None (and the run is partial)."""
        nonlocal deadline_hit
        remaining = deadline - time.monotonic()
        if remaining < needed:
            deadline_hit = True
            return None
        return remaining

    records = None
    remaining = left(1)
    if remaining is not None:
        try:
            records = helper_status(product, timeout=max(1, min(HEALTH_STATUS_TIMEOUT, int(remaining))))
        except CliError as error:
            if error.code == "cancelled":
                raise
            add("servers.status", "ddistro_server", "failed", reason="ddistro_server status: " + error.code)
    else:
        add("servers.status", "ddistro_server", "skipped", reason="deadline reached")
    for record in records or []:
        name = record["product"]
        if record["state"] == "not-installed":
            add(f"server.{name}.http", name, "skipped", reason="not installed")
            continue
        path, service = HEALTH_SERVER_HTTP.get(name, (None, None))
        if path is None:
            add(f"server.{name}.http", name, "skipped", reason="no known local health contract")
            continue
        if left(HEALTH_HTTP_TIMEOUT) is None:
            add(f"server.{name}.http", name, "skipped", reason="deadline reached")
            continue
        started = time.monotonic()
        status, document, problem = health_http_get(record["port"], path)
        elapsed = int((time.monotonic() - started) * 1000)
        if document is None:
            # The problem text is built by health_http_get from fixed words; no body or endpoint is returned.
            add(f"server.{name}.http", name, "failed", elapsed, {"http_status": status}, problem)
            continue
        add(f"server.{name}.http", name, "measured", elapsed,
            {"http_status": status, "service_matched": health_server_matches(document, service),
             "status_ok": status == 200 and health_word(document, "status") == "ok"})
    timeout = left(2)
    if timeout is None:
        add("postgres.select1", "postgres", "skipped", reason="deadline reached")
    else:
        result, elapsed, reason = performance_postgres(max(1, min(PERFORMANCE_PSQL_TIMEOUT, int(timeout))))
        add("postgres.select1", "postgres", result, elapsed, {"client_setup_included": True}, reason)
    for measurement_id, result, values, reason in performance_host():
        add(measurement_id, "host", result, values=values, reason=reason)
    if product in (None, "herika"):
        if left(1) is None:
            add("herika.request_timing", "herika", "skipped", reason="deadline reached")
        else:
            result, values, reason = performance_herika()
            add("herika.request_timing", "herika", result, values=values, reason=reason)
    add("llm.provider_latency", "llm", "skipped", reason="no provider latency or TTFB contract; "
        "herika.request_timing llm_complete spans connector work, generation, output, and TTS")
    add("tts.recent_timing", "tts", "skipped", reason="no maintained TTS timing contract; not separable from llm_complete")
    summary = {result: sum(m["result"] == result for m in measurements) for result in ("measured", "failed", "skipped")}
    data = {"captured_at": captured_at, "scope": "local_bounded", "product": product, "read_as": current_user(),
            "time_unit": "ms", "deadline_seconds": PERFORMANCE_DEADLINE, "complete": not deadline_hit,
            "summary": summary, "measurements": measurements, "scope_limits": PERFORMANCE_SCOPE_LIMITS}
    lines = [f"DwemerDistro performance at {captured_at}: {summary['measured']} measured, {summary['failed']} failed, "
             f"{summary['skipped']} skipped (local timings only{'; deadline reached, partial' if deadline_hit else ''})"]
    for m in measurements:
        shown = f"{m['duration_ms']} ms" if m["duration_ms"] is not None else ""
        if m["values"]:
            shown = ", ".join([shown] * bool(shown) + [f"{k} {json.dumps(v, separators=(',', ':'))}"
                                                       if isinstance(v, dict) else f"{k} {v}"
                                                       for k, v in m["values"].items()])
        lines.append(f"  {m['result']:<8} {m['id']:<28} {shown}" + (f" ({m['reason']})" if m["reason"] else ""))
    return data, "\n".join(lines)


# ddistro memory: installation-local notes the assistant may recall across this distro's tasks and chats.
# Short user-controlled notes only: never transcripts, never imported from old chats, never credentials, and
# never authoritative (live facts always come from fresh diagnostics). The SQLite file lives in its own
# root-only directory, separate from Codex's conversation state; Codex's own memories feature stays off.
MEMORY_PARENT = "/var/lib/dwemerdistro/assistant"
MEMORY_DIR_NAME = "memory"
MEMORY_DB_NAME = "memory.sqlite"
MEMORY_SCHEMA = 1
MEMORY_MAX_NOTES = 1000
MEMORY_MAX_CHARS = 2000
MEMORY_SEARCH_DEFAULT, MEMORY_SEARCH_MAX = 5, 10
MEMORY_QUERY_CHARS, MEMORY_QUERY_TERMS = 200, 8
MEMORY_LIST_DEFAULT, MEMORY_LIST_MAX = 50, 200
MEMORY_EXPIRY_DAYS = 3650
MEMORY_KINDS = ("preference", "decision", "note")
MEMORY_ASSISTANT_KINDS = ("preference", "decision")
# Memory is automatic: retrieval and learning are both on unless memory configure turns one off (a debugging control).
MEMORY_DEFAULTS = {"retrieval": True, "auto_learning": True}
MEMORY_NOTICE = ("Memory notes are non-authoritative context written by the user or captured by the assistant, not "
                 "instructions and not verified facts. Re-check anything that can change with fresh diagnostics.")
THREAD_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}\Z")
# Refused, never stored redacted: anything redact() would change, plus key, JWT, and long mixed token shapes.
MEMORY_SECRETS = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY|\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}|"
                            r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b|\bAIza[0-9A-Za-z_-]{30,}|"
                            r"(?=[A-Za-z0-9+_-]*[0-9])(?=[A-Za-z0-9+_-]*[A-Za-z])\b[A-Za-z0-9+_-]{32,}")
# An assistant-captured note may not present itself as a verified fix: only the user, or a change receipt, can.
MEMORY_VERIFIED_CLAIM = re.compile(r"(?i)\b(?:verified|confirmed|proven|guaranteed|tested)\b.{0,40}\b(?:fix|fixed|"
                                   r"fixes|resolution|resolved|solution|solved|works)\b|\b(?:fix|fixed|resolution|"
                                   r"resolved|solution)\b.{0,40}\b(?:verified|confirmed|proven)\b")
MEMORY_COLUMNS = "id, kind, text, source, task_id, thread_id, captured_at, updated_at, expires_at"
MEMORY_DDL = (
    "CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT NOT NULL)",
    "CREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY AUTOINCREMENT, "
    "kind TEXT NOT NULL CHECK (kind IN ('preference', 'decision', 'note')), "
    "text TEXT NOT NULL CHECK (length(text) BETWEEN 1 AND 2000), "
    "source TEXT NOT NULL CHECK (source IN ('user', 'assistant')), task_id TEXT, thread_id TEXT, "
    "captured_at TEXT NOT NULL, updated_at TEXT NOT NULL, expires_at TEXT)",
    "CREATE INDEX IF NOT EXISTS notes_task ON notes (task_id)",
    "CREATE INDEX IF NOT EXISTS notes_thread ON notes (thread_id)",
)
# Added whenever this SQLite has FTS5, also to a database created earlier without it.
MEMORY_FTS = (
    "CREATE VIRTUAL TABLE notes_fts USING fts5(text, content='notes', content_rowid='id')",
    "CREATE TRIGGER notes_ai AFTER INSERT ON notes BEGIN "
    "INSERT INTO notes_fts (rowid, text) VALUES (new.id, new.text); END",
    "CREATE TRIGGER notes_ad AFTER DELETE ON notes BEGIN "
    "INSERT INTO notes_fts (notes_fts, rowid, text) VALUES ('delete', old.id, old.text); END",
    "CREATE TRIGGER notes_au AFTER UPDATE OF text ON notes BEGIN "
    "INSERT INTO notes_fts (notes_fts, rowid, text) VALUES ('delete', old.id, old.text); "
    "INSERT INTO notes_fts (rowid, text) VALUES (new.id, new.text); END",
    "INSERT INTO notes_fts (notes_fts) VALUES ('rebuild')",
)


def memory_untrusted(what):
    return CliError("unsafe_path", f"The assistant memory {what} is not private to root; nothing was read or "
                    "changed. Fix its owner and mode (root, 0700 directory, 0600 file) or remove it.",
                    {"reason": "memory_untrusted", "location": what})


def memory_now(offset_days=0):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + offset_days * 86400))


def memory_directory(create, parent=None, name=MEMORY_DIR_NAME, untrusted=None):
    """The private memory directory (or another root-private directory name under parent), or None when it is
    absent and create is False.

    Every component is opened without following links and must be root-owned and not group- or
    other-writable; the directory itself must be root's with mode 0700. Nothing is repaired."""
    parent = parent or MEMORY_PARENT
    untrusted = untrusted or memory_untrusted
    fd = os.open("/", INVENTORY_DIR_FLAGS)
    try:
        parts = [p for p in parent.split("/") if p] + [name]
        for index, part in enumerate(parts):
            st = os.fstat(fd)
            if st.st_uid != 0 or st.st_mode & 0o022:
                raise untrusted("parent directory")
            last = index == len(parts) - 1
            try:
                next_fd = os.open(part, INVENTORY_DIR_FLAGS, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    return None
                if not last:
                    raise CliError("unsupported", "The assistant state directory is missing; install the "
                                   "assistant runtime first.", {"reason": "assistant_state_missing"})
                os.mkdir(part, 0o700, dir_fd=fd)
                next_fd = os.open(part, INVENTORY_DIR_FLAGS, dir_fd=fd)
            except OSError:
                raise untrusted("directory" if last else "parent directory")
            os.close(fd)
            fd = next_fd
        st = os.fstat(fd)
        if st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o700:
            raise untrusted("directory")
        return parent + "/" + name
    finally:
        os.close(fd)


def memory_file_ok(st):
    return stat.S_ISREG(st.st_mode) and st.st_uid == 0 and st.st_nlink == 1 and not st.st_mode & 0o077


def memory_open(create):
    """(connection, fts) for the memory database, upgraded in place; None when absent and create is False."""
    if os.geteuid() != 0:
        raise CliError("permission_denied", "ddistro memory must run as root. ddistro never elevates by itself.")
    import sqlite3
    old_umask = os.umask(0o077)
    try:
        directory = memory_directory(create)
        if directory is None:
            return None
        path = directory + "/" + MEMORY_DB_NAME
        try:
            before = os.lstat(path)
        except FileNotFoundError:
            if not create:
                return None
            os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600))
            before = os.lstat(path)
        if not memory_file_ok(before):
            raise memory_untrusted("database file")
        conn = sqlite3.connect(path, timeout=5, isolation_level=None)
        after = os.lstat(path)
        if (after.st_dev, after.st_ino) != (before.st_dev, before.st_ino) or not memory_file_ok(after):
            conn.close()
            raise memory_untrusted("database file")
        # Forgotten text is overwritten on disk, not only unlinked from the b-tree.
        conn.execute("PRAGMA secure_delete = ON")
        return conn, memory_schema(conn)
    finally:
        os.umask(old_umask)


def memory_schema(conn):
    """Idempotent upgrade to MEMORY_SCHEMA; writes only when something is missing. Returns whether FTS5 is used."""
    version = conn.execute("PRAGMA user_version").fetchone()[0]
    if version > MEMORY_SCHEMA:
        raise CliError("unsupported", "The assistant memory database was written by a newer ddistro.",
                       {"reason": "memory_schema_newer", "schema_version": version})
    try:
        conn.execute("CREATE VIRTUAL TABLE temp.fts_probe USING fts5(x)")
        conn.execute("DROP TABLE temp.fts_probe")
        fts_available = True
    except Exception:
        fts_available = False
    has_fts = conn.execute("SELECT 1 FROM sqlite_master WHERE name = 'notes_fts'").fetchone() is not None
    if has_fts and not fts_available:
        raise CliError("unsupported", "The assistant memory index needs SQLite FTS5, which this Python lacks.",
                       {"reason": "memory_fts_unavailable"})
    if version == MEMORY_SCHEMA and (has_fts or not fts_available):
        return has_fts

    def upgrade():
        for statement in MEMORY_DDL:
            conn.execute(statement)
        if fts_available and not has_fts:
            for statement in MEMORY_FTS:
                conn.execute(statement)
        conn.execute(f"PRAGMA user_version = {MEMORY_SCHEMA}")
    memory_write(conn, upgrade)
    return fts_available


def memory_write(conn, change):
    """One IMMEDIATE transaction: concurrent writers wait up to the busy timeout, then fail as busy."""
    import sqlite3
    try:
        conn.execute("BEGIN IMMEDIATE")
    except sqlite3.OperationalError:
        raise CliError("busy", "The assistant memory database is busy; try again.")
    try:
        result = change()
        conn.execute("COMMIT")
        return result
    except BaseException:
        conn.execute("ROLLBACK")
        raise


def memory_settings(conn):
    settings = dict(MEMORY_DEFAULTS)
    if conn is not None:
        for key, value in conn.execute("SELECT key, value FROM settings"):
            if key in settings and value in ("on", "off"):
                settings[key] = value == "on"
    return settings


def memory_view(row, now):
    note = dict(zip(MEMORY_COLUMNS.split(", "), row))
    note["expired"] = note["expires_at"] is not None and note["expires_at"] <= now
    return note


def memory_text(value):
    text = value.strip()
    if not 0 < len(text) <= MEMORY_MAX_CHARS or re.search(r"[\x00-\x08\x0b-\x1f\x7f]", text):
        raise CliError("invalid_argument", f"--text must be 1-{MEMORY_MAX_CHARS} characters without control "
                       "characters.")
    if redact(text) != text or MEMORY_SECRETS.search(text):
        # The text is never echoed back, logged, or stored redacted.
        raise CliError("refused", "The note looks like it contains a credential, token, secret assignment, or "
                       "URL query, so it was not stored. Describe the setting without its value.",
                       {"reason": "secret_shape"})
    return text


def memory_int(opts, key, low, high, default=None):
    value = opts.get(key)
    if value is None:
        return default
    if not re.match(r"^[0-9]{1,6}\Z", value) or not low <= int(value) <= high:
        raise CliError("invalid_argument", f"--{key} must be between {low} and {high}.")
    return int(value)


def memory_choice(opts, key, choices, default=None):
    value = opts.get(key, default)
    if value is not None and value not in choices:
        raise CliError("invalid_argument", f"--{key} must be one of: " + ", ".join(choices))
    return value


def memory_terms(query):
    if len(query) > MEMORY_QUERY_CHARS:
        raise CliError("invalid_argument", f"--query must be at most {MEMORY_QUERY_CHARS} characters.")
    terms = []
    for word in re.findall(r"[^\W_]+", query.lower()):
        if word[:64] not in terms:
            terms.append(word[:64])
    if not terms:
        raise CliError("invalid_argument", "--query needs at least one word.")
    return terms[:MEMORY_QUERY_TERMS]


def memory_search(conn, fts, terms, limit, now):
    """FTS5 ranked match of quoted prefix terms; otherwise an escaped LIKE scan. Expired notes never match."""
    if fts:
        match = " OR ".join('"%s"*' % term for term in terms)
        sql = (f"SELECT {', '.join('n.' + c for c in MEMORY_COLUMNS.split(', '))} FROM notes_fts f "
               "JOIN notes n ON n.id = f.rowid WHERE notes_fts MATCH ? AND (n.expires_at IS NULL OR n.expires_at > ?) "
               "ORDER BY bm25(notes_fts), n.id DESC LIMIT ?")
        return conn.execute(sql, (match, now, limit)).fetchall()
    patterns = ["%" + t.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%" for t in terms]
    where = " OR ".join("lower(text) LIKE ? ESCAPE '\\'" for _ in terms)
    sql = (f"SELECT {MEMORY_COLUMNS} FROM notes WHERE ({where}) AND (expires_at IS NULL OR expires_at > ?) "
           "ORDER BY updated_at DESC, id DESC LIMIT ?")
    return conn.execute(sql, patterns + [now, limit]).fetchall()


def memory_get(conn, note_id, now):
    row = conn.execute(f"SELECT {MEMORY_COLUMNS} FROM notes WHERE id = ?", (note_id,)).fetchone()
    if row is None:
        raise CliError("not_found", "No memory note has that id.", {"id": note_id})
    return memory_view(row, now)


def memory_lines(notes):
    return [f"  #{n['id']} [{n['kind']}, {n['source']}{', expired' if n['expired'] else ''}] {n['text']}"
            for n in notes] or ["  (no notes)"]


def cmd_memory(opts, ctx):
    import sqlite3
    action = ctx["command"].split(" ", 1)[1]
    try:
        return MEMORY_ACTIONS[action](opts)
    except sqlite3.OperationalError as error:
        if "locked" in str(error) or "busy" in str(error):
            raise CliError("busy", "The assistant memory database is busy; try again.")
        raise CliError("failed", "The assistant memory database could not be used.", {"reason": "memory_database"})
    except sqlite3.DatabaseError:
        raise CliError("failed", "The assistant memory database could not be used.", {"reason": "memory_database"})


def memory_status(opts):
    opened = memory_open(create=False)
    conn, fts = opened if opened else (None, False)
    now = memory_now()
    total = expired = 0
    if conn is not None:
        total, expired = conn.execute("SELECT count(*), coalesce(sum(expires_at IS NOT NULL AND expires_at <= ?), 0) "
                                      "FROM notes", (now,)).fetchone()
    settings = memory_settings(conn)
    data = {"present": conn is not None, "location": MEMORY_PARENT + "/" + MEMORY_DIR_NAME + "/" + MEMORY_DB_NAME,
            "schema_version": MEMORY_SCHEMA if conn is not None else None,
            "search_engine": ("fts5" if fts else "lexical") if conn is not None else None,
            "settings": settings, "notes": total, "expired": expired, "scope": "installation",
            "authority": "non_authoritative", "limits": memory_limits()}
    word = {True: "on", False: "off"}
    return data, (f"Assistant memory: {total} notes ({expired} expired); retrieval {word[settings['retrieval']]}, "
                  f"automatic learning {word[settings['auto_learning']]}" + ("" if conn else " (not created yet)"))


def memory_limits():
    return {"notes": MEMORY_MAX_NOTES, "note_chars": MEMORY_MAX_CHARS, "search_results": MEMORY_SEARCH_MAX,
            "query_chars": MEMORY_QUERY_CHARS, "query_terms": MEMORY_QUERY_TERMS, "list_page": MEMORY_LIST_MAX,
            "expiry_days": MEMORY_EXPIRY_DAYS}


def memory_list(opts):
    limit = memory_int(opts, "limit", 1, MEMORY_LIST_MAX, MEMORY_LIST_DEFAULT)
    offset = memory_int(opts, "offset", 0, MEMORY_MAX_NOTES, 0)
    opened, now = memory_open(create=False), memory_now()
    notes, total = [], 0
    if opened:
        conn = opened[0]
        total = conn.execute("SELECT count(*) FROM notes").fetchone()[0]
        notes = [memory_view(row, now) for row in conn.execute(
            f"SELECT {MEMORY_COLUMNS} FROM notes ORDER BY updated_at DESC, id DESC LIMIT ? OFFSET ?", (limit, offset))]
    data = {"notes": notes, "total": total, "limit": limit, "offset": offset,
            "next_offset": offset + len(notes) if offset + len(notes) < total else None}
    return data, "\n".join([f"Assistant memory: {total} notes"] + memory_lines(notes))


def memory_search_cmd(opts):
    terms = memory_terms(opts["query"])
    limit = memory_int(opts, "limit", 1, MEMORY_SEARCH_MAX, MEMORY_SEARCH_DEFAULT)
    opened, now = memory_open(create=False), memory_now()
    conn, fts = opened if opened else (None, False)
    # --assistant is set only by the broker's ddistro_memory tool: it honours the user's retrieval switch.
    if opts.get("assistant") and not memory_settings(conn)["retrieval"]:
        raise CliError("disabled", "Assistant memory retrieval is turned off by the user.",
                       {"reason": "retrieval_off"})
    rows = memory_search(conn, fts, terms, limit, now) if conn is not None else []
    notes = [memory_view(row, now) for row in rows]
    data = {"terms": terms, "engine": "fts5" if fts else "lexical", "notes": notes,
            "authority": "non_authoritative", "notice": MEMORY_NOTICE}
    return data, "\n".join([f"{len(notes)} matching notes"] + memory_lines(notes))


def memory_add(opts):
    text = memory_text(opts["text"])
    source = memory_choice(opts, "source", ("user", "assistant"), "user")
    kind = memory_choice(opts, "kind", MEMORY_ASSISTANT_KINDS if source == "assistant" else MEMORY_KINDS,
                         None if source == "assistant" else "note")
    days = memory_int(opts, "expires-days", 1, MEMORY_EXPIRY_DAYS)
    task, thread = opts.get("task"), opts.get("thread")
    if task is not None and not TASK_ID.match(task):
        raise CliError("invalid_argument", "--task must be a ddistro task id.")
    if thread is not None and not THREAD_ID.match(thread):
        raise CliError("invalid_argument", "--thread must be 1-128 letters, digits, - or _.")
    if source == "assistant":
        # Captured by the broker for one of the current task's threads; the broker supplies task and thread.
        if kind is None or task is None or thread is None:
            raise CliError("invalid_argument", "--source assistant needs --kind preference|decision, --task and "
                           "--thread.")
        if MEMORY_VERIFIED_CLAIM.search(text):
            raise CliError("refused", "An assistant note cannot record a verified fix or resolution; only the user "
                           "can, after checking it.", {"reason": "unverified_claim"})
    conn, _ = memory_open(create=True)
    now = memory_now()

    def insert():
        if source == "assistant":
            settings = memory_settings(conn)
            if not settings["auto_learning"] or not settings["retrieval"]:
                raise CliError("disabled", "Automatic memory learning is off for this installation (memory "
                               "configure), so nothing was stored.", {"reason": "auto_learning_off"})
        row = conn.execute(f"SELECT {MEMORY_COLUMNS} FROM notes WHERE text = ? AND kind = ?", (text, kind)).fetchone()
        if row is not None:
            return memory_view(row, now), True
        if conn.execute("SELECT count(*) FROM notes").fetchone()[0] >= MEMORY_MAX_NOTES:
            raise CliError("limit_reached", f"Assistant memory holds at most {MEMORY_MAX_NOTES} notes; forget some "
                           "first.", {"limit": MEMORY_MAX_NOTES})
        cursor = conn.execute("INSERT INTO notes (kind, text, source, task_id, thread_id, captured_at, updated_at, "
                              "expires_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                              (kind, text, source, task, thread, now, now, memory_now(days) if days else None))
        return memory_get(conn, cursor.lastrowid, now), False
    note, duplicate = memory_write(conn, insert)
    human = ("Already remembered as #%d" if duplicate else "Remembered #%d") % note["id"]
    return {"note": note, "duplicate": duplicate}, human


def memory_update(opts):
    note_id = memory_int(opts, "id", 1, 2 ** 31)
    text = memory_text(opts["text"]) if "text" in opts else None
    kind = memory_choice(opts, "kind", MEMORY_KINDS)
    days = memory_int(opts, "expires-days", 1, MEMORY_EXPIRY_DAYS)
    if days and opts.get("no-expiry"):
        raise CliError("invalid_argument", "Use either --expires-days or --no-expiry.")
    if text is None and kind is None and days is None and not opts.get("no-expiry"):
        raise CliError("invalid_argument", "memory update needs --text, --kind, --expires-days or --no-expiry.")
    opened = memory_open(create=False)
    if not opened:
        raise CliError("not_found", "No memory note has that id.", {"id": note_id})
    conn, now = opened[0], memory_now()

    def change():
        note = memory_get(conn, note_id, now)
        expires = None if opts.get("no-expiry") else memory_now(days) if days else note["expires_at"]
        # An edit is the user's: the note keeps its task and thread provenance and becomes a user note.
        conn.execute("UPDATE notes SET text = ?, kind = ?, source = 'user', updated_at = ?, expires_at = ? "
                     "WHERE id = ?", (text or note["text"], kind or note["kind"], now, expires, note_id))
        return memory_get(conn, note_id, now)
    note = memory_write(conn, change)
    return {"note": note}, f"Updated #{note_id}"


def memory_forget(opts):
    chosen = [key for key in ("id", "task", "thread", "expired") if opts.get(key)]
    if len(chosen) != 1:
        raise CliError("invalid_argument", "memory forget needs exactly one of --id, --task, --thread or --expired.")
    key = chosen[0]
    if key == "id":
        where, params = "id = ?", (memory_int(opts, "id", 1, 2 ** 31),)
    elif key == "task":
        if not TASK_ID.match(opts["task"]):
            raise CliError("invalid_argument", "--task must be a ddistro task id.")
        where, params = "task_id = ?", (opts["task"],)
    elif key == "thread":
        if not THREAD_ID.match(opts["thread"]):
            raise CliError("invalid_argument", "--thread must be 1-128 letters, digits, - or _.")
        where, params = "thread_id = ?", (opts["thread"],)
    else:
        where, params = "expires_at IS NOT NULL AND expires_at <= ?", (memory_now(),)
    opened = memory_open(create=False)
    count = memory_write(opened[0], lambda: opened[0].execute("DELETE FROM notes WHERE " + where, params).rowcount) \
        if opened else 0
    return {"forgotten": count, "by": key}, f"Forgot {count} notes"


def memory_reset(opts):
    if not opts.get("yes"):
        raise CliError("invalid_argument", "memory reset deletes every note; repeat it with --yes.")
    opened = memory_open(create=False)
    count = memory_write(opened[0], lambda: opened[0].execute("DELETE FROM notes").rowcount) if opened else 0
    if opened:
        opened[0].execute("VACUUM")
    return {"forgotten": count, "settings_kept": True}, f"Forgot all {count} notes"


def memory_export(opts):
    opened, now = memory_open(create=False), memory_now()
    conn = opened[0] if opened else None
    notes = [memory_view(row, now) for row in conn.execute(
        f"SELECT {MEMORY_COLUMNS} FROM notes ORDER BY id")] if conn else []
    data = {"exported_at": now, "schema_version": MEMORY_SCHEMA, "scope": "installation",
            "settings": memory_settings(conn), "notes": notes}
    return data, json.dumps(data, indent=2, ensure_ascii=False)


def memory_configure(opts):
    changes = {}
    for flag, key in (("retrieval", "retrieval"), ("auto-learning", "auto_learning")):
        if flag in opts:
            changes[key] = memory_choice(opts, flag, ("on", "off"))
    if not changes:
        raise CliError("invalid_argument", "memory configure needs --retrieval on|off or --auto-learning on|off.")
    conn, _ = memory_open(create=True)
    memory_write(conn, lambda: conn.executemany("INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT (key) "
                                                "DO UPDATE SET value = excluded.value", sorted(changes.items())))
    settings = memory_settings(conn)
    return {"settings": settings}, "Assistant memory settings: " + ", ".join(
        f"{k} {'on' if v else 'off'}" for k, v in settings.items())


MEMORY_READS = ("status", "list", "search", "export")
MEMORY_ACTIONS = {"status": memory_status, "list": memory_list, "search": memory_search_cmd, "add": memory_add,
                  "update": memory_update, "forget": memory_forget, "reset": memory_reset, "export": memory_export,
                  "configure": memory_configure}
# Per action: (valued flags, switches, required flags).
MEMORY_SPEC = {
    "status": ((), (), ()), "export": ((), (), ()),
    "list": (("--limit", "--offset"), (), ()),
    "search": (("--query", "--limit"), ("--assistant",), ("query",)),
    "add": (("--text", "--kind", "--expires-days", "--source", "--task", "--thread"), (), ("text",)),
    "update": (("--id", "--text", "--kind", "--expires-days"), ("--no-expiry",), ("id",)),
    "forget": (("--id", "--task", "--thread"), ("--expired",), ()),
    "reset": ((), ("--yes",), ()),
    "configure": (("--retrieval", "--auto-learning"), (), ()),
}


def parse_memory(rest, ctx):
    if len(rest) < 2 or rest[1] not in MEMORY_SPEC:
        raise CliError("invalid_argument", "Expected memory " + "|".join(MEMORY_SPEC) + ".")
    ctx["command"] = "memory " + rest[1]
    valued, switches, required = MEMORY_SPEC[rest[1]]
    opts, args, index = {}, rest[2:], 0
    while index < len(args):
        token = args[index]
        if token in valued:
            if index + 1 >= len(args):
                raise CliError("invalid_argument", f"{token} needs a value.")
            if token[2:] in opts:
                raise CliError("invalid_argument", f"{token} was given more than once.")
            opts[token[2:]] = args[index + 1]
            index += 1
        elif token in switches:
            opts[token[2:]] = True
        else:
            # Never echo the token: it may be note text.
            raise CliError("invalid_argument", f"Unsupported argument for {ctx['command']}.")
        index += 1
    for key in required:
        if key not in opts:
            raise CliError("invalid_argument", f"{ctx['command']} needs --{key}.")
    return opts


# --- Service restart ------------------------------------------------------------------
# The only services ddistro service restart (and the Assistant's approved restart) may target. Each name maps to a
# fixed root-owned init script, pid file, and ports file; nothing from a request becomes a path or an argument. TTS,
# speech and MCP services start from dwemer-owned start.sh scripts and a PostgreSQL restart drops every database
# session, so they are unsupported rather than guessed. Paths avoid /var/run, a link the trusted reads refuse.
SERVICE_RESTARTS = {
    "apache": {"label": "Apache web server", "init": "/etc/init.d/apache2", "pidfile": "/run/apache2/apache2.pid",
               "ports_conf": "/etc/apache2/ports.conf", "comm": "apache2",
               "impact": "Apache is shared: CHIM (HerikaServer), STOBE and Dialectic web servers and custom PHP mods stop "
                         "answering for a few seconds, and requests in progress fail."},
}
SERVICE_RESTART_TIMEOUT = 60
SERVICE_VERIFY_SECONDS = 15
MAINTENANCE_LOCK = "/run/lock/dwemerdistro-maintenance.lock"
LISTEN_LINE = re.compile(r"^\s*Listen\s+(?:(?:127\.0\.0\.1|0\.0\.0\.0|\[::\]|\*):)?([0-9]{1,5})\s*$", re.M)
# Root-registered services: one <id>.json per service in a root-owned folder, read as data (never sourced). Each names
# a trusted root-owned init script that accepts restart, a pid file under /run, the process name and its explicit
# ports; ddistro adds nothing else to the host-exec allowlist. Apache stays code-owned and PostgreSQL unsupported.
SERVICE_REGISTRY_DIR = "/etc/dwemerdistro/services.d"
SERVICE_REGISTRY_MAX = 16
SERVICE_ID = re.compile(r"^[a-z][a-z0-9-]{1,31}\Z")
SERVICE_RESERVED = ("apache", "apache2", "postgresql", "postgres", "components")
SERVICE_SPEC_KEYS = {"schema", "id", "label", "impact", "init", "pidfile", "comm", "ports"}
SERVICE_INIT = re.compile(r"^/(?:etc/init\.d|usr/local/sbin|usr/local/lib/dwemerdistro)/[A-Za-z0-9][A-Za-z0-9._-]{0,63}\Z")
SERVICE_PIDFILE = re.compile(r"^/run/[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,63})?\.pid\Z")
SERVICE_COMM = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,14}\Z")
SERVICE_HTTP_PATH = re.compile(r"^/[A-Za-z0-9._~/-]{0,99}\Z")
SERVICE_TEXT = re.compile(r"^[^\x00-\x1f\x7f]+\Z")
SERVICE_REFUSED_COMMS = ("apache2", "postgres", "postmaster", "init", "systemd")
SERVICE_UNREGISTERED = ("Only root-registered services can be restarted or checked here; ask root to register a trusted "
                        "init wrapper in " + SERVICE_REGISTRY_DIR + ". A service started from run code stays in that "
                        "run's private view and may be unreachable.")


def maintenance_exclusive_fd():
    """The fixed root-owned maintenance lock held exclusively without waiting, as ddistro changes apply holds it."""
    try:
        fd = os.open(MAINTENANCE_LOCK, os.O_RDONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    except OSError:
        raise CliError("unsafe_path", f"{MAINTENANCE_LOCK} could not be opened safely; it was not replaced.")
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1 or info.st_mode & 0o022:
        os.close(fd)
        raise CliError("unsafe_path", f"{MAINTENANCE_LOCK} is not a root-owned plain file; it was not replaced.")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise CliError("busy", "A DwemerDistro update, repair, or other change is running. Try again when it finishes.")
    return fd


def service_pid(spec):
    """(pid, start time) of the live process the trusted pid file names, if it has the expected name; else (None, None)."""
    text = health_read_small(spec["pidfile"], health_owners(False))
    match = re.match(r"^\s*([0-9]{1,9})\s*$", text or "")
    if not match:
        return None, None
    pid = int(match.group(1))
    started = process_start(pid)
    try:
        with open(f"/proc/{pid}/comm", encoding="ascii", errors="replace") as handle:
            comm = handle.read().strip()
    except OSError:
        return None, None
    return (pid, started) if started and comm == spec["comm"] else (None, None)


def process_start(pid):
    """The start time (clock ticks since boot) of a live pid, or None; with the pid it names one process exactly."""
    try:
        with open(f"/proc/{pid}/stat", encoding="ascii", errors="replace") as handle:
            return handle.read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def service_ports(spec):
    if "ports" in spec:
        return list(spec["ports"])
    text = health_read_small(spec["ports_conf"], health_owners(False))
    if text is None:
        raise CliError("unsupported", "Apache's listener configuration could not be read; no restart was attempted.")
    modules = None
    if re.search(r"<\s*IfModule\b", text, re.I):
        code, out, _ = run_helper(["-M"], 10, 64 * 1024, helper="/usr/sbin/apache2ctl")
        if code != 0:
            raise CliError("unsupported", "Apache's active modules could not be checked; no restart was attempted.")
        modules = set(re.findall(r"^\s*(\w+_module)\s+\((?:static|shared)\)", out.data.decode("utf-8", "replace"), re.M))
        if "core_module" not in modules:
            raise CliError("unsupported", "Apache returned no usable module list; no restart was attempted.")
    return apache_listener_ports(text, modules or set())


def apache_listener_ports(text, modules):
    """Resolve Listen directives and nested IfModule blocks; refuse other configuration rather than guess which ports apply."""
    active, ports = [True], set()
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        opening = re.fullmatch(r"<IfModule\s+(!?)([A-Za-z0-9_.-]+)\s*>", line, re.I)
        if opening:
            negate, name = opening.groups()
            if name.startswith("mod_") and name.endswith(".c"):
                name = name[4:-2] + "_module"
            elif not name.endswith("_module"):
                raise CliError("unsupported", "Apache uses an unsupported module condition; no restart was attempted.")
            enabled = name in modules
            active.append(active[-1] and (not enabled if negate else enabled))
            continue
        if re.fullmatch(r"</IfModule\s*>", line, re.I):
            if len(active) == 1:
                raise CliError("unsupported", "Apache's module conditions are unbalanced; no restart was attempted.")
            active.pop()
            continue
        match = LISTEN_LINE.fullmatch(line)
        if not match:
            raise CliError("unsupported", "Apache's listener configuration needs manual verification; no restart was attempted.")
        if active[-1]:
            port = int(match.group(1))
            if not 0 < port < 65536:
                raise CliError("unsupported", "Apache has an invalid listener port; no restart was attempted.")
            ports.add(port)
    if len(active) != 1 or not ports or len(ports) > 8:
        raise CliError("unsupported", "Apache's active listeners could not be resolved; no restart was attempted.")
    return sorted(ports)


def service_spec_problem(name, spec, reserved_ports):
    """None for a registry entry ddistro may restart, else a short reason code; the entry is never partly used."""
    if (type(spec) is not dict or set(spec) - {"http_path"} != SERVICE_SPEC_KEYS
            or type(spec.get("schema")) is not int or spec["schema"] != 1):
        return "bad_shape"
    if spec["id"] != name:
        return "id_mismatch"
    if any(word in name for word in ("postgres", "apache")):
        return "reserved_id"
    for key, limit in (("label", 80), ("impact", 300)):
        if type(spec[key]) is not str or len(spec[key]) > limit or not SERVICE_TEXT.match(spec[key]):
            return "bad_" + key
    if type(spec["init"]) is not str or not SERVICE_INIT.match(spec["init"]) or ".." in spec["init"]:
        return "bad_init"
    if os.path.basename(spec["init"]).startswith(("apache", "postgres")):
        return "unsupported_init"
    if type(spec["pidfile"]) is not str or not SERVICE_PIDFILE.match(spec["pidfile"]) or ".." in spec["pidfile"] \
            or spec["pidfile"] == SERVICE_RESTARTS["apache"]["pidfile"]:
        return "bad_pidfile"
    if type(spec["comm"]) is not str or not SERVICE_COMM.match(spec["comm"]) or spec["comm"] in SERVICE_REFUSED_COMMS:
        return "bad_comm"
    ports = spec["ports"]
    if (type(ports) is not list or not 1 <= len(ports) <= 8
            or any(type(port) is not int or not 1024 <= port <= 65535 for port in ports)
            or len(set(ports)) != len(ports)):
        return "bad_ports"
    if set(ports) & reserved_ports:
        return "shared_port"
    if "http_path" in spec and (type(spec["http_path"]) is not str or not SERVICE_HTTP_PATH.match(spec["http_path"])
                                or ".." in spec["http_path"]):
        return "bad_http_path"
    return None


def service_registry():
    """({id: spec} of valid root-registered services, [{id, reason}] of refused entries). Each file is read through
    health_read_small: every folder from / and the file itself root-owned and not group/other writable, no link
    followed, at most 4 KB. A missing folder is an empty registry."""
    try:
        names = sorted(os.listdir(SERVICE_REGISTRY_DIR))
    except OSError:
        return {}, []
    # Apache's and PostgreSQL's ports are never claimed by a registered service, so a port check cannot pass for them.
    # Reserve even conditional Apache ports, without running module discovery for each registry read.
    apache_text = health_read_small(SERVICE_RESTARTS["apache"]["ports_conf"], health_owners(False)) or ""
    reserved_ports = {int(port) for port in LISTEN_LINE.findall(apache_text)} | {5432}
    port = os.environ.get("DDISTRO_POSTGRES_PORT", "")
    if re.match(r"^[0-9]{1,5}\Z", port):
        reserved_ports.add(int(port))
    valid, refused = {}, []
    for entry in [name for name in names if name.endswith(".json")]:
        name = entry[:-5]
        if not SERVICE_ID.match(name):
            refused.append({"id": clean_line(name)[:40], "reason": "bad_id"})
            continue
        if name in SERVICE_RESERVED:
            refused.append({"id": name, "reason": "reserved_id"})
            continue
        if len(valid) >= SERVICE_REGISTRY_MAX:
            refused.append({"id": name, "reason": "too_many"})
            continue
        text = health_read_small(SERVICE_REGISTRY_DIR + "/" + entry, (0,))
        if text is None:
            refused.append({"id": name, "reason": "untrusted_or_unreadable"})
            continue
        try:
            spec = json.loads(text, parse_constant=reject_constant)
        except ValueError:
            refused.append({"id": name, "reason": "bad_json"})
            continue
        problem = service_spec_problem(name, spec, reserved_ports)
        if problem:
            refused.append({"id": name, "reason": problem})
            continue
        valid[name] = spec
    return valid, refused


def service_spec(name):
    """The code-owned apache spec or one valid registered spec; anything else is unsupported, with nothing run."""
    if name in SERVICE_RESTARTS:
        return SERVICE_RESTARTS[name]
    if name in OPERATION_UNSUPPORTED_TARGETS:
        raise CliError("unsupported", f"{name} is not supported: {OPERATION_UNSUPPORTED_TARGETS[name]}.",
                       {"reason": "unsupported_target", "target": name})
    registered, refused = service_registry()
    if name in registered:
        return registered[name]
    reason = next((entry["reason"] for entry in refused if entry["id"] == name), "not_registered")
    raise CliError("unsupported", f"{name} is not a registered service ({reason}). " + SERVICE_UNREGISTERED,
                   {"reason": "unsupported_target", "target": name, "registry": reason})


def service_namespace(pid):
    """{mnt, net}: passed when the process shares PID 1's (the distro's own) namespace, failed in another one (such as a
    ddistro_run private view), unknown when it cannot be read. PID 1 is the reference, never ddistro's own view."""
    result = {}
    for kind in ("mnt", "net"):
        try:
            own, reference = os.readlink(f"/proc/{pid}/ns/{kind}"), os.readlink(f"/proc/1/ns/{kind}")
        except (OSError, TypeError):
            result[kind] = "unknown"
            continue
        result[kind] = "passed" if own == reference else "failed"
    return result


def service_http(spec, ports):
    """HTTP transport only: any HTTP status line on the first port passes, 503 included; never application health."""
    if "http_path" not in spec or not ports:
        return None
    status, _, problem = health_http_get(ports[0], spec["http_path"])
    if status is None:
        return {"id": "http", "result": "failed", "detail": problem}
    return {"id": "http", "result": "passed", "detail": f"HTTP {status} answered (transport only, not health)"}


def service_view_checks(pid, ports, spec):
    namespace = service_namespace(pid) if pid else {"mnt": "unknown", "net": "unknown"}
    # unknown (not readable, for example without root) never counts as passed, so it can never verify a restart.
    checks = [{"id": "namespace." + kind, "result": namespace[kind],
               "detail": "the distro's own view" if namespace[kind] == "passed" else
               ("another namespace (a private run view)" if namespace[kind] == "failed" else "not readable")}
              for kind in ("mnt", "net")]
    open_ports = [port for port in ports if health_connect(port)[0]]
    checks += [{"id": f"port.{port}", "result": "passed" if port in open_ports else "failed"} for port in ports]
    http = service_http(spec, ports) if open_ports else None
    if http:
        checks.append(http)
    return checks, namespace


def cmd_service_list(opts, ctx):
    registered, refused = service_registry()
    services = [{"id": "apache", "label": SERVICE_RESTARTS["apache"]["label"], "impact": SERVICE_RESTARTS["apache"]["impact"],
                 "verbs": ["restart", "status"], "source": "code_owned"}]
    services += [{"id": name, "label": spec["label"], "impact": spec["impact"], "verbs": ["restart", "status"],
                  "source": "registry", "ports": spec["ports"]} for name, spec in registered.items()]
    data = {"schema": 1, "services": services, "refused": refused, "registry": SERVICE_REGISTRY_DIR,
            "unsupported": {"targets": OPERATION_UNSUPPORTED_TARGETS, "verbs": {"stop": OPERATION_UNSUPPORTED_VERBS["stop"],
                                                                                "start": OPERATION_UNSUPPORTED_VERBS["start"]}},
            "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    return data, "\n".join(f"{s['id']:<24} {s['label']}" for s in services)


def cmd_service_status(opts, ctx):
    """Read-only: the process behind the pid file, whether it is in the distro's own view, and which ports answer."""
    name = opts["service"]
    spec = service_spec(name)
    pid, started = service_pid(spec)
    ports = service_ports(spec)
    checks, namespace = service_view_checks(pid, ports, spec)
    if pid is None:
        checks.insert(0, {"id": "process", "result": "failed", "detail": "no live " + spec["comm"] + " process behind "
                          + spec["pidfile"]})
    results = {check["result"] for check in checks}
    if pid is None:
        state = "not_running"
    elif "failed" in results:
        state = "degraded"
    elif "unknown" in results:
        state = "unchecked"
    else:
        state = "running"
    data = {"service": name, "label": spec["label"], "action": "status", "executed": False, "state": state,
            "pid": pid, "started": started, "namespace": namespace, "checks": checks, "health": "not_checked",
            "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    return data, f"{spec['label']}: {data['state']}"


def cmd_service_restart(opts, ctx):
    name = opts["service"]
    if os.geteuid() != 0:
        raise CliError("permission_denied", "service restart must run as root. ddistro never elevates by itself.")
    if any(result != "passed" for result in service_namespace(os.getpid()).values()):
        raise CliError("unsupported", "Service restarts must run in the distro's own mount and network namespaces; nothing ran.")
    spec = service_spec(name)
    check_helper(spec["init"])
    ports = service_ports(spec)  # Resolve configuration before an init script can change anything.
    lock = maintenance_exclusive_fd()
    try:
        before = service_pid(spec)
        try:
            code, out, err = run_helper(["restart"], SERVICE_RESTART_TIMEOUT, OUTPUT_TAIL_BYTES, helper=spec["init"])
            output_tail = tail_lines(out.data, 10) + tail_lines(err.data, 10)
        except CliError as error:
            # The script started and was stopped: report it as executed and let the fresh check decide, never as not run.
            if error.code not in ("timeout", "cancelled"):
                raise
            code = error.code
            output_tail = (error.details.get("stdout_tail", [])[-10:] + error.details.get("stderr_tail", [])[-10:])
        # Fresh evidence only: a new process (pid and start time) behind the pid file and every configured port
        # accepting, polled within a bound. An exit code alone is never reported as verified.
        deadline = time.monotonic() + SERVICE_VERIFY_SECONDS
        while True:
            after = service_pid(spec)
            open_ports = [port for port in ports if health_connect(port)[0]]
            # The old process must be gone too, so an answering port cannot be the process the restart was meant to replace.
            old_gone = before[0] is None or process_start(before[0]) != before[1]
            replaced = after[0] is not None and after != before and old_gone
            if (replaced and ports and len(open_ports) == len(ports)) or time.monotonic() > deadline:
                break
            time.sleep(0.5)
    finally:
        os.close(lock)
    checks = [{"id": "command", "result": "passed" if code == 0 else "failed", "detail": f"exit code {code}" if isinstance(code, int) else code},
              {"id": "new_process", "result": "passed" if replaced else "failed",
               "detail": f"pid {before[0]} -> {after[0]}" + ("" if old_gone else "; the old process is still running")}]
    # A new process that answers only inside a private view (for example one started from a ddistro_run) is not the
    # service the distro and Windows reach, so the namespace checks gate verified like the ports do.
    view_checks, namespace = service_view_checks(after[0], ports, spec)
    checks += view_checks
    if not ports:
        checks.append({"id": "ports", "result": "failed", "detail": "no Listen port found in " + spec["ports_conf"]})
    verified = all(check["result"] == "passed" for check in checks)
    data = {"service": name, "label": spec["label"], "action": "restart", "executed": True,
            "state": "verified" if verified else "failed", "verified": verified, "checks": checks,
            "before": {"pid": before[0]}, "after": {"pid": after[0]}, "namespace": namespace, "impact": spec["impact"],
            "health": "not_checked",
            "verified_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "output_tail": output_tail}
    return data, f"{spec['label']} restart: {data['state']}"


# --- Read-only access (ddistro_access) --------------------------------------------------

# command: (positional names, valued flags). Every one is read-only and root-only.
ACCESS_SPEC = {
    "access roots": ((), ()),
    "files list": (("root",), ("--path", "--depth", "--limit")),
    "files search": (("root",), ("--query", "--name-glob", "--path", "--limit")),
    "files read": (("root",), ("--path", "--start", "--lines")),
    "config get": (("root",), ("--key",)),
    "db schema": (("product",), ("--schema", "--table")),
    "db query": (("product",), ("--query-json",)),
}
_ACCESS = None


def load_access():
    """The installed policy module, only when it is a trusted root-owned file in a root-owned folder.
    There is no environment or path override; tests load a source copy themselves."""
    global _ACCESS
    if _ACCESS is None:
        try:
            check_helper(ACCESS_MODULE)
        except CliError as error:
            raise CliError("helper_unavailable", "ddistro_access is not installed as a trusted root-owned file.",
                           {"helper": ACCESS_MODULE, "reason": error.details.get("reason", "untrusted")})
        try:
            spec = spec_from_loader("ddistro_access", SourceFileLoader("ddistro_access", ACCESS_MODULE))
            module = module_from_spec(spec)
            spec.loader.exec_module(module)
        except Exception:  # a broken module must not break capabilities or other commands
            raise CliError("helper_unavailable", "ddistro_access could not be loaded.",
                           {"helper": ACCESS_MODULE, "reason": "unloadable"})
        _ACCESS = module
    return _ACCESS


def access_capabilities(access):
    if isinstance(access, str):
        return {"available": False, "reason": access}
    operators = sorted(access.OPERATORS) + ["in", "not_in", "is_null", "not_null", "contains", "starts_with"]
    return {"available": True, "policy_version": access.POLICY_VERSION, "roots": sorted(access.ACCESS_ROOTS),
            "unsupported_roots": {key: spec["unsupported"] for key, spec in access.ACCESS_ROOTS.items()
                                  if spec.get("unsupported")},
            "db_products": {key: "unsupported" if spec.get("unsupported") else "structured"
                            for key, spec in access.DB_POLICY.items()},
            "db_role": access.DB_ROLE,
            "query": {"fields": sorted(access.QUERY_KEYS), "aggregates": list(access.AGGREGATES),
                      "operators": operators, "raw_sql": False},
            "config": {"execution": "none", "formats": ["json", "ini", "toml", "php_assign"],
                       "effective_value": "uncertain"},
            "limits": dict(access.LIMITS)}


def parse_access(rest, ctx):
    if len(rest) < 2:
        raise CliError("invalid_argument", "Expected one of: " + ", ".join(ACCESS_SPEC) + ".")
    name = rest[0] + " " + rest[1]
    if rest[0] == "db" and "--sql" in rest:
        ctx["command"] = name if name in ACCESS_SPEC else "db query"
        raise CliError("refused", "Raw SQL is not accepted. Use db query PRODUCT --query-json with a structured "
                       "object; run db schema first.", {"reason": "raw_sql_refused"})
    if name not in ACCESS_SPEC:
        raise CliError("invalid_argument", "Expected one of: " + ", ".join(ACCESS_SPEC) + ".")
    ctx["command"] = name
    names, valued = ACCESS_SPEC[name]
    opts, positional, index, args = {}, [], 0, rest[2:]
    while index < len(args):
        token = args[index]
        if token in valued:
            key = token[2:].replace("-", "_")
            if index + 1 >= len(args) or key in opts:
                raise CliError("invalid_argument", f"{token} needs exactly one value.")
            opts[key] = args[index + 1]
            index += 1
        elif token.startswith("-"):
            raise CliError("invalid_argument", f"Unsupported option for {name}: {token[:40]}")
        else:
            positional.append(token)
        index += 1
    if len(positional) != len(names):
        raise CliError("invalid_argument", f"Wrong number of arguments for {name}.\n" + USAGE)
    for key, value in zip(names, positional):
        opts[key] = resolve_product(value) if key == "product" else value
    if name == "db query" and "query_json" not in opts:
        raise CliError("invalid_argument", "db query needs --query-json with a structured query object.")
    return opts


def cmd_access(opts, ctx):
    if os.geteuid() != 0:
        raise CliError("permission_denied", "Read-only access commands run as root (wsl -u root).")
    access = load_access()
    o = opts
    calls = {
        "access roots": lambda: access.roots(),
        "files list": lambda: access.list_files(o["root"], o.get("path"), o.get("depth"), o.get("limit")),
        "files search": lambda: access.search_files(o["root"], o.get("query"), o.get("path"), o.get("name_glob"),
                                                    o.get("limit")),
        "files read": lambda: access.read_file(o["root"], o.get("path"), o.get("start"), o.get("lines")),
        "config get": lambda: access.config_get(o["root"], o.get("key")),
        "db schema": lambda: access.db_schema(o["product"], o.get("schema"), o.get("table")),
        "db query": lambda: access.db_query(o["product"], o["query_json"]),
    }
    try:
        data = calls[ctx["command"]]()
    except access.AccessError as error:
        raise CliError(error.code if error.code in ERRORS else "failed", error.message, error.details)
    note = "" if data.get("complete") else f" (incomplete: {data.get('reason')})"
    return data, f"{ctx['command']}: done{note}. Use --json for the full result."


# --- Sandboxed exec (ddistro_exec) --------------------------------------------------------
# A fixed wrapper: the task and the request object go to the trusted helper as exactly its five arguments. Programs,
# files, roots and the sandbox are the helper's and ddistro_access's to check; nothing here adds a root, path or config.
EXEC_TIMEOUT = 35  # the helper's 30 s maximum, its 2 s kill grace, and start-up; then the process group is stopped
EXEC_STDOUT_LIMIT = 512 * 1024  # 64 KiB stdout + 16 KiB stderr, JSON-escaped, plus snapshot facts
EXEC_REQUEST_BYTES = 64 * 1024
EXEC_ENVELOPE = {"schema_version", "ok", "command", "request_id", "tool", "data", "error", "warnings"}
EXEC_ERRORS = ("invalid_argument", "limit_reached", "not_found", "unsupported", "permission_denied", "unsafe_path",
               "refused", "cancelled", "failed")


def exec_available(access_available):
    """features.exec: the installed helper and the policy module it loads are both trusted root-owned files."""
    if not access_available:
        return False
    try:
        check_helper(EXEC_HELPER)
    except CliError:
        return False
    return True


def exec_result(code, out):
    """(data, warnings) from the helper's one envelope; its error is passed on with its own code, anything else is
    helper_protocol."""
    if out.total > EXEC_STDOUT_LIMIT:
        raise CliError("helper_protocol", "ddistro_exec returned too much output.", {"helper_exit": code})
    try:
        doc = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        doc = None
    if (type(doc) is dict and EXEC_ENVELOPE <= set(doc) <= EXEC_ENVELOPE | {"operation_id"}
            and type(doc["schema_version"]) is int and doc["schema_version"] == 1 and doc["command"] == "exec"
            and type(doc["tool"]) is dict and doc["tool"].get("name") == "ddistro_exec"
            and type(doc["warnings"]) is list and all(type(w) is str for w in doc["warnings"][:100])):
        error = doc["error"]
        if doc["ok"] is True and code == 0 and type(doc["data"]) is dict and error is None:
            return doc["data"], doc["warnings"][:100]
        if doc["ok"] is False and doc["data"] is None and code != 0 and type(error) is dict \
                and error.get("code") in EXEC_ERRORS and type(error.get("message")) is str \
                and type(error.get("details")) is dict:
            raise CliError(error["code"], error["message"][:4096], error["details"])
    raise CliError("helper_protocol", "ddistro_exec returned an unexpected result.", {"helper_exit": code})


def cmd_exec(opts, ctx):
    if os.geteuid() != 0:
        raise CliError("permission_denied", "exec must run as root. ddistro never elevates by itself.")
    code, out, _ = run_helper(["--task", opts["task"], "--request-json", opts["request_json"], "--json"], EXEC_TIMEOUT,
                              EXEC_STDOUT_LIMIT + 1, helper=EXEC_HELPER, echo_stdout=False)
    data, warnings = exec_result(code, out)
    for warning in dict.fromkeys(redact(w[:300]) for w in warnings):
        ctx["warnings"].append(warning)
    return data, f"exec: {data.get('status')} (exit {data.get('exit_code')}). Use --json for the output."


def parse_exec(rest, ctx):
    ctx["command"] = "exec"
    opts, args, index = {}, rest[1:], 0
    while index < len(args):
        token = args[index]
        if token not in ("--task", "--request-json") or index + 1 >= len(args):
            raise CliError("invalid_argument", "exec takes only --task TASK --request-json JSON.")
        key = token[2:].replace("-", "_")
        if key in opts:
            raise CliError("invalid_argument", f"{token} was given more than once.")
        opts[key] = args[index + 1]
        index += 2
    if not TASK_ID.match(opts.get("task", "")):
        raise CliError("invalid_argument", "exec needs --task with the lowercase task UUID.")
    request = opts.get("request_json")
    if request is None or len(request.encode("utf-8", "surrogatepass")) > EXEC_REQUEST_BYTES:
        raise CliError("invalid_argument", f"exec needs --request-json with a JSON object of at most {EXEC_REQUEST_BYTES} bytes.")
    try:
        parsed = json.loads(request, parse_constant=reject_constant)
    except ValueError:
        parsed = None
    if type(parsed) is not dict:
        raise CliError("invalid_argument", "--request-json must be one JSON object (argv, files, timeout).")
    return opts


# --- Typed service operations --------------------------------------------------------------
# operations targets|preview|apply: a fixed matrix of code-owned handlers, never a command, script, argument or
# environment from a request. apache restart is cmd_service_restart (its own lock and fresh verification); a server
# install or update is the trusted ddistro_server with exactly <verb> <product> --branch <allowlisted choice>, never
# --force, repair or uninstall. The name avoids the existing service restart parser. Preview saves a root-private
# receipt with the plan hash, the captured baseline and the helper's sha256; apply recomputes all three and runs the
# plan at most once, recording its outcome (failures too) for any replay.
OPERATION_PREVIEW_SECONDS = 120
OPERATION_RECEIPTS_DIR_NAME = "operation-receipts"
OPERATION_RECEIPTS_MAX = 200
OPERATION_RECEIPT_DAYS = 30
OPERATION_RECEIPT_BYTES = 32 * 1024
OPERATION_TARGET = re.compile(r"^[a-z][a-z0-9_-]{0,31}\Z")
OPERATION_VERB = re.compile(r"^[a-z][a-z-]{0,15}\Z")
OPERATION_BRANCH = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}\Z")
OPERATION_COMMIT = re.compile(r"^[0-9a-f]{40}(?:[0-9a-f]{24})?\Z")
OPERATION_HELPER_BYTES = 4 * 1024 * 1024
OPERATION_VERBS = dict({"apache": ("restart",)}, **{product: ("install", "update") for product in PRODUCTS})
OPERATION_STATES = ("previewed", "executing", "verified", "unverified", "failed", "busy", "not_executed", "stale",
                    "expired", "unknown")
OPERATION_UNSUPPORTED_VERBS = {
    "start": "not a typed operation; Apache and the servers start with DwemerDistro",
    "stop": "not a typed operation; stopping a shared service affects every server",
    "repair": "not offered to the Assistant: repair can reinstall over a partial install",
    "uninstall": "never offered to the Assistant: it deletes the server and its database",
    "force": "never offered: --force discards local edits to tracked server files",
}
OPERATION_UNSUPPORTED_TARGETS = {
    "postgresql": "restarting PostgreSQL drops every database session of every server",
    "components": "TTS, STT, LLM, MCP and other components have no code-owned operation; they are unsupported",
}
OPERATION_VERIFICATION = {"restart": "new_process_and_ports", "install": "git_identity", "update": "git_identity",
                          "health": "not_checked"}
OPERATION_RECEIPT_KEYS = {"schema", "id", "kind", "target", "verb", "branch", "resolved_branch", "created_at",
                          "expires_at", "task_id", "thread_id", "baseline", "helper", "summary", "plan_sha256", "state",
                          "executed", "verified", "result"}


def operation_untrusted(what):
    return CliError("unsafe_path", f"The service operation receipts {what} is not private to root; nothing was read or "
                    "changed.", {"reason": "receipts_untrusted", "location": what})


def operation_receipt_valid(receipt, receipt_id):
    return (type(receipt) is dict and set(receipt) == OPERATION_RECEIPT_KEYS and receipt["schema"] == 1
            and receipt["id"] == receipt_id and receipt["kind"] == "service_operation"
            and receipt["verb"] in OPERATION_VERBS.get(receipt["target"], ()) and receipt["state"] in OPERATION_STATES
            and type(receipt["created_at"]) is int and type(receipt["expires_at"]) is int
            and type(receipt["plan_sha256"]) is str and HASH.match(receipt["plan_sha256"]) is not None
            and type(receipt["baseline"]) is dict and type(receipt["helper"]) is dict
            and type(receipt["summary"]) is list and receipt["executed"] in (True, False, None)
            and type(receipt["verified"]) is bool and (receipt["result"] is None or type(receipt["result"]) is dict))


class OperationReceipts(ModelReceipts):
    """The same root-private store and lock rules as the model receipts, in its own directory and receipt shape."""
    DIR_NAME, MAX_BYTES = OPERATION_RECEIPTS_DIR_NAME, OPERATION_RECEIPT_BYTES
    BUSY = "Another service operation is being prepared or recorded. Try again."
    untrusted, valid = staticmethod(operation_untrusted), staticmethod(operation_receipt_valid)

    def prune(self, now):
        """Drops unused expired previews and finished receipts after OPERATION_RECEIPT_DAYS. One that is executing is
        never dropped; when the rest still fill the store the new preview is refused and nothing else is deleted."""
        kept = []
        for receipt in self.receipts():
            unused = receipt["state"] in ("previewed", "expired", "stale") and receipt["expires_at"] < now
            old = receipt["created_at"] < now - OPERATION_RECEIPT_DAYS * 86400 and receipt["state"] != "executing"
            if unused or old:
                os.unlink(self.path(receipt["id"]))
            else:
                kept.append(receipt)
        excess = len(kept) - (OPERATION_RECEIPTS_MAX - 1)
        removable = [r for r in reversed(kept) if r["state"] not in ("executing", "unknown")][:max(excess, 0)]
        if len(removable) < excess:
            raise CliError("busy", "Too many service operations are unfinished to record another; nothing was prepared.",
                           {"reason": "receipts_full"})
        for receipt in removable:
            os.unlink(self.path(receipt["id"]))


def operation_helper(target):
    """{path, sha256} of the trusted program the plan runs: the init script for apache, else ddistro_server."""
    path = SERVICE_RESTARTS["apache"]["init"] if target == "apache" else SERVER_HELPER
    check_helper(path)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        raise CliError("helper_unavailable", "The operation helper cannot be read.", {"helper": path, "reason": "unreadable"})
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_size > OPERATION_HELPER_BYTES:
            raise CliError("helper_unavailable", "The operation helper is not a trusted root-owned file.",
                           {"helper": path, "reason": "untrusted"})
        digest, left = hashlib.sha256(), OPERATION_HELPER_BYTES + 1
        while left > 0:
            chunk = os.read(fd, min(65536, left))
            if not chunk:
                break
            digest.update(chunk)
            left -= len(chunk)
    finally:
        os.close(fd)
    return {"path": path, "sha256": digest.hexdigest()}


def operation_rev(product, record, rev):
    """A full commit id for rev in the product's managed checkout, read-only and offline, or None when not known."""
    root = UPDATE_CHECK_ROOTS[product]
    if record["repository_state"] != "managed" or record["root"] != root:
        return None
    try:
        check_system_binary(UPDATE_CHECK_GIT)
        code, out, _ = run_helper(update_check_args(root) + ["rev-parse", "--verify", "--quiet", rev],
                                  UPDATE_CHECK_GIT_TIMEOUT, 256, helper=UPDATE_CHECK_GIT, env=dict(UPDATE_CHECK_GIT_ENV))
    except CliError as error:
        if error.code == "cancelled":
            raise
        return None
    text = bytes(out.data).decode("ascii", "replace").strip()
    return text if code == 0 and OPERATION_COMMIT.match(text) else None


def operation_baseline(target):
    """What the plan was reviewed against: the live apache process, or the server's install state, branch and commit."""
    if target == "apache":
        pid, started = service_pid(SERVICE_RESTARTS["apache"])
        return {"running": pid is not None, "pid": pid, "started": started}
    record = helper_status(target)[0]
    baseline = {key: record[key] for key in ("state", "repository_state", "branch", "version", "database_present",
                                             "production_branch", "development_branch")}
    baseline["head"] = operation_rev(target, record, "HEAD^{commit}")
    return baseline


def operation_resolved_branch(choice, baseline):
    """The git branch ddistro_server's resolve_branch will check out for this channel choice."""
    if choice == "main":
        return baseline["production_branch"]
    if choice == "dev":
        return baseline["development_branch"]
    return choice


def operation_plan_sha256(receipt):
    plan = {key: receipt[key] for key in ("id", "kind", "target", "verb", "branch", "resolved_branch", "task_id",
                                          "thread_id", "baseline", "helper", "summary", "expires_at")}
    return hashlib.sha256(json.dumps(plan, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def operation_summary(target, verb, branch, resolved, baseline):
    """At most 8 plain lines for the approval card (launcher service card); no command string is shown."""
    if target == "apache":
        spec = SERVICE_RESTARTS["apache"]
        now = f"running as pid {baseline['pid']}" if baseline["running"] else "no running Apache process found"
        return [f"Restart {spec['label']} (apache)", spec["impact"], f"Now: {now}",
                "Verified only by a new Apache process and every configured Listen port answering."]
    name = PRODUCTS[target]["name"]
    commit = (baseline["head"] or "unknown")[:12]
    lines = [f"{verb.capitalize()} {name} from origin/{resolved} (channel {branch})",
             f"Now: {baseline['state']}, branch {baseline['branch'] or '-'}, commit {commit}",
             "Runs the trusted ddistro_server only; never --force, repair or uninstall.",
             "Downloads from the server's GitHub repository and updates its database schema.",
             "Apache and PostgreSQL are shared: other servers can be briefly affected."]
    if verb == "update":
        lines.append("Local edits to tracked files stop the update; they are never discarded.")
    lines.append("Verified only by install state, branch and commit afterwards, not by a health check.")
    return lines


def operations_ready():
    if os.geteuid() != 0:
        raise CliError("permission_denied", "operations preview and apply must run as root. ddistro never elevates by itself.")


def cmd_operations_targets(opts, ctx):
    targets = [{"id": "apache", "kind": "service", "label": SERVICE_RESTARTS["apache"]["label"], "verbs": ["restart"],
                "handler": "service restart", "impact": SERVICE_RESTARTS["apache"]["impact"]}]
    targets += [{"id": product, "kind": "server", "label": spec["name"], "verbs": list(OPERATION_VERBS[product]),
                 "handler": "ddistro_server", "branches": list(spec["branches"]), "default_branch": "main",
                 "install_requires": "not-installed", "update_requires": "installed"}
                for product, spec in PRODUCTS.items()]
    data = {"schema": 1, "preview_seconds": OPERATION_PREVIEW_SECONDS, "targets": targets,
            "unsupported": {"verbs": OPERATION_UNSUPPORTED_VERBS, "targets": OPERATION_UNSUPPORTED_TARGETS},
            "verification": OPERATION_VERIFICATION}
    return data, "\n".join(f"{t['id']:<10} {', '.join(t['verbs'])}" for t in targets)


def cmd_operations_preview(opts, ctx):
    operations_ready()
    target, verb = opts["target"], opts["verb"]
    if target not in OPERATION_VERBS:
        raise CliError("unsupported", f"{target} has no typed operation. Supported targets: " + ", ".join(OPERATION_VERBS)
                       + ".", {"reason": "unsupported_target", "target": target})
    if verb not in OPERATION_VERBS[target]:
        raise CliError("unsupported", f"{verb} is not offered for {target}.",
                       {"reason": "unsupported_verb", "verb": verb,
                        "why": OPERATION_UNSUPPORTED_VERBS.get(verb, "not a typed operation for this target")})
    branch = opts.get("branch")
    if target == "apache":
        if branch is not None:
            raise CliError("invalid_argument", "apache restart takes no --branch.")
    else:
        branch = branch or "main"
        if branch not in PRODUCTS[target]["branches"]:
            raise CliError("invalid_argument", f"Unsupported branch for {target}. Expected one of: "
                           + ", ".join(PRODUCTS[target]["branches"]) + ".", {"reason": "branch_not_allowed"})
    helper = operation_helper(target)
    baseline = operation_baseline(target)
    resolved = None
    if target != "apache":
        resolved = operation_resolved_branch(branch, baseline)
        if verb == "install" and baseline["state"] != "not-installed":
            raise CliError("refused", f"{target} is {baseline['state']}; install runs only when it is not installed.",
                           {"reason": "not_installable", "state": baseline["state"]})
        if verb == "update" and (baseline["state"] != "installed" or baseline["repository_state"] != "managed"):
            raise CliError("refused", f"{target} is {baseline['state']}; update runs only on a managed installed server.",
                           {"reason": "not_updatable", "state": baseline["state"]})
        if not OPERATION_BRANCH.match(resolved or "") or ".." in resolved:
            raise CliError("helper_protocol", "ddistro_server reported an unexpected branch name.")
    now = int(time.time())
    receipt = {"schema": 1, "id": secrets.token_hex(16), "kind": "service_operation", "target": target, "verb": verb,
               "branch": branch, "resolved_branch": resolved, "created_at": now,
               "expires_at": now + OPERATION_PREVIEW_SECONDS, "task_id": opts.get("task"), "thread_id": opts.get("thread"),
               "baseline": baseline, "helper": helper, "state": "previewed", "executed": None, "verified": False,
               "result": None}
    receipt["summary"] = operation_summary(target, verb, branch, resolved, baseline)
    receipt["plan_sha256"] = operation_plan_sha256(receipt)
    with OperationReceipts(True) as store:
        store.prune(now)
        store.save(receipt)
    data = operation_view(receipt)
    return data, "\n".join(data["summary"] + [f"Apply within {OPERATION_PREVIEW_SECONDS} seconds: ddistro operations apply "
                                              f"--receipt {receipt['id']} --plan-sha256 {receipt['plan_sha256']}"])


def operation_view(receipt, replayed=False):
    data = {key: receipt[key] for key in ("target", "verb", "branch", "resolved_branch", "baseline", "summary", "state",
                                          "executed", "verified", "result", "task_id", "thread_id")}
    data.update(receipt_id=receipt["id"], plan_sha256=receipt["plan_sha256"], helper_sha256=receipt["helper"]["sha256"],
                expires_at=model_stamp(receipt["expires_at"]), replayed=replayed)
    return data


def operation_clip(lines):
    return [redact(clean_line(str(line)))[:300] for line in lines][-20:]


def operation_run_server(receipt):
    """(state, executed, result) for ddistro_server <verb> <product> --branch <choice>, then a fresh identity check."""
    target, verb = receipt["target"], receipt["verb"]
    try:
        code, out, err = run_helper([verb, target, "--branch", receipt["branch"]], UPDATE_TIMEOUT, OUTPUT_TAIL_BYTES,
                                    watch_blocker=verb == "update")
        tail = operation_clip(tail_lines(out.data, 10) + tail_lines(err.data, 10))
    except CliError as error:
        if error.code not in ("timeout", "cancelled"):
            return "not_executed", False, {"error": error.code}
        # Started and stopped: the outcome is decided by the fresh check below, never reported as not run.
        code, tail = error.code, operation_clip(error.details.get("stdout_tail", [])[-10:]
                                                + error.details.get("stderr_tail", [])[-10:])
    result = {"exit": code, "output_tail": tail, "health": "not_checked"}
    if code == 75:
        return "busy", False, dict(result, reason="maintenance_busy")
    if code in BLOCKER_REASONS:
        result["reason"] = "update_blocked_tracked" if code == 79 else "update_blocked_untracked"
    try:
        record = helper_status(target)[0]
        after = {key: record[key] for key in ("state", "repository_state", "branch", "version", "database_present")}
        after["head"] = operation_rev(target, record, "HEAD^{commit}")
        expected = operation_rev(target, record, "refs/remotes/origin/" + receipt["resolved_branch"])
    except CliError as error:
        if error.code == "cancelled":
            raise
        after, expected = None, None
    checks = [{"id": "command", "result": "passed" if code == 0 else "failed", "detail": f"exit {code}"}]
    if after is None:
        checks.append({"id": "status", "result": "failed", "detail": "fresh status unavailable"})
    else:
        checks += [{"id": "installed", "result": "passed" if after["state"] == "installed"
                    and after["repository_state"] == "managed" else "failed", "detail": after["state"]},
                   {"id": "branch", "result": "passed" if after["branch"] == receipt["resolved_branch"] else "failed",
                    "detail": after["branch"] or "-"},
                   {"id": "commit", "result": "passed" if after["head"] and after["head"] == expected else "failed",
                    "detail": f"{(after['head'] or 'unknown')[:12]} vs origin/{receipt['resolved_branch']} "
                              f"{(expected or 'unknown')[:12]}"}]
    result.update(checks=checks, after=after)
    if code != 0:
        return "failed", True, result
    return ("verified" if all(c["result"] == "passed" for c in checks) else "unverified"), True, result


def operation_run_restart(ctx):
    try:
        data, _ = cmd_service_restart({"service": "apache"}, ctx)
    except CliError as error:
        state = "busy" if error.code == "busy" else "not_executed"
        return state, False, {"error": error.code}
    result = {"checks": data["checks"], "before": data["before"], "after": data["after"],
              "output_tail": operation_clip(data["output_tail"]), "health": "apache_only"}
    return data["state"], True, result


def cmd_operations_apply(opts, ctx):
    operations_ready()
    ctx["operation_id"] = str(uuid.uuid4())
    with OperationReceipts(False) as store:
        receipt = store.load(opts["receipt"])
        if receipt is None:
            raise CliError("not_found", "There is no service operation receipt with that id.", {"reason": "receipt_not_found"})
        if receipt["task_id"] is not None and (opts.get("task"), opts.get("thread")) != (receipt["task_id"], receipt["thread_id"]):
            raise CliError("refused", "This receipt belongs to another conversation; nothing was run.",
                           {"reason": "binding_mismatch"})
        if not hmac.compare_digest(receipt["plan_sha256"], opts["plan-sha256"]):
            raise CliError("refused", "The confirmation does not match this preview; nothing was run.",
                           {"reason": "plan_mismatch"})
        if receipt["state"] != "previewed":
            # One execution per receipt: a replay reports the recorded outcome, failures included, and runs nothing.
            data = operation_view(receipt, replayed=True)
            return data, f"{receipt['target']} {receipt['verb']}: {receipt['state']} (recorded)"
        if int(time.time()) > receipt["expires_at"]:
            receipt["state"], receipt["executed"] = "expired", False
            store.save(receipt)
            return operation_view(receipt), "This preview expired; nothing was run. Preview again."
        fresh = dict(receipt, baseline=operation_baseline(receipt["target"]), helper=operation_helper(receipt["target"]))
        if fresh["baseline"] != receipt["baseline"] or fresh["helper"] != receipt["helper"] \
                or operation_plan_sha256(fresh) != receipt["plan_sha256"]:
            receipt["state"], receipt["executed"] = "stale", False
            receipt["result"] = {"reason": "stale_plan", "baseline_changed": fresh["baseline"] != receipt["baseline"],
                                 "helper_changed": fresh["helper"] != receipt["helper"]}
            store.save(receipt)
            return operation_view(receipt), "The target changed since the preview; nothing was run. Preview again."
        # Claimed before the run: a process that ends during it leaves the receipt executing, never runnable again.
        receipt["state"] = "executing"
        store.save(receipt)
    # The store lock is not held during the run, and no maintenance lock is held here: the restart takes it
    # exclusively itself and ddistro_server takes it shared, so neither waits on a lock this process holds.
    if receipt["target"] == "apache":
        state, executed, result = operation_run_restart(dict(ctx, warnings=[]))
    else:
        state, executed, result = operation_run_server(receipt)
    result["finished_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    receipt.update(state=state, executed=executed, verified=state == "verified", result=result)
    try:
        with OperationReceipts(False) as store:
            store.save(receipt)
    except (OSError, CliError):
        ctx["warnings"].append("The outcome could not be recorded; the receipt stays executing.")
    data = operation_view(receipt)
    words = {"verified": "done and verified", "unverified": "ran, but the fresh check did not confirm it (executed_unverified)",
             "failed": "failed", "busy": "not run: another maintenance task is running", "not_executed": "not run"}
    return data, "\n".join(receipt["summary"] + [f"{receipt['verb']}: {words.get(state, state)}"])


def parse_operations(rest, ctx):
    names = ("targets", "preview", "apply")
    if len(rest) < 2 or rest[1] not in names:
        ctx["command"] = "operations"
        raise CliError("invalid_argument", "Expected operations targets|preview|apply.")
    name = rest[1]
    ctx["command"] = "operations " + name
    flags = {"targets": (), "preview": ("--target", "--verb", "--branch", "--task", "--thread"),
             "apply": ("--receipt", "--plan-sha256", "--task", "--thread")}[name]
    opts, args, index = {}, rest[2:], 0
    while index < len(args):
        token = args[index]
        if token not in flags or index + 1 >= len(args):
            raise CliError("invalid_argument", f"Unsupported or incomplete argument for operations {name}: {token[:40]}")
        if token[2:] in opts:
            raise CliError("invalid_argument", f"{token} was given more than once.")
        opts[token[2:]] = args[index + 1]
        index += 2
    checks = (("target", OPERATION_TARGET), ("verb", OPERATION_VERB), ("branch", OPERATION_BRANCH),
              ("task", TASK_ID), ("thread", THREAD_ID), ("receipt", MODEL_RECEIPT_ID), ("plan-sha256", HASH))
    for key, pattern in checks:
        if key in opts and not pattern.match(opts[key]):
            raise CliError("invalid_argument", f"--{key} has an invalid value.")
    if ".." in opts.get("branch", ""):
        raise CliError("invalid_argument", "--branch has an invalid value.")
    if ("task" in opts) != ("thread" in opts):
        raise CliError("invalid_argument", "--task and --thread go together.")
    required = {"targets": (), "preview": ("target", "verb"), "apply": ("receipt", "plan-sha256")}[name]
    if any(key not in opts for key in required):
        raise CliError("invalid_argument", f"operations {name} needs " + ", ".join("--" + key for key in required) + ".")
    return opts


def command_words(argv):
    """The first two command tokens, skipping the global flags wherever they appear first."""
    words, index = [], 0
    while index < len(argv) and len(words) < 2:
        if argv[index] == "--request-id":
            index += 2
            continue
        if argv[index] != "--json":
            words.append(argv[index])
        index += 1
    return words


COMMANDS = {"version": cmd_version, "capabilities": cmd_capabilities, "products": cmd_products,
            "status": cmd_status, "logs": cmd_logs, "server status": cmd_server_status,
            "server update": cmd_server_update, "agent status": cmd_agent_status, "agent probe": cmd_agent_probe,
            "models": cmd_models, "inventory": cmd_inventory, "health": cmd_health, "performance": cmd_performance,
            "agent home-config": cmd_agent_home_config, "agent home-config-repair": cmd_agent_home_config_repair,
            "service restart": cmd_service_restart, "service status": cmd_service_status,
            "service list": cmd_service_list, "update-check": cmd_update_check,
            "models options": cmd_models_options, "models preview": cmd_models_preview, "models apply": cmd_models_apply,
            "models rollback-preview": cmd_models_rollback_preview, "models rollback": cmd_models_rollback}
COMMANDS.update({"changes " + name: cmd_changes for name in CHANGES_SPEC})
COMMANDS.update({"memory " + name: cmd_memory for name in MEMORY_SPEC})
COMMANDS.update({name: cmd_access for name in ACCESS_SPEC})
COMMANDS.update({"exec": cmd_exec, "operations targets": cmd_operations_targets,
                 "operations preview": cmd_operations_preview, "operations apply": cmd_operations_apply})


# --- Arguments and output -------------------------------------------------------------

def parse_globals(argv, ctx):
    rest, index = [], 0
    while index < len(argv):
        token = argv[index]
        if token == "--json":
            ctx["json"] = True
        elif token == "--request-id":
            if ctx["request_id_given"] or index + 1 >= len(argv) or not REQUEST_ID.match(argv[index + 1]):
                raise CliError("invalid_argument", "--request-id needs one value of up to 64 letters, digits, ._:-")
            ctx["request_id"], ctx["request_id_given"] = argv[index + 1], True
            index += 1
        else:
            rest.append(token)
        index += 1
    return rest


def parse_command(rest, ctx):
    if not rest or rest[0] in ("-h", "--help", "help"):
        ctx["command"] = "help"
        if not rest:
            raise CliError("invalid_argument", "A command is required.\n" + USAGE)
        return {}
    name = rest[0]
    if name == "changes":
        return parse_changes(rest, ctx)
    if name == "memory":
        return parse_memory(rest, ctx)
    if name == "models":
        return parse_models(rest, ctx)
    if name in ("access", "files", "config", "db"):
        return parse_access(rest, ctx)
    if name == "exec":
        return parse_exec(rest, ctx)
    if name == "operations":
        return parse_operations(rest, ctx)
    if name == "server":
        if len(rest) < 2 or rest[1] not in ("status", "update"):
            raise CliError("invalid_argument", "Expected server status or server update.")
        name, rest = "server " + rest[1], rest[1:]
    elif name == "agent":
        if len(rest) < 2 or rest[1] not in ("status", "probe", "home-config", "home-config-repair"):
            raise CliError("invalid_argument", "Expected agent status, agent probe, agent home-config, "
                           "agent home-config-repair --sha256 HASH, or agent serve --task TASK.")
        name, rest = "agent " + rest[1], rest[1:]
    elif name == "service":
        if rest[1:] == ["list"]:
            ctx["command"] = "service list"
            return {}
        if len(rest) != 3 or rest[1] not in ("restart", "status"):
            raise CliError("invalid_argument", "Expected service list, service status <service> or service restart <service>.")
        ctx["command"] = "service " + rest[1]
        # Only the shape here; the command resolves the code-owned apache or a registered id, else unsupported.
        if not SERVICE_ID.match(rest[2]):
            raise CliError("unsupported", "That is not a service id. " + SERVICE_UNREGISTERED,
                           {"reason": "unsupported_target"})
        return {"service": rest[2]}
    if name not in COMMANDS:
        raise CliError("invalid_argument", "Unknown command.\n" + USAGE)
    ctx["command"] = name
    valued = {"logs": ("--log", "--lines", "--query", "--since"), "server update": ("--branch",),
              "agent home-config-repair": ("--sha256",)}.get(name, ())
    switches = ("--force",) if name == "server update" else ()
    opts, positional, index, args = {}, [], 0, rest[1:]
    while index < len(args):
        token = args[index]
        if token in valued:
            if index + 1 >= len(args):
                raise CliError("invalid_argument", f"{token} needs a value.")
            if token[2:] in opts:
                raise CliError("invalid_argument", f"{token} was given more than once.")
            opts[token[2:]] = args[index + 1]
            index += 1
        elif token in switches:
            opts["force"] = True
        elif token.startswith("-"):
            raise CliError("invalid_argument", f"Unsupported option for {name}: {token[:40]}")
        else:
            positional.append(token)
        index += 1
    required = {"logs": 1, "server update": 1}.get(name, 0)
    allowed = 1 if name in ("status", "health", "performance", "server status", "logs", "server update", "update-check") else 0
    if not required <= len(positional) <= allowed:
        raise CliError("invalid_argument", f"Wrong number of arguments for {name}.\n" + USAGE)
    if name == "logs":
        opts["target"] = resolve_product(positional[0], ("apache", "postgres"))
        if "lines" in opts:
            if not re.match(r"^[0-9]{1,4}\Z", opts["lines"]) or not 1 <= int(opts["lines"]) <= MAX_LOG_LINES:
                raise CliError("invalid_argument", f"--lines must be between 1 and {MAX_LOG_LINES}.")
            opts["lines"] = int(opts["lines"])
        query = opts.get("query")
        if query is not None and (not query.strip() or len(query) > LOG_QUERY_CHARS or CONTROL.search(query)
                                  or "\n" in query):
            raise CliError("invalid_argument", f"--query must be 1-{LOG_QUERY_CHARS} characters of plain text.")
        since = opts.get("since")
        if since is not None:
            try:
                valid = bool(SINCE.match(since)) and bool(time.strptime(since, "%Y-%m-%dT%H:%M:%SZ"))
            except ValueError:
                valid = False
            if not valid:
                raise CliError("invalid_argument", "--since must be a UTC time like 2026-10-20T14:00:00Z.")
    elif name == "agent home-config-repair":
        if not re.match(r"^[0-9a-f]{64}\Z", opts.get("sha256", "")):
            raise CliError("invalid_argument", "agent home-config-repair needs --sha256 with the 64-hex hash from agent home-config.")
    elif positional:
        opts["product"] = resolve_product(positional[0])
    return opts


def emit(ctx, data=None, human="", error=None):
    if ctx["json"]:
        document = {"schema_version": SCHEMA_VERSION, "ok": error is None, "command": ctx["command"],
                    "request_id": ctx["request_id"], "tool": TOOL, "data": data, "error": error,
                    "warnings": ctx["warnings"]}
        if ctx.get("operation_id"):
            document["operation_id"] = ctx["operation_id"]
        sys.stdout.write(json.dumps(document, ensure_ascii=True) + "\n")
        sys.stdout.flush()
        return
    if error is None:
        if human:
            print(human, flush=True)
    else:
        print("[FAIL] " + error["message"], file=sys.stderr)
        blocker = error["details"].get("blocker") or {}
        for path in blocker.get("files", []):
            print("  " + path, file=sys.stderr)
    for warning in ctx["warnings"]:
        print("[WARN] " + warning, file=sys.stderr)


def raise_cancelled(signum, frame):
    raise Cancelled()


def main(argv):
    if command_words(argv) == ["agent", "serve"]:
        if argv[:2] != ["agent", "serve"]:
            return serve_refusal("invalid_argument", "agent serve takes no --json or --request-id", 64)
        return agent_serve(argv[2:])
    ctx = {"json": "--json" in argv, "command": None, "request_id": str(uuid.uuid4()),
           "request_id_given": False, "warnings": []}
    signal.signal(signal.SIGTERM, raise_cancelled)
    if hasattr(signal, "SIGHUP"):
        signal.signal(signal.SIGHUP, raise_cancelled)
    try:
        opts = parse_command(parse_globals(argv, ctx), ctx)
        if ctx["command"] == "help":
            emit(ctx, {"usage": USAGE}, USAGE)
            return 0
        data, human = COMMANDS[ctx["command"]](opts, ctx)
        emit(ctx, data, human)
        return 0
    except CliError as error:
        failure = error
    except (KeyboardInterrupt, Cancelled):
        failure = CliError("cancelled", "Cancelled.")
    except Exception:
        failure = CliError("internal_error", "ddistro hit an unexpected internal error.")
    exit_code = ERRORS[failure.code]
    try:
        emit(ctx, None, "", {"code": failure.code, "exit_code": exit_code, "message": redact(failure.message),
                             "details": failure.details})
    except BrokenPipeError:
        pass
    return exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
