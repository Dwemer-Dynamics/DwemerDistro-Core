#!/usr/bin/env python3
"""One stable command surface for DwemerDistro status, logs, server updates, and file changes.

See ASSISTANT.md for the command and JSON contract. This tool is not a sandbox or an
authorization boundary: it runs with the caller's privileges, never elevates, and calls
only the trusted root-owned helpers below, always with explicit argument vectors.
"""
import errno
import json
import os
import pwd
import re
import shutil
import signal
import socket
import stat
import subprocess
import sys
import threading
import time
import uuid

TOOL = {"name": "ddistro", "version": "1.0.0", "source": "DwemerDistro-Core"}
SCHEMA_VERSION = 1
SERVER_HELPER = "/usr/local/bin/ddistro_server"
CHANGES_HELPER = "/usr/local/bin/ddistro_changes"
AGENT_HELPER = "/usr/local/bin/ddistro_agent"
HELPER_OWNER_UID = 0
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
STATUS_TIMEOUT = 120
UPDATE_TIMEOUT = 3 * 3600  # Reign updates include a native build.
CHANGES_TIMEOUT = 600
AGENT_STATUS_TIMEOUT = 120  # the first status after an install hashes the pinned runtime
AGENT_PROBE_TIMEOUT = 600
AGENT_STDOUT_LIMIT = 256 * 1024
CHANGES_STDOUT_LIMIT = 24 * 1024 * 1024  # an 8 MiB change batch plus its diff
CHANGES_DIFF_BYTES = 8 * 1024 * 1024  # JSON-encoded diff bound in ddistro_changes
STOP_GRACE = 10
STATUS_STDOUT_LIMIT = 1024 * 1024
OUTPUT_TAIL_BYTES = 64 * 1024
OUTPUT_TAIL_LINES = 60
HELPER_LINE_LIMIT = 128 * 1024
MAX_LOG_LINES = 400
DEFAULT_LOG_LINES = 100
MAX_LOG_BYTES = 256 * 1024
MAX_LINE_CHARS = 4096
BLOCKED_PREFIX = b"DDISTRO_UPDATE_BLOCKED "
REQUEST_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}\Z")
STATE_TOKEN = re.compile(r"^[a-z][a-z0-9-]{0,31}\Z")

# Stable error code names and their process exit codes. partial, conflict, and rollback
# come only from ddistro changes apply and rollback.
ERRORS = {
    "failed": 1, "internal_error": 1, "helper_failed": 1, "helper_protocol": 1,
    "partial": 10, "conflict": 11, "rollback": 12,
    "invalid_argument": 64, "not_found": 66, "unsupported": 69, "helper_unavailable": 69,
    "busy": 75, "permission_denied": 77, "unsafe_path": 77,
    "update_blocked_tracked": 79, "update_blocked_untracked": 80,
    "timeout": 124, "cancelled": 130,
}

# The official servers managed by ddistro_server, in its status order.
PRODUCTS = {
    "herika": {"name": "CHIM (HerikaServer)", "aliases": ["chim", "skyrim"],
               "branches": ["main", "dev", "aiagent"]},
    "lorkhan": {"name": "LorkhanServer", "aliases": [], "branches": ["main", "dev", "unstable", "lorkhan"]},
    "stobe": {"name": "Stobe (StobeServer)", "aliases": ["kenshi"], "branches": ["main", "dev", "stobe"]},
    "dialectic": {"name": "Dialectic (DialecticServer)", "aliases": ["fnv", "ttw"],
                  "branches": ["main", "dev", "dialectic"]},
    "reign": {"name": "ReignServer", "aliases": [], "branches": ["main", "dev", "unstable", "reign"]},
}
ALIASES = {alias: key for key, product in PRODUCTS.items() for alias in product["aliases"]}

# Allowlisted log files per target, first is the default. Nothing outside these roots is read.
LOG_SOURCES = {
    "herika": ("/var/www/html/HerikaServer/log", ["chim.log", "output_from_llm.log", "output_to_plugin.log",
               "context_sent_to_llm.log", "debugStream.log", "minai.log", "vision.log"]),
    "lorkhan": ("/var/log/lorkhanserver", ["lorkhan.log", "output_from_llm.log", "output_from_llm_fast.log",
                "output_to_plugin.log", "context_sent_to_llm.log", "context_sent_to_llm_fast.log", "stt.log"]),
    "stobe": ("/var/www/html/StobeServer/log", ["stobe.log", "stobeserver.log", "stobe_import.log",
              "output_from_llm.log", "context_sent_to_llm.log"]),
    "dialectic": ("/var/www/html/DialecticServer/log", ["dialectic.log", "service.log", "manager.log",
                  "monitor.log", "output_from_llm.log", "output_from_llm_fast.log", "output_to_plugin.log",
                  "context_sent_to_llm.log", "context_sent_to_llm_fast.log", "debugStream.log"]),
    "reign": ("/var/www/html/ReignServer/data/logs", ["server.log", "server-log.jsonl", "llm-log.jsonl",
              "otel-traces.ndjson"]),
    "apache": ("/var/log/apache2", ["error.log", "other_vhosts_access.log", "stobe_error.log",
               "dialectic_error.log"]),
    "postgres": ("/var/log/postgresql", ["main"]),  # newest postgresql-<version>-main.log
}
POSTGRES_LOG = re.compile(r"^postgresql-([0-9]{1,3})-main\.log\Z")

STATUS_STRINGS = ("product", "state", "repository_state", "root", "database", "branch", "version",
                  "production_branch", "development_branch")
STATUS_KEYS = set(STATUS_STRINGS) | {"schema_version", "database_present", "port"}
BLOCKER_KEYS = {"schema_version", "reason", "product", "branch", "total", "files"}
BLOCKER_REASONS = {79: "tracked-changes", 80: "untracked-files"}

USAGE = """Usage: ddistro <command> [arguments] [--json] [--request-id ID]

  version | capabilities | products
  status [product]
  logs <product|apache|postgres> [--log NAME] [--lines N]   (N <= 400)
  server status [product]
  server update <product> --branch <main|dev|...> [--force]   (root)
  changes prepare --product herika [--path RELATIVE ...]       (root)
  changes diff|stage|status|rollback TASK | changes list         (root)
  changes apply TASK --manifest-sha256 HASH                     (root)
  agent status | agent probe                                    (probe: root)
  models herika                 (root; configured CHIM profile model assignments, read-only)
  inventory                     (read-only presence snapshot: servers, ext folders, components, custom mods)
  health [product]              (bounded local checks: servers, ports, database presence, disk; no repair)
  agent serve --task TASK      (root; raw Codex App Server JSONL, no --json envelope)

Products: herika (chim, skyrim), lorkhan, stobe (kenshi), dialectic (fnv, ttw), reign.
--force discards local edits to tracked server files; it is never added automatically."""


class CliError(Exception):
    def __init__(self, code, message, details=None):
        super().__init__(message)
        self.code, self.message, self.details = code, message, details or {}


class Cancelled(BaseException):
    pass


# --- Redaction ------------------------------------------------------------------------

CONTROL = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|[\x00-\x08\x0b-\x1f\x7f]")
URL_USERINFO = re.compile(r"(?i)\b([a-z][a-z0-9+.-]{1,15}://)[^\s/@\"'<>]+@")
URL_QUERY = re.compile(r"(?i)(\bhttps?://[^\s\"'<>?#]+)[?#][^\s\"'<>]*")
AUTH_SCHEME = re.compile(r"(?i)\b(bearer|basic)\s+[A-Za-z0-9._~+/=-]{8,}")
KEY_VALUE = re.compile(r"(?im)((?:authorization|api[_-]?key|apikey|pairing[_-]?key|access[_-]?token|"
                       r"refresh[_-]?token|auth[_-]?token|token|password|passwd|pwd|secret|private[_-]?key)"
                       r"[\"']?\s*[:=]\s*).*$")
TOKEN_SHAPES = re.compile(r"\b(?:hf_|sk-|gh[pousr]_|github_pat_|xox[abp]-)[A-Za-z0-9_-]{16,}")


def redact(text):
    """Same intent as the launcher's DiagnosticEvidenceService.Sanitize, plus control bytes."""
    text = CONTROL.sub("?", text)
    text = URL_USERINFO.sub(r"\1[redacted]@", text)
    text = URL_QUERY.sub(r"\1?[redacted]", text)
    text = AUTH_SCHEME.sub(r"\1 [redacted]", text)
    text = KEY_VALUE.sub(r"\1[redacted]", text)
    return TOKEN_SHAPES.sub("[redacted]", text)


def clean_line(text):
    text = redact(text)
    if len(text) > MAX_LINE_CHARS:
        text = text[:MAX_LINE_CHARS] + " [line truncated]"
    return text


def tail_lines(raw, limit=OUTPUT_TAIL_LINES):
    rows = bytes(raw).decode("utf-8", "replace").replace("\r", "").split("\n")
    return [clean_line(row) for row in rows if row.strip()][-limit:]


# --- Trusted helper execution ---------------------------------------------------------

def check_helper(path):
    """Accept only a root-owned regular file in a root-owned directory that only root can change."""
    name = os.path.basename(path)
    try:
        info, parent = os.lstat(path), os.stat(os.path.dirname(path))
    except FileNotFoundError:
        raise CliError("helper_unavailable", f"{name} is not installed.",
                       {"helper": path, "reason": "missing"})
    except OSError:
        raise CliError("helper_unavailable", f"{name} cannot be inspected.",
                       {"helper": path, "reason": "unreadable"})
    trusted = (stat.S_ISREG(info.st_mode) and info.st_uid == HELPER_OWNER_UID and not info.st_mode & 0o022
               and parent.st_uid == HELPER_OWNER_UID and not parent.st_mode & 0o022
               and os.access(path, os.X_OK))
    if not trusted:
        raise CliError("helper_unavailable", f"{name} is not a trusted root-owned executable.",
                       {"helper": path, "reason": "untrusted"})


def helper_env():
    try:
        home = pwd.getpwuid(os.geteuid()).pw_dir
    except KeyError:
        home = "/"
    env = {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": home,
           "GIT_TERMINAL_PROMPT": "0"}
    port = os.environ.get("DDISTRO_POSTGRES_PORT", "")
    if re.match(r"^[0-9]{1,5}\Z", port):
        env["DDISTRO_POSTGRES_PORT"] = port
    return env


class Capture(threading.Thread):
    """Drain one pipe, keep a bounded tail, and remember a complete blocker line."""

    def __init__(self, stream, keep, echo=False, watch_blocker=False):
        super().__init__(daemon=True)
        self.stream, self.keep, self.echo, self.watch = stream, keep, echo, watch_blocker
        self.data, self.total, self.blocker = bytearray(), 0, None

    def run(self):
        line_start = True
        try:
            while True:
                chunk = self.stream.readline(HELPER_LINE_LIMIT)
                if not chunk:
                    break
                self.total += len(chunk)
                if self.watch and line_start and chunk.startswith(BLOCKED_PREFIX) and chunk.endswith(b"\n"):
                    self.blocker = chunk
                line_start = chunk.endswith(b"\n")
                self.data += chunk
                if len(self.data) > self.keep:
                    del self.data[:len(self.data) - self.keep]
                if self.echo:
                    print(clean_line(chunk.decode("utf-8", "replace").rstrip("\r\n")), file=sys.stderr, flush=True)
        except (OSError, ValueError):
            pass


def stop_child(proc):
    previous = {sig: signal.signal(sig, signal.SIG_IGN) for sig in (signal.SIGINT, signal.SIGTERM)}
    try:
        for sig, wait in ((signal.SIGTERM, STOP_GRACE), (signal.SIGKILL, 5)):
            try:
                os.killpg(proc.pid, sig)
            except (ProcessLookupError, PermissionError):
                break
            try:
                proc.wait(timeout=wait)
                break
            except subprocess.TimeoutExpired:
                continue
        try:
            os.killpg(proc.pid, signal.SIGKILL)  # leftover helper children
        except (ProcessLookupError, PermissionError):
            pass
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def run_helper(args, timeout, keep, echo=False, watch_blocker=False, helper=None, echo_stdout=True, env=None):
    helper = helper or SERVER_HELPER
    name = os.path.basename(helper)
    check_helper(helper)
    try:
        proc = subprocess.Popen([helper] + args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=env or helper_env(), cwd="/", close_fds=True,
                                start_new_session=True)
    except OSError as error:
        raise CliError("helper_unavailable", f"{name} could not be started.",
                       {"helper": helper, "reason": errno.errorcode.get(error.errno, "error")})
    out = Capture(proc.stdout, keep, echo and echo_stdout, watch_blocker)
    err = Capture(proc.stderr, OUTPUT_TAIL_BYTES, echo)
    out.start()
    err.start()
    deadline = time.monotonic() + timeout
    failure = None
    try:
        while proc.poll() is None:
            if time.monotonic() > deadline:
                failure = ("timeout", f"{name} did not finish within {timeout} seconds.")
                break
            time.sleep(0.1)
    except (KeyboardInterrupt, Cancelled):
        failure = ("cancelled", f"Cancelled; {name} was stopped.")
    if failure:
        stop_child(proc)
    out.join(5)
    err.join(5)
    if failure:
        raise CliError(failure[0], failure[1], {"helper_exit": proc.returncode, "stdout_tail": tail_lines(out.data),
                                                "stderr_tail": tail_lines(err.data)})
    return proc.returncode, out, err


# --- Server status --------------------------------------------------------------------

def protocol_error(reason):
    return CliError("helper_protocol", "ddistro_server returned an unexpected status document.",
                    {"reason": reason})


def reject_constant(value):
    raise ValueError(value)


def validate_record(record, product):
    if type(record) is not dict or set(record) != STATUS_KEYS:
        raise protocol_error("status keys")
    if type(record["schema_version"]) is not int or record["schema_version"] != 1:
        raise protocol_error("status schema_version")
    for key in STATUS_STRINGS:
        if type(record[key]) is not str or len(record[key]) > 4096:
            raise protocol_error("status " + key)
    if record["product"] != product:
        raise protocol_error("status product")
    if not STATE_TOKEN.match(record["state"]) or not STATE_TOKEN.match(record["repository_state"]):
        raise protocol_error("status state")
    if record["database_present"] not in (True, False, None) or type(record["database_present"]) is int:
        raise protocol_error("status database_present")
    if type(record["port"]) is not int or not 0 < record["port"] < 65536:
        raise protocol_error("status port")
    return dict(record)


def helper_status(product=None, timeout=STATUS_TIMEOUT):
    code, out, err = run_helper(["status", product or "all", "--json"], timeout, STATUS_STDOUT_LIMIT)
    if code != 0:
        raise CliError("helper_failed", "ddistro_server status failed.",
                       {"helper_exit": code, "stderr_tail": tail_lines(err.data, 20)})
    if out.total > STATUS_STDOUT_LIMIT:
        raise protocol_error("status output too large")
    try:
        document = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        raise protocol_error("status is not one JSON document")
    if product:
        return [validate_record(document, product)]
    if type(document) is not dict or set(document) != {"schema_version", "servers"} \
            or type(document["schema_version"]) is not int or document["schema_version"] != 1 \
            or type(document["servers"]) is not list \
            or len(document["servers"]) != len(PRODUCTS):
        raise protocol_error("status list")
    return [validate_record(record, key) for record, key in zip(document["servers"], PRODUCTS)]


DATABASE_WORDS = {True: "present", False: "absent", None: "unknown"}


def human_status(records):
    return "\n".join(f"{r['product']:<10} {r['state']:<15} branch={r['branch'] or '-':<10} "
                     f"version={r['version'] or '-'} database={DATABASE_WORDS[r['database_present']]}"
                     for r in records)


# --- Commands -------------------------------------------------------------------------

def resolve_product(token, extra=()):
    if token in PRODUCTS or token in extra:
        return token
    if token in ALIASES:
        return ALIASES[token]
    choices = ", ".join(list(PRODUCTS) + list(extra))
    raise CliError("invalid_argument", f"Unknown product. Expected one of: {choices}.")


def current_user():
    try:
        return pwd.getpwuid(os.geteuid()).pw_name
    except KeyError:
        return str(os.geteuid())


def cmd_version(opts, ctx):
    data = dict(TOOL, schema_version=SCHEMA_VERSION)
    return data, f"ddistro {TOOL['version']} (JSON schema {SCHEMA_VERSION})"


def cmd_capabilities(opts, ctx):
    data = {
        "commands": [
            {"name": "version", "mutates": False}, {"name": "capabilities", "mutates": False},
            {"name": "products", "mutates": False},
            {"name": "status", "arguments": ["[product]"], "mutates": False},
            {"name": "logs", "arguments": ["<target>"], "flags": ["--log", "--lines"], "mutates": False},
            {"name": "server status", "arguments": ["[product]"], "mutates": False},
            {"name": "server update", "arguments": ["<product>"], "flags": ["--branch", "--force"],
             "mutates": True, "requires_root": True},
        ] + [dict(CHANGES_SPEC[name], name="changes " + name, requires_root=True) for name in CHANGES_SPEC] + [
            {"name": "agent status", "mutates": False},
            {"name": "agent probe", "mutates": True, "requires_root": True},
            {"name": "agent serve", "flags": ["--task"], "mutates": False, "requires_root": True,
             "transport": "jsonl"},
            {"name": "models", "arguments": ["herika"], "mutates": False, "requires_root": True},
            # Any user may run it; as another user, unreadable folders are reported as unreadable.
            {"name": "inventory", "mutates": False},
            {"name": "health", "arguments": ["[product]"], "mutates": False},
        ],
        "global_flags": ["--json", "--request-id"],
        "aliases": ALIASES,
        "log_targets": {target: names for target, (_, names) in LOG_SOURCES.items()},
        "error_codes": ERRORS,
        "limits": {"log_lines": MAX_LOG_LINES, "log_bytes": MAX_LOG_BYTES, "line_chars": MAX_LINE_CHARS,
                   "change_files": 200, "change_file_bytes": 1024 * 1024, "change_batch_bytes": 8 * 1024 * 1024,
                   "change_diff_bytes": CHANGES_DIFF_BYTES},
        # A diff with diff_truncated true is a preview only; changes stage refuses it, so a
        # staged manifest always comes with its complete diff.
        "change_review": {"truncated_flag": "diff_truncated", "stage_refuses_truncated": True},
        "change_products": ["herika"],
        # agent means the commands and a trusted helper are present; readiness (runtime installed
        # and a passing probe on this distro) is only ever reported by agent status.
        "features": {"file_changes": True, "locks": True, "agent": agent_helper_trusted(), "chat": False,
                     "models": True, "inventory": True,
                     "health": True, "assistant_tools": agent_helper_trusted()},
        "agent": {"provider": "codex", "readiness_command": "agent status", "ready_when": ["installed", "probe_passed"]},
        # Configured profile assignments only; which profile an NPC is using is not reported.
        "models": {"products": ["herika"], "scope": "configured_profiles", "roles": [role for role, _ in MODELS_ROLES],
                   "max_assignments": MODELS_MAX, "string_chars": MODELS_STRING_CHARS},
        "inventory": {"scope": "presence_only", "extension_products": list(INVENTORY_EXTENSION_ROOTS),
                      "components": [c[0] for c in INVENTORY_COMPONENTS], "max_entries": INVENTORY_MAX_ENTRIES,
                      "scan_limit": INVENTORY_SCAN_LIMIT, "max_custom_mods": INVENTORY_MAX_MODS,
                      "string_chars": INVENTORY_STRING_CHARS},
        "health": {"scope": "local_bounded", "results": ["passed", "failed", "skipped"], "overall_verdict": False,
                   "scope_limits": HEALTH_SCOPE_LIMITS},
        # The broker declares and runs this one tool itself; see ASSISTANT_RUNTIME.md.
        "assistant_tools": {"requires": "initialize capabilities.experimentalApi true", "declared_on": "thread/start",
                            "tools": [{"name": "ddistro_read", "mutates": False,
                                       "operations": ["inventory", "status", "models", "logs", "health"],
                                       "max_log_lines": 100}]},
    }
    return data, "\n".join(command["name"] for command in data["commands"])


def cmd_products(opts, ctx):
    products = [{"id": key, "name": value["name"], "aliases": value["aliases"], "branches": value["branches"],
                 "logs": LOG_SOURCES[key][1]} for key, value in PRODUCTS.items()]
    human = "\n".join(f"{p['id']:<10} {p['name']:<28} aliases: {', '.join(p['aliases']) or '-'}" for p in products)
    return {"products": products}, human


def cmd_status(opts, ctx):
    records = helper_status(opts.get("product"))
    servers = [{key: record[key] for key in ("product", "state", "repository_state", "database_present",
                                              "branch", "version")} for record in records]
    data = {"user": current_user(), "is_root": os.geteuid() == 0, "servers": servers}
    return data, human_status(records)


def cmd_server_status(opts, ctx):
    records = helper_status(opts.get("product"))
    return {"servers": records}, human_status(records)


def postgres_log_name(root):
    try:
        versions = [int(match.group(1)) for match in map(POSTGRES_LOG.match, os.listdir(root)) if match]
    except FileNotFoundError:
        return None
    except PermissionError:
        raise CliError("permission_denied", "The PostgreSQL log folder is not readable by this user.",
                       {"path": root, "read_as": current_user()})
    return f"postgresql-{max(versions)}-main.log" if versions else None


def read_tail(path, lines):
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_CLOEXEC", 0)
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise CliError("unsafe_path", "The log is not a regular file.", {"path": path})
        start = max(0, info.st_size - MAX_LOG_BYTES)
        os.lseek(fd, start, os.SEEK_SET)
        raw = bytearray()
        while len(raw) < MAX_LOG_BYTES:
            chunk = os.read(fd, MAX_LOG_BYTES - len(raw))
            if not chunk:
                break
            raw += chunk
    finally:
        os.close(fd)
    rows = bytes(raw).decode("utf-8", "replace").replace("\r", "").split("\n")
    if rows and rows[-1] == "":
        rows.pop()
    if start > 0 and len(rows) > 1:
        rows.pop(0)  # partial first line
    truncated = start > 0 or len(rows) > lines
    output, size = [], 0
    for row in reversed(rows[-lines:]):
        row = clean_line(row)
        size += len(row.encode("utf-8")) + 1
        if size > MAX_LOG_BYTES:
            truncated = True
            break
        output.append(row)
    output.reverse()
    return {"size_bytes": info.st_size, "modified": int(info.st_mtime), "truncated": truncated, "lines": output}


def cmd_logs(opts, ctx):
    target = opts["target"]
    root, names = LOG_SOURCES[target]
    name = opts.get("log") or names[0]
    if name not in names:
        raise CliError("invalid_argument", f"Unknown log for {target}. Expected one of: {', '.join(names)}.")
    data = {"target": target, "log": name, "read_as": current_user(), "available": False, "reason": None,
            "lines": []}
    try:
        root_info = os.lstat(root)
    except FileNotFoundError:
        root_info = None
    except PermissionError:
        raise CliError("permission_denied", "The log folder is not readable by this user.",
                       {"path": root, "read_as": data["read_as"]})
    if root_info is not None and (not stat.S_ISDIR(root_info.st_mode) or os.path.realpath(root) != root):
        raise CliError("unsafe_path", "The log folder is redirected; it was not read.", {"path": root})
    filename = name if target != "postgres" else (postgres_log_name(root) if root_info else None)
    data["path"] = os.path.join(root, filename) if filename else root
    try:
        if root_info is None or filename is None:
            raise FileNotFoundError
        data.update(read_tail(data["path"], opts.get("lines", DEFAULT_LOG_LINES)), available=True)
    except FileNotFoundError:
        data["reason"] = "missing"
    except PermissionError:
        raise CliError("permission_denied", "The log is not readable by this user.",
                       {"path": data["path"], "read_as": data["read_as"]})
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise CliError("unsafe_path", "The log is a symbolic link; it was not read.", {"path": data["path"]})
        raise CliError("failed", "The log could not be read.",
                       {"path": data["path"], "reason": errno.errorcode.get(error.errno, "error")})
    if not data["available"]:
        return data, f"{data['path']}: not present (no log written yet)."
    header = f"== {data['path']} ({len(data['lines'])} lines" + (", truncated" if data["truncated"] else "") + ")"
    return data, "\n".join([header] + data["lines"])


def parse_blocker(line, product, code):
    """Validate the one-line DDISTRO_UPDATE_BLOCKED payload; anything unexpected is ignored."""
    try:
        doc = json.loads(line[len(BLOCKED_PREFIX):].decode("utf-8"), parse_constant=reject_constant)
    except (ValueError, TypeError, AttributeError):
        return None
    valid = (type(doc) is dict and set(doc) == BLOCKER_KEYS and type(doc["schema_version"]) is int
             and doc["schema_version"] == 1 and doc["reason"] == BLOCKER_REASONS[code]
             and doc["product"] == product and type(doc["branch"]) is str and len(doc["branch"]) <= 255
             and type(doc["total"]) is int and doc["total"] >= 0 and type(doc["files"]) is list
             and len(doc["files"]) <= min(20, doc["total"])
             and all(type(path) is str and len(path) <= 4096 for path in doc["files"]))
    if not valid:
        return None
    return dict(doc, files=[CONTROL.sub("?", path) for path in doc["files"]])


def cmd_server_update(opts, ctx):
    product, branch, force = opts["product"], opts.get("branch"), opts.get("force", False)
    if not branch:
        raise CliError("invalid_argument", "server update requires --branch.")
    if branch not in PRODUCTS[product]["branches"]:
        raise CliError("invalid_argument",
                       f"Unsupported branch for {product}. Expected one of: {', '.join(PRODUCTS[product]['branches'])}.")
    if os.geteuid() != 0:
        raise CliError("permission_denied", "server update must run as root. ddistro never elevates by itself.")
    ctx["operation_id"] = str(uuid.uuid4())
    before = helper_status(product)[0]
    if before["state"] == "not-installed":
        raise CliError("not_found", f"{product} is not installed. Update never installs missing products.",
                       {"product": product, "state": before["state"]})
    args = ["update", product, "--branch", branch] + (["--force"] if force else [])
    code, out, err = run_helper(args, UPDATE_TIMEOUT, OUTPUT_TAIL_BYTES, echo=not ctx["json"], watch_blocker=True)
    details = {"product": product, "branch": branch, "force": force, "helper_exit": code,
               "stdout_tail": tail_lines(out.data), "stderr_tail": tail_lines(err.data)}
    if code in BLOCKER_REASONS:
        details["blocker"] = parse_blocker(out.blocker, product, code) if out.blocker else None
        details["force_may_resolve"] = code == 79
        if code == 79:
            raise CliError("update_blocked_tracked", f"Local edits to tracked {product} files block this update. "
                           "Re-run with --force only if discarding them is intended.", details)
        raise CliError("update_blocked_untracked",
                       f"Untracked {product} files are in the way of this update. Move them, then update again.",
                       details)
    mapped = {75: "busy", 64: "invalid_argument", 130: "cancelled", 143: "cancelled"}.get(code)
    if code != 0:
        raise CliError(mapped or "helper_failed", f"ddistro_server update failed (exit {code}).", details)
    data = {"product": product, "branch": branch, "force": force, "before": before,
            "stdout_tail": details["stdout_tail"], "stderr_tail": details["stderr_tail"]}
    try:
        data["after"] = helper_status(product)[0]
    except CliError as error:
        data["after"] = None
        ctx["warnings"].append(f"Post-update status unavailable: {error.code}.")
    return data, f"Updated {product} on branch {branch}."


# ddistro changes: the root-only ddistro_changes helper does the work; this layer checks
# arguments and the helper's trust, then passes its one JSON result through unchanged.
CHANGES_SPEC = {
    "prepare": {"flags": ["--product", "--path"], "mutates": False},
    "diff": {"arguments": ["TASK"], "mutates": False},
    "stage": {"arguments": ["TASK"], "mutates": False},
    "apply": {"arguments": ["TASK"], "flags": ["--manifest-sha256"], "mutates": True},
    "status": {"arguments": ["TASK"], "mutates": False},
    "rollback": {"arguments": ["TASK"], "mutates": True},
    "list": {"mutates": False},
}
TASK_ID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\Z")
HASH = re.compile(r"^[0-9a-f]{64}\Z")


def changes_result(code, out):
    """Validate the helper's single JSON document and its exit code; anything else is helper_protocol."""
    if out.total > CHANGES_STDOUT_LIMIT:
        raise CliError("helper_protocol", "ddistro_changes returned too much output.")
    try:
        doc = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        doc = None
    if type(doc) is dict and set(doc) == {"schema_version", "ok", "data", "error"}             and type(doc["schema_version"]) is int and doc["schema_version"] == 1:
        error = doc["error"]
        if doc["ok"] is True and code == 0 and type(doc["data"]) is dict and error is None:
            return doc["data"]
        if doc["ok"] is False and doc["data"] is None and type(error) is dict \
                and set(error) == {"code", "message", "details"} and error["code"] in ERRORS \
                and ERRORS[error["code"]] == code and code != 0 and type(error["message"]) is str \
                and type(error["details"]) is dict:
            raise CliError(error["code"], error["message"][:4096], error["details"])
    raise CliError("helper_protocol", "ddistro_changes returned an unexpected result.", {"helper_exit": code})


def changes_human(name, data):
    if name == "prepare":
        return f"Prepared task {data['task_id']} for {data['product']}.\nWorkspace: {data['workspace']}"
    if name in ("diff", "stage"):
        return (data["diff"] or "(no changes)\n") + f"manifest-sha256: {data['manifest_sha256']}"
    if name == "list":
        return "\n".join(f"{t['task_id']}  {t['state']:<20} {t['product'] or '-'}" for t in data["tasks"])
    return f"{data['task_id']}: {data['state']} ({len(data.get('files') or [])} files)"


def cmd_changes(opts, ctx):
    name = ctx["command"].split(" ", 1)[1]
    if os.geteuid() != 0:
        raise CliError("permission_denied", "ddistro changes must run as root (for example with sudo). "
                       "ddistro never elevates by itself.")
    if name in ("apply", "rollback"):
        ctx["operation_id"] = str(uuid.uuid4())
    args = [name]
    if name == "prepare":
        args += ["--product", opts["product"]]
        for path in opts["paths"]:
            args += ["--path", path]
    elif name != "list":
        args.append(opts["task"])
    if name == "apply":
        args += ["--manifest-sha256", opts["manifest-sha256"]]
    code, out, _ = run_helper(args, CHANGES_TIMEOUT, CHANGES_STDOUT_LIMIT + 1, echo=not ctx["json"],
                              helper=CHANGES_HELPER, echo_stdout=False)
    data = changes_result(code, out)
    warnings = data.get("warnings", [])
    if type(warnings) is not list or len(warnings) > 400 or any(type(w) is not str for w in warnings):
        raise CliError("helper_protocol", "ddistro_changes returned malformed warnings.", {"helper_exit": code})
    if name == "stage" and data.get("diff_truncated") is not False:
        raise CliError("helper_protocol", "ddistro_changes staged a diff that is not complete.", {"helper_exit": code})
    for warning in dict.fromkeys(redact(w[:300]) for w in warnings):
        ctx["warnings"].append(warning)
    return data, changes_human(name, data)


def parse_changes(rest, ctx):
    if len(rest) < 2 or rest[1] not in CHANGES_SPEC:
        raise CliError("invalid_argument", "Expected changes " + "|".join(CHANGES_SPEC) + ".")
    name = rest[1]
    ctx["command"] = "changes " + name
    flags = CHANGES_SPEC[name].get("flags", [])
    opts, positional, args, index = {"paths": []}, [], rest[2:], 0
    while index < len(args):
        token = args[index]
        if token in flags:
            if index + 1 >= len(args):
                raise CliError("invalid_argument", f"{token} needs a value.")
            if token == "--path":
                opts["paths"].append(args[index + 1])
            elif token[2:] in opts:
                raise CliError("invalid_argument", f"{token} was given more than once.")
            else:
                opts[token[2:]] = args[index + 1]
            index += 2
            continue
        if token.startswith("-"):
            raise CliError("invalid_argument", f"Unsupported option for changes {name}: {token[:40]}")
        positional.append(token)
        index += 1
    if len(positional) != len(CHANGES_SPEC[name].get("arguments", [])):
        raise CliError("invalid_argument", f"Wrong number of arguments for changes {name}.\n" + USAGE)
    if positional:
        if not TASK_ID.match(positional[0]):
            raise CliError("invalid_argument", "TASK must be a lowercase task UUID from changes prepare.")
        opts["task"] = positional[0]
    if name == "prepare":
        if "product" not in opts:
            raise CliError("invalid_argument", "changes prepare requires --product.")
        opts["product"] = resolve_product(opts["product"])
        if len(opts["paths"]) > 200 or any(len(path) > 512 or "\0" in path for path in opts["paths"]):
            raise CliError("invalid_argument", "At most 200 --path values of up to 512 characters are allowed.")
    if name == "apply" and not HASH.match(opts.get("manifest-sha256", "")):
        raise CliError("invalid_argument", "changes apply requires --manifest-sha256 with the 64-hex hash from stage.")
    return opts


# ddistro agent: the ddistro_agent helper owns the runtime, sandbox, and attestation. status and
# probe are validated into the normal envelope; serve replaces this process with the helper.
AGENT_STATUS_KEYS = {"installed", "probe_passed", "provider", "version", "reason"}
AGENT_TOKEN = re.compile(r"^[a-z][a-z0-9_]{0,63}\Z")  # status reasons and probe check names


def agent_helper_trusted():
    try:
        check_helper(AGENT_HELPER)
        return True
    except CliError:
        return False


def agent_document(out, keys):
    if out.total > AGENT_STDOUT_LIMIT:
        raise CliError("helper_protocol", "ddistro_agent returned too much output.")
    try:
        doc = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant)
    except ValueError:
        doc = None
    if type(doc) is not dict or set(doc) != keys:
        raise CliError("helper_protocol", "ddistro_agent returned an unexpected result.")
    return doc


def agent_status():
    code, out, _ = run_helper(["status"], AGENT_STATUS_TIMEOUT, AGENT_STDOUT_LIMIT + 1, helper=AGENT_HELPER)
    doc = agent_document(out, AGENT_STATUS_KEYS)
    valid = (code == 0 and type(doc["installed"]) is bool and type(doc["probe_passed"]) is bool
             and (doc["installed"] or not doc["probe_passed"]) and doc["provider"] == "codex"
             and (doc["version"] is None or type(doc["version"]) is str and len(doc["version"]) <= 64)
             and type(doc["reason"]) is str and AGENT_TOKEN.match(doc["reason"]))
    if not valid:
        raise CliError("helper_protocol", "ddistro_agent returned an unexpected status.", {"helper_exit": code})
    return doc


def agent_human(data):
    return f"{data['provider']} {data['version'] or '-'}: {data['reason']}"


def cmd_agent_status(opts, ctx):
    data = agent_status()
    return data, agent_human(data)


def probe_diagnostics(value):
    """Bounded per-step exit status and redacted stderr lines; anything else is dropped."""
    steps = {}
    for name, step in list(value.items())[:8] if type(value) is dict else []:
        if not AGENT_TOKEN.match(name) or type(step) is not dict:
            continue
        clean = {}
        if type(step.get("exit")) is int:
            clean["exit"] = step["exit"]
        for key in ("failure", "error"):
            if type(step.get(key)) is str:
                clean[key] = clean_line(step[key][:64])
        lines = step.get("stderr")
        if type(lines) is list:
            clean["stderr"] = [clean_line(line[:300]) for line in lines[:20] if type(line) is str]
        steps[name] = clean
    return steps


def cmd_agent_probe(opts, ctx):
    if os.geteuid() != 0:
        raise CliError("permission_denied", "agent probe must run as root. ddistro never elevates by itself.")
    ctx["operation_id"] = str(uuid.uuid4())
    code, out, _ = run_helper(["probe"], AGENT_PROBE_TIMEOUT, AGENT_STDOUT_LIMIT + 1, helper=AGENT_HELPER)
    doc = agent_document(out, {"passed", "checks", "diagnostics"})
    checks = doc["checks"]
    if type(checks) is not dict or len(checks) > 64 or not all(
            type(name) is str and AGENT_TOKEN.match(name) and type(value) is bool for name, value in checks.items()):
        raise CliError("helper_protocol", "ddistro_agent returned malformed probe checks.", {"helper_exit": code})
    if code == 75:
        raise CliError("busy", "An assistant session is running. Stop it before running the isolation check.")
    if type(doc["passed"]) is not bool or code != (0 if doc["passed"] else 1) or doc["passed"] != (
            bool(checks) and all(checks.values())):
        raise CliError("helper_protocol", "ddistro_agent returned an inconsistent probe result.", {"helper_exit": code})
    # Failed checks first, so a short list still shows what is wrong.
    rows = sorted(({"name": name, "passed": value} for name, value in checks.items()), key=lambda row: row["passed"])
    data = {"passed": doc["passed"], "checks": rows, "diagnostics": probe_diagnostics(doc["diagnostics"])}
    data.update(agent_status())
    human = "\n".join([("Isolation check passed." if data["passed"] else "Isolation check failed.") + " " + agent_human(data)]
                      + [f"  {'ok  ' if row['passed'] else 'FAIL'} {row['name']}" for row in rows])
    return data, human


def serve_refusal(error, reason, exit_code):
    """agent serve owns stdout for JSONL, so its own refusals are one JSON line on stderr only."""
    try:
        sys.stderr.write(json.dumps({"error": error, "reason": reason}) + "\n")
        sys.stderr.flush()
    except OSError:
        pass
    return exit_code


def agent_serve(args):
    """Exactly agent serve --task TASK: validated here, then this process becomes the root helper."""
    if len(args) != 2 or args[0] != "--task" or not TASK_ID.match(args[1]):
        return serve_refusal("invalid_argument", "usage: agent serve --task TASK (no other options)", 64)
    if os.geteuid() != 0:
        return serve_refusal("assistant_unavailable", "requires_root", 3)
    try:
        check_helper(AGENT_HELPER)
        os.chdir("/")
        os.execve(AGENT_HELPER, [AGENT_HELPER, "serve", "--task", args[1]],
                  {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"})
    except CliError:
        return serve_refusal("assistant_unavailable", "helper_unavailable", 3)
    except OSError:
        return serve_refusal("assistant_unavailable", "helper_unavailable", 3)


# ddistro models herika: the CHIM connector assigned to each role of each configured profile,
# read-only from the local dwemer database as the postgres superuser over the Unix socket.
# Only fixed, explicitly public-qualified SQL built from the constants below ever runs; there
# are no SQL, schema, or database arguments, no PHP, and no secret-bearing columns are read.
MODELS_RUNUSER = "/usr/sbin/runuser"
MODELS_PSQL = "/usr/bin/psql"
MODELS_SOCKET = "/var/run/postgresql"
MODELS_DATABASE = "dwemer"
MODELS_TIMEOUT = 30
MODELS_MAX = 200
MODELS_STRING_CHARS = 256
MODELS_FIELD_CHARS = 512  # clipped in SQL, before redaction and the final 256-character bound
MODELS_STDOUT_LIMIT = 4 * 1024 * 1024
# (role, core_profiles field), in HerikaServer's order; roles whose field is missing are skipped.
MODELS_ROLES = (("standard", "llm_primary_id"), ("fast", "llm_secondary_id"), ("powerful", "llm_tertiary_id"),
                ("experimental", "llm_quaternary_id"), ("formatter", "llm_formatter_id"),
                ("fallback", "llm_fallback_id"), ("diary", "diary_connector_id"))
MODELS_REQUIRED = {"core_profiles.id", "core_profiles.label", "core_llm_connector.id", "core_llm_connector.label",
                   "core_llm_connector.model", "core_llm_connector.provider", "core_llm_connector.driver"}
MODELS_COLUMNS = MODELS_REQUIRED | {"core_profiles." + field for _, field in MODELS_ROLES}


def check_system_binary(path):
    """check_helper, also accepting one root-owned symlink hop (Debian's psql links to pg_wrapper)."""
    try:
        info = os.lstat(path)
    except OSError:
        info = None
    if info is not None and stat.S_ISLNK(info.st_mode):
        parent = os.stat(os.path.dirname(path))
        if info.st_uid != HELPER_OWNER_UID or parent.st_uid != HELPER_OWNER_UID or parent.st_mode & 0o022:
            raise CliError("helper_unavailable", "untrusted link", {"helper": path, "reason": "untrusted"})
        path = os.path.normpath(os.path.join(os.path.dirname(path), os.readlink(path)))
    check_helper(path)


def models_psql(sql, keep):
    """Run one fixed read-only query; returns (exit code, stdout bytes). stderr is never returned."""
    port = os.environ.get("DDISTRO_POSTGRES_PORT", "")
    port = port if re.match(r"^[0-9]{1,5}\Z", port) and 0 < int(port) < 65536 else "5432"
    env = {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PGCONNECT_TIMEOUT": "5",
           "PGAPPNAME": "ddistro-models", "PGTZ": "UTC",
           "PGOPTIONS": "-c default_transaction_read_only=on -c statement_timeout=10000 -c lock_timeout=2000 "
                        "-c idle_in_transaction_session_timeout=10000 -c search_path=pg_catalog"}
    args = ["-u", "postgres", "--", MODELS_PSQL, "-X", "-A", "-t", "-q", "--no-password", "-v", "ON_ERROR_STOP=1",
            "-h", MODELS_SOCKET, "-p", port, "-d", MODELS_DATABASE, "-1",
            "-c", "SET TRANSACTION READ ONLY", "-c", sql]
    code, out, _ = run_helper(args, MODELS_TIMEOUT, keep + 1, helper=MODELS_RUNUSER, env=env)
    if code == 0 and out.total > keep:
        raise CliError("helper_protocol", "output too large", {"reason": "unexpected_output"})
    return code, bytes(out.data)


def models_columns():
    names = ", ".join(f"'{name.split('.')[1]}'" for name in sorted(MODELS_COLUMNS))
    code, raw = models_psql("SELECT table_name || '.' || column_name FROM information_schema.columns "
                            "WHERE table_schema = 'public' AND table_name IN ('core_profiles', 'core_llm_connector') "
                            f"AND column_name IN ({names})", 64 * 1024)
    if code != 0:
        return code, None
    # Intersected with the allowlist, so only our own constants are ever put into SQL.
    return 0, MODELS_COLUMNS & set(raw.decode("utf-8", "replace").split("\n"))


def models_text(value):
    if value is None:
        return ""
    # clean_line keeps tabs and newlines (log rows are already split); one-line values here.
    return clean_line(re.sub(r"[\t\r\n]", " ", value[:MODELS_FIELD_CHARS]))[:MODELS_STRING_CHARS]


def models_rows(raw, roles):
    rows = []
    for line in raw.decode("utf-8").split("\n"):
        if not line:
            continue
        row = json.loads(line, parse_constant=reject_constant)
        if type(row) is not list or len(row) != 8 or type(row[0]) is not int or type(row[3]) is not int \
                or row[2] not in roles or any(row[i] is not None and type(row[i]) is not str for i in (1, 4, 5, 6, 7)):
            raise ValueError("row")
        rows.append({"profile_id": row[0], "profile": models_text(row[1]), "role": row[2], "connector_id": row[3],
                     "connector": models_text(row[4]), "model": models_text(row[5]),
                     "provider": models_text(row[6]), "driver": models_text(row[7])})
    return rows


def models_query():
    """Returns (assignments, truncated, reason); reason is empty only when the read succeeded."""
    if os.geteuid() != 0:
        return [], False, "requires_root"
    try:
        check_system_binary(MODELS_PSQL)
        pwd.getpwnam("postgres")
    except (CliError, KeyError, OSError):
        return [], False, "helper_unavailable"
    try:
        code, columns = models_columns()
        if code == 0 and not MODELS_REQUIRED <= columns:
            return [], False, "schema_missing"
        roles = [(order, role, field) for order, (role, field) in enumerate(MODELS_ROLES)
                 if "core_profiles." + field in (columns or ())]
        if code == 0 and not roles:
            return [], False, "schema_missing"
        if code == 0:
            values = ", ".join(f"({order}, '{role}', p.{field})" for order, role, field in roles)
            text = ", ".join(f"left({column}::text, {MODELS_FIELD_CHARS})"
                             for column in ("c.label", "c.model", "c.provider", "c.driver"))
            code, raw = models_psql(
                f"SELECT json_build_array(p.id, left(p.label::text, {MODELS_FIELD_CHARS}), r.role, c.id, {text}) "
                f"FROM public.core_profiles AS p CROSS JOIN LATERAL (VALUES {values}) AS r(ord, role, connector_id) "
                "JOIN public.core_llm_connector AS c ON c.id = r.connector_id "
                f"ORDER BY p.id, r.ord LIMIT {MODELS_MAX + 1}", MODELS_STDOUT_LIMIT)
    except CliError as error:
        if error.code == "cancelled":
            raise
        return [], False, {"timeout": "timeout", "helper_protocol": "unexpected_output"}.get(
            error.code, "helper_unavailable")
    if code != 0:
        # psql exits 2 when it cannot connect (server down, database missing); other failures are generic.
        return [], False, "database_unavailable" if code == 2 else "query_failed"
    try:
        rows = models_rows(raw, {role for _, role, _ in roles})
    except ValueError:
        return [], False, "unexpected_output"
    return rows[:MODELS_MAX], len(rows) > MODELS_MAX, ""


def cmd_models(opts, ctx):
    product = opts["product"]
    if product != "herika":
        raise CliError("unsupported", "ddistro models currently supports only herika (chim, skyrim).",
                       {"product": product})
    captured_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    assignments, truncated, reason = models_query()
    data = {"product": product, "available": not reason, "scope": "configured_profiles", "captured_at": captured_at,
            "assignments": assignments, "truncated": truncated, "reason": reason}
    if reason:
        return data, f"herika model assignments unavailable: {reason}"
    lines = ["Configured CHIM profile model assignments (not necessarily the active NPC profile):"]
    lines += [f"  {a['profile_id']:>4} {a['profile'] or '-':<24} {a['role']:<12} {a['model'] or '-'} "
              f"({a['provider'] or '-'}/{a['driver'] or '-'}, connector {a['connector_id']} {a['connector'] or '-'})"
              for a in assignments] or ["  (none)"]
    if truncated:
        lines.append(f"  ... truncated to {MODELS_MAX} assignments")
    return data, "\n".join(lines)


# ddistro inventory: one fresh, read-only snapshot of what is installed, for the launcher's assistant.
# It only reports presence: no repository or plugin code runs, no file content is read, no link is
# followed, and nothing says whether an extension is enabled or healthy or a component is running.
INVENTORY_STATUS_TIMEOUT = 20
INVENTORY_MODS_TIMEOUT = 10
INVENTORY_MODS_HELPER = "/usr/local/bin/ddistro_custom_mod"
INVENTORY_MODS_STDOUT_LIMIT = 1024 * 1024
INVENTORY_MAX_ENTRIES = 200  # per extension folder, sorted by name
INVENTORY_SCAN_LIMIT = 4096  # directory entries examined per folder before giving up
INVENTORY_MAX_MODS = 100
INVENTORY_STRING_CHARS = 128
# Products whose repositories load add-ons from an ext/ folder; the others have no known root.
INVENTORY_EXTENSION_ROOTS = {"herika": "/var/www/html/HerikaServer", "dialectic": "/var/www/html/DialecticServer"}
# The startup markers start_env and update_gws check, in that order. "all" markers must all be
# present, "any" needs one. A marker present means startup would try the component, not that it runs.
INVENTORY_COMPONENTS = (
    ("dashboard", "Dwemer Dashboard", "dashboard", "all", ("/var/www/html/Dwemer-Dashboard/.git",)),
    ("minime_t5", "Minime-T5 / TXT2VEC", "embeddings", "all", ("/home/dwemer/minime-t5/start.sh",)),
    ("mimic3", "Mimic3", "tts", "all", ("/home/dwemer/mimic3/start.sh",)),
    ("melotts", "MeloTTS", "tts", "all", ("/home/dwemer/MeloTTS/start.sh",)),
    ("parakeet", "Parakeet", "stt", "all", ("/home/dwemer/parakeet-api-server/start.sh",)),
    ("chatterbox", "Chatterbox", "tts", "all", ("/home/dwemer/chatterbox/start.sh",)),
    ("pockettts_audiocpp", "PocketTTS (audio.cpp)", "tts", "all", ("/home/dwemer/audio.cpp/start.sh",)),
    ("pocket_tts", "pocket-tts", "tts", "all", ("/home/dwemer/pocket-tts/start.sh",)),
    ("piper", "Piper TTS", "tts", "all", ("/home/dwemer/piper/cuda-keyring_1.1-1_all.deb",
                                         "/home/dwemer/piper/start.sh")),
    ("localwhisper", "LocalWhisper", "stt", "all", ("/home/dwemer/remote-faster-whisper/start.sh",)),
    ("xtts", "CHIM XTTS", "tts", "all", ("/home/dwemer/xtts-api-server/start.sh",)),
    ("higgs", "Higgs TTS", "tts", "all", ("/home/dwemer/higgs-tts/service.sh",)),
    ("omnivoice", "OmniVoice TTS", "tts", "all", ("/home/dwemer/omnivoice-tts/start-gpu.sh",)),
    ("chim_mcp", "CHIM MCP Server", "mcp", "any", ("/home/dwemer/CHIM-MCP/start.sh",
                                                   "/home/dwemer/chim-mcp-server/start.sh")),
)
INVENTORY_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._+()@,=~-]{0,127}\Z")
INVENTORY_MOD_ID = re.compile(r"^[a-z][a-z0-9-]{1,30}[a-z0-9]\Z")
INVENTORY_COMMIT = re.compile(r"^(?:[0-9a-f]{40})?\Z")
INVENTORY_DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
INVENTORY_ERRNO = {errno.ENOENT: "absent", errno.ELOOP: "redirected", errno.ENOTDIR: "not_directory",
                   errno.EACCES: "unreadable", errno.EPERM: "unreadable"}


def inventory_reason(error):
    if error.code == "cancelled":
        raise error
    return error.code if error.code in ("helper_unavailable", "helper_failed", "helper_protocol", "timeout") else "failed"


def inventory_step(fd, name):
    """Opens the folder name below fd without following a link; returns (fd, "") or (None, state).

    Linux may refuse a link opened with O_DIRECTORY|O_NOFOLLOW with ENOTDIR rather than ELOOP, so
    any failure other than a plain absence is classified by a no-follow stat of the same name under
    the same fd: a link is redirected, a non-folder is not_directory. Nothing is ever followed."""
    try:
        return os.open(name, INVENTORY_DIR_FLAGS, dir_fd=fd), ""
    except OSError as error:
        if error.errno in (errno.ENOENT, errno.ELOOP):
            return None, INVENTORY_ERRNO[error.errno]
        failure = error.errno
    try:
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
    except OSError as error:
        # It changed after the open failed, so it is not provably absent.
        return None, "unreadable" if error.errno == errno.ENOENT else INVENTORY_ERRNO.get(error.errno, "unreadable")
    if stat.S_ISLNK(info.st_mode):
        return None, "redirected"
    if not stat.S_ISDIR(info.st_mode):
        return None, "not_directory"
    return None, INVENTORY_ERRNO.get(failure, "unreadable") if failure in (errno.EACCES, errno.EPERM) else "unreadable"


def inventory_open_dir(path):
    """Opens a fixed absolute folder from / one name at a time, refusing a link at every step.

    Returns (fd, "") or (None, state) for the first name that could not be opened."""
    fd = os.open("/", INVENTORY_DIR_FLAGS)
    for name in path.strip("/").split("/"):
        next_fd, state = inventory_step(fd, name)
        os.close(fd)
        if next_fd is None:
            return None, state
        fd = next_fd
    return fd, ""


def inventory_marker(path):
    parent, name = path.rsplit("/", 1)
    try:
        fd, state = inventory_open_dir(parent)
        if fd is None:
            # A plain file where a folder should be means the marker cannot exist; a link stays redirected.
            return "absent" if state == "not_directory" else state
        try:
            info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        finally:
            os.close(fd)
    except OSError as error:
        return INVENTORY_ERRNO.get(error.errno, "unreadable")
    if stat.S_ISLNK(info.st_mode):
        return "redirected"
    return "present" if stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode) else "unreadable"


def inventory_component(component_id, name, role, mode, markers):
    states = [inventory_marker(path) for path in markers]
    if (all if mode == "all" else any)(state == "present" for state in states):
        state = "present"
    else:
        state = next((s for s in states if s not in ("present", "absent")), "absent")
    return {"id": component_id, "name": name, "role": role, "state": state}


def inventory_extensions(product, root):
    """Names of the entries directly in <root>/ext, never followed or opened; links are reported as links."""
    result = {"product": product, "root": "ext", "state": "listed", "total": 0, "truncated": False, "skipped": 0,
              "entries": []}
    try:
        root_fd, state = inventory_open_dir(root)
        if root_fd is None:
            result["state"] = "product_absent" if state == "absent" else state
            return result
        try:
            ext_fd, state = inventory_step(root_fd, "ext")
        finally:
            os.close(root_fd)
    except OSError as error:
        ext_fd, state = None, INVENTORY_ERRNO.get(error.errno, "unreadable")
    if ext_fd is None:
        result["state"] = state
        return result
    entries = []
    try:
        with os.scandir(ext_fd) as scan:
            for entry in scan:
                result["total"] += 1
                if result["total"] > INVENTORY_SCAN_LIMIT:
                    result["total"], result["truncated"] = INVENTORY_SCAN_LIMIT, True
                    break
                if not INVENTORY_NAME.match(entry.name) or redact(entry.name) != entry.name:
                    result["skipped"] += 1
                    continue
                kind = ("link" if entry.is_symlink() else "dir" if entry.is_dir(follow_symlinks=False)
                        else "file" if entry.is_file(follow_symlinks=False) else "other")
                entries.append({"name": entry.name, "kind": kind})
    except OSError as error:
        return dict(result, state=INVENTORY_ERRNO.get(error.errno, "unreadable"), total=0, skipped=0)
    finally:
        os.close(ext_fd)
    entries.sort(key=lambda item: (item["name"].lower(), item["name"]))
    result["truncated"] = result["truncated"] or len(entries) > INVENTORY_MAX_ENTRIES
    result["entries"] = entries[:INVENTORY_MAX_ENTRIES]
    return result


def inventory_text(value, limit=INVENTORY_STRING_CHARS):
    return clean_line(re.sub(r"[\t\r\n]", " ", value[:limit * 2]))[:limit] if type(value) is str else ""


def inventory_custom_mods():
    """Registry entries from ddistro_custom_mod status (no health check, no network); a few fields only."""
    section = {"available": False, "reason": "", "truncated": False, "items": []}
    try:
        code, out, _ = run_helper(["status", "--json"], INVENTORY_MODS_TIMEOUT, INVENTORY_MODS_STDOUT_LIMIT + 1,
                                  helper=INVENTORY_MODS_HELPER)
    except CliError as error:
        section["reason"] = inventory_reason(error)
        return section
    if code != 0:
        section["reason"] = "helper_failed"
        return section
    try:
        if out.total > INVENTORY_MODS_STDOUT_LIMIT:
            raise ValueError("size")
        doc = json.loads(bytes(out.data).decode("utf-8"), parse_constant=reject_constant)
        if type(doc) is not dict or doc.get("schema_version") != 1 or type(doc.get("mods")) is not list:
            raise ValueError("shape")
        items = []
        for mod in doc["mods"]:
            if type(mod) is not dict or type(mod.get("id")) is not str or not INVENTORY_MOD_ID.match(mod["id"]):
                raise ValueError("mod")
            state, commit = mod.get("state"), mod.get("commit", "")
            items.append({"id": mod["id"], "name": inventory_text(mod.get("name")),
                          "state": state if type(state) is str and STATE_TOKEN.match(state) else "unknown",
                          "branch": inventory_text(mod.get("branch")),
                          "commit": commit if type(commit) is str and INVENTORY_COMMIT.match(commit) else ""})
    except (ValueError, UnicodeDecodeError):
        section["reason"] = "helper_protocol"
        return section
    section.update(available=True, truncated=len(items) > INVENTORY_MAX_MODS, items=items[:INVENTORY_MAX_MODS])
    return section


def cmd_inventory(opts, ctx):
    captured_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    servers = {"available": False, "reason": "", "items": []}
    try:
        records = helper_status(timeout=INVENTORY_STATUS_TIMEOUT)
        servers.update(available=True, items=[
            {"product": r["product"], "state": r["state"], "repository_state": r["repository_state"],
             "database_present": r["database_present"], "branch": inventory_text(r["branch"]),
             "version": inventory_text(r["version"])} for r in records])
    except CliError as error:
        servers["reason"] = inventory_reason(error)
    extensions = {"items": [inventory_extensions(product, root) for product, root in INVENTORY_EXTENSION_ROOTS.items()],
                  "no_known_root": [product for product in PRODUCTS if product not in INVENTORY_EXTENSION_ROOTS]}
    components = {"basis": "startup_markers", "items": [inventory_component(*c) for c in INVENTORY_COMPONENTS]}
    custom_mods = inventory_custom_mods()
    complete = (servers["available"] and custom_mods["available"] and not custom_mods["truncated"]
                and all(item["state"] in ("listed", "absent", "product_absent") and not item["truncated"]
                        and not item["skipped"] for item in extensions["items"])
                and all(item["state"] in ("present", "absent") for item in components["items"]))
    data = {"captured_at": captured_at, "scope": "presence_only", "read_as": current_user(), "complete": complete,
            "servers": servers, "extensions": extensions, "components": components, "custom_mods": custom_mods}
    lines = [f"DwemerDistro inventory at {captured_at} (presence only; not enabled, running, or healthy state)"]
    lines += ["Servers:"] + ([f"  {r['product']:<10} {r['state']:<15} branch={r['branch'] or '-'} "
                             f"version={r['version'] or '-'} database={DATABASE_WORDS[r['database_present']]}"
                             for r in servers["items"]] or [f"  unavailable: {servers['reason']}"])
    for item in extensions["items"]:
        names = ", ".join(e["name"] + ("/" if e["kind"] == "dir" else "") for e in item["entries"]) or "-"
        lines.append(f"{item['product']} ext ({item['state']}{', truncated' if item['truncated'] else ''}"
                     f"{', %d names skipped' % item['skipped'] if item['skipped'] else ''}): {names}")
    lines.append("Components: " + ", ".join(f"{c['id']}={c['state']}" for c in components["items"]))
    lines.append("Custom mods: " + (", ".join(f"{m['id']} ({m['state']})" for m in custom_mods["items"]) or "-")
                 if custom_mods["available"] else f"Custom mods: unavailable: {custom_mods['reason']}")
    return data, "\n".join(lines)


# ddistro health: bounded local checks with fresh evidence. A check is passed, failed, or skipped (with a
# reason); there is no overall verdict, nothing is repaired, and no provider or in-game path is exercised.
HEALTH_STATUS_TIMEOUT = 30
HEALTH_CONNECT_TIMEOUT = 1.5
HEALTH_SERVICES_CONF = "/etc/dwemerdistro_services.conf"
HEALTH_DISK_MIN_BYTES = 2 * 1024 ** 3
HEALTH_READ_LIMIT = 4096
# Component -> (services.conf key or None, default port, per-component port file); defaults as in ddistro_doctor.
HEALTH_COMPONENT_PORTS = {
    "xtts": ("XTTS_PORT", 8020, None),
    "omnivoice": ("OMNIVOICE_PORT", 8021, None),
    "parakeet": ("PARAKEET_PORT", 8022, None),
    "chatterbox": (None, 8020, "/home/dwemer/chatterbox/.dwemerdistro-port"),
    "pocket_tts": (None, 8020, "/home/dwemer/pocket-tts/.dwemerdistro-port"),
    "pockettts_audiocpp": ("POCKETTTS_AUDIOCPP_PORT", 8086, None),
}
HEALTH_SCOPE_LIMITS = [
    "A port check proves only that something accepts TCP on 127.0.0.1, not which service or that it answers correctly.",
    "Database checks report presence as seen by ddistro_server status; tables, credentials, and queries are not checked.",
    "Components without a known local port are skipped; marker presence alone is never reported as passed.",
    "No external provider, model, network, or in-game path is tested, and nothing is repaired.",
]


def health_port_value(text):
    text = text.strip().strip("\"'")
    return int(text) if re.match(r"^[0-9]{1,5}\Z", text) and 0 < int(text) < 65536 else None


def health_owners(dwemer):
    """Accounts trusted to own a health config file and its folders: root, plus dwemer for its own files."""
    try:
        return (0, pwd.getpwnam("dwemer").pw_uid) if dwemer else (0,)
    except KeyError:
        return (0,)


def health_read_small(path, owners):
    """Up to HEALTH_READ_LIMIT bytes of a fixed small config file; None when absent, unsafe, or too large.

    The path is walked from / one name at a time without following a link (as inventory does); "/", every
    folder, and the file must be owned by one of owners and not group/other writable. The file must be a
    regular file before and after a non-blocking open, so a FIFO, device, or swapped name never blocks or
    redirects the read."""
    parent, name = path.rsplit("/", 1)
    file_flags = (os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NOCTTY", 0)
                  | getattr(os, "O_CLOEXEC", 0))

    def trusted(info):
        return info.st_uid in owners and not info.st_mode & 0o022
    fd = fd_file = None
    try:
        fd = os.open("/", INVENTORY_DIR_FLAGS)
        for part in [p for p in parent.split("/") if p]:
            if not trusted(os.fstat(fd)):
                return None
            next_fd = os.open(part, INVENTORY_DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        if not trusted(os.fstat(fd)):
            return None
        before = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if not stat.S_ISREG(before.st_mode) or before.st_size > HEALTH_READ_LIMIT:
            return None
        fd_file = os.open(name, file_flags, dir_fd=fd)
        info = os.fstat(fd_file)
        if ((info.st_dev, info.st_ino) != (before.st_dev, before.st_ino) or not stat.S_ISREG(info.st_mode)
                or info.st_size > HEALTH_READ_LIMIT or not trusted(info)):
            return None
        data = os.read(fd_file, HEALTH_READ_LIMIT + 1)
        return None if len(data) > HEALTH_READ_LIMIT else data.decode("utf-8", "replace")
    except OSError:
        return None
    finally:
        for handle in (fd_file, fd):
            if handle is not None:
                os.close(handle)


def health_services_conf():
    """Plain NAME=port lines of a root-owned services.conf; it is never sourced."""
    text = health_read_small(HEALTH_SERVICES_CONF, health_owners(False)) or ""
    return {match.group(1): port for match in re.finditer(r"(?m)^\s*([A-Z_]{1,40})=(\S+)\s*$", text)
            if (port := health_port_value(match.group(2)))}


def health_connect(port):
    started = time.monotonic()
    try:
        socket.create_connection(("127.0.0.1", port), timeout=HEALTH_CONNECT_TIMEOUT).close()
        return True, f"tcp 127.0.0.1:{port} accepted in {int((time.monotonic() - started) * 1000)} ms"
    except OSError as error:
        return False, f"tcp 127.0.0.1:{port} {errno.errorcode.get(error.errno, 'timeout') if error.errno else 'timeout'}"


def cmd_health(opts, ctx):
    product = opts.get("product")
    captured_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    checks = []

    def add(check_id, component, result, evidence, reason=None):
        checks.append({"id": check_id, "component": component, "result": result, "evidence": evidence,
                       "reason": reason, "captured_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())})

    def port_check(check_id, component, port, source):
        passed, evidence = health_connect(port)
        add(check_id, component, "passed" if passed else "failed", f"{evidence} (port from {source})")

    try:
        records = helper_status(product, timeout=HEALTH_STATUS_TIMEOUT)
    except CliError as error:
        if error.code == "cancelled":
            raise
        records = None
        add("servers.status", "ddistro_server", "failed", "ddistro_server status: " + error.code)
    for record in records or []:
        name, state = record["product"], record["state"]
        if state == "not-installed":
            add(f"server.{name}.installed", name, "skipped", "state not-installed", "not installed")
            continue
        add(f"server.{name}.installed", name, "passed" if state == "installed" else "failed",
            f"state {state}, repository {record['repository_state']}")
        port_check(f"server.{name}.port", name, record["port"], "ddistro_server status")
        present = record["database_present"]
        add(f"server.{name}.database", name, {True: "passed", False: "failed", None: "skipped"}[present],
            f"database {DATABASE_WORDS[present]}", None if present is not None else "PostgreSQL not ready for status")
    pg_port = health_port_value(os.environ.get("DDISTRO_POSTGRES_PORT", "")) or 5432
    port_check("postgres.port", "postgres", pg_port, "DDISTRO_POSTGRES_PORT" if pg_port != 5432 else "default")
    if product is None:
        conf = health_services_conf()
        for component_id, name, role, mode, markers in INVENTORY_COMPONENTS:
            state = inventory_component(component_id, name, role, mode, markers)["state"]
            if state != "present":
                add(f"component.{component_id}.port", component_id, "skipped", f"startup marker {state}",
                    "not installed" if state == "absent" else "marker could not be checked")
                continue
            if component_id not in HEALTH_COMPONENT_PORTS:
                add(f"component.{component_id}.port", component_id, "skipped", "startup marker present",
                    "no known local port contract")
                continue
            key, port, port_file = HEALTH_COMPONENT_PORTS[component_id]
            source = "default"
            if key and key in conf:
                port, source = conf[key], HEALTH_SERVICES_CONF
            saved = health_port_value(health_read_small(port_file, health_owners(True)) or "") if port_file else None
            if saved:
                port, source = saved, port_file
            port_check(f"component.{component_id}.port", component_id, port, source)
    for path in ("/", "/var/lib/postgresql", "/home/dwemer"):
        try:
            usage = shutil.disk_usage(path)
        except OSError:
            add(f"disk.{path}", "disk", "skipped", path + " not present", "path absent or unreadable")
            continue
        low = usage.free < HEALTH_DISK_MIN_BYTES or usage.free * 20 < usage.total
        add(f"disk.{path}", "disk", "failed" if low else "passed",
            f"{usage.free // 1024 ** 2} MiB free of {usage.total // 1024 ** 2} MiB (minimum 2048 MiB and 5%)")
    summary = {result: sum(c["result"] == result for c in checks) for result in ("passed", "failed", "skipped")}
    data = {"captured_at": captured_at, "scope": "local_bounded", "product": product,
            "read_as": current_user(), "summary": summary, "checks": checks, "scope_limits": HEALTH_SCOPE_LIMITS}
    lines = [f"DwemerDistro health at {data['captured_at']}: {summary['passed']} passed, {summary['failed']} failed, "
             f"{summary['skipped']} skipped (local checks only)"]
    lines += [f"  {c['result']:<7} {c['id']:<32} {c['evidence']}" + (f" ({c['reason']})" if c["reason"] else "")
              for c in checks]
    return data, "\n".join(lines)


def command_words(argv):
    """The first two command tokens, skipping the global flags wherever they appear first."""
    words, index = [], 0
    while index < len(argv) and len(words) < 2:
        if argv[index] == "--request-id":
            index += 2
            continue
        if argv[index] != "--json":
            words.append(argv[index])
        index += 1
    return words


COMMANDS = {"version": cmd_version, "capabilities": cmd_capabilities, "products": cmd_products,
            "status": cmd_status, "logs": cmd_logs, "server status": cmd_server_status,
            "server update": cmd_server_update, "agent status": cmd_agent_status, "agent probe": cmd_agent_probe,
            "models": cmd_models, "inventory": cmd_inventory, "health": cmd_health}
COMMANDS.update({"changes " + name: cmd_changes for name in CHANGES_SPEC})


# --- Arguments and output -------------------------------------------------------------

def parse_globals(argv, ctx):
    rest, index = [], 0
    while index < len(argv):
        token = argv[index]
        if token == "--json":
            ctx["json"] = True
        elif token == "--request-id":
            if ctx["request_id_given"] or index + 1 >= len(argv) or not REQUEST_ID.match(argv[index + 1]):
                raise CliError("invalid_argument", "--request-id needs one value of up to 64 letters, digits, ._:-")
            ctx["request_id"], ctx["request_id_given"] = argv[index + 1], True
            index += 1
        else:
            rest.append(token)
        index += 1
    return rest


def parse_command(rest, ctx):
    if not rest or rest[0] in ("-h", "--help", "help"):
        ctx["command"] = "help"
        if not rest:
            raise CliError("invalid_argument", "A command is required.\n" + USAGE)
        return {}
    name = rest[0]
    if name == "changes":
        return parse_changes(rest, ctx)
    if name == "server":
        if len(rest) < 2 or rest[1] not in ("status", "update"):
            raise CliError("invalid_argument", "Expected server status or server update.")
        name, rest = "server " + rest[1], rest[1:]
    elif name == "agent":
        if len(rest) < 2 or rest[1] not in ("status", "probe"):
            raise CliError("invalid_argument", "Expected agent status, agent probe, or agent serve --task TASK.")
        name, rest = "agent " + rest[1], rest[1:]
    if name not in COMMANDS:
        raise CliError("invalid_argument", "Unknown command.\n" + USAGE)
    ctx["command"] = name
    valued = {"logs": ("--log", "--lines"), "server update": ("--branch",)}.get(name, ())
    switches = ("--force",) if name == "server update" else ()
    opts, positional, index, args = {}, [], 0, rest[1:]
    while index < len(args):
        token = args[index]
        if token in valued:
            if index + 1 >= len(args):
                raise CliError("invalid_argument", f"{token} needs a value.")
            if token[2:] in opts:
                raise CliError("invalid_argument", f"{token} was given more than once.")
            opts[token[2:]] = args[index + 1]
            index += 1
        elif token in switches:
            opts["force"] = True
        elif token.startswith("-"):
            raise CliError("invalid_argument", f"Unsupported option for {name}: {token[:40]}")
        else:
            positional.append(token)
        index += 1
    required = {"logs": 1, "server update": 1, "models": 1}.get(name, 0)
    allowed = 1 if name in ("status", "health", "server status", "logs", "server update", "models") else 0
    if not required <= len(positional) <= allowed:
        raise CliError("invalid_argument", f"Wrong number of arguments for {name}.\n" + USAGE)
    if name == "logs":
        opts["target"] = resolve_product(positional[0], ("apache", "postgres"))
        if "lines" in opts:
            if not re.match(r"^[0-9]{1,4}\Z", opts["lines"]) or not 1 <= int(opts["lines"]) <= MAX_LOG_LINES:
                raise CliError("invalid_argument", f"--lines must be between 1 and {MAX_LOG_LINES}.")
            opts["lines"] = int(opts["lines"])
    elif positional:
        opts["product"] = resolve_product(positional[0])
    return opts


def emit(ctx, data=None, human="", error=None):
    if ctx["json"]:
        document = {"schema_version": SCHEMA_VERSION, "ok": error is None, "command": ctx["command"],
                    "request_id": ctx["request_id"], "tool": TOOL, "data": data, "error": error,
                    "warnings": ctx["warnings"]}
        if ctx.get("operation_id"):
            document["operation_id"] = ctx["operation_id"]
        sys.stdout.write(json.dumps(document, ensure_ascii=True) + "\n")
        sys.stdout.flush()
        return
    if error is None:
        if human:
            print(human, flush=True)
    else:
        print("[FAIL] " + error["message"], file=sys.stderr)
        blocker = error["details"].get("blocker") or {}
        for path in blocker.get("files", []):
            print("  " + path, file=sys.stderr)
    for warning in ctx["warnings"]:
        print("[WARN] " + warning, file=sys.stderr)


def raise_cancelled(signum, frame):
    raise Cancelled()


def main(argv):
    if command_words(argv) == ["agent", "serve"]:
        if argv[:2] != ["agent", "serve"]:
            return serve_refusal("invalid_argument", "agent serve takes no --json or --request-id", 64)
        return agent_serve(argv[2:])
    ctx = {"json": "--json" in argv, "command": None, "request_id": str(uuid.uuid4()),
           "request_id_given": False, "warnings": []}
    signal.signal(signal.SIGTERM, raise_cancelled)
    if hasattr(signal, "SIGHUP"):
        signal.signal(signal.SIGHUP, raise_cancelled)
    try:
        opts = parse_command(parse_globals(argv, ctx), ctx)
        if ctx["command"] == "help":
            emit(ctx, {"usage": USAGE}, USAGE)
            return 0
        data, human = COMMANDS[ctx["command"]](opts, ctx)
        emit(ctx, data, human)
        return 0
    except CliError as error:
        failure = error
    except (KeyboardInterrupt, Cancelled):
        failure = CliError("cancelled", "Cancelled.")
    except Exception:
        failure = CliError("internal_error", "ddistro hit an unexpected internal error.")
    exit_code = ERRORS[failure.code]
    try:
        emit(ctx, None, "", {"code": failure.code, "exit_code": exit_code, "message": redact(failure.message),
                             "details": failure.details})
    except BrokenPipeError:
        pass
    return exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
