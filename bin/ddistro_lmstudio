#!/usr/bin/python3
"""Restricted, per-user LM Studio control shared by the launcher and Dashboard."""
import fcntl
import errno
import hashlib
import hmac
import json
import math
import os
from pathlib import Path
import pwd
import re
import secrets
import selectors
import shutil
import stat
import struct
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = Path('/home/dwemer')
STATE = HOME / '.config/dwemerdistro/lmstudio'
LMS = HOME / '.lmstudio/bin/lms'
API = 'http://127.0.0.1:1234'
CATALOG = Path('/etc/dwemerdistro-lmstudio.json')
MUTATIONS = {'start', 'stop', 'restart', 'settings', 'download', 'import', 'load', 'unload', 'test', 'model-defaults', 'test-preset'}
IMPORTS = STATE / 'imports'
IMPORT_TARGET = STATE / 'import-target.json'
# Distinct language models that may stay loaded together, such as a dialogue model and a smaller decision model.
MAX_LOADED = 2
# Numbered slots (1..MAX_LOADED) map to exact loaded model keys and persist across polls and page reloads. They only
# organise loading here; inference clients still choose a model by its id.
SLOTS = STATE / 'slots.json'
# Byte sizes of fixed-width GGUF metadata value types (enum gguf_type in ggml's gguf.h).
GGUF_SIZES = {0: 1, 1: 1, 2: 2, 3: 2, 4: 4, 5: 4, 6: 4, 7: 1, 10: 8, 11: 8, 12: 8}
GGUF_UINT16, GGUF_STRING, GGUF_ARRAY = 2, 8, 9
# Metadata bounds. Real models, including 250k+ token vocabularies with merges, use a few tens of MB and
# well under a million strings; these stop a crafted file from allocating memory or holding the worker.
GGUF_KEY_BYTES, GGUF_METADATA_BYTES, GGUF_ITEMS, GGUF_SECONDS = 65535, 512 * 1024**2, 4 * 1024**2, 60
SDK_PYTHON = '/opt/dwemerdistro-lmstudio/bin/python'
# Only documented SDK load settings are accepted; omitted values keep engine defaults.
LOAD_NUMBERS = {'evalBatchSize': (1, 2048, int), 'seed': (0, 4294967295, int),
                'ropeFrequencyBase': (0, 10000000, float), 'ropeFrequencyScale': (0.01, 100, float)}
LOAD_BOOLEANS = {'flashAttention', 'offloadKVCacheToGpu', 'keepModelInMemory', 'tryMmap', 'gpuStrictVramCap'}
CACHE_TYPES = {'f32', 'f16', 'q8_0', 'q4_0', 'q4_1', 'iq4_nl', 'q5_0', 'q5_1'}
TEST_NUMBERS = {'temperature': (0, 1, float), 'max_output_tokens': (1, 4096, int),
                'top_p': (0, 1, float), 'top_k': (1, 1000, int), 'min_p': (0, 1, float),
                'repeat_penalty': (0.1, 2, float)}
# Hugging Face discovery: fixed public API, validated names, short cache and a request budget shared by all sessions.
HF = 'https://huggingface.co'
HF_REPO = re.compile(r'[A-Za-z0-9][\w.-]{0,95}/[\w.-]{1,96}', re.A)
HF_FILE = re.compile(r'[\w.+-]{1,200}\.gguf', re.I | re.A)
HF_SPLIT = re.compile(r'-\d{5}-of-\d{5}\.gguf$', re.I)
# Calibration data (an imatrix name without a quant) and multi-token prediction companions (mtp- prefix) share
# repositories with models.
HF_IMATRIX = re.compile(r'(?<![A-Za-z0-9])imatrix(?![A-Za-z0-9])', re.I)
HF_MTP = re.compile(r'mtp[-_.]', re.I)
HF_QUANT = re.compile(r'(?<![A-Za-z0-9])(I?Q\d_[A-Z0-9_]+?|TQ\d_\d|MXFP4|BF16|F16|F32)(?=[.-]|$)', re.I)
HF_CACHE, HF_CACHE_SECONDS, HF_BUDGET = STATE / 'hf-cache.json', 600, 30
# Browse filters map to fixed Hugging Face API values; HF parameter ranges include both ends.
HF_SIZES = {'': None, '0-4': 'max:4B', '4-9': 'min:4B,max:9B', '9-15': 'min:9B,max:15B', '15-35': 'min:15B,max:35B',
            '35-': 'min:35B'}
HF_TASKS = {'': None, 'text-generation': 'text-generation', 'image-text-to-text': 'image-text-to-text'}
HF_SORTS = {'trending': 'trendingScore', 'downloads': 'downloads', 'likes': 'likes', 'updated': 'lastModified',
            'newest': 'createdAt'}
HF_CURSOR = re.compile(r'[A-Za-z0-9+/=_-]{1,1500}', re.A)
HF_PAGE = 20
os.umask(0o077)


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default


def write_json(path, value):
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(value))
    temporary.replace(path)


def initialize():
    if os.getuid() != pwd.getpwnam('dwemer').pw_uid:
        raise ValueError('Run this helper as dwemer.')
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE, 0o700)
    try:
        with (STATE / 'access').open('x') as token:
            token.write(secrets.token_urlsafe(32))
    except FileExistsError:
        pass


def request(path, payload=None, timeout=3):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(API + path, data=data, headers={'Content-Type': 'application/json'})
    return urllib.request.urlopen(req, timeout=timeout)


def command(*arguments, timeout=300, job=None):
    output, last = '', 0
    # llmster refreshes lms during daemon startup. A concurrent exec can briefly return ETXTBSY.
    for attempt in range(30):
        try:
            # lms must never wait for an answer; a prompt fails or times out with its text visible.
            process = subprocess.Popen([str(LMS), *arguments], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                       stderr=subprocess.STDOUT, env={**os.environ, 'HOME': str(HOME),
                                       'PATH': '/usr/lib/wsl/lib:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'})
            break
        except OSError as error:
            if error.errno != errno.ETXTBSY or attempt == 29:
                raise
            time.sleep(.2)
    with process:
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            deadline = time.monotonic() + timeout
            while selector.get_map():
                if time.monotonic() > deadline:
                    process.kill()
                    tail = '\n'.join(output.splitlines()[-8:])
                    raise ValueError(f'lms {arguments[0]} did not finish within {timeout} seconds.' + (
                        '\nLast output:\n' + tail if tail else ''))
                for key, _ in selector.select(1):
                    chunk = os.read(key.fd, 8192)
                    if not chunk:
                        selector.unregister(key.fd)
                        continue
                    output = re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '', output + chunk.decode(errors='replace'))[-12000:]
                    if job is not None and time.monotonic() - last > 1:
                        progress(job, '\n'.join(output.splitlines()[-8:]))
                        last = time.monotonic()
        process.wait(timeout=5)
    if process.returncode:
        raise ValueError(output or 'LM Studio command failed.')
    return output.strip()


def resources():
    memory = dict(re.findall(r'^(MemAvailable|MemTotal):\s+(\d+)', Path('/proc/meminfo').read_text(), re.M))
    vram = 0
    try:
        result = subprocess.run(['/usr/lib/wsl/lib/nvidia-smi', '--query-gpu=memory.free',
                                 '--format=csv,noheader,nounits'], capture_output=True, text=True, timeout=3)
        vram = max([int(n) for n in result.stdout.split() if n.isdigit()] or [0]) * 1024**2
    except (OSError, subprocess.TimeoutExpired):
        pass
    return {'ramAvailable': int(memory.get('MemAvailable', 0)) * 1024,
            'ramTotal': int(memory.get('MemTotal', 0)) * 1024, 'vramFree': vram,
            'diskFree': shutil.disk_usage(STATE).free}


def model_changed():
    # Instance ids can repeat after a reload, so any load or unload turns every test and load report into history.
    for name in ('last-test.json', 'last-load.json'):
        (STATE / name).unlink(missing_ok=True)
    previous = read_json(STATE / 'model-state.json', {}).get('changedAt', 0)
    write_json(STATE / 'model-state.json', {'changedAt': max(time.time(), previous + .001)})


def slot_map(models):
    # Saved slots keep loaded models; a loaded model without one (an older helper, lms or the desktop app) takes the
    # lowest free slot. A model that is no longer loaded frees its slot.
    loaded = [m.get('key') for m in models if m.get('loaded_instances') and m.get('type') == 'llm']
    saved, slots = read_json(SLOTS, {}), {}
    saved = saved if isinstance(saved, dict) else {}
    for number in range(1, MAX_LOADED + 1):
        key = saved.get(str(number))
        if key in loaded and key not in slots.values():
            slots[str(number)] = key
    for key in loaded:
        free = next((str(n) for n in range(1, MAX_LOADED + 1) if str(n) not in slots), None)
        if key not in slots.values() and free:
            slots[free] = key
    return slots


def memlock_limit():
    # The engine's soft RLIMIT_MEMLOCK in bytes; None when unlimited or the engine is not running.
    for proc in Path('/proc').iterdir():
        try:
            if proc.name.isdigit() and proc.stat().st_uid == os.getuid() and (proc / 'comm').read_text().strip() == 'llmster':
                limit = re.search(r'^Max locked memory\s+(\S+)', (proc / 'limits').read_text(), re.M)
                return int(limit.group(1)) if limit and limit.group(1).isdigit() else None
        except OSError:
            continue
    return None


def status():
    models, running = [], False
    # Keep the stopped manager useful without waking the engine or treating cached models as loaded.
    try:
        inventory_cache = read_json(STATE / 'model-inventory.json', {})
        if not isinstance(inventory_cache, dict):
            inventory_cache = {}
    except (OSError, ValueError):
        inventory_cache = {}
    inventory = inventory_cache.get('models', [])
    if not isinstance(inventory, list) or any(not isinstance(model, dict) for model in inventory):
        inventory = []
    inventory = [{key: value for key, value in model.items() if key != 'loaded_instances'}
                 for model in inventory if model.get('type') == 'llm']
    inventory_updated = inventory_cache.get('updatedAt')
    if not isinstance(inventory_updated, (int, float)) or not math.isfinite(inventory_updated):
        inventory_updated = None
    changed = read_json(STATE / 'model-state.json', {}).get('changedAt')
    try:
        with request('/api/v1/models') as response:
            models = json.load(response)['models']
            running = True
    except (OSError, ValueError, KeyError):
        pass
    if running:
        inventory = [{key: value for key, value in model.items() if key != 'loaded_instances'}
                     for model in models if model.get('type') == 'llm']
    keys = {m.get('key') for m in models if m.get('loaded_instances')}
    instances = {i.get('id') for m in models for i in m.get('loaded_instances') or []}
    # A killed worker must not leave the UI waiting forever after a distro restart.
    with (STATE / 'job.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            # Status callers share the job lock so they cannot race the atomic cache replacement.
            if running and (inventory != inventory_cache.get('models') or
                            inventory_updated is None or time.time() - inventory_updated >= 300):
                inventory_updated = time.time()
                write_json(STATE / 'model-inventory.json', {'models': inventory, 'updatedAt': inventory_updated})
            job = read_json(STATE / 'job.json', {})
            if job.get('state') == 'running':
                message = 'Operation interrupted. Check the model state and retry.'
                if job.get('preset') or job.get('file'):
                    message = 'Operation interrupted. Retry to resume the download.'
                if job.get('action') == 'import':
                    retained = clear_imports()
                    message = ('Import interrupted. Private staging was cleared and your original file is '
                               'unchanged. Retry the import.')
                    if retained:
                        message += f' A registration file was preserved at {retained}. Check it before retrying.'
                job.update(state='failed', message=message)
            # LM Studio unloads idle models itself (TTL). Forget results for instances that are gone, unless a
            # job changed the model state after the list above was read.
            tested = read_json(STATE / 'last-test.json', {}).get('model')
            loaded = read_json(STATE / 'last-load.json', {}).get('model')
            gone = (tested is not None and tested not in instances) or (loaded is not None and loaded not in keys)
            if running and gone and changed == read_json(STATE / 'model-state.json', {}).get('changedAt'):
                model_changed()
            # Same guard: a job that loaded or unloaded after the list above was read keeps its own slot record.
            if running and changed == read_json(STATE / 'model-state.json', {}).get('changedAt'):
                if slot_map(models) != read_json(SLOTS, {}):
                    write_json(SLOTS, slot_map(models))
        except BlockingIOError:
            job = read_json(STATE / 'job.json', {})
    last_test, last_load = read_json(STATE / 'last-test.json', {}), read_json(STATE / 'last-load.json', {})
    result = {'installed': LMS.is_file(), 'running': running, 'models': models, 'job': job,
              'inventory': inventory, 'inventoryUpdatedAt': inventory_updated,
              'inventoryCached': not running and bool(inventory),
              'endpoint': API + '/v1', 'chatUrl': API + '/v1/chat/completions',
              'settings': read_json(STATE / 'settings.json', {'autostart': False}),
              'modelDefaults': read_json(STATE / 'model-defaults.json', {}),
              'testPresets': read_json(STATE / 'test-presets.json', {}),
              'advancedAvailable': Path(SDK_PYTHON).is_file(), 'maxLoaded': MAX_LOADED,
              'slots': slot_map(models) if running else {},
              'lastTest': last_test if last_test.get('model') in instances else {},
              'lastLoad': last_load if last_load.get('model') in keys else {},
              'memoryLockLimit': memlock_limit(), 'resources': resources()}
    changed = read_json(STATE / 'model-state.json', {}).get('changedAt')
    if changed is not None:
        result['modelStateChangedAt'] = changed
    return result


def progress(job, message, **extra):
    job.update(message=message[-12000:], updated=time.time(), **extra)
    write_json(STATE / 'job.json', job)


def number(data, key, minimum, maximum, default):
    value = data.get(key, default)
    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:
        raise ValueError(f'{key} must be between {minimum} and {maximum}.')
    return value


# Validate optional settings before they reach the engine or persistent defaults.
def configuration(value, kind):
    if not isinstance(value, dict):
        raise ValueError('Settings must be an object.')
    numbers = LOAD_NUMBERS if kind == 'load' else TEST_NUMBERS
    allowed = set(numbers) | (LOAD_BOOLEANS | {'llamaKCacheQuantizationType', 'llamaVCacheQuantizationType'}
                              if kind == 'load' else {'system_prompt', 'reasoning'})
    if set(value) - allowed:
        raise ValueError('Unknown settings: ' + ', '.join(sorted(set(value) - allowed)))
    for key, item in value.items():
        if key in numbers:
            low, high, numeric = numbers[key]
            if type(item) not in ((int,) if numeric is int else (int, float)) or not math.isfinite(item) or not low <= item <= high:
                raise ValueError(f'{key} must be between {low} and {high}.')
        elif key in LOAD_BOOLEANS:
            if type(item) is not bool:
                raise ValueError(f'{key} must be true or false.')
        elif key.startswith('llama'):
            if not isinstance(item, str) or item not in CACHE_TYPES:
                raise ValueError('Invalid KV cache type.')
        elif key == 'system_prompt':
            if not isinstance(item, str) or len(item) > 4000:
                raise ValueError('System prompt must be at most 4000 characters.')
        elif key == 'reasoning' and item not in {'default', 'off', 'on', 'low', 'medium', 'high'}:
            raise ValueError('Invalid reasoning setting.')
    if kind == 'load' and value.get('llamaVCacheQuantizationType', 'f16') not in {'f16', 'f32'} and value.get('flashAttention') is not True:
        raise ValueError('Quantized V cache requires Flash Attention enabled.')
    return value


def validate(data):
    action = data.get('action')
    if action not in MUTATIONS:
        raise ValueError('Unknown action.')
    if action == 'settings' and type(data.get('autostart')) is not bool:
        raise ValueError('autostart must be true or false.')
    if action in {'load', 'unload', 'test', 'model-defaults'}:
        model = data.get('model', '')
        if not isinstance(model, str) or not 1 <= len(model) <= 512 or model.startswith('-') or '\x00' in model:
            raise ValueError('Choose a model first.')
    if action in {'load', 'model-defaults'}:
        number(data, 'context', 512, 131072, 4096)
        number(data, 'ttl', 60, 86400, 600)
        number(data, 'gpu', 0, 100, 100)
        configuration(data.get('advanced', {}), 'load')
    if action == 'load' and 'slot' in data:
        number(data, 'slot', 1, MAX_LOADED, 1)
    if action == 'settings':
        for key in ('startupModel', 'startupDecisionModel'):
            startup = data.get(key, '')
            if not isinstance(startup, str) or len(startup) > 512 or startup.startswith('-') or '\x00' in startup:
                raise ValueError('Invalid startup model.')
    if action == 'test-preset':
        if not isinstance(data.get('name'), str) or not re.fullmatch(r'[\w .-]{1,60}', data['name']):
            raise ValueError('Preset name must be 1–60 letters, numbers, spaces, dots or hyphens.')
        if type(data.get('delete', False)) is not bool:
            raise ValueError('Invalid preset action.')
        configuration(data.get('generation', {}), 'test')
    if action == 'download':
        if data.get('preset'):
            if data['preset'] not in {m['id'] for m in catalog_models()}:
                raise ValueError('Unknown preset.')
        elif 'repo' in data:
            hf_repo(data['repo'])
            if not isinstance(data.get('file'), str) or not HF_FILE.fullmatch(data['file']) or '..' in data['file']:
                raise ValueError('Choose a standalone .gguf file from the repository.')
        else:
            source = data.get('source', '')
            # lms accepts HF URLs or a catalog identifier; flags, local paths and other hosts do not pass.
            if not isinstance(source, str) or not re.fullmatch(
                    r'(?:https://huggingface\.co/)?[\w.-]+/[\w./@-]+', source) or '..' in source:
                raise ValueError('Enter a Hugging Face model URL or owner/model catalog identifier.')
    if action == 'import':
        import_parts(data.get('source'))
    if action == 'test':
        configuration(data.get('generation', {}), 'test')
        if data.get('reasoning', 'default') not in {'default', 'off', 'on', 'low', 'medium', 'high'}:
            raise ValueError('Invalid reasoning setting.')
        if not isinstance(data.get('prompt'), str) or not 1 <= len(data['prompt']) <= 4000:
            raise ValueError('Enter a prompt up to 4000 characters.')


def start():
    if not LMS.is_file():
        raise ValueError('Install LM Studio from the launcher first.')
    command('daemon', 'up')
    command('server', 'start', '--bind', '127.0.0.1', '--port', '1234')
    with request('/api/v1/models', timeout=10) as response:
        json.load(response)


def sha256(path, job, size):
    digest, done, last = hashlib.sha256(), 0, 0
    with path.open('rb') as source:
        while chunk := source.read(8 * 1024**2):
            digest.update(chunk)
            done += len(chunk)
            if time.monotonic() - last > 1:
                progress(job, 'Step 2 of 3: Verifying SHA-256 checksum...', phase='verify', downloaded=done, total=size)
                last = time.monotonic()
    return digest.hexdigest()


def installed_entry(model):
    installed = json.loads(command('ls', '--json'))
    return next((m for m in installed if m.get('path') == model['repo'] + '/' + model['file'] and
                 m.get('sizeBytes') == model['bytes']), None)


# The manager selects a finished download only by the key lms lists for that exact file. A key grouping several
# variants may load a different file, so it is not reported and the user chooses the model in the list instead.
def model_identity(entry):
    key = (entry or {}).get('modelKey')
    if entry and entry.get('type', 'llm') == 'llm' and isinstance(key, str) and key and len(entry.get('variants') or []) <= 1:
        return {'modelKey': key}
    return {}


# Presets keep their original list for Quickstart; recommended dialogue and decision candidates live beside it.
def catalog_models():
    catalog = read_json(CATALOG, {})
    return catalog.get('models', []) + catalog.get('recommended', []) + catalog.get('decisionRecommended', [])


# Exact identity only: the file lms import creates for this repository and name, with the pinned byte count.
def installed_file(repo, file, size):
    try:
        info = (models_folder() / repo / file).lstat()
    except (OSError, ValueError):
        return False
    return stat.S_ISREG(info.st_mode) and info.st_size == size


# API lookups follow only canonical-name redirects; downloads may also continue to the Hugging Face CDN.
class HFRedirects(urllib.request.HTTPRedirectHandler):
    def __init__(self, cdn):
        self.cdn = cdn

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        url = urllib.parse.urlsplit(urllib.parse.urljoin(req.full_url, newurl))
        host = (url.hostname or '').lower()
        if not (url.scheme == 'https' and url.port in {None, 443} and (
                (host == 'huggingface.co' and url.path.startswith('/api/models/')) or (self.cdn and (
                    host == 'huggingface.co' or host.endswith('.huggingface.co') or host.endswith('.hf.co'))))):
            raise urllib.error.HTTPError(req.full_url, code, 'Redirect refused', headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def hf_opener(cdn=False):
    return urllib.request.build_opener(HFRedirects(cdn))


# With pages=True, also return the next-page cursor from a Link header that points back at the same endpoint.
def hf_get(path, query, limit, pages=False):
    req = urllib.request.Request(HF + path + '?' + urllib.parse.urlencode(query),
                                 headers={'Accept': 'application/json', 'User-Agent': 'DwemerDistro-LMStudio'})
    body, deadline = b'', time.monotonic() + 20
    try:
        with hf_opener().open(req, timeout=10) as response:
            link = response.headers.get('Link', '') if pages else ''
            while chunk := response.read(65536):
                body += chunk
                if len(body) > limit:
                    raise ValueError('Hugging Face returned more data than DwemerDistro accepts.')
                if time.monotonic() > deadline:
                    raise ValueError('Hugging Face took too long to respond. Retry later.')
    except urllib.error.HTTPError as error:
        if error.code == 400 and pages:
            raise ValueError('Hugging Face rejected these results. Search again.')
        if error.code in {401, 403, 404}:
            raise ValueError('Repository not found, private, or not available without signing in.')
        if error.code == 429:
            raise ValueError('Hugging Face is limiting requests. Wait a minute and retry.')
        if 300 <= error.code < 400:
            raise ValueError('Hugging Face redirected to an unexpected location, so the request was stopped.')
        raise ValueError(f'Hugging Face returned HTTP {error.code}. Retry later.')
    except OSError:
        raise ValueError('Could not reach Hugging Face. Check the internet connection and retry.')
    try:
        value = json.loads(body)
    except ValueError:
        raise ValueError('Hugging Face returned an unreadable response.')
    if not pages:
        return value
    cursor, found = None, re.search(r'<([^<>]{1,4096})>\s*;\s*rel="next"', link)
    if found:
        url = urllib.parse.urlsplit(found.group(1))
        values = urllib.parse.parse_qs(url.query).get('cursor', [])
        if url.scheme == 'https' and url.hostname == 'huggingface.co' and url.path == path and len(values) == 1 and \
                HF_CURSOR.fullmatch(values[0]):
            cursor = values[0]
    return value, cursor


# One shared cache and per-minute request budget for every browser session; errors are never cached.
def hf_cached(key, fetch, fresh=False):
    with (STATE / 'hf.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cache = read_json(HF_CACHE, {})
        except (OSError, ValueError):
            cache = {}
        now = time.time()
        entries = cache.get('entries') if isinstance(cache, dict) and isinstance(cache.get('entries'), dict) else {}
        entries = {k: v for k, v in entries.items() if isinstance(v, dict) and isinstance(v.get('at'), (int, float))
                   and 0 <= now - v['at'] < HF_CACHE_SECONDS and 'value' in v}
        if not fresh and key in entries:
            return entries[key]['value']
        recent = cache.get('requests') if isinstance(cache, dict) and isinstance(cache.get('requests'), list) else []
        recent = [t for t in recent if isinstance(t, (int, float)) and 0 <= now - t < 60]
        if len(recent) >= HF_BUDGET:
            raise ValueError('Too many Hugging Face lookups in the last minute. Wait a moment and retry.')
        recent.append(now)
        write_json(HF_CACHE, {'entries': entries, 'requests': recent})
        value = fetch()
        entries[key] = {'at': time.time(), 'value': value}
        entries = dict(sorted(entries.items(), key=lambda item: item[1]['at'])[-40:])
        write_json(HF_CACHE, {'entries': entries, 'requests': recent})
        return value


def hf_repo(value):
    if not isinstance(value, str) or len(value) > 300:
        value = ''
    value = value.strip()
    url = re.fullmatch(r'https://huggingface\.co/([^/?#]+/[^/?#]+)(?:/(?:tree|blob|resolve)/[^?#]*)?/?(?:[?#].*)?', value)
    repo = url.group(1) if url else value
    if not HF_REPO.fullmatch(repo) or '..' in repo or repo.split('/')[0] in {'datasets', 'spaces', 'api'}:
        raise ValueError('Enter a Hugging Face model repository as owner/name or its https://huggingface.co/ URL.')
    return repo


def hf_count(value):
    return value if type(value) is int and value >= 0 else 0


def hf_choice(data, key, choices, default=''):
    value = data.get(key, default)
    if not isinstance(value, str) or value not in choices:
        raise ValueError('Invalid search filter. Reset filters and retry.')
    return value


# Metadata Hugging Face read from a repository's GGUF header, when it has one. The rest of that object, including
# chat templates, is dropped here and never cached or returned.
def hf_gguf(item):
    info = item.get('gguf') if isinstance(item.get('gguf'), dict) else {}
    params, arch, context = info.get('total'), info.get('architecture'), info.get('context_length')
    return {'params': params if type(params) is int and 0 < params < 10**13 else None,
            'architecture': arch if isinstance(arch, str) and re.fullmatch(r'[\w.-]{1,40}', arch, re.A) else None,
            'context': context if type(context) is int and 0 < context <= 2**24 else None}


# Browse or search public GGUF repositories, one bounded page at a time. The browser returns only the opaque cursor
# from the previous page; the endpoint, host and every other parameter are rebuilt here from allowlists.
def hf_search(data):
    query, author, cursor = data.get('query', ''), data.get('author', ''), data.get('cursor')
    if not isinstance(query, str) or (query.strip() and not re.fullmatch(r'[\w .+/-]{2,80}', query.strip(), re.A)):
        raise ValueError('Search with 2–80 letters, numbers, spaces, dots, hyphens or slashes, or paste a '
                         'https://huggingface.co/ repository URL.')
    if not isinstance(author, str) or (author.strip() and
                                       not re.fullmatch(r'[A-Za-z0-9][\w.-]{0,95}', author.strip(), re.A)):
        raise ValueError('Creator must be a Hugging Face user or organisation name, such as bartowski.')
    if cursor is not None and (not isinstance(cursor, str) or not HF_CURSOR.fullmatch(cursor)):
        raise ValueError('Invalid results page. Search again.')
    size, task = hf_choice(data, 'size', HF_SIZES), hf_choice(data, 'task', HF_TASKS)
    sort = hf_choice(data, 'sort', HF_SORTS, 'trending')
    query, author = ' '.join(query.split()), author.strip()
    params = [('filter', 'gguf'), ('gated', 'false'), ('sort', HF_SORTS[sort]), ('direction', '-1'), ('limit', HF_PAGE)]
    for key, value in (('search', query), ('author', author), ('num_parameters', HF_SIZES[size]),
                       ('pipeline_tag', HF_TASKS[task]), ('cursor', cursor)):
        if value:
            params.append((key, value))
    params += [('expand[]', key) for key in ('gated', 'downloads', 'likes', 'lastModified', 'private', 'pipeline_tag', 'gguf')]

    def fetch():
        # GGUF headers include chat templates that HF cannot leave out, so a page of 20 may reach a few hundred KB.
        found, after = hf_get('/api/models', params, 4 * 1024**2, pages=True)
        if not isinstance(found, list):
            raise ValueError('Hugging Face returned an unreadable response.')
        results = [{'id': item['id'], 'downloads': hf_count(item.get('downloads')), 'likes': hf_count(item.get('likes')),
                    'gated': bool(item.get('gated')), 'updated': str(item.get('lastModified') or '')[:10],
                    'task': item['pipeline_tag'] if isinstance(item.get('pipeline_tag'), str) and
                    re.fullmatch(r'[a-z-]{1,40}', item['pipeline_tag']) else None, **hf_gguf(item)}
                   for item in found[:HF_PAGE] if isinstance(item, dict) and isinstance(item.get('id'), str)
                   and HF_REPO.fullmatch(item['id']) and not item.get('private')]
        return {'query': query, 'author': author, 'size': size, 'task': task, 'sort': sort, 'results': results,
                'cursor': after if len(found) >= HF_PAGE else None}
    key = json.dumps(['search', query.lower(), author, size, task, sort, cursor])
    return hf_cached(key, fetch)


# List GGUF files with the reason any of them cannot be downloaded as one standalone language model.
def hf_files(value, fresh=False):
    repo = hf_repo(value)

    def fetch():
        info = hf_get(f'/api/models/{repo}', [('blobs', 'true')], 8 * 1024**2)
        if not isinstance(info, dict) or not isinstance(info.get('id'), str) or not HF_REPO.fullmatch(info['id']) or \
                not isinstance(info.get('sha'), str) or not re.fullmatch(r'[0-9a-f]{40}', info['sha']) or \
                not isinstance(info.get('siblings'), list):
            raise ValueError('Hugging Face returned incomplete repository metadata.')
        locked = ('Gated on Hugging Face; downloads that need sign-in are not supported here.' if info.get('gated') else
                  'This repository is private or disabled.' if info.get('private') or info.get('disabled') else '')
        files = []
        for sibling in info['siblings'][:10000]:
            name = sibling.get('rfilename') if isinstance(sibling, dict) else None
            if not isinstance(name, str) or not name.lower().endswith('.gguf'):
                continue
            lfs = sibling.get('lfs') if isinstance(sibling.get('lfs'), dict) else {}
            size, digest, base = lfs.get('size'), lfs.get('sha256'), name.rsplit('/', 1)[-1]
            reason = ('Part of a split set; split models are not supported.' if HF_SPLIT.search(name) else
                      'Vision projector, not a language model.' if 'mmproj' in base.lower() else
                      'Importance-matrix calibration data, not a language model.' if HF_IMATRIX.search(base) and not HF_QUANT.search(base) else
                      'Multi-token prediction companion, not a standalone model.' if HF_MTP.match(base) else
                      'Stored in a subfolder; not supported here.' if '/' in name else
                      'Unsupported file name.' if not HF_FILE.fullmatch(name) or '..' in name else
                      'Missing size or checksum metadata.' if type(size) is not int or size <= 0 or
                      sibling.get('size', size) != size or not isinstance(digest, str) or
                      not re.fullmatch(r'[0-9a-f]{64}', digest) else locked)
            quant = HF_QUANT.search(base)
            files.append({'name': name[:300], 'size': size if type(size) is int and size > 0 else None,
                          'quant': quant.group(1).upper() if quant else '', 'selectable': not reason, 'reason': reason,
                          'sha256': digest if not reason else None})
            if len(files) >= 300:
                break
        return {'repo': info['id'], 'revision': info['sha'], 'gated': bool(info.get('gated')), 'files': files,
                'truncated': len(files) >= 300}
    result = hf_cached(f'files:{repo.lower()}', fetch, fresh)
    # Installed state is local and changes after downloads, so it is checked on every request, not cached.
    for file in result['files']:
        file['installed'] = file['selectable'] and installed_file(result['repo'], file['name'], file['size'])
    return result


def download_preset(data, job):
    download_verified(next(m for m in catalog_models() if m['id'] == data['preset']), job)


# Re-resolve the chosen file from Hugging Face; the browser supplies only repository and file names.
def download_hf(data, job):
    progress(job, 'Checking the file on Hugging Face...')
    info = hf_files(data['repo'], fresh=True)
    file = next((f for f in info['files'] if f['name'] == data['file']), None)
    if not file or not file['selectable']:
        raise ValueError((file or {}).get('reason') or 'That file is not in the repository. Search again.')
    download_verified({'name': file['name'], 'repo': info['repo'], 'revision': info['revision'], 'file': file['name'],
                       'bytes': file['size'], 'sha256': file['sha256']}, job, check=True)


def download_verified(model, job, check=False):
    command('daemon', 'up')
    entry = installed_entry(model)
    if entry:
        progress(job, f"{model['name']} is already installed.", **model_identity(entry))
        return
    # An imported file that lms does not list yet must not be downloaded again; its import would also be refused.
    if installed_file(model['repo'], model['file'], model['bytes']):
        raise ValueError(f"{model['name']} is downloaded, but LM Studio has not listed it yet. Retry in a moment.")
    # Staging is keyed by the expected SHA-256, so equal file names from different repositories never share a partial.
    folder = STATE / 'downloads' / model['sha256']
    folder.mkdir(parents=True, exist_ok=True)
    target = folder / model['file']
    partial = target.with_suffix('.part')
    legacy = STATE / 'downloads' / model['file']
    if 'id' in model:
        for old, new in ((legacy, target), (legacy.with_suffix('.part'), partial)):
            if old.is_file() and not old.is_symlink() and not new.exists():
                old.replace(new)
    # A file verified by an earlier attempt that failed to import is reused after re-verification.
    if target.exists():
        if target.stat().st_size == model['bytes'] and sha256(target, job, model['bytes']) == model['sha256']:
            partial.unlink(missing_ok=True)
            import_preset(model, target, job, check)
            return
        target.unlink()
    offset = partial.stat().st_size if partial.exists() else 0
    if shutil.disk_usage(folder).free < model['bytes'] - offset + 1024**3:
        raise ValueError('Not enough disk space for this model plus 1 GB working space.')
    url = f"{HF}/{model['repo']}/resolve/{model['revision']}/{urllib.parse.quote(model['file'])}"
    if offset < model['bytes']:
        req = urllib.request.Request(url, headers={'Range': f'bytes={offset}-'} if offset else {})
        with hf_opener(cdn=True).open(req, timeout=60) as response:
            if offset and (response.status != 206 or not response.headers.get('Content-Range', '').startswith(f'bytes {offset}-')):
                offset = 0
            with partial.open('ab' if offset else 'wb') as output:
                last = 0
                while chunk := response.read(1024**2):
                    output.write(chunk)
                    offset += len(chunk)
                    if offset > model['bytes']:
                        raise ValueError('Download exceeded the catalog file size.')
                    if time.monotonic() - last > 1:
                        progress(job, f"Step 1 of 3: Downloading {model['name']}", phase='download',
                                 downloaded=offset, total=model['bytes'])
                        last = time.monotonic()
    progress(job, 'Step 2 of 3: Verifying SHA-256 checksum...', phase='verify', downloaded=0, total=model['bytes'])
    if offset != model['bytes'] or sha256(partial, job, model['bytes']) != model['sha256']:
        partial.unlink(missing_ok=True)
        raise ValueError('Model checksum failed. Retry to download a clean copy.')
    partial.replace(target)
    import_preset(model, target, job, check)


def import_preset(model, target, job, check=False):
    if check:
        # A searched file passed its checksum; its metadata must still describe one whole language model.
        try:
            with target.open('rb', buffering=1024**2) as stream:
                check_gguf(stream, model['bytes'], language=True)
        except ValueError:
            target.unlink(missing_ok=True)
            raise
    job.pop('downloaded', None)
    job.pop('total', None)
    progress(job, 'Step 3 of 3: Importing verified model into LM Studio...', phase='import')
    try:
        command('daemon', 'up')
        # Moving triggers a one-time confirmation that --yes does not skip. A hard link needs no prompt or extra space.
        command('import', str(target), '--user-repo', model['repo'], '--yes', '--hard-link', timeout=120)
    except ValueError as error:
        raise ValueError(f'Import failed. The verified download is kept; retry to import it without downloading again.\n{error}')
    if target.stat().st_nlink < 2:
        raise ValueError('Import reported success but no model link was created. The verified download is kept; retry to import it.')
    target.unlink()
    # LM Studio indexes imports asynchronously, so give it a short, bounded time to list the exact file.
    entry = installed_entry(model)
    deadline = time.monotonic() + 10
    if not entry:
        progress(job, 'Waiting for LM Studio to list the model...')
    while not entry and time.monotonic() < deadline:
        time.sleep(0.5)
        try:
            entry = installed_entry(model)
        except ValueError:
            pass
    if entry:
        progress(job, f"{model['name']} is installed.", **model_identity(entry))
    else:
        # LM Studio indexes imports asynchronously; the hard link above already proves the import.
        progress(job, f"{model['name']} was imported. LM Studio may take a moment to list it.")


# Map a pasted Windows path or /mnt/<drive> path to (drive letter, path components). Only shape is checked here.
def import_parts(source):
    if not isinstance(source, str) or len(source) > 1024 or any(ord(c) < 32 for c in source):
        raise ValueError('Enter the full path of a .gguf file on this PC.')
    # Explorer's "Copy as path" wraps the path in quotes.
    source = source.strip().strip('"').strip()
    windows = re.fullmatch(r'([A-Za-z]):[\\/](.+)', source)
    mounted = re.fullmatch(r'/mnt/([a-z])/(.+)', source)
    if windows:
        letter, parts = windows.group(1).lower(), re.split(r'[\\/]', windows.group(2))
    elif mounted:
        letter, parts = mounted.group(1), mounted.group(2).split('/')
    else:
        raise ValueError(r'Enter a full path on a Windows drive of this PC, such as C:\Models\model.gguf.')
    parts = [part for part in parts if part]
    if not parts or any(part in {'.', '..'} for part in parts):
        raise ValueError('The path must not contain . or .. folders.')
    split = re.search(r'-\d{5}-of-(\d{5})\.gguf$', parts[-1], re.I)
    if not parts[-1].lower().endswith('.gguf') or len(parts[-1]) > 200:
        raise ValueError('Choose a single .gguf model file.')
    if split and int(split.group(1)) > 1:
        raise ValueError('Split GGUF models (-00001-of-0000N) are not supported. Merge them into one .gguf file first.')
    return letter, parts


# Open the source one component at a time without following links, starting from a Windows drive mount and
# staying on it. A link anywhere in the path is refused, and the descriptor checked is the one copied.
def open_import_source(letter, parts):
    mount = f'/mnt/{letter}'
    drives = []
    for line in Path('/proc/self/mountinfo').read_text().splitlines():
        left, _, right = line.partition(' - ')
        fields, kind = left.split(), right.split()
        if len(fields) > 4 and kind and (kind[0] == 'drvfs' or (kind[0] == '9p' and 'aname=drvfs' in right)):
            drives.append(fields[4])
    if mount not in drives:
        raise ValueError(f'Drive {letter.upper()}: is not available inside DwemerDistro.')
    shown = letter.upper() + ':\\' + '\\'.join(parts)
    directory = os.open('/', os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        device = None
        for index, name in enumerate(['mnt', letter, *parts[:-1]]):
            following = os.open(name, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory)
            os.close(directory)
            directory = following
            if index == 1:
                device = os.fstat(directory).st_dev
            elif index > 1 and os.fstat(directory).st_dev != device:
                raise ValueError(f'{shown} is not stored directly on drive {letter.upper()}:.')
        source = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
    except FileNotFoundError:
        raise ValueError(f'{shown} was not found. Check the path on this PC.')
    except PermissionError:
        raise ValueError(f'DwemerDistro cannot read {shown}. Check its Windows permissions.')
    except OSError as error:
        if error.errno in {errno.ELOOP, errno.ENOTDIR}:
            raise ValueError(f'{shown} goes through a shortcut, link or junction, or a part of it is not a folder. '
                             'Enter the real location of the file.')
        raise
    finally:
        os.close(directory)
    info = os.fstat(source)
    if not stat.S_ISREG(info.st_mode) or info.st_dev != device:
        os.close(source)
        raise ValueError(f'{shown} is not a regular file on drive {letter.upper()}:.')
    return source, info


# Read the GGUF header and metadata without loading tensors. Rejects other formats, malformed headers and
# split sets, so the extension alone is never trusted.
def check_gguf(stream, size, language=False):
    deadline, items = time.monotonic() + GGUF_SECONDS, 0

    def invalid(reason):
        return ValueError(f'The file is not a valid GGUF model: {reason}.')

    # Every read and skip is checked against the file size and the metadata budget before it happens.
    def jump(length):
        if length > size - stream.tell():
            raise invalid('its metadata is truncated or malformed')
        if length > GGUF_METADATA_BYTES - stream.tell():
            raise invalid('its metadata is larger than DwemerDistro accepts')
        return stream.tell() + length

    def take(length):
        jump(length)
        return stream.read(length)

    def tick():
        nonlocal items
        items += 1
        if items > GGUF_ITEMS:
            raise invalid('its metadata has more entries than DwemerDistro accepts')
        if time.monotonic() > deadline:
            raise invalid('its metadata took too long to read')

    def skip(kind):
        if kind in GGUF_SIZES:
            stream.seek(jump(GGUF_SIZES[kind]))
        elif kind == GGUF_STRING:
            stream.seek(jump(struct.unpack('<Q', take(8))[0]))
        elif kind == GGUF_ARRAY:
            inner, count = struct.unpack('<IQ', take(12))
            if inner in GGUF_SIZES:
                stream.seek(jump(count * GGUF_SIZES[inner]))
            elif inner == GGUF_STRING:
                # Each string needs at least its 8-byte length, so a huge count fails the size check first.
                jump(count * 8)
                for _ in range(count):
                    tick()
                    skip(GGUF_STRING)
            else:
                raise invalid('unsupported metadata')
        else:
            raise invalid('unknown metadata type')

    header = stream.read(24) if size >= 24 else b''
    if header[:4] != b'GGUF':
        raise ValueError('This is not a GGUF model file. Only standalone .gguf files can be imported.')
    version, _, count = struct.unpack('<IQQ', header[4:])
    if version not in {2, 3}:
        raise ValueError('This GGUF version is not supported. Use a current GGUF (version 2 or 3) file.')
    # Each entry needs at least a key length, one key byte and a type.
    jump(count * 13)
    found = {b'general.architecture': None, b'general.type': None}
    for _ in range(count):
        tick()
        length = struct.unpack('<Q', take(8))[0]
        if length > GGUF_KEY_BYTES:
            raise invalid('a metadata key is too long')
        key = take(length)
        kind = struct.unpack('<I', take(4))[0]
        if language and key in found and kind == GGUF_STRING:
            length = struct.unpack('<Q', take(8))[0]
            # Overlong values are skipped and recorded as unrecognised.
            found[key] = take(length) if length <= 64 else b''
            if length > 64:
                stream.seek(jump(length))
        elif key != b'split.count':
            skip(kind)
        elif kind != GGUF_UINT16:
            raise invalid('its split.count metadata has the wrong type')
        # gguf-split writes the shard count; a merged model keeps split.count = 0.
        elif struct.unpack('<H', take(2))[0] > 1:
            raise ValueError('This file is one part of a split GGUF model. Split models are not supported; '
                             'merge them into one .gguf file first.')
    if language:
        # Vision projectors use the clip architecture; imatrix data and adapters declare a non-model general.type.
        # A file with no architecture at all cannot be loaded as a language model.
        architecture, kind = found[b'general.architecture'], found[b'general.type']
        if architecture == b'clip' or kind == b'mmproj':
            raise ValueError('This file is a vision projector, not a language model.')
        if kind == b'imatrix':
            raise ValueError('This file is importance-matrix calibration data, not a language model.')
        if kind not in {None, b'model'} or not architecture:
            raise ValueError('This file is not a standalone language model.')


# LM Studio's model folder, resolved as lms import does: the home named by ~/.lmstudio-home-pointer (lms writes it
# on first run), then settings.json downloadsFolder, else <home>/models.
def models_folder():
    pointer = HOME / '.lmstudio-home-pointer'
    home = Path(pointer.read_text().strip()) if pointer.is_file() else HOME / '.lmstudio'
    try:
        folder = read_json(home / 'settings.json', {}).get('downloadsFolder')
    except (ValueError, AttributeError):
        folder = None
    if not isinstance(folder, str):
        return home / 'models'
    if not folder.startswith('/'):
        raise ValueError("LM Studio's model folder setting is not a full path, so the import destination is unclear.")
    return Path(folder)


# Undo only a registration whose identity proves it is our staged file. Cross-filesystem copies cannot be
# identified safely after lms creates them; preserve those files and return their path for recovery feedback.
def discard_import_target():
    retained = None
    owned = read_json(IMPORT_TARGET, None)
    if owned:
        target = Path(owned['target'])
        try:
            info = target.lstat()
        except FileNotFoundError:
            info = None
        if info:
            ours = (owned['linked'] and stat.S_ISREG(info.st_mode)
                    and [info.st_dev, info.st_ino] == owned['file'] and info.st_size == owned['size'])
            if ours:
                target.unlink(missing_ok=True)
            else:
                retained = str(target)
    IMPORT_TARGET.unlink(missing_ok=True)
    return retained


# Imports run one at a time under the job lock, so leftover private staging belongs to an interrupted import.
def clear_imports():
    retained = discard_import_target()
    IMPORTS.mkdir(mode=0o700, exist_ok=True)
    for item in IMPORTS.iterdir():
        if not item.is_dir() or item.is_symlink():
            item.unlink(missing_ok=True)
    return retained


def gigabytes(size):
    return f'{size / 1024**3:.1f} GB'


# Copy a validated Windows GGUF file into private staging, then register it with lms. The original is only read.
def import_local(data, job):
    letter, parts = import_parts(data['source'])
    name = parts[-1]
    progress(job, f'Checking {name}...')
    source, before = open_import_source(letter, parts)
    try:
        # A large buffer keeps metadata reads over the Windows drive mount few and quick.
        with os.fdopen(os.dup(source), 'rb', buffering=1024**2) as stream:
            check_gguf(stream, before.st_size)
        command('daemon', 'up')
        # Finish any interrupted import first, so its unconfirmed registration does not block this one.
        clear_imports()
        repo = 'local/' + (re.sub(r'[^\w.-]+', '-', name[:-5]).strip('.-') or 'model')[:100]
        models = models_folder()
        # lms import registers the file as <model folder>/<user>/<repo>/<file name>.
        target = models / repo / name
        if os.path.lexists(target):
            raise ValueError(f'{repo}/{name} is already imported. Rename the file to import another copy.')
        existing = models
        while not existing.exists():
            existing = existing.parent
        # A hard link registers without a second copy; another filesystem needs lms to copy it again.
        linked = existing.stat().st_dev == IMPORTS.stat().st_dev
        size, headroom = before.st_size, 1024**3
        for place, label in [(IMPORTS, 'DwemerDistro')] + ([] if linked else [(existing, "LM Studio's model folder")]):
            free = shutil.disk_usage(place).free
            if free < size + headroom:
                raise ValueError(f'Not enough disk space in {label}: importing needs {gigabytes(size)} plus 1 GB '
                                 f'working space, but only {gigabytes(free)} is free.')
        partial, staged = IMPORTS / (name + '.part'), IMPORTS / name
        done, last = 0, 0
        try:
            with open(os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600), 'wb') as output:
                while done < size:
                    chunk = os.pread(source, min(8 * 1024**2, size - done), done)
                    if not chunk:
                        break
                    output.write(chunk)
                    done += len(chunk)
                    if time.monotonic() - last > 1:
                        progress(job, f'Step 1 of 2: Copying {name}', phase='copy', downloaded=done, total=size)
                        last = time.monotonic()
                output.flush()
                os.fsync(output.fileno())
        except OSError as error:
            if error.errno == errno.ENOSPC:
                raise ValueError('DwemerDistro ran out of disk space while copying. The partial copy was removed.')
            raise ValueError(f'Copying stopped: {error.strerror}. The partial copy was removed; your original file is unchanged.')
        after = os.fstat(source)
        if done != size or (after.st_size, after.st_mtime_ns) != (before.st_size, before.st_mtime_ns):
            raise ValueError(f'{name} changed while it was being copied. Close programs using it and retry.')
        partial.replace(staged)
        # Check the copy itself, since that is what LM Studio receives.
        with staged.open('rb', buffering=1024**2) as stream:
            check_gguf(stream, size)
        job.pop('downloaded', None)
        job.pop('total', None)
        progress(job, f'Step 2 of 2: Registering {name} with LM Studio...', phase='import')
        # Record the destination before lms creates it, so a failed or interrupted registration can be undone.
        file = staged.stat()
        write_json(IMPORT_TARGET, {'target': str(target), 'size': size, 'linked': linked,
                                   'file': [file.st_dev, file.st_ino]})
        if os.path.lexists(target):
            IMPORT_TARGET.unlink()
            raise ValueError(f'{repo}/{name} appeared in LM Studio during the import. Rename the file and retry.')
        try:
            command('import', str(staged), '--user-repo', repo, '--yes', '--hard-link' if linked else '--copy',
                    timeout=120 if linked else 7200)
        except ValueError as error:
            # lms refuses an existing destination, which then belongs to someone else.
            if 'Target file already exists' in str(error):
                IMPORT_TARGET.unlink()
            raise
        # lms can exit successfully without importing, so confirm the registered file itself.
        registered = target.is_file() and not target.is_symlink()
        if registered and linked:
            registered = os.path.samefile(target, staged)
        elif registered:
            registered = target.stat().st_size == size
        if not registered:
            raise ValueError('LM Studio did not register the model. Your original file is unchanged; retry the import.')
        IMPORT_TARGET.unlink()
        # The model is registered; a failed listing only leaves the user to choose it in the list.
        try:
            identity = model_identity(installed_entry({'repo': repo, 'file': name, 'bytes': size}))
        except (OSError, ValueError):
            identity = {}
        progress(job, f'{name} was imported as {repo}. Start the server and load it from Installed; '
                      'LM Studio may take a moment to list it.', **identity)
    except Exception as error:
        retained = clear_imports()
        if retained:
            raise ValueError(f'{error} A registration file was preserved at {retained}. '
                             'Check it before retrying; your original file is unchanged.') from error
        raise
    finally:
        os.close(source)
        clear_imports()


def execute(data, job):
    action = data['action']
    if action in {'stop', 'restart'}:
        command('daemon', 'down')
        SLOTS.unlink(missing_ok=True)
        model_changed()
    if action in {'start', 'restart'}:
        start()
    elif action == 'settings':
        settings = read_json(STATE / 'settings.json', {})
        settings.update(autostart=data['autostart'])
        # Each startup model changes only when sent, so a save naming only the dialogue model keeps the decision model.
        for key in ('startupModel', 'startupDecisionModel'):
            if key in data:
                settings[key] = data[key]
        write_json(STATE / 'settings.json', settings)
    elif action == 'model-defaults':
        defaults = read_json(STATE / 'model-defaults.json', {})
        if data['model'] not in defaults and len(defaults) >= 50:
            raise ValueError('At most 50 model defaults can be saved.')
        defaults[data['model']] = {key: data.get(key, default) for key, default in
                                   [('context', 4096), ('gpu', 100), ('ttl', 600), ('advanced', {})]}
        write_json(STATE / 'model-defaults.json', defaults)
    elif action == 'test-preset':
        presets = read_json(STATE / 'test-presets.json', {})
        if data.get('delete'):
            presets.pop(data['name'], None)
        else:
            if data['name'] not in presets and len(presets) >= 10:
                raise ValueError('At most 10 test presets can be saved.')
            presets[data['name']] = data.get('generation', {})
        write_json(STATE / 'test-presets.json', presets)
    elif action == 'download':
        if data.get('preset'):
            download_preset(data, job)
        elif 'repo' in data:
            download_hf(data, job)
        else:
            command('daemon', 'up')
            progress(job, 'Downloading custom model. LM Studio is selecting the requested file/quantization.')
            command('get', data['source'], '--gguf', '--yes', timeout=14400, job=job)
    elif action == 'import':
        import_local(data, job)
    elif action == 'load':
        with request('/api/v1/models') as response:
            models = json.load(response)['models']
        model = next((m for m in models if m['key'] == data['model'] and m['type'] == 'llm'), None)
        if not model:
            raise ValueError('Choose an installed language model. Start the API first.')
        if model.get('loaded_instances'):
            raise ValueError('This model is already loaded. Unload it before loading it again.')
        if sum(len(m.get('loaded_instances') or []) for m in models) >= MAX_LOADED:
            raise ValueError(f'At most {MAX_LOADED} models can be loaded at once. Unload one before loading another.')
        # An explicit slot must be free; nothing is ever replaced. Without one (startup, older callers) the lowest
        # free slot is used.
        slots = slot_map(models)
        slot = str(data['slot']) if 'slot' in data else next((str(n) for n in range(1, MAX_LOADED + 1) if str(n) not in slots), None)
        if slot is None or slot in slots:
            holder = next((m.get('display_name') or m['key'] for m in models if m['key'] == slots.get(slot)), 'another model')
            raise ValueError(f'Slot {slot} holds {holder}. Unload it first; loading never replaces a model.' if slot
                             else 'No slot is free. Unload a model first.')
        job['slot'] = int(slot)
        available = resources()
        # Free memory already excludes loaded models. Leave space for the desktop and KV cache; LM Studio also
        # applies its own load guardrails.
        budget = available['ramAvailable'] + (available['vramFree'] if data.get('gpu', 100) else 0) - 2 * 1024**3
        if model['size_bytes'] > budget:
            raise ValueError('Insufficient available RAM/VRAM for this model plus 2 GB headroom. Choose a smaller model, '
                             'unload another model or free memory.')
        advanced = data.get('advanced', {})
        if advanced:
            if not Path(SDK_PYTHON).is_file():
                raise ValueError('Reinstall the LM Studio component to enable advanced settings.')
            config = {**advanced, 'contextLength': data.get('context', 4096), 'gpu': {'ratio': data.get('gpu', 100) / 100}}
            # The official SDK exposes loading options not available in lms or REST.
            script = '''import json,sys,lmstudio
d=json.load(sys.stdin)
with lmstudio.Client("127.0.0.1:1234") as client:
    model=client.llm.load_new_instance(d["model"], ttl=d["ttl"], config=d["config"])
    print(json.dumps(model.get_load_config().to_dict()))
'''
            try:
                result = subprocess.run([SDK_PYTHON, '-c', script], input=json.dumps({'model': data['model'],
                                        'ttl': data.get('ttl', 600), 'config': config}), capture_output=True, text=True, timeout=300)
            except subprocess.TimeoutExpired:
                # The exception text repeats the whole inline script; report the outcome instead.
                raise ValueError('Advanced loading did not finish within 300 seconds. LM Studio may still be loading '
                                 'the model; check the model list before retrying.')
            if result.returncode:
                raise ValueError(result.stderr[-4000:] or 'Advanced model loading failed.')
            applied = {'model': data['model'], 'appliedConfig': json.loads(result.stdout)}
            message, locking = 'Model loaded.', applied['appliedConfig'].get('keepModelInMemory', True)
        else:
            message = command('load', data['model'], '--context-length', str(data.get('context', 4096)),
                              '--gpu', str(data.get('gpu', 100) / 100), '--ttl', str(data.get('ttl', 600)), '--yes')
            # The engine default keeps models in memory.
            applied, locking = {}, True
        model_changed()
        write_json(SLOTS, {**slots, slot: data['model']})
        limit = memlock_limit()
        # llama.cpp only warns when mlock fails, so the reported setting alone would overstate it.
        if locking and limit is not None and limit < model['size_bytes']:
            applied['memoryLockWarning'] = (f'Keep model in memory is limited: this system lets the engine lock only '
                                            f'{limit // 1024**2} MiB, so the model can still be paged out.')
        if advanced:
            applied['modelStateChangedAt'] = read_json(STATE / 'model-state.json', {})['changedAt']
            write_json(STATE / 'last-load.json', applied)
        progress(job, message, **applied)
    elif action == 'unload':
        command('unload', data['model'])
        model_changed()
        # The unload already succeeded; if the list is unavailable, status frees the slot on its next check.
        try:
            with request('/api/v1/models') as response:
                write_json(SLOTS, slot_map(json.load(response)['models']))
        except (OSError, ValueError, KeyError):
            pass
    elif action == 'test':
        with request('/api/v1/models') as response:
            models = json.load(response)['models']
        owner = next((m for m in models for i in m.get('loaded_instances', []) if i['id'] == data['model']), None)
        if not owner:
            raise ValueError('Load the model first. A test never loads a model automatically.')
        payload = {'model': data['model'], 'input': data['prompt'], 'stream': True,
                   'store': False, 'max_output_tokens': 192, 'temperature': 0.2}
        payload.update(data.get('generation', {}))
        reasoning = payload.pop('reasoning', data.get('reasoning', 'default'))
        capability = (owner.get('capabilities') or {}).get('reasoning')
        # A connection test only needs the answer, so skip thinking when the model allows it. Explicit choices win.
        if reasoning == 'default' and isinstance(capability, dict) and 'off' in (capability.get('allowed_options') or []):
            reasoning = 'off'
        if reasoning != 'default':
            payload['reasoning'] = reasoning
        text, last, stats, finished, reasoned = '', 0, {}, False, False
        started = time.monotonic()
        with request('/api/v1/chat', payload, timeout=120) as response:
            for raw in response:
                if not raw.startswith(b'data: '):
                    continue
                try:
                    event = json.loads(raw[6:])
                except ValueError:
                    raise ValueError('The model stream was interrupted or malformed. Retry the test.')
                if event.get('type') == 'error':
                    raise ValueError(str(event.get('error', event)))
                if event.get('type') == 'chat.end':
                    finished = True
                    stats = event.get('result', {}).get('stats', {})
                # Reasoning text is internal; only the answer is shown or stored.
                if event.get('type') == 'reasoning.delta':
                    reasoned = True
                if event.get('type') == 'message.delta':
                    text = (text + event.get('content', ''))[-12000:]
                if event.get('type') in {'message.delta', 'reasoning.delta'} and time.monotonic() - last > .3:
                    progress(job, 'Generating...' if text else 'Reasoning...', output=text)
                    last = time.monotonic()
        if not finished:
            raise ValueError('The model stream ended before completion. Retry the test.')
        message = 'Test finished.'
        if not text.strip():
            message = 'Test finished, but the model returned no answer text.' + (
                ' It may have spent the output limit on reasoning; turn reasoning off or raise max output tokens.'
                if reasoned else '')
        result = {'output': text, 'stats': stats, 'elapsedSeconds': round(time.monotonic() - started, 2),
                  'model': data['model'], 'generation': {key: value for key, value in payload.items()
                  if key not in {'model', 'input', 'stream', 'store'}}, 'updated': time.time()}
        if 'changedAt' in read_json(STATE / 'model-state.json', {}):
            result['modelStateChangedAt'] = read_json(STATE / 'model-state.json', {})['changedAt']
        write_json(STATE / 'last-test.json', result)
        progress(job, message, **{key: value for key, value in result.items() if key != 'updated'})


# Returns once the job has ended and released the job lock. A failed, interrupted or replaced job raises.
def wait_for_job(job_id):
    # A load runs lms or the SDK for at most 300 seconds; the rest covers memory checks and bookkeeping.
    deadline = time.monotonic() + 360
    with (STATE / 'job.lock').open('a') as lock:
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise ValueError('The startup model load did not finish within 360 seconds.')
                time.sleep(1)
        job = read_json(STATE / 'job.json', {})
    if job.get('id') != job_id:
        raise ValueError('Another operation replaced the startup model load.')
    if job.get('state') == 'failed':
        raise ValueError(job.get('message') or 'The startup model load failed.')
    if job.get('state') != 'completed':
        raise ValueError('The startup model load was interrupted.')


def main():
    initialize()
    action = sys.argv[1] if len(sys.argv) == 2 else ''
    if action == 'init':
        return {'ok': True}
    if action == 'catalog':
        catalog = read_json(CATALOG, {'models': []})
        for model in catalog.get('models', []) + catalog.get('recommended', []) + catalog.get('decisionRecommended', []):
            model['installed'] = installed_file(model['repo'], model['file'], model['bytes'])
        return catalog
    if action in {'search', 'files'}:
        # Read-only lookups: no job lock, engine start or download.
        data = json.loads(sys.stdin.read(4096) or '{}')
        if not isinstance(data, dict):
            raise ValueError('Invalid request.')
        return hf_search(data) if action == 'search' else hf_files(data.get('repo'))
    if action == 'status':
        return status()
    if action == 'access':
        if os.environ.get('SUDO_USER') == 'www-data':
            raise ValueError('Open the manager from the launcher to obtain access.')
        return {'token': (STATE / 'access').read_text()}
    if action == 'authorize':
        data = json.loads(sys.stdin.read(16384))
        return {'authorized': hmac.compare_digest(str(data.get('token', '')), (STATE / 'access').read_text())}
    if action == 'autostart':
        settings = read_json(STATE / 'settings.json', {})
        if settings.get('autostart') and LMS.is_file():
            start()
            # The dialogue model first, then the optional decision model. Each exact key loads once, and a key that is
            # already loaded is skipped, so running startup again changes nothing.
            keys = [settings.get(key) for key in ('startupModel', 'startupDecisionModel')]
            with request('/api/v1/models', timeout=10) as response:
                loaded = {m.get('key') for m in json.load(response)['models'] if m.get('loaded_instances')}
            keys = [model for model in dict.fromkeys(keys) if isinstance(model, str) and model and model not in loaded]
            for model in keys:
                defaults = read_json(STATE / 'model-defaults.json', {}).get(model, {})
                # Use the same job lock and validation as manual loads.
                result = subprocess.run([sys.executable, __file__, 'submit'], input=json.dumps(
                    {**defaults, 'action': 'load', 'model': model}), capture_output=True, text=True, timeout=10)
                if result.returncode:
                    raise ValueError(result.stdout)
                # Every load, the last too, must end before startup reports success: the next load needs the job lock and
                # is checked against the memory this one leaves, and a failed load must not look like a ready startup.
                wait_for_job(json.loads(result.stdout)['id'])
        return {'ok': True}
    if action == 'shutdown':
        if LMS.is_file():
            command('daemon', 'down')
            SLOTS.unlink(missing_ok=True)
            model_changed()
        return {'ok': True}
    if action != 'submit':
        raise ValueError('Unknown command.')
    data = json.loads(sys.stdin.read(16384))
    validate(data)
    lock = (STATE / 'job.lock').open('a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise ValueError('Another operation is running. Wait for it to finish.')
    job = {'id': secrets.token_hex(8), 'action': data['action'], 'state': 'running', 'message': 'Starting...', 'updated': time.time()}
    # With two models loaded, a running job names its target so another model's view never shows its output.
    if data['action'] in {'load', 'unload', 'test'}:
        job['model'] = data['model']
    if data['action'] == 'download' and data.get('preset'):
        job['preset'] = data['preset']
    elif data['action'] == 'download' and 'repo' in data:
        job.update(repo=data['repo'], file=data['file'])
    write_json(STATE / 'job.json', job)
    if os.fork():
        lock.close()
        return job
    # Keep the inherited lock for the complete job; close the web/launcher pipes before returning.
    os.setsid()
    with open(os.devnull, 'r+') as null:
        for fd in (0, 1, 2):
            os.dup2(null.fileno(), fd)
    try:
        execute(data, job)
        keep = data['action'] in {'test', 'import'} or (data['action'] == 'download' and (data.get('preset') or 'repo' in data))
        progress(job, job.get('message', 'Done') if keep else 'Done.', state='completed')
    except Exception as error:
        progress(job, str(error), state='failed')
    finally:
        lock.close()
    os._exit(0)


if __name__ == '__main__':
    try:
        print(json.dumps(main()), flush=True)
    except Exception as error:
        print(json.dumps({'error': str(error)}), flush=True)
        sys.exit(1)
