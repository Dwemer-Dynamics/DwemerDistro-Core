#!/usr/bin/env python3
"""Distro-owned manager for user-added ("custom") PHP/PostgreSQL mod servers.

The launcher only ever calls this tool with argument vectors. This tool owns the
registry, the scoped folders and databases, and every lifecycle operation. See
CUSTOM_MODS.md for the version 1 manifest contract.

Privilege split:
  * root only creates the scoped folder and database, fixes ownership, takes
    backups, and writes registry entries. root never runs repository code,
    never runs git inside a checkout, and never requires repository PHP.
  * git, config syntax checks, and the repository migration run as dwemer.
"""
import datetime
import fcntl
import grp
import importlib.util
import json
import os
import pwd
import re
import secrets
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

APP_USER = "dwemer"
WEB_GROUP = "www-data"
DATABASE_ROLE = "dwemer"
WEB_ROOT = "/var/www/html"
MOD_ROOT = WEB_ROOT + "/custom-mods"
# The shared loopback Apache listener for every custom mod (and a manual ExampleServer).
# Official server ports are never touched; see setup_web.
SERVICES_CONF = "/etc/dwemerdistro_services.conf"
CUSTOM_PORT_DEFAULT = 19000
CUSTOM_PORT_MIN, CUSTOM_PORT_MAX = 19000, 19999
CUSTOM_PORT_LINE = re.compile(r'^CUSTOM_MODS_PORT=("?)([0-9]{1,5})\1\Z')
APACHE_DIR = "/etc/apache2"
WEB_SITE = "dwemerdistro-custom-mods"
WEB_MARKER = "# Managed by ddistro_custom_mod setup-web; do not edit."
STATE_ROOT = "/var/lib/dwemerdistro-custom-mods"
REGISTRY_ROOT = STATE_ROOT + "/registry"
BACKUP_ROOT = STATE_ROOT + "/backups"
# Root-only opt-in list, one mod id per line, of custom-mods/<id> folders that get the KAGRENAC
# source denials (setup-web --protect-project). Outside the registry, so status never reads it.
PROTECTED_PROJECTS = STATE_ROOT + "/protected-projects"
MAX_PROTECTED_PROJECTS = 32
# Root-only list, one server folder per line, of direct /var/www/html/<Name>Server roots. Each name
# is saved here before its folder is created or moved in, and is never removed (see setup_web).
PROTECTED_ROOTS = STATE_ROOT + "/protected-roots"
MAX_PROTECTED_ROOTS = 64
# Same lock protocol and path as ddistro_server, so official and custom
# operations never run at the same time.
LOCK_PATH = "/run/lock/dwemerdistro-server-manager.d"
MANIFEST_NAME = "dwemer-mod.json"
SCHEMA_VERSION = 1
STATUS_SCHEMA_VERSION = 1
# A root-owned tombstone: hidden from status, and the only proof that lets Add reattach the
# exact folder and database this manager created. Nothing else is ever adopted.
UNREGISTERED = "unregistered"
POSTGRES_PORT = "5432"
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ID_PATTERN = re.compile(r"^[a-z][a-z0-9-]{1,30}[a-z0-9]\Z")
SHA_PATTERN = re.compile(r"^[0-9a-f]{40}\Z")
BRANCH_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}\Z")
REL_PATH_SEGMENT = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*\Z")
# A direct server folder: ASCII letters and digits only (no dots, slashes or hyphens), ending in Server.
SERVER_FOLDER_PATTERN = re.compile(r"^[A-Z][A-Za-z0-9]{0,40}Server\Z")
HOST_LABEL = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z")
URL_PATH = re.compile(r"^(/[A-Za-z0-9._~-]+)+/?\Z")
# IDs that name official products, their folders, or distro internals.
RESERVED_IDS = {
    "herika", "herikaserver", "chim", "stobe", "stobeserver", "dialectic", "dialecticserver",
    "reign", "reignserver", "lorkhan", "lorkhanserver", "dwemer", "dwemerdistro", "postgres",
    "template", "custom-mods", "html", "admin", "root", "www-data",
}
MANIFEST_KEYS = {"schema_version", "id", "name", "description", "project_url", "dashboard_path",
                 "health_path", "requirements", "setup", "assets", "branches", "server_folder"}
BRANCH_KEYS = {"default", "allowed"}
MAX_BRANCHES = 10
ASSET_KEYS = ("icon", "banner")
ASSET_EXTENSIONS = (".png", ".jpg", ".jpeg")
REQUIREMENT_KEYS = {"php", "postgresql"}
SETUP_KEYS = {"config_template", "config_path", "token_placeholder", "database_placeholder",
              "migrate_script"}
PLACEHOLDER_PATTERN = re.compile(r"^[A-Za-z0-9_]{6,64}\Z")
MAX_MANIFEST_BYTES = 16 * 1024
MAX_TEMPLATE_BYTES = 256 * 1024
CHECK_TIMEOUT = 300
CLONE_TIMEOUT = 900
MIGRATE_TIMEOUT = 600
PHP_SECURITY_HELPERS = ("/usr/local/bin/ensure_php_security", "/home/dwemer/dwemerdistro/bin/ensure_php_security")


class ModError(Exception):
    """A safe, user-facing failure. Messages never contain secrets."""


# --- Output ---------------------------------------------------------------------------

SECRETS_TO_REDACT = []


def redact(text):
    for value in SECRETS_TO_REDACT:
        if value:
            text = text.replace(value, "[redacted]")
    return re.sub(r"(?i)(password|token|secret|api_key)(\s*[=:]\s*)\S+", r"\1\2[redacted]", text)


def info(message):
    print("[INFO] " + redact(message), file=sys.stderr, flush=True)


def ok(message):
    print("[OK] " + redact(message), file=sys.stderr, flush=True)


def now_utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --- Validation (pure functions; covered by tests/test_ddistro_custom_mod.py) ------------

def validate_repository_url(url):
    """Accept only a plain public https://host/path Git URL."""
    if not isinstance(url, str) or not url or len(url) > 300:
        raise ModError("Enter a repository URL of at most 300 characters.")
    if any(ord(c) < 0x21 or ord(c) > 0x7E for c in url):
        raise ModError("The repository URL contains spaces or unsupported characters.")
    if not url.startswith("https://"):
        raise ModError("Only public https:// repository URLs are supported.")
    rest = url[len("https://"):]
    host, slash, path = rest.partition("/")
    if not slash:
        raise ModError("The repository URL must include the repository path.")
    if any(c in url for c in "@?#%\\") or ";" in url:
        raise ModError("The repository URL must not contain credentials, a query, a fragment, or escapes.")
    if ":" in host:
        raise ModError("The repository URL must not set a port.")
    if len(host) > 253 or "." not in host:
        raise ModError("The repository host is not a public host name.")
    labels = host.split(".")
    if not all(HOST_LABEL.match(label) for label in labels) or labels[-1].isdigit():
        raise ModError("The repository host is not a public host name.")
    if host == "localhost" or host.endswith((".localhost", ".local", ".internal", ".lan", ".home")):
        raise ModError("Local network repository hosts are not supported.")
    path = "/" + path
    if not URL_PATH.match(path) or "/../" in path + "/" or "/./" in path + "/":
        raise ModError("The repository path contains unsupported characters.")
    return url


def validate_relative_path(value, label, allow_trailing_slash=False):
    """A bounded relative path inside the mod folder; no traversal, hidden, or odd segments."""
    if not isinstance(value, str) or not value or len(value) > 200:
        raise ModError(f"Manifest {label} must be a relative path of at most 200 characters.")
    path = value
    if allow_trailing_slash and path.endswith("/"):
        path = path[:-1]
        if not path:
            return value
    if path.startswith("/") or "\\" in path or "//" in path:
        raise ModError(f"Manifest {label} must be a relative path inside the mod folder.")
    for segment in path.split("/"):
        if segment in ("", ".", "..") or not REL_PATH_SEGMENT.match(segment):
            raise ModError(f"Manifest {label} contains an unsupported path segment.")
    return value


def text_field(manifest, key, maximum, required=True):
    value = manifest.get(key)
    if value is None and not required:
        return ""
    if not isinstance(value, str) or not value.strip() or len(value) > maximum:
        raise ModError(f"Manifest {key} must be text of at most {maximum} characters.")
    if any(ord(c) < 0x20 for c in value):
        raise ModError(f"Manifest {key} contains control characters.")
    return value.strip()


def database_name_for(mod_id):
    return "custom_" + mod_id.replace("-", "_")


def validate_mod_id(mod_id):
    if not isinstance(mod_id, str) or not ID_PATTERN.match(mod_id) or "--" in mod_id:
        raise ModError("Manifest id must be 3-32 lowercase letters, digits, or single hyphens, "
                       "starting with a letter.")
    if mod_id in RESERVED_IDS:
        raise ModError("Manifest id is reserved by DwemerDistro.")
    return mod_id


def validate_server_folder(name):
    """A direct /var/www/html/<name> folder: <Letters/digits>Server, never an official or Kagrenac product name."""
    if not isinstance(name, str) or not SERVER_FOLDER_PATTERN.match(name):
        raise ModError("Manifest server_folder must be 7-47 ASCII letters or digits, start with a capital "
                       "letter and end in Server, such as CommonGroundServer.")
    if name[:-len("Server")].lower() in RESERVED_IDS | {"example", "kagrenac", "custom", "custommods"}:
        raise ModError("Manifest server_folder is reserved by DwemerDistro.")
    return name


def parse_manifest(raw):
    """Validate legacy branch manifests and opt-in version 2 release manifests."""
    if len(raw) > MAX_MANIFEST_BYTES:
        raise ModError(f"{MANIFEST_NAME} is larger than {MAX_MANIFEST_BYTES} bytes.")
    try:
        manifest = json.loads(raw.decode("utf-8") if isinstance(raw, bytes) else raw)
    except (ValueError, UnicodeDecodeError):
        raise ModError(f"{MANIFEST_NAME} is not valid UTF-8 JSON.")
    if not isinstance(manifest, dict):
        raise ModError(f"{MANIFEST_NAME} must be a JSON object.")
    version = manifest.get("schema_version")
    if isinstance(version, bool) or version not in (1, 2) or (version == 2 and type(version) is not int):
        raise ModError("Unsupported manifest schema_version. This distro supports versions 1 and 2.")
    unknown = set(manifest) - (MANIFEST_KEYS | ({"game", "distribution", "features", "testing"} if version == 2 else set()))
    if unknown:
        raise ModError("Manifest has unsupported fields: " + ", ".join(sorted(unknown)[:5]))

    result = {
        "schema_version": int(version),
        "id": validate_mod_id(manifest.get("id")),
        "name": text_field(manifest, "name", 60),
        "description": text_field(manifest, "description", 300, required=False),
        "project_url": "",
        "dashboard_path": validate_relative_path(manifest.get("dashboard_path"), "dashboard_path", True),
        "health_path": validate_relative_path(manifest.get("health_path"), "health_path"),
    }
    if manifest.get("project_url") is not None:
        result["project_url"] = validate_repository_url(manifest.get("project_url"))
    # Optional; without it the mod keeps the custom-mods/<id> layout. Chosen only at first install.
    result["server_folder"] = ""
    if manifest.get("server_folder") is not None:
        result["server_folder"] = validate_server_folder(manifest.get("server_folder"))

    requirements = manifest.get("requirements")
    if not isinstance(requirements, dict) or set(requirements) != REQUIREMENT_KEYS:
        raise ModError("Manifest requirements must list exactly php and postgresql.")
    if requirements.get("php") != "8.2" or requirements.get("postgresql") is not True:
        raise ModError("Manifest requirements must be {\"php\": \"8.2\", \"postgresql\": true}.")
    result["requirements"] = {"php": "8.2", "postgresql": True}

    setup = manifest.get("setup")
    if not isinstance(setup, dict) or set(setup) != SETUP_KEYS:
        raise ModError("Manifest setup must contain exactly: " + ", ".join(sorted(SETUP_KEYS)))
    clean_setup = {}
    for key in ("config_template", "config_path", "migrate_script"):
        clean_setup[key] = validate_relative_path(setup.get(key), "setup." + key)
        if not clean_setup[key].endswith(".php"):
            raise ModError(f"Manifest setup.{key} must be a .php file.")
    for key in ("token_placeholder", "database_placeholder"):
        value = setup.get(key)
        if not isinstance(value, str) or not PLACEHOLDER_PATTERN.match(value):
            raise ModError(f"Manifest setup.{key} must be 6-64 letters, digits, or underscores.")
        clean_setup[key] = value
    if clean_setup["config_template"] == clean_setup["config_path"]:
        raise ModError("Manifest setup.config_path must differ from setup.config_template.")
    if clean_setup["token_placeholder"] == clean_setup["database_placeholder"]:
        raise ModError("Manifest placeholders must differ.")
    result["setup"] = clean_setup
    result["assets"] = parse_assets(manifest.get("assets"))
    result["branches"] = parse_branches(manifest.get("branches"))
    if version == 2:
        try:
            release_support().validate_distribution(manifest)
        except (ValueError, TypeError, KeyError) as error:
            raise ModError(str(error))
        result["game"] = manifest["game"]
        result["distribution"] = manifest["distribution"]
    if result["server_folder"]:
        check_served_paths(result)
    return result


def check_served_paths(manifest, suffix=""):
    """A direct root always gets the project source denials, so nothing it serves may live there."""
    for label, path in [("dashboard_path", manifest["dashboard_path"]), ("health_path", manifest["health_path"])] + \
            [("assets." + k, v) for k, v in manifest["assets"].items()]:
        if re.match(rf"^({PROJECT_SOURCE_DIRS})(/|$)", path) or re.search(rf"(^|/)({PROJECT_PRIVATE_FILES})$", path):
            raise ModError(f"Manifest {label} is in a folder or file a server_folder install never serves.{suffix}")


def validate_branch_name(branch, message="The repository default branch name is not supported."):
    if (not isinstance(branch, str) or not BRANCH_PATTERN.match(branch) or ".." in branch or "//" in branch
            or branch.endswith((".lock", "/", "."))):
        raise ModError(message)
    return branch


def parse_branches(branches):
    """Optional {"default", "allowed"} branch policy; None means the repository default branch alone.

    Only the manifest on the repository's default branch (remote HEAD) is authoritative; see
    branch_policy. Branch existence is checked against the remote there, not here.
    """
    if branches is None:
        return None
    if not isinstance(branches, dict) or set(branches) != BRANCH_KEYS:
        raise ModError("Manifest branches must contain exactly default and allowed.")
    allowed = branches.get("allowed")
    if not isinstance(allowed, list) or not 1 <= len(allowed) <= MAX_BRANCHES:
        raise ModError(f"Manifest branches.allowed must list 1-{MAX_BRANCHES} branch names.")
    clean = [validate_branch_name(name, "Manifest branches.allowed contains an unsupported branch name.")
             for name in allowed]
    if len(set(clean)) != len(clean):
        raise ModError("Manifest branches.allowed lists a branch twice.")
    if branches.get("default") not in clean:
        raise ModError("Manifest branches.default must be one of branches.allowed.")
    return {"default": branches["default"], "allowed": clean}


def parse_assets(assets):
    """Optional {"icon", "banner"} image paths; missing means none. Files are checked in validate_tree."""
    if assets is None:
        return {}
    if not isinstance(assets, dict) or set(assets) - set(ASSET_KEYS):
        raise ModError("Manifest assets may only contain: " + ", ".join(ASSET_KEYS))
    clean = {}
    for key in ASSET_KEYS:
        if key in assets:
            path = validate_relative_path(assets[key], "assets." + key)
            if not path.lower().endswith(ASSET_EXTENSIONS):
                raise ModError(f"Manifest assets.{key} must be a .png, .jpg, or .jpeg file.")
            clean[key] = path
    return clean


def validate_tree(entries, manifest):
    """Validate a `git ls-tree -r -z` listing (mode, type, path) before checkout.

    Symlinks, submodules, and tracked private config paths are rejected, so an
    incoming commit can never place a link or overwrite the generated config.
    """
    paths = set()
    for mode, kind, path in entries:
        if mode == "120000":
            raise ModError(f"The repository contains a symbolic link ({path}); links are not supported.")
        if kind != "blob" or mode not in ("100644", "100755"):
            raise ModError(f"The repository contains an unsupported entry ({path}).")
        segments = path.split("/")
        if any(s in ("", ".", "..") for s in segments) or any(ord(c) < 0x20 for c in path) or "\\" in path:
            raise ModError("The repository contains an unsupported file path.")
        if any(s.lower() == ".git" for s in segments):
            raise ModError("The repository contains an unsupported .git path.")
        paths.add(path)
    setup = manifest["setup"]
    private = setup["config_path"]
    for path in paths:
        if path == private or path.startswith(private + "/") or private.startswith(path + "/"):
            raise ModError(f"The repository tracks the private config path {private}.")
    for key in ("config_template", "migrate_script"):
        if setup[key] not in paths:
            raise ModError(f"The repository does not contain setup.{key} ({setup[key]}).")
    if manifest["health_path"] not in paths:
        raise ModError("The repository does not contain the manifest health_path file.")
    for key, path in manifest["assets"].items():
        if path not in paths:
            raise ModError(f"The repository does not contain the manifest assets.{key} file.")
    if MANIFEST_NAME not in paths:
        raise ModError(f"The repository does not contain {MANIFEST_NAME}.")
    return paths


def render_config(template, setup, token, database):
    """Fill the template's quoted placeholders. Each must appear exactly once as a PHP string."""
    if len(template) > MAX_TEMPLATE_BYTES:
        raise ModError("The config template is too large.")
    text = template.decode("utf-8") if isinstance(template, bytes) else template
    for placeholder, value in ((setup["token_placeholder"], token), (setup["database_placeholder"], database)):
        quoted = "'" + placeholder + "'"
        if text.count(placeholder) != 1 or text.count(quoted) != 1:
            raise ModError("The config template must contain each placeholder exactly once as a quoted PHP string.")
        text = text.replace(quoted, "'" + value + "'")
    if not text.lstrip().startswith("<?php"):
        raise ModError("The config template must be a PHP file.")
    return text


def parse_ls_tree(output):
    entries = []
    for record in output.split(b"\0"):
        if not record:
            continue
        meta, _, path = record.partition(b"\t")
        parts = meta.split(b" ")
        if len(parts) != 3:
            raise ModError("Could not read the repository file list.")
        try:
            entries.append((parts[0].decode(), parts[1].decode(), path.decode("utf-8")))
        except UnicodeDecodeError:
            raise ModError("The repository contains a file name that is not UTF-8.")
    return entries


def parse_default_branch(ls_remote_output):
    """Read the remote HEAD symref from `git ls-remote --symref <url> HEAD`."""
    for line in ls_remote_output.splitlines():
        match = re.match(r"^ref: refs/heads/(\S+)\tHEAD$", line)
        if match:
            return validate_branch_name(match.group(1))
    raise ModError("Could not discover the repository default branch.")


def parse_remote_refs(ls_remote_output):
    """Default branch and {branch: commit} from `git ls-remote --symref <url> HEAD refs/heads/*`."""
    heads = {}
    for line in ls_remote_output.splitlines():
        commit, _, ref = line.partition("\t")
        if ref.startswith("refs/heads/") and SHA_PATTERN.match(commit):
            heads[ref[len("refs/heads/"):]] = commit
    return parse_default_branch(ls_remote_output), heads


def branch_policy(head_manifest, head_branch, heads):
    """The author's policy from the default branch's manifest; without one, that branch alone.

    The installed branch's manifest is never consulted, so a branch cannot widen its own offer.
    """
    policy = head_manifest["branches"] or {"default": head_branch, "allowed": [head_branch]}
    for branch in policy["allowed"]:
        if branch not in heads:
            raise ModError(f"The manifest offers branch {branch}, which the repository does not have.")
    return {"default": policy["default"], "allowed": list(policy["allowed"])}


def stored_policy(entry):
    """The last checked policy from the registry (no network); old entries offer their branch alone."""
    try:
        policy = parse_branches(entry.get("branches"))
    except ModError:
        policy = None
    branch = entry.get("branch", "")
    return policy or {"default": branch, "allowed": [branch] if branch else []}


def parse_custom_port(text):
    """CUSTOM_MODS_PORT from the services file, read as data and never sourced; the last line wins."""
    port = CUSTOM_PORT_DEFAULT
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("#") or "CUSTOM_MODS_PORT" not in line:
            continue
        match = CUSTOM_PORT_LINE.match(line)
        if not match or not CUSTOM_PORT_MIN <= int(match.group(2)) <= CUSTOM_PORT_MAX:
            raise ModError(f"CUSTOM_MODS_PORT in {SERVICES_CONF} must be a whole number from "
                           f"{CUSTOM_PORT_MIN} to {CUSTOM_PORT_MAX}.")
        port = int(match.group(2))
    return port


CUSTOM_PORT = None


def custom_port():
    """The configured shared port; the default when the root-owned services file does not set it."""
    global CUSTOM_PORT
    if CUSTOM_PORT is None:
        try:
            info_ = os.lstat(SERVICES_CONF)
        except FileNotFoundError:
            CUSTOM_PORT = CUSTOM_PORT_DEFAULT
            return CUSTOM_PORT
        if not stat.S_ISREG(info_.st_mode) or info_.st_uid != 0 or info_.st_mode & 0o022:
            raise ModError(f"{SERVICES_CONF} must be a plain root-owned file that only root can change.")
        try:
            with open(SERVICES_CONF, encoding="utf-8") as handle:
                text = handle.read(64 * 1024)
        except (OSError, UnicodeDecodeError):
            raise ModError(f"Could not read {SERVICES_CONF}.")
        CUSTOM_PORT = parse_custom_port(text)
    return CUSTOM_PORT


def route_path(mod_id, server_folder=""):
    """The URL path of a mod: /<server_folder> for a direct root, else /custom-mods/<id>."""
    if server_folder:
        return "/" + validate_server_folder(server_folder)
    return "/custom-mods/" + validate_mod_id(mod_id)


def route_base(mod_id, server_folder=""):
    return f"http://127.0.0.1:{custom_port()}{route_path(mod_id, server_folder)}"


def mod_urls(mod_id, manifest):
    """Dashboard and health URLs; manifest["server_folder"] must be the registered one for an installed mod."""
    base = route_base(mod_id, manifest.get("server_folder", "")) + "/"
    return base + manifest["dashboard_path"], base + manifest["health_path"]


def entry_folder(entry):
    """The canonical folder of a registry entry: its validated server_folder under WEB_ROOT, else custom-mods/<id>."""
    if entry.get("server_folder"):
        return WEB_ROOT + "/" + validate_server_folder(entry["server_folder"])
    return mod_folder(entry["id"])


def asset_urls(entry):
    """Fixed-route icon/banner URLs for the installed revision; empty when absent, invalid, or not a plain file."""
    try:
        assets = parse_assets(entry.get("assets"))
        folder = entry_folder(entry)
    except ModError:
        return {"icon_url": "", "banner_url": ""}
    urls = {}
    for key in ASSET_KEYS:
        path = assets.get(key, "")
        usable = path and not path_has_links(folder, path) and os.path.isfile(folder + "/" + path)
        urls[key + "_url"] = f"{route_base(entry['id'], entry.get('server_folder', ''))}/{path}" if usable else ""
    return urls


# --- Process helpers ------------------------------------------------------------------

def run(args, *, user=None, cwd=None, timeout=120, input_bytes=None, env_extra=None):
    env = {"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"}
    if user:
        env["HOME"] = "/home/" + user if user == APP_USER else "/"
    if env_extra:
        env.update(env_extra)
    command = list(args)
    if user and os.geteuid() == 0:
        command = ["runuser", "-u", user, "--"] + command
    try:
        return subprocess.run(command, cwd=cwd or "/", env=env, input=input_bytes,
                              capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise ModError(f"{os.path.basename(args[0])} timed out.")


# No user or system Git config: no credential helpers, no stored credentials, no prompts.
GIT_ENV = {"GIT_TERMINAL_PROMPT": "0", "GIT_ASKPASS": "/bin/false", "SSH_ASKPASS": "/bin/false",
           "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"}


def git_args(local_source):
    allow = ["-c", "protocol.allow=never", "-c", "protocol.https.allow=always"]
    if local_source:
        allow += ["-c", "protocol.file.allow=always"]
    return ["git", "-c", "credential.helper=", "-c", "core.hooksPath=/dev/null",
            "-c", "core.symlinks=false", "-c", "submodule.recurse=false"] + allow


def git(args, *, cwd=None, local_source=False, timeout=120, check=True, message="Git failed."):
    result = run(git_args(local_source) + list(args), user=APP_USER, cwd=cwd, timeout=timeout,
                 env_extra=GIT_ENV)
    if check and result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip().splitlines()[-1:] or [""]
        raise ModError(message + (" " + redact(detail[0])[:200] if detail[0] else ""))
    return result


def require_root():
    if os.geteuid() != 0:
        raise ModError("This command must run as root.")


def require_php_security():
    """Install, update, and switch deploy and migrate mod PHP; require the fixed shared PHP first.

    The helper does no APT or network work when PHP is already fixed. Its progress goes to
    stderr so stdout stays reserved for JSON results.
    """
    helper = next((path for path in PHP_SECURITY_HELPERS if os.access(path, os.X_OK)), None)
    if helper is None:
        raise ModError("The PHP security helper is unavailable. Update DwemerDistro first.")
    sys.stderr.flush()
    # No timeout here: the helper bounds its own APT lock waits, and killing it mid-upgrade
    # would leave APT running unseen.
    result = subprocess.run([helper], env={"PATH": SAFE_PATH, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
                            cwd="/", stdin=subprocess.DEVNULL, stdout=sys.stderr)
    if result.returncode != 0:
        raise ModError("The PHP security update is incomplete, so the mod files and data were not updated. "
                       "Shared PHP may still need repair or a restart; see the messages above.")


def validate_local_source(path):
    """Admin-only fixture input: an absolute local Git repository path."""
    if not isinstance(path, str) or not path.startswith("/") or ".." in path.split("/"):
        raise ModError("--local-source must be an absolute path.")
    if any(ord(c) < 0x21 or ord(c) > 0x7E for c in path):
        raise ModError("--local-source contains unsupported characters.")
    if not os.path.exists(path):
        raise ModError("--local-source does not exist.")
    return path


# --- Lock (same protocol as ddistro_server acquire_operation_lock) ----------------------

LOCK_HELD = False


def acquire_lock():
    global LOCK_HELD
    os.makedirs(os.path.dirname(LOCK_PATH), exist_ok=True)
    for _ in range(2):
        try:
            os.mkdir(LOCK_PATH)
            with open(LOCK_PATH + "/pid", "w") as handle:
                handle.write(f"{os.getpid()}\n")
            LOCK_HELD = True
            return
        except FileExistsError:
            if lock_owner_alive():
                raise ModError("Another server install, update, repair, or uninstall operation is running.")
            try:
                os.unlink(LOCK_PATH + "/pid")
            except OSError:
                pass
            try:
                os.rmdir(LOCK_PATH)
            except OSError:
                pass
    raise ModError("Another server install, update, repair, or uninstall operation is running.")


def lock_pid():
    try:
        with open(LOCK_PATH + "/pid") as handle:
            pid = handle.readline().strip()
    except OSError:
        return None
    return int(pid) if pid.isdigit() else None


def lock_owner_alive():
    pid = lock_pid()
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True
    except OSError:
        return False


def release_lock():
    global LOCK_HELD
    if LOCK_HELD:
        try:
            os.unlink(LOCK_PATH + "/pid")
            os.rmdir(LOCK_PATH)
        except OSError:
            pass
        LOCK_HELD = False


# --- Registry -------------------------------------------------------------------------

def ensure_state_dirs():
    # Explicit modes: root's 0077 umask must not hide the registry from dwemer status reads.
    for path, mode in ((STATE_ROOT, 0o755), (REGISTRY_ROOT, 0o755), (BACKUP_ROOT, 0o700)):
        if os.path.islink(path):
            raise ModError(f"Refusing to use linked state path {path}.")
        os.makedirs(path, exist_ok=True)
        os.chown(path, 0, 0)
        os.chmod(path, mode)


def registry_path(mod_id):
    return f"{REGISTRY_ROOT}/{validate_mod_id(mod_id)}.json"


def read_entry(mod_id, include_unregistered=False):
    try:
        with open(registry_path(mod_id), encoding="utf-8") as handle:
            entry = json.load(handle)
    except FileNotFoundError:
        raise ModError(f"Custom mod {mod_id} is not registered.")
    except ValueError:
        raise ModError(f"Registry entry for {mod_id} is unreadable.")
    if not isinstance(entry, dict) or entry.get("id") != mod_id:
        raise ModError(f"Registry entry for {mod_id} is unreadable.")
    if entry.get("state") == UNREGISTERED and not include_unregistered:
        raise ModError(f"Custom mod {mod_id} is not registered.")
    return entry


def write_entry(entry):
    """Atomic, world-readable (no secrets), root-owned registry write, synced so an interrupted move resumes from it."""
    ensure_state_dirs()
    write_root_file(registry_path(entry["id"]), json.dumps(entry, indent=2, sort_keys=True) + "\n")


def list_entries():
    entries = []
    try:
        names = sorted(os.listdir(REGISTRY_ROOT))
    except FileNotFoundError:
        return entries
    for name in names:
        if not name.endswith(".json") or name.startswith("."):
            continue
        try:
            entries.append(read_entry(name[:-5]))
        except ModError:
            # Unreadable entries and unregistered tombstones stay out of the list.
            continue
    return entries


# --- Repository inspection ------------------------------------------------------------

def discover_remote_refs(source, local_source):
    result = git(["ls-remote", "--symref", source, "HEAD", "refs/heads/*"], local_source=local_source,
                 timeout=60, message="Could not reach the repository.")
    return parse_remote_refs(result.stdout.decode("utf-8", "replace"))


def read_commit_manifest(checkout, ref):
    """Read and validate the manifest and tree from a commit, never from the worktree."""
    raw = git(["show", f"{ref}:{MANIFEST_NAME}"], cwd=checkout,
              message=f"The repository has no {MANIFEST_NAME} at its root.").stdout
    manifest = parse_manifest(raw)
    tree = git(["ls-tree", "-r", "-z", "--full-tree", ref], cwd=checkout,
               message="Could not list repository files.").stdout
    paths = validate_tree(parse_ls_tree(tree), manifest)
    template = git(["show", f"{ref}:{manifest['setup']['config_template']}"], cwd=checkout,
                   message="Could not read the config template.").stdout
    render_config(template, manifest["setup"], "x" * 48, database_name_for(manifest["id"]))
    commit = git(["rev-parse", "--verify", ref + "^{commit}"], cwd=checkout).stdout.decode().strip()
    if not SHA_PATTERN.match(commit):
        raise ModError("Could not read the repository commit.")
    return manifest, paths, template, commit


def inspect_repository(source, local_source, branch=None, policy_only=False):
    """Shallow, bounded, no-checkout clone into a private dwemer temp dir.

    The branch policy is read from the remote default branch's manifest. The target branch
    (the authored default unless given) must be offered and must keep the same mod id.
    Returns (manifest, branch, commit, policy); policy_only skips the target branch.
    """
    head_branch, heads = discover_remote_refs(source, local_source)
    temp = run(["mktemp", "-d", "/tmp/ddistro-custom-mod-check.XXXXXXXX"], user=APP_USER)
    if temp.returncode != 0:
        raise ModError("Could not create a temporary folder.")
    temp_root = temp.stdout.decode().strip()
    if not temp_root.startswith("/tmp/ddistro-custom-mod-check."):
        raise ModError("Unexpected temporary folder.")
    try:
        repo = temp_root + "/repo"
        depth = [] if local_source else ["--depth", "1"]
        git(["clone", "--quiet", "--no-checkout", "--single-branch", "--no-tags", "--branch", head_branch]
            + depth + ["--", source, repo], local_source=local_source,
            timeout=CHECK_TIMEOUT, message="Could not download the repository.")
        manifest, _, _, commit = read_commit_manifest(repo, "HEAD")
        policy = branch_policy(manifest, head_branch, heads)
        if policy_only:
            return manifest, head_branch, commit, policy
        target = branch or policy["default"]
        if target not in policy["allowed"]:
            raise ModError(f"Branch {target} is not offered by this mod. Offered: " + ", ".join(policy["allowed"]))
        if target != head_branch:
            head_id = manifest["id"]
            git(["fetch", "--quiet", "--no-tags"] + depth + [source, f"+refs/heads/{target}:refs/remotes/origin/{target}"],
                cwd=repo, local_source=local_source, timeout=CHECK_TIMEOUT,
                message=f"Could not download branch {target}.")
            manifest, _, _, commit = read_commit_manifest(repo, f"refs/remotes/origin/{target}")
            if manifest["id"] != head_id:
                raise ModError(f"Branch {target} declares a different mod id. It is not offered.")
        return manifest, target, commit, policy
    finally:
        run(["rm", "-rf", "--", temp_root], user=APP_USER, timeout=120)


def registry_state(mod_id, source, local):
    """'none', 'registered', 'restorable' (own tombstone, same source) or 'conflict'."""
    if not os.path.lexists(registry_path(mod_id)):
        return "none", None
    entry = read_entry(mod_id, include_unregistered=True)
    if entry.get("state") != UNREGISTERED:
        return "registered", entry
    if entry.get("repository") == source and bool(entry.get("local_source")) == local:
        return "restorable", entry
    return "conflict", entry


def preview_document(manifest, branch, commit, source, local, policy):
    state, entry = registry_state(manifest["id"], source, local)
    # An existing install keeps its registered location; the manifest only chooses it for a new one.
    server_folder = entry.get("server_folder", "") if state in ("registered", "restorable") else manifest["server_folder"]
    dashboard_url, health_url = mod_urls(manifest["id"], dict(manifest, server_folder=server_folder))
    return {
        "branches": policy,
        "schema_version": STATUS_SCHEMA_VERSION,
        "id": manifest["id"],
        "name": manifest["name"],
        "description": manifest["description"],
        "project_url": manifest["project_url"],
        "repository": source,
        "branch": branch,
        "commit": commit,
        "requirements": manifest["requirements"],
        "folder": entry_folder({"id": manifest["id"], "server_folder": server_folder}),
        "server_folder": server_folder,
        "database": database_name_for(manifest["id"]),
        "dashboard_url": dashboard_url,
        "health_url": health_url,
        "registered": state == "registered",
        # Add reattaches the kept installation as it is; it never installs this newer commit.
        "restorable": state == "restorable",
        "installed_commit": entry.get("commit", "") if state == "restorable" else "",
    }


# --- PostgreSQL (root, as the postgres superuser; names are validated custom_* only) -----

def psql_value(sql):
    result = run(["psql", "-p", POSTGRES_PORT, "-d", "template1", "-XAtq", "-v", "ON_ERROR_STOP=1",
                  "-c", sql], user="postgres", timeout=30)
    if result.returncode != 0:
        raise ModError("PostgreSQL is not available.")
    return result.stdout.decode().strip()


def database_exists(name):
    assert re.match(r"^custom_[a-z0-9_]+\Z", name)
    return psql_value(f"SELECT 1 FROM pg_database WHERE datname = '{name}'") == "1"


def require_existing_role():
    # The role is shared with official servers: never create, alter, or re-password it here.
    if psql_value(f"SELECT 1 FROM pg_roles WHERE rolname = '{DATABASE_ROLE}' AND rolcanlogin") != "1":
        raise ModError("The shared dwemer database role is missing. Run Update Distro first.")


def create_database(name):
    assert re.match(r"^custom_[a-z0-9_]+\Z", name)
    result = run(["createdb", "-p", POSTGRES_PORT, "--maintenance-db=template1", "--owner=" + DATABASE_ROLE,
                  "--encoding=UTF8", "--locale=C", "--template=template0", name], user="postgres", timeout=60)
    if result.returncode != 0:
        raise ModError(f"Could not create database {name}.")


def database_owner(name):
    assert re.match(r"^custom_[a-z0-9_]+\Z", name)
    return psql_value("SELECT pg_get_userbyid(datdba) FROM pg_database "
                      f"WHERE datname = '{name}'")


# --- Filesystem -----------------------------------------------------------------------

def ensure_mod_root():
    """Root-owned parent so dwemer cannot plant links or folders between mod folders."""
    if os.path.islink(MOD_ROOT):
        raise ModError(f"Refusing to use linked folder {MOD_ROOT}.")
    os.makedirs(MOD_ROOT, exist_ok=True)
    os.chown(MOD_ROOT, 0, 0)
    os.chmod(MOD_ROOT, 0o755)


def require_safe_web_root():
    """A direct root's parent is WEB_ROOT itself; it is checked, never changed.

    DwemerDistro ships it as dwemer:www-data 2755, so root or the app account may own it; no group or
    other write and no links. Because dwemer may then add names to it, root changes a new direct root
    only through a no-follow handle (create_direct_root, apply_permissions).
    """
    try:
        info_ = os.lstat(WEB_ROOT)
    except FileNotFoundError:
        raise ModError(f"{WEB_ROOT} is missing.")
    if (not stat.S_ISDIR(info_.st_mode) or info_.st_uid not in (0, pwd_uid(APP_USER)) or info_.st_mode & 0o022
            or path_has_linked_part(WEB_ROOT)):
        raise ModError(f"{WEB_ROOT} must be a folder owned by root or {APP_USER} that no group or other user can "
                       "change, reached without links, before a server folder can be placed in it. Nothing was changed.")


def create_direct_root(folder):
    """mkdir WEB_ROOT/<server folder> and hand it to dwemer; refuses a name or folder that appeared meanwhile."""
    try:
        os.mkdir(folder, 0o750)
    except FileExistsError:
        raise ModError(f"{folder} appeared during install. It was kept and is not adopted.")
    try:
        fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        raise ModError(f"{folder} was replaced during install. It was kept and is not adopted.")
    try:
        if os.fstat(fd).st_uid != 0 or os.listdir(fd):
            raise ModError(f"{folder} was replaced during install. It was kept and is not adopted.")
        os.fchown(fd, pwd_uid(APP_USER), group_id(WEB_GROUP))
    finally:
        os.close(fd)


def server_folder_claims(name, mod_id):
    """Why name cannot become mod_id's direct root (an entry, another registry claim, any letter case), or None."""
    lower = name.lower()
    try:
        existing = os.listdir(WEB_ROOT)
    except FileNotFoundError:
        existing = []
    for entry_name in existing:
        if entry_name.lower() == lower:
            return f"{WEB_ROOT}/{entry_name} already exists. It was kept and is not adopted."
    try:
        names = os.listdir(REGISTRY_ROOT)
    except FileNotFoundError:
        names = []
    for file_name in names:
        if not file_name.endswith(".json") or file_name.startswith(".") or file_name[:-5] == mod_id:
            continue
        try:
            other = read_entry(file_name[:-5], include_unregistered=True)
        except ModError:
            continue
        pending = other.get("migration") if isinstance(other.get("migration"), dict) else {}
        if lower in (str(other.get("server_folder", "")).lower(), str(pending.get("server_folder", "")).lower()):
            return f"Server folder {name} is already registered to {other['id']}."
    return None


def mod_folder(mod_id):
    return f"{MOD_ROOT}/{validate_mod_id(mod_id)}"


def refuse_pending_move(entry):
    """Nothing but migrate-root itself touches an entry whose move was interrupted."""
    record = entry.get("migration")
    if record is not None:
        name = record.get("server_folder") if isinstance(record, dict) else None
        raise ModError(f"A move of {entry['id']} to /{name} was interrupted. Run sudo ddistro_custom_mod migrate-root "
                       f"{entry['id']} --server-folder {name} to finish or undo it. Nothing was changed.")


def checked_folder(entry):
    refuse_pending_move(entry)
    folder = entry_folder(entry)
    if entry.get("folder") != folder or os.path.islink(folder) or not os.path.isdir(folder):
        raise ModError("The custom mod folder is missing or not a plain folder.")
    if os.path.realpath(folder) != folder:
        raise ModError("The custom mod folder path resolves through a link.")
    return folder


def path_has_linked_part(path):
    """True if the path or any parent is a link, so recursion could land outside the scoped folder."""
    current = path
    while True:
        if os.path.islink(current):
            return True
        parent = os.path.dirname(current)
        if parent == current:
            return False
        current = parent


def apply_permissions(folder):
    # Same contract as official servers: dwemer:www-data, group-readable, no world access.
    # find -P never follows links; validate_tree already rejected tracked links.
    if not is_scoped_folder(folder) or path_has_linked_part(folder) or not os.path.isdir(folder):
        raise ModError("Refusing to set permissions outside a custom mod folder.")
    direct = os.path.dirname(folder) == WEB_ROOT
    commands = [["find", "-P", folder, "-exec", "chown", "-h", f"{APP_USER}:{WEB_GROUP}", "{}", "+"],
                ["find", "-P", folder, "-type", "d", "-exec", "chmod", "u+rwx,g+rxs,g-w,o-rwx", "{}", "+"],
                ["find", "-P", folder, "-type", "f", "-exec", "chmod", "u+rw,g+r,g-w,o-rwx", "{}", "+"]]
    if not direct:
        commands.append(["chmod", "u+rwx,g+rxs,o-rwx", "--", folder])
    for command in commands:
        if run(command, timeout=300).returncode != 0:
            raise ModError("Could not set the mod folder's owner and permissions.")
    if direct:
        # dwemer may own WEB_ROOT and swap the name for a link; chmod would follow it, fchmod on O_NOFOLLOW cannot.
        try:
            fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except OSError:
            raise ModError("Could not set the mod folder's owner and permissions.")
        try:
            os.fchmod(fd, (stat.S_IMODE(os.fstat(fd).st_mode) | 0o750 | stat.S_ISGID) & ~0o007)
        finally:
            os.close(fd)


def is_scoped_folder(folder):
    """custom-mods/<valid id> or WEB_ROOT/<valid server folder>, exactly; nothing else under the web root."""
    parent, name = os.path.split(folder)
    try:
        if parent == MOD_ROOT:
            return folder == mod_folder(name)
        if parent == WEB_ROOT:
            return name == validate_server_folder(name)
    except ModError:
        return False
    return False


def path_has_links(folder, relative):
    current = folder
    for segment in relative.split("/"):
        current = current + "/" + segment
        if os.path.islink(current):
            return True
        if not os.path.exists(current):
            return False
    return False


def write_config_if_missing(folder, manifest, template, mod_id):
    """Generate the private config once, as dwemer, with a fresh random token."""
    setup = manifest["setup"]
    config_path = folder + "/" + setup["config_path"]
    if path_has_links(folder, setup["config_path"]):
        raise ModError("The private config path goes through a link.")
    if os.path.lexists(config_path):
        info("Keeping the existing private config.")
        return
    token = secrets.token_hex(24)
    SECRETS_TO_REDACT.append(token)
    text = render_config(template, setup, token, database_name_for(mod_id))
    parent = os.path.dirname(config_path)
    if not os.path.isdir(parent):
        result = run(["mkdir", "-p", "--", parent], user=APP_USER)
        if result.returncode != 0 or path_has_links(folder, setup["config_path"]):
            raise ModError("Could not create the private config folder.")
    # noclobber (set -C) refuses to replace anything that appeared in the meantime.
    result = run(["sh", "-c", 'umask 027 && set -C && cat > "$1"', "sh", config_path], user=APP_USER,
                 input_bytes=text.encode("utf-8"))
    if result.returncode != 0:
        raise ModError("Could not write the private config.")
    if os.path.islink(config_path) or not os.path.isfile(config_path):
        raise ModError("The private config is not a regular file.")
    os.chown(config_path, -1, group_id(WEB_GROUP), follow_symlinks=False)
    os.chmod(config_path, 0o640)
    ok("Created the private config with a new random token.")


def group_id(name):
    return grp.getgrnam(name).gr_gid


def run_setup_checks(folder, manifest):
    """Config syntax and migration run as dwemer; root never loads repository PHP."""
    setup = manifest["setup"]
    config_path = folder + "/" + setup["config_path"]
    for user in (APP_USER, WEB_GROUP):
        if run(["test", "-r", config_path], user=user).returncode != 0:
            raise ModError(f"{user} cannot read the private config.")
    if run(["php", "-l", config_path], user=APP_USER, cwd=folder).returncode != 0:
        raise ModError("The private config has a PHP syntax error.")
    info("Applying database migrations as dwemer.")
    result = run(["php", setup["migrate_script"]], user=APP_USER, cwd=folder, timeout=MIGRATE_TIMEOUT)
    for line in result.stdout.decode("utf-8", "replace").splitlines()[-20:]:
        info(line[:300])
    if result.returncode != 0:
        for line in result.stderr.decode("utf-8", "replace").splitlines()[-5:]:
            info(line[:300])
        raise ModError("The mod's database migration failed.")


def check_health(mod_id, manifest):
    _, url = mod_urls(mod_id, manifest)
    request = urllib.request.Request(url, method="GET", headers={"User-Agent": "ddistro_custom_mod"})
    opener = urllib.request.build_opener(NoRedirect)
    try:
        with opener.open(request, timeout=10) as response:
            if response.status == 200:
                return True, "Healthy."
            return False, f"Health check returned HTTP {response.status}."
    except urllib.error.HTTPError as error:
        return False, f"Health check returned HTTP {error.code}."
    except (urllib.error.URLError, OSError):
        return False, "The web server is not reachable. Start the server, then choose Update to finish."


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


# --- Shared web listener (root; Apache config only, never repository code) -------------

# Never served from a mod checkout: Git metadata in any custom mod or a manual ExampleServer,
# and the source-only folders and private files of the known Kagrenac install paths (launcher
# id, manual folder, legacy path). A manually named or forked copy elsewhere needs setup-web
# --protect-project (custom-mods/<id> only) or its own server-side rules.
GIT_DENY_DIR = r"^/var/www/html/(ExampleServer|custom-mods/[^/]+)/(.+/)?\.git(/|$)"
GIT_DENY_URL = r"^/+(ExampleServer|custom-mods/+[^/]+)/+(.*/)?\.git(/|$)"
# Root-level folders and any-depth file names hidden for the known paths and opted-in projects.
PROJECT_SOURCE_DIRS = "client|ports|docs|config|lib|sql|scripts"
PROJECT_PRIVATE_FILES = r"config\.json|\.env"


def deny_rules(dir_roots, url_roots):
    """(source folder, project folder, URL) patterns for project roots given as regex alternatives."""
    return (rf"^/var/www/html/({dir_roots})/({PROJECT_SOURCE_DIRS})(/|$)",
            rf"^/var/www/html/({dir_roots})(/|$)",
            rf"^/+({url_roots})/+(({PROJECT_SOURCE_DIRS})(/|$)|(.*/)?({PROJECT_PRIVATE_FILES})(/|$))")


SOURCE_DENY_DIR, PRIVATE_DENY_DIR, SOURCE_DENY_URL = deny_rules(
    "ExampleServer|custom-mods/(example-server|KagrenacServer)", "ExampleServer|custom-mods/+(example-server|KagrenacServer)")


def project_deny_rules(protected):
    """The same patterns scoped to the opted-in custom-mods/<id> only, each id validated and escaped."""
    ids = "|".join(re.escape(validate_mod_id(mod_id)) for mod_id in protected)
    return deny_rules(f"custom-mods/({ids})", f"custom-mods/+({ids})")


def deny_dir_text(source_dir, project_dir):
    return (f'<DirectoryMatch "{source_dir}">\n\tRequire all denied\n</DirectoryMatch>\n'
            f'<DirectoryMatch "{project_dir}">\n\t<FilesMatch "^({PROJECT_PRIVATE_FILES})$">\n'
            "\t\tRequire all denied\n\t</FilesMatch>\n</DirectoryMatch>\n")


def read_protected_projects():
    return read_protected_list(PROTECTED_PROJECTS, validate_mod_id, MAX_PROTECTED_PROJECTS)


def read_protected_roots():
    return read_protected_list(PROTECTED_ROOTS, validate_server_folder, MAX_PROTECTED_ROOTS)


def read_protection_lists():
    read_protected_projects()
    read_protected_roots()


def read_protected_list(path, validate, maximum):
    """The opted-in names; missing means none. Anything but a private root file of valid names is refused.

    The writer never saves an empty list and nothing removes ids, so an empty file is damage, not "none".

    Refusing (instead of skipping) means the listener is never rewritten without a protection
    that was asked for.
    """
    try:
        parent = os.lstat(STATE_ROOT)
    except FileNotFoundError:
        return []
    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0 or parent.st_mode & 0o022:
        raise ModError(f"{STATE_ROOT} is not a root-owned folder that only root can change. Nothing was changed.")
    problem = f"{path} is not a private root-owned list (0600). Nothing was changed."
    try:
        # Non-blocking, so a FIFO or device returns at once and is then refused by the fstat check.
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY)
    except FileNotFoundError:
        return []
    except OSError:
        raise ModError(problem)
    with os.fdopen(fd, "rb") as handle:
        info_ = os.fstat(handle.fileno())
        if not stat.S_ISREG(info_.st_mode) or info_.st_uid != 0 or info_.st_mode & 0o777 != 0o600:
            raise ModError(problem)
        raw = handle.read(maximum * 48 + 1)
    try:
        lines = raw.decode("ascii").split("\n")
    except UnicodeDecodeError:
        raise ModError(problem)
    if lines[-1] != "" or len(lines) - 1 > maximum:
        raise ModError(problem)
    projects = lines[:-1]
    if not projects:
        raise ModError(problem)
    try:
        for name in projects:
            validate(name)
    except ModError:
        raise ModError(problem)
    if len(set(projects)) != len(projects):
        raise ModError(problem)
    return projects


def protect_project(mod_id):
    protect_name(PROTECTED_PROJECTS, read_protected_projects, MAX_PROTECTED_PROJECTS, mod_id, f"/custom-mods/{mod_id}")


def protect_root(name):
    protect_name(PROTECTED_ROOTS, read_protected_roots, MAX_PROTECTED_ROOTS, validate_server_folder(name), f"/{name}")


def protect_name(path, reader, maximum, name, route):
    """Persist the opt-in before it is applied, so a failed apply keeps it for the retry and later runs."""
    names = reader()
    if name in names:
        info(f"{route} is already protected.")
        return
    if len(names) >= maximum:
        raise ModError(f"At most {maximum} names can be protected in {path}. Nothing was changed.")
    ensure_state_dirs()
    write_root_file(path, "".join(p + "\n" for p in sorted(names + [name])), mode=0o600)
    # Reading it back checks the real owner, mode, and content that later runs will see.
    if name not in reader():
        raise ModError(f"Could not save the protection for {route}.")
    ok(f"Saved the protection for {route}.")


def web_locations():
    """Direct roots to protect and grant (the saved list plus every registry entry's, tombstones too), and the
    (id, server_folder) legacy aliases of migrated entries. A root never loses protection while it is registered."""
    roots, aliases = set(read_protected_roots()), []
    try:
        names = sorted(os.listdir(REGISTRY_ROOT))
    except FileNotFoundError:
        names = []
    for file_name in names:
        if not file_name.endswith(".json") or file_name.startswith("."):
            continue
        try:
            entry = read_entry(file_name[:-5], include_unregistered=True)
            if not entry.get("server_folder"):
                continue
            folder = validate_server_folder(entry["server_folder"])
        except ModError:
            continue
        roots.add(folder)
        if entry.get("legacy_route") == "/custom-mods/" + entry["id"]:
            aliases.append((entry["id"], folder))
    return sorted(roots), aliases


def root_deny_rules(roots, alias_ids):
    """(source folder, project folder, URL, git folder, git URL) patterns for direct roots and legacy alias URLs."""
    dirs = "|".join(re.escape(validate_server_folder(name)) for name in roots)
    urls = dirs + ("|custom-mods/+(" + "|".join(re.escape(validate_mod_id(i)) for i in alias_ids) + ")" if alias_ids else "")
    return deny_rules(dirs, urls) + (rf"^/var/www/html/({dirs})/(.+/)?\.git(/|$)", rf"^/+({urls})/+(.*/)?\.git(/|$)")


def web_site_text(port, protected=(), roots=(), aliases=()):
    """This manager's own Apache site: one loopback listener serving only the custom mod paths.

    The DirectoryMatch denials sit outside the virtual host, so they also apply on the other
    listeners that serve /var/www/html; the LocationMatch copies come after this listener's
    grant, which would otherwise override them. Opted-in projects only add their own copies.
    Direct roots are granted on this listener by exact name only, with the same denials in place
    everywhere; a migrated mod's old /custom-mods/<id> URL is an Alias to its one folder.
    """
    outside = inside = grant = ""
    if protected:
        source_dir, project_dir, url = project_deny_rules(protected)
        outside = deny_dir_text(source_dir, project_dir)
        inside = f'\t<LocationMatch "{url}">\n\t\tRequire all denied\n\t</LocationMatch>\n'
    if roots:
        source_dir, project_dir, url, git_dir, git_url = root_deny_rules(roots, [i for i, _ in aliases])
        outside += f'<DirectoryMatch "{git_dir}">\n\tRequire all denied\n</DirectoryMatch>\n' + \
            deny_dir_text(source_dir, project_dir)
        grant = "".join(f'\tAlias "/custom-mods/{validate_mod_id(i)}" "{WEB_ROOT}/{validate_server_folder(f)}"\n'
                        for i, f in aliases)
        names = "|".join(re.escape(name) for name in roots)
        grant += f'\t<LocationMatch "^/({names})(/|$)">\n\t\tRequire all granted\n\t</LocationMatch>\n'
        inside += "".join(f'\t<LocationMatch "{pattern}">\n\t\tRequire all denied\n\t</LocationMatch>\n'
                          for pattern in (git_url, url))
    return f"""{WEB_MARKER} To change the port, set
# CUSTOM_MODS_PORT ({CUSTOM_PORT_MIN}-{CUSTOM_PORT_MAX}) in {SERVICES_CONF}, then run:
#   sudo ddistro_custom_mod setup-web
Listen 127.0.0.1:{port}
<DirectoryMatch "{GIT_DENY_DIR}">
\tRequire all denied
</DirectoryMatch>
{deny_dir_text(SOURCE_DENY_DIR, PRIVATE_DENY_DIR)}{outside}<VirtualHost 127.0.0.1:{port}>
\tDocumentRoot /var/www/html
\t<Location "/">
\t\tRequire all denied
\t</Location>
\t<LocationMatch "^/(ExampleServer|custom-mods/[^/]+)(/|$)">
\t\tRequire all granted
\t</LocationMatch>
{grant}\t<LocationMatch "{GIT_DENY_URL}">
\t\tRequire all denied
\t</LocationMatch>
\t<LocationMatch "{SOURCE_DENY_URL}">
\t\tRequire all denied
\t</LocationMatch>
{inside}\tErrorLog ${{APACHE_LOG_DIR}}/custom_mods_error.log
\tCustomLog ${{APACHE_LOG_DIR}}/custom_mods_access.log combined
</VirtualHost>
"""


def config_uses_port(text, port):
    """True if Apache config text listens on, or declares a virtual host for, the port."""
    return bool(re.search(rf"^\s*Listen\s+(?:\S*:)?{port}(?:\s|$)", text, re.M | re.I)
                or re.search(rf"<VirtualHost\s[^>]*:{port}[\s>]", text, re.I))


def apache_conflict(port, own_site):
    """The first other enabled Apache config file that uses the port, or None."""
    paths = [APACHE_DIR + "/apache2.conf", APACHE_DIR + "/ports.conf"]
    for folder in ("sites-enabled", "conf-enabled"):
        try:
            paths += [f"{APACHE_DIR}/{folder}/{name}" for name in sorted(os.listdir(f"{APACHE_DIR}/{folder}"))]
        except FileNotFoundError:
            pass
    for path in paths:
        if os.path.realpath(path) == own_site or not os.path.isfile(path):
            continue
        with open(path, encoding="utf-8", errors="replace") as handle:
            if config_uses_port(handle.read(), port):
                return path
    return None


def port_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def apache_running():
    return run(["/etc/init.d/apache2", "status"], timeout=30).returncode == 0


def write_root_file(path, text, mode=0o644):
    """Atomic replace; the data is synced before the rename and the folder after it, before returning."""
    folder = os.path.dirname(path)
    fd, temp = tempfile.mkstemp(dir=folder, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.chmod(temp, mode)
            os.fsync(handle.fileno())
        os.replace(temp, path)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise
    sync_folder(folder)


def sync_folder(folder):
    if hasattr(os, "O_DIRECTORY"):  # always on Linux; Windows cannot open a folder to sync it
        folder_fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(folder_fd)
        finally:
            os.close(folder_fd)


def apply_apache(reload, port):
    result = run(["apache2ctl", "configtest"], timeout=60)
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip().splitlines()[:1] or [""]
        raise ModError(f"Apache rejected the custom mod listener on port {port}. {detail[0][:200]}".strip())
    if reload and (run(["/etc/init.d/apache2", "reload"], timeout=120).returncode != 0 or not apache_running()):
        raise ModError(f"Apache could not reload with the custom mod listener on port {port}.")
    deadline = time.monotonic() + 5
    while reload:  # a reload returns before the new listener accepts; wait briefly so health checks see it
        try:
            socket.create_connection(("127.0.0.1", port), timeout=0.5).close()
            return
        except OSError:
            if time.monotonic() >= deadline:
                raise ModError(f"Apache reloaded but nothing answered on 127.0.0.1:{port} within 5 seconds.")
            time.sleep(0.2)


def setup_web():
    """Create or move this manager's own loopback listener; repeatable, needs root and the lock.

    Official sites and ports.conf are never edited. Moving the port rewrites only this
    file, so only the old custom listener goes away. On failure the previous file returns.
    """
    port = custom_port()
    available, enabled = APACHE_DIR + "/sites-available", APACHE_DIR + "/sites-enabled"
    site, link = f"{available}/{WEB_SITE}.conf", f"{enabled}/{WEB_SITE}.conf"
    for path in (APACHE_DIR, available, enabled):
        if os.path.islink(path) or not os.path.isdir(path):
            raise ModError(f"{path} is missing or a link. The custom mod listener was not set up.")
    if os.path.lexists(link) and (not os.path.islink(link) or os.path.realpath(link) != site):
        raise ModError(f"{link} is not this manager's site link. Nothing was changed.")
    previous = None
    if os.path.lexists(site):
        info_ = os.lstat(site)
        if not stat.S_ISREG(info_.st_mode) or info_.st_uid != 0 or info_.st_mode & 0o022:
            raise ModError(f"{site} is not a plain root-owned file that only root can change. Nothing was changed.")
        with open(site, encoding="utf-8", errors="replace") as handle:
            previous = handle.read(64 * 1024)
        if not previous.startswith(WEB_MARKER):
            raise ModError(f"{site} was not written by this manager. Nothing was changed.")
    was_enabled = os.path.lexists(link)
    text = web_site_text(port, read_protected_projects(), *web_locations())
    conflict = apache_conflict(port, site)
    retry = f"Choose another CUSTOM_MODS_PORT ({CUSTOM_PORT_MIN}-{CUSTOM_PORT_MAX}) in {SERVICES_CONF}, then run " \
            "ddistro_custom_mod setup-web again. Nothing was changed."
    if conflict:
        raise ModError(f"Apache already uses port {port} in {conflict}. " + retry)
    running = apache_running()
    ours_live = running and was_enabled and previous is not None and config_uses_port(previous, port)
    if not ours_live and not port_free(port):
        raise ModError(f"Port {port} is already in use by another program. " + retry)
    if previous == text and was_enabled:
        apply_apache(False, port)
        ok(f"Custom mods are served on http://127.0.0.1:{port}/.")
        return port
    write_root_file(site, text)
    try:
        if not was_enabled and run(["a2ensite", "-q", WEB_SITE], timeout=60).returncode != 0:
            raise ModError("Could not enable the custom mod listener site.")
        apply_apache(running, port)
    except ModError:
        if previous is None:
            os.unlink(site)
        else:
            write_root_file(site, previous)
        if not was_enabled and os.path.islink(link):
            os.unlink(link)
        if running:
            run(["/etc/init.d/apache2", "reload" if apache_running() else "start"], timeout=120)
        raise
    ok(f"Custom mods are served on http://127.0.0.1:{port}/.")
    return port


# --- Backup ---------------------------------------------------------------------------

def backup(entry):
    """Private root-only copy of the generated config plus a dump of the mod's own database."""
    folder = checked_folder(entry)
    ensure_state_dirs()
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d%H%M%S")
    target = f"{BACKUP_ROOT}/{entry['id']}/{stamp}-{os.getpid()}"
    os.makedirs(target, mode=0o700)
    os.chmod(os.path.dirname(target), 0o700)
    os.chmod(target, 0o700)
    config_rel = entry["setup"]["config_path"]
    config_path = folder + "/" + config_rel
    if os.path.lexists(config_path):
        if path_has_links(folder, config_rel) or not os.path.isfile(config_path):
            raise ModError("The private config is not a regular file; backup stopped.")
        with open(config_path, "rb") as source, \
                os.fdopen(os.open(target + "/config.php", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as dest:
            shutil.copyfileobj(source, dest)
    database = entry["database"]
    if database_exists(database):
        dump = target + "/database.dump"
        with os.fdopen(os.open(dump, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as handle:
            result = subprocess.run(["runuser", "-u", "postgres", "--", "pg_dump", "-p", POSTGRES_PORT,
                                     "-Fc", database], stdout=handle, stderr=subprocess.PIPE,
                                    env={"PATH": SAFE_PATH}, cwd="/", timeout=1800)
        if result.returncode != 0:
            raise ModError("The database backup failed; nothing was changed.")
    ok("Backup saved in " + target)
    return target


# --- Commands -------------------------------------------------------------------------

def resolve_source(args):
    if args.get("local_source"):
        require_root()
        return validate_local_source(args["local_source"]), True
    if not args.get("url"):
        raise ModError("A repository URL is required.")
    return validate_repository_url(args["url"]), False


def command_check(args):
    source, local = resolve_source(args)
    info("Checking the repository.")
    manifest, branch, commit, policy = inspect_repository(source, local)
    print(json.dumps(preview_document(manifest, branch, commit, source, local, policy)))


def command_install(args):
    require_root()
    source, local = resolve_source(args)
    expected = args.get("expect_commit")
    if expected is not None and not SHA_PATTERN.match(expected):
        raise ModError("--expect-commit must be a full commit id.")
    if not local and expected is None:
        raise ModError("Check the repository first; install needs the checked commit.")
    acquire_lock()
    require_php_security()
    read_protection_lists()  # a damaged list stops here, not in setup-web after the migration
    manifest, branch, commit, policy = inspect_repository(source, local)
    if manifest["schema_version"] == 2:
        raise ModError("This mod publishes release packages. Use release-check, then release-install.")
    if expected and commit != expected:
        raise ModError("The repository changed after it was checked. Check it again.")
    mod_id = manifest["id"]
    server_folder = manifest["server_folder"]
    folder = entry_folder({"id": mod_id, "server_folder": server_folder})
    database = database_name_for(mod_id)
    state, previous = registry_state(mod_id, source, local)
    if state == "registered":
        raise ModError(f"A custom mod with id {mod_id} is already registered.")
    if state == "conflict":
        raise ModError(f"A removed custom mod with id {mod_id} came from a different repository. Its folder "
                       "and database were kept and are not adopted.")
    if state == "restorable":
        # The kept checkout stays on its own branch; a newer commit is only reported for that branch.
        same_branch = previous.get("branch") == branch
        restore_entry(previous, manifest, commit if same_branch else None, policy)
        return
    if server_folder:
        require_safe_web_root()
        claim = server_folder_claims(server_folder, mod_id)
        if claim:
            raise ModError(claim)
    else:
        ensure_mod_root()
    if os.path.lexists(folder):
        raise ModError(f"{folder} already exists. It was kept; remove or rename it before installing.")
    require_existing_role()
    if database_exists(database):
        raise ModError(f"Database {database} already exists. It was kept and is not adopted.")
    if server_folder:
        # Denied on every listener before the folder exists, so no source is ever served from it.
        protect_root(server_folder)
        try:
            setup_web()
        except ModError as error:
            raise ModError(f"{error} The protection for /{server_folder} is saved but not active; nothing was installed.")

    entry = {
        "schema_version": STATUS_SCHEMA_VERSION, "id": mod_id, "name": manifest["name"],
        "description": manifest["description"], "project_url": manifest["project_url"],
        "repository": source, "local_source": local, "branch": branch, "commit": commit,
        "folder": folder, "server_folder": server_folder, "database": database,
        "dashboard_path": manifest["dashboard_path"],
        "health_path": manifest["health_path"], "setup": manifest["setup"], "assets": manifest["assets"],
        "branches": policy, "branches_checked_at": now_utc(),
        "state": "installing", "message": "Installing.", "installed_at": now_utc(), "updated_at": now_utc(),
        "operation_pid": os.getpid(),
    }

    if server_folder:
        create_direct_root(folder)
    else:
        os.mkdir(folder, 0o750)
        os.chown(folder, pwd_uid(APP_USER), group_id(WEB_GROUP))
    info(f"Downloading {manifest['name']} from branch {branch}.")
    clone = git(["clone", "--quiet", "--no-checkout", "--single-branch", "--no-tags", "--branch", branch,
                 "--", source, folder], local_source=local, timeout=CLONE_TIMEOUT, check=False)
    if clone.returncode != 0:
        # Only the folder this run just created, holding only the partial download, is removed.
        run(["rm", "-rf", "--", folder], timeout=300)
        raise ModError("Could not download the repository. Nothing was installed.")
    try:
        manifest2, _, template, commit2 = read_commit_manifest(folder, "HEAD")
        if manifest2 != manifest or commit2 != commit:
            raise ModError("The repository changed during install. Check it again.")
        git(["checkout", "--quiet", "HEAD", "--", "."], cwd=folder, message="Could not unpack the repository.")
    except ModError:
        run(["rm", "-rf", "--", folder], timeout=300)
        raise

    # From here the folder is registered so the user can retry with Update or unregister.
    write_entry(entry)
    try:
        apply_permissions(folder)
        create_database(database)
        write_config_if_missing(folder, manifest, template, mod_id)
        run_setup_checks(folder, manifest)
        setup_web()
        healthy, message = check_health(mod_id, manifest)
        if not healthy:
            raise ModError(message)
    except ModError as error:
        entry.pop("operation_pid", None)
        entry.update(state="failed", message=str(error), updated_at=now_utc())
        write_entry(entry)
        raise
    entry.pop("operation_pid", None)
    entry.update(state="ready", message="Installed.", updated_at=now_utc())
    write_entry(entry)
    ok(f"{manifest['name']} is installed.")


def pwd_uid(name):
    return pwd.getpwnam(name).pw_uid


def entry_source(entry):
    local = bool(entry.get("local_source"))
    source = validate_local_source(entry["repository"]) if local else validate_repository_url(entry["repository"])
    return source, local


def refresh_policy(entry, source, local):
    """Store the author's current branch policy; an update still runs if it cannot be read."""
    try:
        manifest, _, _, policy = inspect_repository(source, local, policy_only=True)
        if manifest["id"] != entry["id"]:
            raise ModError("the repository now declares a different mod id.")
    except ModError as error:
        info("Could not refresh the offered branches: " + str(error))
        return
    entry.update(branches=policy, branches_checked_at=now_utc())
    if entry.get("branch") not in policy["allowed"]:
        info(f"Branch {entry.get('branch')} is no longer offered by the author. Update keeps it; "
             "switch branches to move.")


def command_update(args):
    require_root()
    expected = args.get("expect_commit")
    if expected is not None and not SHA_PATTERN.match(expected):
        raise ModError("--expect-commit must be a full commit id.")
    acquire_lock()
    require_php_security()
    read_protection_lists()  # a damaged list stops here, not in setup-web after the migration
    entry = read_entry(args["id"])
    if entry.get("install_mode") == "release":
        raise ModError("This mod uses matched release packages; preview and use release-update.")
    folder = checked_folder(entry)
    source, local = entry_source(entry)
    # Update always stays on the installed branch, even when the author changed the default.
    branch = validate_branch_name(entry["branch"], "The registered branch is invalid.")
    refresh_policy(entry, source, local)
    previous_state = entry.get("state")
    entry.update(state="updating", message="Updating.", updated_at=now_utc(), operation_pid=os.getpid())
    write_entry(entry)
    progress = {"changed": False}
    try:
        update_checkout(entry, folder, source, local, branch, progress, expect_commit=expected)
    except ModError as error:
        # A refusal before any change keeps a ready mod ready; a failure after it is visible.
        if previous_state == "ready" and not progress["changed"]:
            entry.update(state="ready", message="Last update was refused: " + str(error))
        else:
            entry.update(state="failed", message="Update failed: " + str(error))
        entry.pop("operation_pid", None)
        entry["updated_at"] = now_utc()
        write_entry(entry)
        raise
    entry.pop("operation_pid", None)
    entry.update(state="ready", message="Up to date.", updated_at=now_utc())
    write_entry(entry)
    ok(f"{entry['name']} is up to date.")


def branch_target(args, entry):
    target = validate_branch_name(args.get("branch"), "Choose a supported branch name.")
    if target == entry.get("branch"):
        raise ModError(f"{entry['name']} is already on branch {target}. Use Update instead.")
    return target


def command_branches(args):
    """Explicit refresh of the offered branches, optionally previewing one target's exact commit."""
    require_root()
    acquire_lock()
    entry = read_entry(args["id"])
    refuse_pending_move(entry)
    source, local = entry_source(entry)
    target = branch_target(args, entry) if args.get("branch") else None
    manifest, branch, commit, policy = inspect_repository(source, local, target, policy_only=target is None)
    if manifest["id"] != entry["id"]:
        raise ModError("The repository now declares a different mod id. Nothing was changed.")
    entry.update(branches=policy, branches_checked_at=now_utc())
    write_entry(entry)
    document = {"schema_version": STATUS_SCHEMA_VERSION, "id": entry["id"], "name": entry.get("name", entry["id"]),
                "current_branch": entry.get("branch", ""), "current_commit": entry.get("commit", ""),
                "branches": policy, "branch": "", "commit": ""}
    if target:
        if manifest["setup"]["config_path"] != entry["setup"]["config_path"]:
            raise ModError(f"Branch {target} moves the private config path. Nothing was changed.")
        document.update(branch=branch, commit=commit)
    print(json.dumps(document))


def command_switch(args):
    """Move an installed mod to another offered branch at the reviewed commit.

    Same backup, config preservation, migration, and health steps as Update, but the
    target may diverge from the installed history. A failure returns the code to the
    previous branch and commit; database changes made by a migration are not rolled back.
    """
    require_root()
    expected = args.get("expect_commit")
    if not expected or not SHA_PATTERN.match(expected):
        raise ModError("Review the branch first; switch needs the reviewed commit.")
    acquire_lock()
    require_php_security()
    read_protection_lists()  # a damaged list stops here, not in setup-web after the migration
    entry = read_entry(args["id"])
    folder = checked_folder(entry)
    source, local = entry_source(entry)
    target = branch_target(args, entry)
    _, _, commit, policy = inspect_repository(source, local, target)
    entry.update(branches=policy, branches_checked_at=now_utc())
    before = dict(entry)
    if commit != expected:
        write_entry(entry)
        raise ModError(f"Branch {target} changed after it was reviewed. Review it again.")
    old_branch = validate_branch_name(entry["branch"], "The registered branch is invalid.")
    old_commit = entry["commit"]
    entry.update(state="updating", message=f"Switching to branch {target}.", updated_at=now_utc(),
                 operation_pid=os.getpid())
    write_entry(entry)
    progress = {"changed": False}
    try:
        update_checkout(entry, folder, source, local, target, progress, expect_commit=expected, switching=True)
    except ModError as error:
        entry.clear()
        entry.update(before)
        if not progress["changed"]:
            entry["message"] = "Last branch switch was refused: " + str(error)
        else:
            entry.update(switch_rollback(entry, folder, old_branch, old_commit, target, error, progress))
        entry["updated_at"] = now_utc()
        write_entry(entry)
        raise
    entry.pop("operation_pid", None)
    entry.update(state="ready", message=f"Switched to branch {target}.", updated_at=now_utc())
    write_entry(entry)
    ok(f"{entry['name']} is now on branch {target}.")


def switch_rollback(entry, folder, old_branch, old_commit, target, error, progress):
    """Return the code to the previous branch and commit; never claims a database rollback."""
    database_note = (f" Database changes made by the {target} migration were not rolled back; the backup "
                     "taken before the switch is in the distro's custom mod backups.") if progress.get("migrated") else ""
    try:
        git(["checkout", "--quiet", "-B", old_branch, old_commit], cwd=folder,
            message="Could not return the code to the previous branch.")
        apply_permissions(folder)
    except ModError as rollback_error:
        return {"state": "failed", "message": f"Switch to {target} failed: {error} {rollback_error} "
                                              "Choose Update to retry." + database_note}
    healthy, _ = check_health(entry["id"], {"dashboard_path": entry.get("dashboard_path", ""),
                                            "health_path": entry.get("health_path", ""),
                                            "server_folder": entry.get("server_folder", "")})
    state = "ready" if healthy and entry.get("state") == "ready" else "failed"
    return {"state": state, "message": f"Switch to {target} failed: {error} The code was returned to branch "
                                       f"{old_branch} at {old_commit[:7]}." + database_note}


def incoming_collisions(folder, new_paths):
    """Paths an update would add over existing untracked (possibly git-ignored) files or links."""
    collisions = []
    for path in sorted(new_paths):
        current = folder
        segments = path.split("/")
        for index, segment in enumerate(segments):
            current += "/" + segment
            last = index == len(segments) - 1
            if os.path.islink(current) or (os.path.lexists(current) and (last or not os.path.isdir(current))):
                collisions.append(path)
                break
    return collisions


def update_checkout(entry, folder, source, local, branch, progress, expect_commit=None, switching=False):
    """Update fast-forwards the installed branch (to expect_commit when pinned); only a switch may diverge."""
    if switching and not expect_commit:
        raise ModError("A branch switch needs the reviewed commit. Nothing was changed.")
    # Custom mods never discard edits: there is no force option here.
    status = git(["status", "--porcelain", "--untracked-files=no"], cwd=folder,
                 message="Could not read the mod folder status.")
    if status.stdout.strip():
        raise ModError("Files tracked by the mod were changed locally. Nothing was updated.")
    if switching or expect_commit:
        # Rollback recreates the registered branch at the registered commit, and a pinned update records the
        # reviewed commit for the registered branch, so both must be what is installed.
        head = git(["rev-parse", "--verify", "--quiet", "HEAD^{commit}"], cwd=folder, check=False)
        current = git(["symbolic-ref", "--quiet", "--short", "HEAD"], cwd=folder, check=False)
        if (head.stdout.decode().strip() != entry["commit"]
                or current.stdout.decode().strip() != entry["branch"]):
            raise ModError("The mod folder is not at its registered branch and commit. Nothing was changed.")
    backup(entry)
    git(["fetch", "--quiet", "--no-tags", source, f"+refs/heads/{branch}:refs/remotes/origin/{branch}"],
        cwd=folder, local_source=local, timeout=CLONE_TIMEOUT, message="Could not download the update.")
    incoming = f"refs/remotes/origin/{branch}"
    manifest, new_paths, template, commit = read_commit_manifest(folder, incoming)
    if expect_commit and commit != expect_commit:
        raise ModError(f"Branch {branch} changed after it was reviewed. Nothing was changed.")
    if manifest["id"] != entry["id"]:
        raise ModError("The update changes the mod id. Nothing was updated.")
    if manifest["setup"]["config_path"] != entry["setup"]["config_path"]:
        raise ModError("The update moves the private config path. Nothing was updated.")
    if entry.get("server_folder"):
        # The registered root decides the denials, even while this manifest has no server_folder.
        check_served_paths(manifest, " Nothing was updated.")
    if manifest["server_folder"] != entry.get("server_folder", ""):
        info(f"The repository declares server_folder {manifest['server_folder'] or '(none)'}; this install stays in "
             f"{entry['folder']}. Only migrate-root moves an installed mod.")
    # The validated commit, not the ref, is what lands, so a pinned update installs exactly the reviewed one.
    if not switching and git(["merge-base", "--is-ancestor", "HEAD", commit], cwd=folder,
                             check=False).returncode != 0:
        raise ModError("The update is not a fast-forward of the installed version. Nothing was updated.")
    local_ref = f"refs/heads/{branch}"
    if switching and git(["show-ref", "--verify", "--quiet", local_ref], cwd=folder, check=False).returncode == 0 \
            and git(["merge-base", "--is-ancestor", local_ref, expect_commit], cwd=folder,
                    check=False).returncode != 0:
        # checkout -B would discard local commits on an existing destination branch.
        raise ModError(f"The mod folder has local commits on branch {branch}. Nothing was changed.")
    old_paths = set(git(["ls-tree", "-r", "-z", "--name-only", "--full-tree", "HEAD"], cwd=folder)
                    .stdout.decode("utf-8", "replace").split(chr(0))) - {""}
    # Git may silently replace ignored files, so .gitignore alone is not protection.
    collisions = incoming_collisions(folder, new_paths - old_paths)
    if collisions:
        raise ModError(f"The update would replace local file {collisions[0]}. Nothing was updated.")
    if switching:
        git(["checkout", "--quiet", "-B", branch, expect_commit], cwd=folder, message="Could not switch branches.")
    else:
        git(["merge", "--ff-only", "--quiet", commit], cwd=folder, message="Fast-forward update failed.")
    progress["changed"] = True
    # Recorded now, so a later failure leaves the registry naming what is checked out and a pinned retry works.
    entry.update(commit=commit, branch=branch)
    apply_permissions(folder)
    write_config_if_missing(folder, manifest, template, entry["id"])
    if not database_exists(entry["database"]):
        require_existing_role()
        create_database(entry["database"])
    elif database_owner(entry["database"]) != DATABASE_ROLE:
        raise ModError("The mod database is not owned by the dwemer role.")
    progress["migrated"] = True
    run_setup_checks(folder, manifest)
    setup_web()
    healthy, message = check_health(entry["id"], dict(manifest, server_folder=entry.get("server_folder", "")))
    entry.update(name=manifest["name"], description=manifest["description"],
                 project_url=manifest["project_url"], dashboard_path=manifest["dashboard_path"],
                 health_path=manifest["health_path"], setup=manifest["setup"], assets=manifest["assets"])
    if not healthy:
        raise ModError(message)


def command_backup(args):
    require_root()
    acquire_lock()
    backup(read_entry(args["id"]))


def http_status(url):
    request = urllib.request.Request(url, method="GET", headers={"User-Agent": "ddistro_custom_mod"})
    try:
        with urllib.request.build_opener(NoRedirect).open(request, timeout=10) as response:
            return response.status
    except urllib.error.HTTPError as error:
        return error.code
    except (urllib.error.URLError, OSError):
        return 0


def route_problem(entry, server_folder):
    """Why one route of the entry's folder is not serving it safely: health 200, .git and the private config 403."""
    manifest = {"dashboard_path": entry["dashboard_path"], "health_path": entry["health_path"],
                "server_folder": server_folder}
    healthy, message = check_health(entry["id"], manifest)
    base = route_base(entry["id"], server_folder)
    if not healthy:
        return f"{base}: {message}"
    config = entry["setup"]["config_path"]
    for probe in [".git/HEAD"] + ([config] if re.match(rf"^({PROJECT_SOURCE_DIRS})/", config) else []):
        code = http_status(f"{base}/{probe}")
        if code != 403:
            return f"{base}/{probe} answered HTTP {code}, not 403."
    return None


def hold_config_lock(folder, entry):
    """The app's config lock (<config_path>.lock), taken without waiting so no config save runs during a move.

    A missing lock is not created: root would make a file the app may not open. A save that creates it
    meanwhile is still safe, because the app's config writer uses absolute paths under the old folder;
    after the rename each of its path steps fails (the root-owned custom-mods cannot gain the name
    back) and it saves nothing, while a step before the rename completes in place and moves with it.
    """
    relative = entry["setup"]["config_path"] + ".lock"
    lock = folder + "/" + relative
    if not os.path.lexists(lock):
        return None
    if path_has_links(folder, relative) or not os.path.isfile(lock):
        raise ModError("The config lock is not a regular file. Nothing was changed.")
    fd = os.open(lock, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        raise ModError("A config save is running (its lock is held). Try again when it is finished. Nothing was changed.")
    return fd


def backup_for_move(entry):
    """The usual backup (config and database), plus the registry entry and this manager's Apache site."""
    target = backup(entry)
    site = f"{APACHE_DIR}/sites-available/{WEB_SITE}.conf"
    for source, name in ((registry_path(entry["id"]), "registry.json"), (site, "apache-site.conf")):
        if os.path.isfile(source) and not os.path.islink(source):
            with open(source, "rb") as handle, \
                    os.fdopen(os.open(f"{target}/{name}", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as dest:
                shutil.copyfileobj(handle, dest)
    return target


def command_migrate_root(args):
    """Move a ready custom-mods/<id> install to WEB_ROOT/<server folder> in one same-filesystem rename.

    Nothing is copied: owners, modes, the private config and its lock keep their inodes, and the
    database, token and history are not touched. The new folder is denied on every listener, and
    Apache is seen answering with those denials, before the rename; the old URL is served from the
    same folder by an Alias until --drop-legacy-url. The registry records the move (exact source,
    destination, backup and folder inode) before the rename, so a rerun after a crash finishes or
    restarts exactly that move.
    """
    require_root()
    acquire_lock()
    read_protection_lists()
    entry = read_entry(args["id"])
    if args.get("drop_legacy_url"):
        drop_legacy_url(entry)
        return
    name = args["server_folder"]
    if entry.get("migration") is not None:
        entry = resume_move(entry, name)
        if entry is None:
            return
    if entry.get("server_folder"):
        raise ModError(f"{entry['name']} is already in {entry['folder']}. Nothing was changed.")
    if entry.get("state") != "ready":
        raise ModError(f"Only a ready mod is moved; {entry['name']} is {entry.get('state')}. Choose Update first. "
                       "Nothing was changed.")
    source = checked_folder(entry)
    dest = f"{WEB_ROOT}/{name}"
    require_safe_web_root()
    claim = server_folder_claims(name, entry["id"])
    if claim:
        raise ModError(claim + " Nothing was changed.")
    if os.lstat(source).st_dev != os.lstat(WEB_ROOT).st_dev:
        raise ModError(f"{source} and {WEB_ROOT} are on different filesystems, so it cannot be moved in place. "
                       "Nothing was changed.")
    require_clean_checkout(source, entry)
    lock_fd = hold_config_lock(source, entry)
    try:
        target = backup_for_move(entry)
        try:
            protect_root(name)
            setup_web()  # the destination is denied everywhere before anything appears there
            wait_for_root_grant(entry["id"], name)
            record = move_record(entry, name, target, source)
            write_entry(dict(entry, migration=record))
        except (OSError, ModError) as error:
            raise ModError(f"{error} Nothing was moved (backup in {target}).")
        try:
            os.rename(source, dest)
        except OSError as error:
            write_entry(entry)
            raise ModError(f"{error} Nothing was moved (backup in {target}).")
        sync_folder(MOD_ROOT)
        sync_folder(WEB_ROOT)
        finish_move(record)
    finally:
        if lock_fd is not None:
            os.close(lock_fd)


def require_clean_checkout(folder, entry):
    if git(["status", "--porcelain", "--untracked-files=no"], cwd=folder,
           message="Could not read the mod folder status.").stdout.strip():
        raise ModError("Files tracked by the mod were changed locally. Nothing was changed.")
    head = git(["rev-parse", "--verify", "--quiet", "HEAD^{commit}"], cwd=folder, check=False).stdout.decode().strip()
    current = git(["symbolic-ref", "--quiet", "--short", "HEAD"], cwd=folder, check=False).stdout.decode().strip()
    if head != entry["commit"] or current != entry["branch"]:
        raise ModError("The mod folder is not at its registered branch and commit. Nothing was changed.")


# Seconds an admin move waits for a graceful reload to be what answers; probes of a not-yet-existing root.
RELOAD_TIMEOUT = 20
RELOAD_CONFIRMATIONS = 3
ROOT_PROBES = (".git/HEAD", "config/config.php", "lib/", "config.json")


def wait_for_root_grant(mod_id, name):
    """Until Apache answers with the config that grants and protects the still-missing /<name>.

    A graceful reload returns before its children serve, and the custom port was already open, so
    neither proves anything. The old config denies all of /<name> (403); the new one grants it, so an
    unknown path is 404 while each protected path stays 403. Several fresh connections in a row must agree.
    """
    base = route_base(mod_id, name)
    nonce = "ddistro-reload-" + secrets.token_hex(8)
    expected = [404] + [403] * len(ROOT_PROBES)
    deadline, agreed = time.monotonic() + RELOAD_TIMEOUT, 0
    while True:
        answers = [http_status(f"{base}/{path}") for path in (nonce,) + ROOT_PROBES]
        agreed = agreed + 1 if answers == expected else 0
        if agreed >= RELOAD_CONFIRMATIONS:
            return
        if time.monotonic() >= deadline:
            raise ModError(f"Apache did not answer with the protection for /{name} within {RELOAD_TIMEOUT} seconds "
                           f"(HTTP {answers}, expected {expected}); is it running?")
        if not agreed:
            time.sleep(0.2)


def wait_for_routes(entry, name):
    """Both routes of the moved folder, retried until the reload that adds the alias answers, within a deadline."""
    deadline = time.monotonic() + RELOAD_TIMEOUT
    while True:
        problem = route_problem(entry, name) or route_problem(entry, "")
        if problem is None:
            return
        if time.monotonic() >= deadline:
            raise ModError(problem)
        time.sleep(0.2)


MOVE_RECORD_KEYS = {"server_folder", "source", "dest", "backup", "folder_id", "entry"}
# The only entry fields a move changes; every other field must match the recorded entry exactly.
MOVE_FIELDS = {"migration", "folder", "server_folder", "legacy_route", "message", "updated_at"}


def move_record(entry, name, target, source):
    info_ = os.lstat(source)
    return {"server_folder": name, "source": source, "dest": f"{WEB_ROOT}/{name}", "backup": target,
            "folder_id": [info_.st_dev, info_.st_ino], "entry": entry}


def same_folder(path, folder_id):
    """True only for the plain folder that was being moved (same device and inode), reached without links."""
    try:
        info_ = os.lstat(path)
    except FileNotFoundError:
        return False
    return (stat.S_ISDIR(info_.st_mode) and [info_.st_dev, info_.st_ino] == folder_id
            and os.path.realpath(path) == path)


def kept_fields(entry):
    return {key: value for key, value in entry.items() if key not in MOVE_FIELDS}


def pending_move(entry, name):
    """(entry before the move, record) of an interrupted move, once the record names exactly that move."""
    record, mod_id = entry["migration"], entry["id"]
    damaged = ModError(f"The interrupted move record of {mod_id} is damaged. Nothing was changed; restore the "
                       "registry entry from the backup it names, or move the folder back by hand.")
    if not isinstance(record, dict) or set(record) != MOVE_RECORD_KEYS:
        raise damaged
    if record["server_folder"] != name:
        raise ModError(f"The interrupted move of {mod_id} was to /{record['server_folder']}. Run migrate-root {mod_id} "
                       f"--server-folder {record['server_folder']} to finish or undo it. Nothing was changed.")
    before, backup_dir, folder_id = record["entry"], record["backup"], record["folder_id"]
    source = mod_folder(mod_id)
    if (not isinstance(before, dict) or before.get("id") != mod_id or before.get("folder") != source
            or before.get("state") != "ready" or set(before) & {"migration", "server_folder", "legacy_route"}
            or record["source"] != source or record["dest"] != f"{WEB_ROOT}/{validate_server_folder(name)}"
            or entry.get("folder") not in (source, record["dest"]) or entry.get("server_folder", "") not in ("", name)
            or kept_fields(entry) != kept_fields(before)
            or not isinstance(backup_dir, str) or os.path.dirname(backup_dir) != f"{BACKUP_ROOT}/{mod_id}"
            or not re.match(r"^[0-9]{14}-[0-9]+\Z", os.path.basename(backup_dir))
            or os.path.islink(backup_dir) or not os.path.isdir(backup_dir)
            or not isinstance(folder_id, list) or len(folder_id) != 2
            or not all(type(part) is int for part in folder_id)):
        raise damaged
    return before, record


def resume_move(entry, name):
    """Finish, or restart, a move that stopped part way. Returns the entry to restart from, or None when finished.

    Only the exact folder that was being moved is used, at exactly one of its two paths, and only while its
    checkout is clean at the registered commit; anything else is refused and left as it is.
    """
    before, record = pending_move(entry, name)
    source, dest, target = record["source"], record["dest"], record["backup"]
    at_source, at_dest = os.path.lexists(source), os.path.lexists(dest)
    if at_source and at_dest:
        raise ModError(f"Both {source} and {dest} exist, so the interrupted move of {entry['id']} cannot be resumed. "
                       f"Nothing was changed and neither is adopted; compare them by hand (backup in {target}).")
    if not at_source and not at_dest:
        raise ModError(f"Neither {source} nor {dest} exists, so the interrupted move of {entry['id']} cannot be "
                       f"resumed. Nothing was changed (backup in {target}).")
    folder = source if at_source else dest
    if not same_folder(folder, record["folder_id"]):
        raise ModError(f"{folder} is not the folder that was being moved. It is not adopted. Nothing was changed.")
    require_clean_checkout(folder, before)
    if at_source:
        write_entry(before)
        info(f"The interrupted move had not renamed {source} yet; starting it again.")
        return before
    info(f"The interrupted move had already renamed the folder to {dest}; finishing it.")
    lock_fd = hold_config_lock(dest, before)
    try:
        finish_move(record)
    finally:
        if lock_fd is not None:
            os.close(lock_fd)
    return None


def finish_move(record):
    """After the rename: record it, add the alias and check both routes; any failure moves everything back."""
    before, name, dest = record["entry"], record["server_folder"], record["dest"]
    moved = dict(before, server_folder=name, folder=dest, legacy_route=route_path(before["id"]), updated_at=now_utc(),
                 message=f"Moved to /{name}; the old /custom-mods/{before['id']} URL is kept as an alias.")
    try:
        write_entry(dict(moved, migration=record))
        setup_web()
        wait_for_routes(moved, name)
        write_entry(moved)
    except BaseException as error:
        raise ModError(f"The move failed: {error} {undo_move(record)}")
    ok(f"{before['name']} moved to {dest} (database {before['database']}, config and token kept). Canonical URL: "
       f"{route_base(before['id'], name)}/; the old {route_base(before['id'])}/ stays an alias until "
       f"ddistro_custom_mod migrate-root {before['id']} --drop-legacy-url.")


def undo_move(record):
    """Folder, then registry, then listener back as they were; reports anything it could not undo.

    The registry keeps the move record until the moved folder is back, so an interrupted undo is resumable too.
    """
    before, source, dest, target = record["entry"], record["source"], record["dest"], record["backup"]
    problems = []
    try:
        write_entry(dict(before, migration=record))
        if same_folder(dest, record["folder_id"]) and not os.path.lexists(source):
            os.rename(dest, source)
        if same_folder(source, record["folder_id"]) and not os.path.lexists(dest):
            write_entry(before)
        else:
            problems.append(f"folder ({dest} is not back at {source})")
    except (OSError, ModError) as error:
        problems.append(f"folder or registry entry ({error})")
    try:
        setup_web()
    except ModError as error:
        problems.append(f"web listener ({error})")
    if problems:
        return (f"Could not undo: {'; '.join(problems)}. The backup in {target} holds the config, database, registry "
                f"entry and Apache site; run sudo ddistro_custom_mod migrate-root {before['id']} --server-folder "
                f"{record['server_folder']} again to resume the move.")
    return f"It was undone: {source} and its registry entry are as before (backup in {target})."


def drop_legacy_url(entry):
    refuse_pending_move(entry)
    if not entry.get("legacy_route"):
        raise ModError(f"{entry['name']} has no old URL alias. Nothing was changed.")
    before = dict(entry)
    entry = dict(entry, message=f"Served only at /{entry['server_folder']}.", updated_at=now_utc())
    entry.pop("legacy_route")
    write_entry(entry)
    try:
        setup_web()
    except ModError:
        write_entry(before)
        raise
    ok(f"The old URL {route_base(entry['id'])}/ was removed; {entry['name']} is served at "
       f"{route_base(entry['id'], entry['server_folder'])}/.")


def unregistered_entry(entry):
    """The tombstone kept in place of a listed entry; files and database are not touched."""
    tombstone = dict(entry)
    tombstone.pop("operation_pid", None)
    # The lock is held, so an installing/updating entry was interrupted.
    tombstone.update(state=UNREGISTERED, unregistered_from="ready" if entry.get("state") == "ready" else "failed",
                     message="Removed from the list. Add the same repository again to restore it.",
                     updated_at=now_utc())
    return tombstone


def command_unregister(args):
    require_root()
    acquire_lock()
    entry = read_entry(args["id"])
    refuse_pending_move(entry)
    write_entry(unregistered_entry(entry))
    ok(f"{entry['name']} was removed from the list. Its folder {entry['folder']} and database "
       f"{entry['database']} were kept; add the same repository again to restore it.")


def tombstone_problem(entry, mod_id):
    """Pure checks that a tombstone still names exactly what this manager created for mod_id."""
    if entry.get("state") != UNREGISTERED or entry.get("id") != mod_id:
        return "The removed custom mod record does not match this repository."
    try:
        folder = entry_folder(entry)
    except ModError:
        folder = None
    if entry.get("folder") != folder or entry.get("database") != database_name_for(mod_id):
        return "The removed custom mod record names an unexpected folder or database."
    branch = entry.get("branch") or ""
    if (not SHA_PATTERN.match(entry.get("commit") or "") or entry.get("unregistered_from") not in ("ready", "failed")
            or not BRANCH_PATTERN.match(branch) or ".." in branch):
        return "The removed custom mod record is incomplete."
    setup = entry.get("setup")
    try:
        if not isinstance(setup, dict) or set(setup) != SETUP_KEYS:
            raise ModError("")
        validate_relative_path(setup.get("config_path"), "setup.config_path")
    except ModError:
        return "The removed custom mod record is incomplete."
    return None


def restore_entry(entry, remote_manifest, remote_commit, policy=None):
    """Put a removed mod back in the list without touching its files, config, or database.

    Only the exact folder and database named by our own root-owned tombstone are accepted,
    after the kept checkout's manifest is validated again. The checkout is never reset and
    nothing is migrated; a newer repository commit stays an explicit Update.
    """
    mod_id = remote_manifest["id"]
    problem = tombstone_problem(entry, mod_id)
    if problem:
        raise ModError(problem + " Nothing was changed.")
    folder = checked_folder(entry)
    if os.lstat(folder).st_uid != pwd_uid(APP_USER):
        raise ModError("The kept mod folder is not owned by dwemer. Nothing was changed.")
    head = git(["rev-parse", "--verify", "HEAD^{commit}"], cwd=folder,
               message="The kept mod folder is not a readable checkout. Nothing was changed.").stdout.decode().strip()
    commit = entry["commit"]
    if head != commit:
        # Only a failed Update of our own may have fast-forwarded past the recorded commit.
        fetched = git(["rev-parse", "--verify", f"refs/remotes/origin/{entry['branch']}^{{commit}}"], cwd=folder,
                      check=False).stdout.decode().strip()
        if (entry["unregistered_from"] != "failed" or head != fetched or
                git(["merge-base", "--is-ancestor", commit, head], cwd=folder, check=False).returncode != 0):
            raise ModError("The kept mod folder is at an unexpected commit. Nothing was changed.")
    manifest, _, _, _ = read_commit_manifest(folder, "HEAD")
    if manifest["id"] != mod_id or manifest["setup"]["config_path"] != entry["setup"]["config_path"]:
        raise ModError("The kept checkout's manifest does not match its record. Nothing was changed.")
    config_rel = entry["setup"]["config_path"]
    config_path = folder + "/" + config_rel
    if path_has_links(folder, config_rel) or (os.path.lexists(config_path) and not os.path.isfile(config_path)):
        raise ModError("The kept private config is not a regular file. Nothing was changed.")
    database = entry["database"]
    has_database = database_exists(database)
    if has_database and database_owner(database) != DATABASE_ROLE:
        raise ModError("The kept database is not owned by the dwemer role. Nothing was changed.")
    restored = restored_entry(entry, head, remote_commit, has_database and os.path.isfile(config_path))
    restored["assets"] = manifest["assets"]
    if policy:
        restored.update(branches=policy, branches_checked_at=now_utc())
    setup_web()
    write_entry(restored)
    ok(f"{entry['name']} is back in the list. Its files, private config, and database were kept as they were.")


def restored_entry(entry, head, remote_commit, setup_present):
    """A ready mod returns ready at its installed commit; anything unfinished needs Update."""
    restored = dict(entry)
    previous = restored.pop("unregistered_from", None)
    if previous == "ready" and head == entry["commit"] and setup_present:
        message = "Restored with the installed version."
        if remote_commit and remote_commit != head:
            message += " A newer version is available; choose Update to install it."
        restored.update(state="ready", message=message)
    else:
        restored.update(state="failed", commit=head, message="Restored. Setup is not finished; choose Update to retry.")
    restored["updated_at"] = now_utc()
    return restored


def status_entry(entry, check):
    state = entry.get("state", "failed")
    message = entry.get("message", "")
    if state in ("installing", "updating") and not operation_running(entry):
        state, message = "failed", "The last operation was interrupted. Choose Update to retry."
    try:
        refuse_pending_move(entry)
    except ModError as error:
        state, message = "failed", str(error)
    manifest ={"dashboard_path": entry.get("dashboard_path", ""), "health_path": entry.get("health_path", ""),
                "server_folder": entry.get("server_folder", "")}
    dashboard_url, health_url = mod_urls(entry["id"], manifest)
    document = {
        "id": entry["id"], "name": entry.get("name", entry["id"]), "description": entry.get("description", ""),
        "project_url": entry.get("project_url", ""), "repository": entry.get("repository", ""),
        "branch": entry.get("branch", ""), "commit": entry.get("commit", ""), "state": state,
        "message": message, "folder": entry.get("folder", ""), "database": entry.get("database", ""),
        "dashboard_url": dashboard_url, "health_url": health_url, "updated_at": entry.get("updated_at", ""),
        "server_folder": entry.get("server_folder", ""),
        "install_mode": entry.get("install_mode", "branch"),
        "release": entry.get("release"), "pending_release": entry.get("pending_release"),
        # The old URL of a migrated mod, kept until its clients are rebuilt; dashboard_url is canonical.
        "legacy_url": (route_base(entry["id"]) + "/") if entry.get("legacy_route") else "",
    }
    document.update(asset_urls(entry))
    # The last checked author policy, read from the registry only: status never contacts the remote.
    document["branches"] = stored_policy(entry)
    document["branches_checked_at"] = entry.get("branches_checked_at", "")
    if check:
        healthy, health_message = check_health(entry["id"], manifest)
        document["health"] = "ok" if healthy else "failed"
        document["health_message"] = health_message
    return document


def operation_running(entry):
    """Busy only while the manager run that wrote this entry still holds the shared lock."""
    pid = entry.get("operation_pid")
    return isinstance(pid, int) and pid == lock_pid() and lock_owner_alive()


def command_setup_web(args):
    require_root()
    acquire_lock()
    mod_id = args.get("protect_project") or args.get("protect_root")
    if not mod_id:
        setup_web()
        return
    if args.get("protect_root"):
        protect_root(mod_id)
    else:
        protect_project(mod_id)
    try:
        setup_web()
    except ModError as error:
        raise ModError(f"{error} The protection for {mod_id} is saved but not active; do not place its "
                       "source until sudo ddistro_custom_mod setup-web succeeds.")


def command_status(args):
    if args.get("id"):
        entries = [read_entry(args["id"])]
    else:
        entries = list_entries()
    mods = []
    for entry in entries:
        try:
            validate_mod_id(entry.get("id"))
            entry_folder(entry)
        except ModError:
            continue
        mods.append(status_entry(entry, args.get("check_health", False)))
    print(json.dumps({"schema_version": STATUS_SCHEMA_VERSION, "mods": mods}))


def release_support():
    """Load the distro-owned sibling helper, never a module from an installed mod."""
    name = "ddistro_mod_release"
    if name not in sys.modules:
        spec = importlib.util.spec_from_file_location(name, os.path.join(os.path.dirname(__file__), name + ".py"))
        if spec is None or spec.loader is None:
            raise ModError("Update Distro to install release package support.")
        module = importlib.util.module_from_spec(spec)
        sys.modules[name] = module
        spec.loader.exec_module(module)
    return sys.modules[name]


def command_release(args):
    release_support().command(globals(), args)


USAGE = """Usage: ddistro_custom_mod <command> [options]

  status [<id>] [--check-health] --json
  check <https-url> --json             Preview a repository's manifest (no changes).
  install <https-url> --expect-commit <sha>
  release-check <github-url> [--tag <version>] --json
  release-install <github-url> --tag <version> --expect-commit <sha> --expect-release <sha256>
  release-update <id> --tag <version> --expect-commit <sha> --expect-release <sha256>
                                       Install matching published server packages; never git pull.
  update <id> [--expect-commit <sha>]  Back up, then fast-forward and migrate (same branch);
                                       with --expect-commit, only to exactly that commit.
  branches <id> [--branch <name>] --json
                                       Refresh the offered branches; with --branch, preview its commit.
  switch <id> --branch <name> --expect-commit <sha>
                                       Back up, then move to another offered branch and migrate.
  backup <id>                          Back up the private config and database.
  unregister <id>                      Remove from the list; files and database are kept,
                                       and adding the same repository again restores it.
  setup-web                            Create or move the shared loopback listener on
                                       CUSTOM_MODS_PORT from /etc/dwemerdistro_services.conf.
  setup-web --protect-project <id>     Also deny /custom-mods/<id> source folders and private
                                       files from now on; run before placing the source.
  setup-web --protect-root <Name>Server
                                       The same for /var/www/html/<Name>Server, and serve it here.
  migrate-root <id> --server-folder <Name>Server
                                       Back up, then move a ready custom-mods/<id> install to
                                       /var/www/html/<Name>Server; the old URL stays an alias.
  migrate-root <id> --drop-legacy-url  Remove that alias once every client uses the new URL.

Admin/test only: check|install --local-source </absolute/path/repo.git> (root).
For a bundle, first: git clone --bare /path/example.bundle /path/example.git
"""


def parse_args(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        sys.exit(0 if argv else 64)
    command, rest = argv[0], argv[1:]
    args = {"command": command}
    positional = []
    index = 0
    while index < len(rest):
        token = rest[index]
        if token == "--json":
            args["json"] = True
        elif token == "--check-health" and command == "status":
            args["check_health"] = True
        elif token == "--drop-legacy-url" and command == "migrate-root":
            args["drop_legacy_url"] = True
        elif token in ("--tag", "--expect-release", "--local-release") and index + 1 < len(rest):
            if not command.startswith("release-") or token[2:].replace("-", "_") in args:
                raise ModError(f"Unsupported or repeated option {token}.")
            args[token[2:].replace("-", "_")] = rest[index + 1]
            index += 1
        elif token in ("--expect-commit", "--local-source", "--branch", "--protect-project", "--protect-root",
                       "--server-folder") and index + 1 < len(rest):
            allowed = {"--expect-commit": ("install", "update", "switch", "release-install", "release-update"), "--local-source": ("check", "install"),
                       "--branch": ("branches", "switch"), "--protect-project": ("setup-web",),
                       "--protect-root": ("setup-web",), "--server-folder": ("migrate-root",)}[token]
            if command not in allowed:
                raise ModError(f"{token} is not supported for {command}.")
            if token in ("--protect-project", "--protect-root") and ("protect_project" in args or "protect_root" in args):
                raise ModError(f"{token} takes one name, once.")
            if token == "--server-folder" and "server_folder" in args:
                raise ModError("--server-folder takes one folder name.")
            args[token[2:].replace("-", "_")] = rest[index + 1]
            index += 1
        elif token.startswith("-"):
            raise ModError(f"Unknown option {token[:40]}.")
        else:
            positional.append(token)
        index += 1
    if command == "release-pair":
        if len(positional) != 1 or set(args) - {"command"}:
            raise ModError("release-pair takes one installed mod id.")
        args["id"] = validate_mod_id(positional[0])
    elif command in ("release-check", "release-install", "release-update"):
        if len(positional) > 1 or (positional and args.get("local_release") and command != "release-update"):
            raise ModError("Provide one GitHub URL, or --local-release for an administrator's local package.")
        if command == "release-update":
            if len(positional) != 1:
                raise ModError("release-update needs a registered mod id.")
            args["id"] = validate_mod_id(positional[0])
        else:
            args["url"] = positional[0] if positional else None
            if not args["url"] and not args.get("local_release"):
                raise ModError("A GitHub repository URL is required.")
        if command != "release-check" and (not SHA_PATTERN.fullmatch(args.get("expect_commit", "")) or
                not re.fullmatch(r"[a-f0-9]{64}", args.get("expect_release", ""))):
            raise ModError("Check the release first; install/update needs its commit and descriptor SHA-256.")
    elif command in ("check", "install"):
        if len(positional) > 1 or (positional and args.get("local_source")):
            raise ModError(f"{command} takes one repository URL.")
        args["url"] = positional[0] if positional else None
    elif command in ("update", "backup", "unregister", "status", "branches", "switch", "migrate-root"):
        if len(positional) > 1 or (command != "status" and len(positional) != 1):
            raise ModError(f"{command} takes one custom mod id.")
        args["id"] = validate_mod_id(positional[0]) if positional else None
        if command == "switch" and not (args.get("branch") and args.get("expect_commit")):
            raise ModError("switch needs --branch and --expect-commit.")
        if command == "migrate-root":
            if ("server_folder" in args) == bool(args.get("drop_legacy_url")):
                raise ModError("migrate-root needs exactly one of --server-folder <Name>Server or --drop-legacy-url.")
            if "server_folder" in args:
                args["server_folder"] = validate_server_folder(args["server_folder"])
    elif command == "setup-web":
        if positional:
            raise ModError("setup-web takes no arguments.")
        if "protect_project" in args:
            args["protect_project"] = validate_mod_id(args["protect_project"])
        if "protect_root" in args:
            args["protect_root"] = validate_server_folder(args["protect_root"])
    else:
        raise ModError(f"Unknown command {command[:40]}.")
    return args


COMMANDS = {"status": command_status, "check": command_check, "install": command_install,
            "release-check": command_release, "release-install": command_release, "release-update": command_release,
            "release-pair": command_release,
            "update": command_update, "backup": command_backup, "unregister": command_unregister,
            "branches": command_branches, "switch": command_switch, "setup-web": command_setup_web,
            "migrate-root": command_migrate_root}


def main(argv):
    os.umask(0o022)
    try:
        args = parse_args(argv)
        COMMANDS[args["command"]](args)
        return 0
    except ModError as error:
        print("[FAIL] " + redact(str(error)), file=sys.stderr, flush=True)
        return 1
    except KeyboardInterrupt:
        return 130
    finally:
        release_lock()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
